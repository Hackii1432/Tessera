From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Fri, 25 Sep 2026 13:58:12 +0200
Subject: [PATCH] Document regional post effects ownership


diff --git a/src/main/java/io/papermc/paper/entity/PlayerPostEffects.java b/src/main/java/io/papermc/paper/entity/PlayerPostEffects.java
index 8d26f700917e54ae34b7e06d7f0c3e2ece2d6d02..020aa3fb3d9fdb091f8aa9c9f5f0bc02789c6926 100644
--- a/src/main/java/io/papermc/paper/entity/PlayerPostEffects.java
+++ b/src/main/java/io/papermc/paper/entity/PlayerPostEffects.java
@@ -8,6 +8,10 @@ import org.jspecify.annotations.NullMarked;
 
 /**
  * Represents the post-effects that can be applied to a player.
+ * <p>On region-threaded servers, every operation, including {@link #values()},
+ * must run on the player's owning thread (for example, via the player's entity
+ * scheduler). The player must be active. Retained instances resolve the current
+ * player after respawn; returned lists are immutable snapshots.</p>
  * @see <a href="https://minecraft.wiki/w/Shader#Post-processing_effects">Post-Effects - Minecraft Wiki</a>
  */
 @NullMarked

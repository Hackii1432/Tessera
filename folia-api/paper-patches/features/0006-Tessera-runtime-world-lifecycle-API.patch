--- /dev/null
+++ b/src/main/java/io/papermc/paper/world/WorldCloneOptions.java
@@ -0,0 +1,94 @@
+package io.papermc.paper.world;
+
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Immutable options for validated arena-template cloning.
+ */
+@NullMarked
+public final class WorldCloneOptions {
+
+    private final boolean requireReadOnlyTemplate;
+    private final boolean flushSource;
+    private final boolean copyDataDirectory;
+    private final int spawnChunkRadius;
+
+    private WorldCloneOptions(final Builder builder) {
+        this.requireReadOnlyTemplate = builder.requireReadOnlyTemplate;
+        this.flushSource = builder.flushSource;
+        this.copyDataDirectory = builder.copyDataDirectory;
+        this.spawnChunkRadius = builder.spawnChunkRadius;
+    }
+
+    /**
+     * Conservative defaults: quiesce and flush the template, validate region
+     * files, never copy players, and prepare a 5x5 spawn area.
+     */
+    public static WorldCloneOptions defaults() {
+        return builder().build();
+    }
+
+    public static Builder builder() {
+        return new Builder();
+    }
+
+    public boolean requireReadOnlyTemplate() {
+        return this.requireReadOnlyTemplate;
+    }
+
+    public boolean flushSource() {
+        return this.flushSource;
+    }
+
+    public boolean copyDataDirectory() {
+        return this.copyDataDirectory;
+    }
+
+    public int spawnChunkRadius() {
+        return this.spawnChunkRadius;
+    }
+
+    public static final class Builder {
+        private boolean requireReadOnlyTemplate = true;
+        private boolean flushSource = true;
+        private boolean copyDataDirectory = true;
+        private int spawnChunkRadius = 2;
+
+        private Builder() {
+        }
+
+        /**
+         * Requires the caller to treat the source as a template. Tessera also
+         * quiesces a loaded source while producing the filesystem snapshot.
+         */
+        public Builder requireReadOnlyTemplate(final boolean requireReadOnlyTemplate) {
+            this.requireReadOnlyTemplate = requireReadOnlyTemplate;
+            return this;
+        }
+
+        public Builder flushSource(final boolean flushSource) {
+            this.flushSource = flushSource;
+            return this;
+        }
+
+        public Builder copyDataDirectory(final boolean copyDataDirectory) {
+            this.copyDataDirectory = copyDataDirectory;
+            return this;
+        }
+
+        /**
+         * Sets the prepared radius around spawn, from 0 through 8 chunks.
+         */
+        public Builder spawnChunkRadius(final int spawnChunkRadius) {
+            if (spawnChunkRadius < 0 || spawnChunkRadius > 8) {
+                throw new IllegalArgumentException("spawnChunkRadius must be between 0 and 8");
+            }
+            this.spawnChunkRadius = spawnChunkRadius;
+            return this;
+        }
+
+        public WorldCloneOptions build() {
+            return new WorldCloneOptions(this);
+        }
+    }
+}

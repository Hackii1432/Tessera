diff --git a/src/main/java/io/papermc/paper/threadedregions/TesseraCapabilities.java b/src/main/java/io/papermc/paper/threadedregions/TesseraCapabilities.java
new file mode 100644
index 0000000000000000000000000000000000000000..6199a5120590ddbe660287c34688372b4479a255
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/TesseraCapabilities.java
@@ -0,0 +1,30 @@
+package io.papermc.paper.threadedregions;
+
+import org.jetbrains.annotations.ApiStatus;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Stable, implementation-backed feature detection for Tessera extensions.
+ *
+ * <p>Plugins which also run on Paper or unmodified Folia should first test for
+ * the presence of this type (or use reflection) before linking it. Server names
+ * and version strings are intentionally not part of the capability contract.</p>
+ */
+@NullMarked
+@ApiStatus.NonExtendable
+public interface TesseraCapabilities {
+
+    /**
+     * Returns whether the region-safe asynchronous runtime world lifecycle is available.
+     *
+     * @return {@code true} when runtime worlds can be managed through Tessera
+     */
+    boolean supportsRuntimeWorldLifecycle();
+
+    /**
+     * Returns whether Bukkit scoreboards are implemented using Tessera's region-safe model.
+     *
+     * @return {@code true} when per-player scoreboards can be used on region threads
+     */
+    boolean supportsRegionSafeScoreboards();
+}
diff --git a/src/main/java/io/papermc/paper/world/RuntimeWorldManager.java b/src/main/java/io/papermc/paper/world/RuntimeWorldManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..0cb6ab9eb4c2d976e2906ccc1db810c2260447dc
--- /dev/null
+++ b/src/main/java/io/papermc/paper/world/RuntimeWorldManager.java
@@ -0,0 +1,52 @@
+package io.papermc.paper.world;
+
+import java.util.concurrent.CompletionStage;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+import org.bukkit.WorldCreator;
+import org.jetbrains.annotations.ApiStatus;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Controls Tessera's asynchronous, region-safe runtime world lifecycle.
+ *
+ * <p>Every method is non-blocking and may be invoked from plugin, asynchronous,
+ * entity, region, or global-region threads. Completion happens only after the
+ * requested world has reached a terminal registered or fully closed state.</p>
+ *
+ * <p>Lifecycle events are fired on the global-region thread. Chunk preparation,
+ * snapshot validation and storage I/O are not awaited by a tick thread.</p>
+ */
+@NullMarked
+@ApiStatus.NonExtendable
+public interface RuntimeWorldManager {
+
+    boolean supportsRuntimeWorldLifecycle();
+
+    /**
+     * Creates a new world. Existing world data is rejected.
+     */
+    CompletionStage<WorldLoadResult> createWorldAsync(WorldCreator creator);
+
+    /**
+     * Loads an existing world. A missing or incomplete {@code level.dat} is rejected.
+     */
+    CompletionStage<WorldLoadResult> loadWorldAsync(WorldCreator creator);
+
+    /**
+     * Creates an independent world from a validated template snapshot.
+     */
+    CompletionStage<WorldCloneResult> cloneWorldAsync(
+        World source,
+        NamespacedKey target,
+        WorldCloneOptions options
+    );
+
+    /**
+     * Quiesces, flushes, closes, and unregisters a runtime world.
+     */
+    CompletionStage<WorldUnloadResult> unloadWorldAsync(
+        World world,
+        WorldUnloadOptions options
+    );
+}
diff --git a/src/main/java/io/papermc/paper/world/WorldCloneOptions.java b/src/main/java/io/papermc/paper/world/WorldCloneOptions.java

+        TARGET_EXISTS,
+        SNAPSHOT_FAILED,
+        CORRUPT_TEMPLATE,
+        COPY_FAILED,
+        LOAD_FAILED,
+        CLEANUP_FAILED,
+        CANCELLED
+    }

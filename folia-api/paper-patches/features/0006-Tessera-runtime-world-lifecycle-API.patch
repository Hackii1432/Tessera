+package io.papermc.paper.world;
+
+import org.bukkit.World;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Result of a runtime create or load operation.
+ *
+ * @param status terminal status
+ * @param world registered world on success, otherwise {@code null}
+ * @param message diagnostic message
+ * @param cause underlying failure, when available
+ */
+@NullMarked
+public record WorldLoadResult(
+    Status status,
+    @Nullable World world,
+    String message,
+    @Nullable Throwable cause
+) {
+
+    public boolean successful() {
+        return this.status == Status.SUCCESS;
+    }
+
+    public enum Status {
+        SUCCESS,
+        UNSUPPORTED,
+        SERVER_STOPPING,
+        INVALID_REQUEST,
+        INVALID_NAME,
+        INVALID_KEY,
+        ALREADY_EXISTS,
+        ALREADY_LOADED,
+        NOT_FOUND,
+        INCOMPLETE_WORLD,
+        CORRUPT_WORLD,
+        INITIALIZATION_FAILED,
+        CHUNK_PREPARATION_FAILED,
+        REGISTRATION_FAILED,
+        ROLLBACK_FAILED,
+        CANCELLED
+    }
+}
diff --git a/src/main/java/io/papermc/paper/world/WorldUnloadOptions.java b/src/main/java/io/papermc/paper/world/WorldUnloadOptions.java
new file mode 100644
index 0000000000000000000000000000000000000000..ec4a366626ae11fb76f33e64422bb92362002474
--- /dev/null
+++ b/src/main/java/io/papermc/paper/world/WorldUnloadOptions.java
@@ -0,0 +1,99 @@
+package io.papermc.paper.world;
+
+import java.time.Duration;
+import org.bukkit.Location;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Immutable options for a runtime world unload.
+ */
+@NullMarked
+public final class WorldUnloadOptions {
+
+    private final boolean save;
+    private final PlayerHandling playerHandling;
+    private final @Nullable Location teleportTarget;
+    private final Duration timeout;
+
+    private WorldUnloadOptions(final Builder builder) {
+        this.save = builder.save;
+        this.playerHandling = builder.playerHandling;
+        this.teleportTarget = builder.teleportTarget == null ? null : builder.teleportTarget.clone();
+        this.timeout = builder.timeout;
+    }
+
+    public static WorldUnloadOptions defaults() {
+        return builder().build();
+    }
+
+    public static Builder builder() {
+        return new Builder();
+    }
+
+    public boolean save() {
+        return this.save;
+    }
+
+    public PlayerHandling playerHandling() {
+        return this.playerHandling;
+    }
+
+    public @Nullable Location teleportTarget() {
+        return this.teleportTarget == null ? null : this.teleportTarget.clone();
+    }
+
+    public Duration timeout() {
+        return this.timeout;
+    }
+
+    public enum PlayerHandling {
+        FAIL,
+        TELEPORT
+    }
+
+    public static final class Builder {
+        private boolean save = true;
+        private PlayerHandling playerHandling = PlayerHandling.FAIL;
+        private @Nullable Location teleportTarget;
+        private Duration timeout = Duration.ofSeconds(90);
+
+        private Builder() {
+        }
+
+        public Builder save(final boolean save) {
+            this.save = save;
+            return this;
+        }
+
+        public Builder failWhenPlayersPresent() {
+            this.playerHandling = PlayerHandling.FAIL;
+            this.teleportTarget = null;
+            return this;
+        }
+
+        public Builder teleportPlayers(final Location target) {
+            if (target == null || target.getWorld() == null) {
+                throw new IllegalArgumentException("Teleport target and target world must be present");
+            }
+            this.playerHandling = PlayerHandling.TELEPORT;
+            this.teleportTarget = target.clone();
+            return this;
+        }
+
+        public Builder timeout(final Duration timeout) {
+            if (timeout == null || timeout.isNegative() || timeout.isZero()) {
+                throw new IllegalArgumentException("timeout must be positive");
+            }
+            this.timeout = timeout;
+            return this;
+        }
+
+        public WorldUnloadOptions build() {
+            if (this.playerHandling == PlayerHandling.TELEPORT && this.teleportTarget == null) {
+                throw new IllegalStateException("TELEPORT player handling requires a target");
+            }
+            return new WorldUnloadOptions(this);
+        }
+    }
+}

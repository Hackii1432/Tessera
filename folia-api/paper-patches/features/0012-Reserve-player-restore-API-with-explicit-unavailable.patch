diff --git a/src/test/java/io/papermc/paper/world/PlayerRestoreApiTest.java b/src/test/java/io/papermc/paper/world/PlayerRestoreApiTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..0eeb37b70d27a56f37d84f8a93bc5050786fdd06
--- /dev/null
+++ b/src/test/java/io/papermc/paper/world/PlayerRestoreApiTest.java
@@ -0,0 +1,55 @@
+package io.papermc.paper.world;
+
+import java.lang.reflect.Modifier;
+import java.nio.file.Path;
+import java.util.EnumSet;
+import java.util.UUID;
+import java.util.concurrent.CompletionStage;
+import org.bukkit.Bukkit;
+import org.bukkit.Server;
+import org.bukkit.World;
+import org.bukkit.event.player.PlayerTeleportEvent;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PlayerRestoreApiTest {
+    @Test
+    void signaturesArePublicAndHaveNoImplementationTypes() throws Exception {
+        Class<PlayerRestoreService> api = PlayerRestoreService.class;
+        assertEquals(int.class, api.getMethod("contractVersion").getReturnType());
+        assertEquals(CompletionStage.class, api.getMethod("prepareAsync", UUID.class, Path.class, Path.class, World.class).getReturnType());
+        assertEquals(CompletionStage.class, api.getMethod("applyAsync", UUID.class, boolean.class).getReturnType());
+        assertEquals(CompletionStage.class, api.getMethod("completeAsync", UUID.class, boolean.class).getReturnType());
+        assertEquals(boolean.class, api.getMethod("isRestoreTeleport", PlayerTeleportEvent.class, UUID.class).getReturnType());
+        assertEquals(api, Bukkit.class.getMethod("getPlayerRestoreService").getReturnType());
+        assertTrue(Modifier.isStatic(Bukkit.class.getMethod("getPlayerRestoreService").getModifiers()));
+        assertEquals(api, Server.class.getMethod("getPlayerRestoreService").getReturnType());
+        for (var type : new Class<?>[]{api, PlayerRestoreStatus.class, PlayerRestoreResult.class}) {
+            assertTrue(Modifier.isPublic(type.getModifiers()));
+        }
+    }
+
+    @Test
+    void exactlyTheFourContractStatusesAreSuccessfulAndResultsAreReflectable() throws Exception {
+        UUID id = UUID.randomUUID();
+        var successful = EnumSet.of(PlayerRestoreStatus.PREPARED, PlayerRestoreStatus.APPLIED, PlayerRestoreStatus.ROLLED_BACK, PlayerRestoreStatus.COMPLETED);
+        for (var status : PlayerRestoreStatus.values()) {
+            Object result = new PlayerRestoreResult(id, status, "diagnostic");
+            assertEquals(id, result.getClass().getMethod("operationId").invoke(result));
+            assertEquals(status, result.getClass().getMethod("status").invoke(result));
+            assertEquals("diagnostic", result.getClass().getMethod("message").invoke(result));
+            assertEquals(successful.contains(status), result.getClass().getMethod("successful").invoke(result));
+        }
+    }
+
+    @Test
+    void nullResultComponentsAreRejected() {
+        UUID id = UUID.randomUUID();
+        assertThrows(NullPointerException.class, () -> new PlayerRestoreResult(null, PlayerRestoreStatus.PREPARED, ""));
+        assertThrows(NullPointerException.class, () -> new PlayerRestoreResult(id, null, ""));
+        assertThrows(NullPointerException.class, () -> new PlayerRestoreResult(id, PlayerRestoreStatus.PREPARED, null));
+    }
+}

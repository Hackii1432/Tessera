@@ -0,0 +1,20 @@
+package io.papermc.paper.world;
+
+/** Outcome of a player-store restore request. */
+public enum PlayerRestoreStatus {
+    PREPARED,
+    APPLIED,
+    ROLLED_BACK,
+    COMPLETED,
+    UNSUPPORTED,
+    INVALID_REQUEST,
+    CONFLICT,
+    BUSY,
+    CANCELLED,
+    VALIDATION_FAILED,
+    PLAYER_BUSY,
+    SAVE_FAILED,
+    TRANSFER_FAILED,
+    COMPLETE_FAILED,
+    SERVER_STOPPING
+}

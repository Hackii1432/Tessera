new file mode 100644
index 0000000000000000000000000000000000000000..14af820b7bc79c3eb886fa30e551433bd5088633
--- /dev/null
+++ b/src/main/java/io/papermc/paper/world/PlayerRestoreResult.java
@@ -0,0 +1,28 @@
+package io.papermc.paper.world;
+
+import java.util.Objects;
+import java.util.UUID;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Public, reflection-accessible restore result.
+ *
+ * @param operationId requested operation identity
+ * @param status outcome
+ * @param message diagnostic, never null
+ */
+@NullMarked
+public record PlayerRestoreResult(UUID operationId, PlayerRestoreStatus status, String message) {
+    public PlayerRestoreResult {
+        Objects.requireNonNull(operationId, "operationId");
+        Objects.requireNonNull(status, "status");
+        Objects.requireNonNull(message, "message");
+    }
+
+    public boolean successful() {
+        return switch (this.status) {
+            case PREPARED, APPLIED, ROLLED_BACK, COMPLETED -> true;
+            default -> false;
+        };
+    }
+}
diff --git a/src/main/java/io/papermc/paper/world/PlayerRestoreService.java b/src/main/java/io/papermc/paper/world/PlayerRestoreService.java
new file mode 100644
index 0000000000000000000000000000000000000000..774757b93dcfaabd4a67195d32e74061ec9bed00
--- /dev/null
+++ b/src/main/java/io/papermc/paper/world/PlayerRestoreService.java
@@ -0,0 +1,67 @@
+package io.papermc.paper.world;
+
+import java.nio.file.Path;
+import java.util.UUID;
+import java.util.concurrent.CompletionStage;
+import org.bukkit.World;
+import org.bukkit.event.player.PlayerTeleportEvent;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Server-owned restoration of the shared vanilla player store.
+ * Callers must check {@link #contractVersion()} before starting a live load.
+ * Version {@code 0} means unavailable; it must never enable MCC's v1 adapter.
+ * Version {@code 1} is reserved for the complete MCC live-load contract.
+ * No stage may be synchronously awaited on a tick or network thread.
+ * Operation identities are retained until server restart, including cancelled
+ * identities. Restart recovery remains the caller's offline journal's responsibility.
+ */
+@NullMarked
+public interface PlayerRestoreService {
+    /** @return 1 only when the complete live-restore contract is supported; otherwise 0 */
+    int contractVersion();
+
+    /**
+     * Validate the immutable source and capture a durable, fresh rollback store.
+     * The source and rollback roots contain {@code data}, {@code stats}, and
+     * {@code advancements}. The rollback root must not exist. Successful prepare
+     * keeps gameplay and player-store writes fenced until completion.
+     *
+     * @param operationId non-null operation identity
+     * @param sourcePlayers immutable staging root
+     * @param rollbackPlayers new rollback root
+     * @param fallbackWorld spawn world for players absent from the source
+     * @return non-null stage carrying the requested identity
+     */
+    CompletionStage<PlayerRestoreResult> prepareAsync(UUID operationId, Path sourcePlayers, Path rollbackPlayers, World fallbackWorld);
+
+    /**
+     * Apply the source, or drain preceding work and restore the rollback state.
+     * Rollback also accepts unknown identities and prevents their later prepare.
+     *
+     * @param operationId non-null operation identity
+     * @param forward true to apply; false to roll back
+     * @return completion after all owned work has settled
+     */
+    CompletionStage<PlayerRestoreResult> applyAsync(UUID operationId, boolean forward);
+
+    /**
+     * Release the fence after the matching applied or rolled-back decision.
+     * The caller durably commits its journal before passing {@code true}.
+     *
+     * @param operationId non-null operation identity
+     * @param committed matching final decision
+     * @return completion; failures retain the fence and allow retry
+     */
+    CompletionStage<PlayerRestoreResult> completeAsync(UUID operationId, boolean committed);
+
+    /**
+     * Test the identity of the exact restore teleport event during its dispatch.
+     * This is never a general permission to teleport a player under restoration.
+     *
+     * @param event event currently being dispatched
+     * @param operationId operation identity
+     * @return true only for that operation's concrete native transfer event
+     */
+    boolean isRestoreTeleport(PlayerTeleportEvent event, UUID operationId);
+}
diff --git a/src/main/java/io/papermc/paper/world/PlayerRestoreStatus.java b/src/main/java/io/papermc/paper/world/PlayerRestoreStatus.java

diff --git a/ca/spottedleaf/dataconverter/minecraft/MCDataConverter.java b/ca/spottedleaf/dataconverter/minecraft/MCDataConverter.java
index 45da8ee6046fa5e3dfa88dd90a112b11aa60dc6c..7830fda877a53901951cfbc2ecff04cafb71eef2 100644
--- a/ca/spottedleaf/dataconverter/minecraft/MCDataConverter.java
+++ b/ca/spottedleaf/dataconverter/minecraft/MCDataConverter.java
@@ -3,17 +3,29 @@ package ca.spottedleaf.dataconverter.minecraft;
 import ca.spottedleaf.converter.DataConverter;
 import ca.spottedleaf.converter.datatypes.DataType;
 import ca.spottedleaf.dataconverter.minecraft.datatypes.MCDataType;
+import ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry;
 import ca.spottedleaf.dataconverter.minecraft.versions.V99;
 import ca.spottedleaf.dataconverter.types.json.JsonMapType;
 import ca.spottedleaf.dataconverter.types.nbt.NBTMapType;
 import com.google.gson.JsonObject;
+import com.mojang.datafixers.DSL;
+import com.mojang.serialization.Dynamic;
+import com.mojang.serialization.JsonOps;
 import it.unimi.dsi.fastutil.longs.LongArrayList;
 import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtOps;
+import net.minecraft.util.datafix.DataFixers;
+import net.minecraft.util.datafix.fixes.References;
 
 public final class MCDataConverter {
 
     private static final LongArrayList BREAKPOINTS = MCVersionRegistry.getBreakpoints();
 
+    // Sinopia - the bundled converters cover 26.2. Let vanilla perform all newer
+    // schema changes, including 26.3 block-state fields and the terrain stage merge.
+    // Never run the old walkers on data that already uses the new schema.
+    private static final int LAST_NATIVE_VERSION = MCVersions.V26_2;
+
     public static <T> T copy(final T type) {
         if (type instanceof CompoundTag) {
             return (T)((CompoundTag)type).copy();
@@ -25,6 +37,17 @@ public final class MCDataConverter {
     }
 
     public static CompoundTag convertTag(final MCDataType type, final CompoundTag data, final int fromVersion, final int toVersion) {
+        if (fromVersion >= toVersion) {
+            return data;
+        }
+        if (toVersion > LAST_NATIVE_VERSION) {
+            final DSL.TypeReference reference = vanillaType(type);
+            final boolean vanillaOnly = type == MCTypeRegistry.LEVEL || type == MCTypeRegistry.LIGHTWEIGHT_LEVEL;
+            final CompoundTag intermediate = !vanillaOnly && fromVersion < LAST_NATIVE_VERSION
+                ? convertTag(type, data, fromVersion, LAST_NATIVE_VERSION) : data;
+            return (CompoundTag)DataFixers.getDataFixer().update(reference, new Dynamic<>(NbtOps.INSTANCE, intermediate),
+                vanillaOnly ? fromVersion : Math.max(fromVersion, LAST_NATIVE_VERSION), toVersion).getValue();
+        }
         final NBTMapType wrapped = new NBTMapType(data);
 
         final NBTMapType replaced = (NBTMapType)convert(type, wrapped, fromVersion, toVersion);
@@ -33,6 +56,18 @@ public final class MCDataConverter {
     }
 
     public static JsonObject convertJson(final MCDataType type, final JsonObject data, final boolean compressed, final int fromVersion, final int toVersion) {
+        if (fromVersion >= toVersion) {
+            return data;
+        }
+        if (toVersion > LAST_NATIVE_VERSION) {
+            final DSL.TypeReference reference = vanillaType(type);
+            final boolean vanillaOnly = type == MCTypeRegistry.LEVEL || type == MCTypeRegistry.LIGHTWEIGHT_LEVEL;
+            final JsonObject intermediate = !vanillaOnly && fromVersion < LAST_NATIVE_VERSION
+                ? convertJson(type, data, compressed, fromVersion, LAST_NATIVE_VERSION) : data;
+            return DataFixers.getDataFixer().update(reference,
+                new Dynamic<>(compressed ? JsonOps.COMPRESSED : JsonOps.INSTANCE, intermediate),
+                vanillaOnly ? fromVersion : Math.max(fromVersion, LAST_NATIVE_VERSION), toVersion).getValue().getAsJsonObject();
+        }
         final JsonMapType wrapped = new JsonMapType(data, compressed);
 
         final JsonMapType replaced = (JsonMapType)convert(type, wrapped, fromVersion, toVersion);
@@ -82,5 +117,41 @@ public final class MCDataConverter {
         return (R)ret;
     }
 
+    private static DSL.TypeReference vanillaType(final MCDataType type) {
+        if (type == MCTypeRegistry.LEVEL) return References.LEVEL;
+        if (type == MCTypeRegistry.LIGHTWEIGHT_LEVEL) return References.LIGHTWEIGHT_LEVEL;
+        if (type == MCTypeRegistry.PLAYER) return References.PLAYER;
+        if (type == MCTypeRegistry.CHUNK) return References.CHUNK;
+        if (type == MCTypeRegistry.HOTBAR) return References.HOTBAR;
+        if (type == MCTypeRegistry.OPTIONS) return References.OPTIONS;
+        if (type == MCTypeRegistry.STRUCTURE) return References.STRUCTURE;
+        if (type == MCTypeRegistry.STATS) return References.STATS;
+        if (type == MCTypeRegistry.ADVANCEMENTS) return References.ADVANCEMENTS;
+        if (type == MCTypeRegistry.POI_CHUNK) return References.POI_CHUNK;
+        if (type == MCTypeRegistry.ENTITY_CHUNK) return References.ENTITY_CHUNK;
+        if (type == MCTypeRegistry.TILE_ENTITY) return References.BLOCK_ENTITY;
+        if (type == MCTypeRegistry.ITEM_STACK) return References.ITEM_STACK;
+        if (type == MCTypeRegistry.BLOCK_STATE) return References.BLOCK_STATE;
+        if (type == MCTypeRegistry.DATA_COMPONENTS) return References.DATA_COMPONENTS;
+        if (type == MCTypeRegistry.VILLAGER_TRADE) return References.VILLAGER_TRADE;
+        if (type == MCTypeRegistry.ENTITY) return References.ENTITY_TREE;
+        if (type == MCTypeRegistry.UNTAGGED_SPAWNER) return References.UNTAGGED_SPAWNER;
+        if (type == MCTypeRegistry.STRUCTURE_FEATURE) return References.STRUCTURE_FEATURE;
+        if (type == MCTypeRegistry.OBJECTIVE) return References.OBJECTIVE;
+        if (type == MCTypeRegistry.TEAM) return References.TEAM;
+        if (type == MCTypeRegistry.WORLD_GEN_SETTINGS) return References.WORLD_GEN_SETTINGS;
+        if (type == MCTypeRegistry.ENTITY_EQUIPMENT) return References.ENTITY_EQUIPMENT;
+        if (type == MCTypeRegistry.SAVED_DATA_RANDOM_SEQUENCES) return References.SAVED_DATA_RANDOM_SEQUENCES;
+        if (type == MCTypeRegistry.SAVED_DATA_SCOREBOARD) return References.SAVED_DATA_SCOREBOARD;
+        if (type == MCTypeRegistry.SAVED_DATA_STRUCTURE_FEATURE_INDICES) return References.SAVED_DATA_STRUCTURE_FEATURE_INDICES;
+        if (type == MCTypeRegistry.SAVED_DATA_MAP_DATA) return References.SAVED_DATA_MAP_DATA;
+        if (type == MCTypeRegistry.SAVED_DATA_RAIDS) return References.SAVED_DATA_RAIDS;
+        if (type == MCTypeRegistry.SAVED_DATA_COMMAND_STORAGE) return References.SAVED_DATA_COMMAND_STORAGE;
+        if (type == MCTypeRegistry.SAVED_DATA_MAP_INDEX) return References.SAVED_DATA_MAP_INDEX;
+        if (type == MCTypeRegistry.SAVED_DATA_TICKETS) return References.SAVED_DATA_TICKETS;
+        if (type == MCTypeRegistry.SAVED_DATA_WORLD_BORDER) return References.SAVED_DATA_WORLD_BORDER;
+        throw new IllegalArgumentException("No vanilla data-fix type for " + type.name);
+    }
+
     private MCDataConverter() {}
 }

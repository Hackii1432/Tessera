diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index d4e60de0df69f2929024b513f3c637d5e27cf6fa..b9606ee0c31788ab75f8aa828c50a9f6628740b3 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -408,9 +408,9 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
     }
 
     @Override
-    public boolean saveAllChunks(final boolean silent, final boolean flush, final boolean force) {
+    public boolean saveAllChunks(final boolean silent, final boolean flush, final boolean force, final boolean close) { // Paper - add close param
         this.notificationManager().serverSaveStarted();
-        boolean savedChunks = super.saveAllChunks(silent, flush, force);
+        boolean savedChunks = super.saveAllChunks(silent, flush, force, close); // Paper - add close param
         this.notificationManager().serverSaveCompleted();

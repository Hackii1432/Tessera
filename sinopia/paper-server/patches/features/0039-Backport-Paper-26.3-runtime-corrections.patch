Subject: [PATCH] Backport Paper 26.3 runtime corrections

Selective backports from PaperMC/Paper: a8210fd786a1e329fe6bff82620c9afaa547fe16, 4c90083394b217ada5ce9c2f41527d0f3a480f09, 74737daa9b99aa65b06b635b827cd9f024cafe7a, e285a336a6bc7ccdec8803d528c67c80d431760a. Preserve local sign placement and Folia ownership in downstream patches. Additionally honor clock event cancellation before writes and reject negative NBT lengths.

diff --git a/net/minecraft/core/component/BlockTransformer.java b/net/minecraft/core/component/BlockTransformer.java
index a47b51b11137e2bc133d93f9b4f9c6a0730eedd0..38c8f3d58865be2a80e2e2ede6622ec4d59d7872 100644
--- a/net/minecraft/core/component/BlockTransformer.java
+++ b/net/minecraft/core/component/BlockTransformer.java
@@ -68,6 +68,14 @@ public record BlockTransformer(List<BlockTransformer.BlockTransformData> transfo
                     BlockState updatedShape = transformData.updateFromNeighbors ? Block.updateFromNeighbourShapes(newBlockState, level, pos) : newBlockState;
                     Player player = context.getPlayer();
                     ItemStack itemInHand = context.getItemInHand();
+                    // Paper start - EntityChangeBlockEvent for block transformations
+                    if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(player, pos, updatedShape)) {
+                        if (itemInHand.isStackable() && !player.hasInfiniteMaterials() && player instanceof ServerPlayer serverPlayer) {
+                            serverPlayer.containerMenu.forceHeldSlot(context.getHand());
+                        }
+                        return InteractionResult.PASS;
+                    }
+                    // Paper end - EntityChangeBlockEvent for block transformations
                     if (player instanceof ServerPlayer serverPlayer) {
                         CriteriaTriggers.ITEM_USED_ON_BLOCK.trigger(serverPlayer, pos, itemInHand);
                     }

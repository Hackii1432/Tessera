diff --git a/net/minecraft/util/datafix/fixes/SinopiaRemoveTemptedMemoryFix.java b/net/minecraft/util/datafix/fixes/SinopiaRemoveTemptedMemoryFix.java
new file mode 100644
index 0000000000000000000000000000000000000000..31d557f5185e0f6b23df9002ea4a662c9667e43c
--- /dev/null
+++ b/net/minecraft/util/datafix/fixes/SinopiaRemoveTemptedMemoryFix.java
@@ -0,0 +1,22 @@
+package net.minecraft.util.datafix.fixes;
+
+import com.mojang.datafixers.DSL;
+import com.mojang.datafixers.DataFix;
+import com.mojang.datafixers.TypeRewriteRule;
+import com.mojang.datafixers.schemas.Schema;
+
+/** Paper's removed-memory migration, integrated with Sinopia's post-26.2 vanilla DFU path. */
+@org.jspecify.annotations.NullMarked
+public final class SinopiaRemoveTemptedMemoryFix extends DataFix {
+    public SinopiaRemoveTemptedMemoryFix(final Schema schema) {
+        super(schema, false);
+    }
+
+    @Override
+    protected TypeRewriteRule makeRule() {
+        return this.fixTypeEverywhereTyped("Sinopia remove obsolete is_tempted memory",
+            this.getInputSchema().getType(References.ENTITY), entity -> entity.update(DSL.remainderFinder(),
+                data -> data.update("Brain", brain -> brain.update("memories",
+                    memories -> memories.remove("minecraft:is_tempted")))));
+    }
+}

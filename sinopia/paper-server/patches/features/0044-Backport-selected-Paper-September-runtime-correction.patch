     // Paper start - lag compensation
-    private long lagCompensationTick = MinecraftServer.SERVER_INIT;
+    // Sinopia - constructor-safe clock, also used before a player has a Folia region.
+    public static long currentLagCompensationTick() {
+        return (System.nanoTime() - MinecraftServer.SERVER_INIT) / java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(50L);
+    }
+
+    private long lagCompensationTick = currentLagCompensationTick();
 
     public long getLagCompensationTick() {
         return this.lagCompensationTick;
     }
 
     public void updateLagCompensationTick() {
-        this.lagCompensationTick = (System.nanoTime() - MinecraftServer.SERVER_INIT) / (java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(50L));
+        this.lagCompensationTick = currentLagCompensationTick();
     }
     // Paper end - lag compensation
 }

diff --git a/src/test/java/io/papermc/paper/porting/NativeRestoreAdmissionTest.java b/src/test/java/io/papermc/paper/porting/NativeRestoreAdmissionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a05c90aca270db33c9b0e0e72f8b0b9b291db92d
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/NativeRestoreAdmissionTest.java
@@ -0,0 +1,43 @@
+package io.papermc.paper.porting;
+
+import java.util.List;
+import java.util.UUID;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.common.ServerboundKeepAlivePacket;
+import net.minecraft.network.protocol.common.ServerboundPongPacket;
+import net.minecraft.network.protocol.game.ServerboundAcceptTeleportationPacket;
+import net.minecraft.network.protocol.game.ServerboundPlayerLoadedPacket;
+import net.minecraft.network.protocol.game.ServerboundChatCommandPacket;
+import net.minecraft.network.protocol.game.ServerboundPlayerActionPacket;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import org.bukkit.craftbukkit.world.PlayerStoreFence;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class NativeRestoreAdmissionTest {
+    @Test
+    void fencePreservesConnectionMaintenanceAndRejectsGameplayUntilOpened() {
+        var listener = mock(ServerGamePacketListenerImpl.class, CALLS_REAL_METHODS);
+        doReturn(true).when(listener).isAcceptingMessages();
+        var gameplay = List.<Packet<?>>of(mock(ServerboundChatCommandPacket.class), mock(ServerboundPlayerActionPacket.class));
+        var control = List.<Packet<?>>of(new ServerboundKeepAlivePacket(11L), new ServerboundPongPacket(2),
+            new ServerboundAcceptTeleportationPacket(9, 1, 2, 3, 0, 0), mock(ServerboundPlayerLoadedPacket.class));
+        gameplay.forEach(packet -> assertTrue(listener.shouldHandleMessage(packet)));
+        UUID operation = UUID.randomUUID();
+        PlayerStoreFence.INSTANCE.close(operation);
+        try {
+            gameplay.forEach(packet -> assertFalse(listener.shouldHandleMessage(packet)));
+            control.forEach(packet -> assertTrue(listener.shouldHandleMessage(packet)));
+            doReturn(false).when(listener).isAcceptingMessages();
+            control.forEach(packet -> assertFalse(listener.shouldHandleMessage(packet)));
+        } finally {
+            PlayerStoreFence.INSTANCE.open(operation);
+        }
+        doReturn(true).when(listener).isAcceptingMessages();
+        gameplay.forEach(packet -> assertTrue(listener.shouldHandleMessage(packet)));
+    }
+}
diff --git a/src/test/java/io/papermc/paper/threadedregions/RestoreTaskQueueTest.java b/src/test/java/io/papermc/paper/threadedregions/RestoreTaskQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..97a207ecf0983a7580172de88e9d99fa061b03f4
--- /dev/null
+++ b/src/test/java/io/papermc/paper/threadedregions/RestoreTaskQueueTest.java
@@ -0,0 +1,82 @@
+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@Tag("Normal")
+class RestoreTaskQueueTest {
+    @Test
+    void frozenControlWorkWaitsForAllChildren() {
+        RestoreTaskQueue<String> queue = new RestoreTaskQueue<>();
+        CompletableFuture<Integer> child = new CompletableFuture<>();
+        var result = queue.submit(owner -> {
+            assertEquals("current owner", owner);
+            return child;
+        }).toCompletableFuture();
+        assertFalse(result.isDone());
+        queue.drain(() -> "current owner", () -> false);
+        assertFalse(result.isDone());
+        queue.drain(() -> "current owner", () -> true);
+        assertFalse(result.isDone());
+        child.complete(7);
+        assertEquals(7, result.join());
+    }
+
+    @Test
+    void transferStopsTheOldOwnerAndUsesTheCurrentHandle() {
+        RestoreTaskQueue<String> queue = new RestoreTaskQueue<>();
+        AtomicBoolean owns = new AtomicBoolean(true);
+        queue.submit(owner -> {
+            owns.set(false);
+            return CompletableFuture.completedStage(null);
+        });
+        var next = queue.submit(CompletableFuture::completedStage).toCompletableFuture();
+        queue.drain(() -> "old", owns::get);
+        assertFalse(next.isDone());
+        queue.drain(() -> "new", () -> true);
+        assertEquals("new", next.join());
+    }
+
+    @Test
+    void cancellationOfCallerViewDoesNotCancelOwnedWork() {
+        RestoreTaskQueue<Object> queue = new RestoreTaskQueue<>();
+        AtomicInteger calls = new AtomicInteger();
+        var stage = queue.submit(owner -> CompletableFuture.completedStage(calls.incrementAndGet()));
+        stage.toCompletableFuture().cancel(false);
+        queue.drain(Object::new, () -> true);
+        assertEquals(1, calls.get());
+        assertEquals(1, stage.toCompletableFuture().join());
+    }
+
+    @Test
+    void retirementFailsQueuedWorkButDoesNotLieAboutDispatchedChildren() {
+        RestoreTaskQueue<Object> queue = new RestoreTaskQueue<>();
+        CompletableFuture<Void> child = new CompletableFuture<>();
+        var active = queue.submit(owner -> child).toCompletableFuture();
+        queue.drain(Object::new, () -> true);
+        var waiting = queue.submit(owner -> CompletableFuture.completedStage(null)).toCompletableFuture();
+        queue.retire();
+        assertTrue(waiting.isCompletedExceptionally());
+        assertFalse(active.isDone());
+        assertTrue(queue.submit(owner -> child).toCompletableFuture().isCompletedExceptionally());
+        child.complete(null);
+        assertNull(active.join());
+    }
+
+    @Test
+    void exceptionsAndNullStagesDoNotLoseLaterTasks() {
+        RestoreTaskQueue<Object> queue = new RestoreTaskQueue<>();
+        var throwing = queue.submit(owner -> { throw new IllegalArgumentException("injected"); }).toCompletableFuture();
+        var invalid = queue.submit(owner -> null).toCompletableFuture();
+        var later = queue.submit(owner -> CompletableFuture.completedStage(2)).toCompletableFuture();
+        queue.drain(Object::new, () -> true);
+        assertTrue(throwing.isCompletedExceptionally());
+        assertTrue(invalid.isCompletedExceptionally());
+        assertEquals(2, later.join());
+    }
+}

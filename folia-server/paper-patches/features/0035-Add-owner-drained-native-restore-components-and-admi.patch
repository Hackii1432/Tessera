diff --git a/src/main/java/io/papermc/paper/threadedregions/RestoreTaskQueue.java b/src/main/java/io/papermc/paper/threadedregions/RestoreTaskQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..d0a7efd5efa7e4a3bbf789d986dc3b9cdf4a8435
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/RestoreTaskQueue.java
@@ -0,0 +1,88 @@
+package io.papermc.paper.threadedregions;
+
+import java.util.ArrayDeque;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import java.util.function.BooleanSupplier;
+import java.util.function.Function;
+import java.util.function.Supplier;
+
+/**
+ * Internal owner work, independent of gameplay time. Completion includes the
+ * returned child stage. Cancelling a caller's future cannot retire owned work.
+ * No action is invoked from admission or retirement (both may be off-owner).
+ */
+public final class RestoreTaskQueue<T> {
+    private final ArrayDeque<Task<T, ?>> queued = new ArrayDeque<>();
+    private boolean retired;
+
+    public synchronized boolean hasTasks() {
+        return !this.queued.isEmpty();
+    }
+
+    public synchronized <R> CompletionStage<R> submit(Function<T, CompletionStage<R>> action) {
+        Objects.requireNonNull(action, "action");
+        if (this.retired) {
+            return CompletableFuture.failedStage(new IllegalStateException("Restore owner has retired"));
+        }
+        Task<T, R> task = new Task<>(action);
+        this.queued.addLast(task);
+        return task.result.minimalCompletionStage();
+    }
+
+    /** Owner must be checked afresh after every action: an action can transfer it. */
+    public void drain(Supplier<T> owner, BooleanSupplier owns) {
+        final int limit;
+        synchronized (this) {
+            limit = this.queued.size();
+        }
+        for (int i = 0; i < limit && owns.getAsBoolean(); ++i) {
+            Task<T, ?> task;
+            synchronized (this) {
+                task = this.queued.pollFirst();
+            }
+            if (task == null) {
+                return;
+            }
+            task.run(owner.get());
+        }
+    }
+
+    public void retire() {
+        ArrayDeque<Task<T, ?>> pending;
+        synchronized (this) {
+            this.retired = true;
+            pending = new ArrayDeque<>(this.queued);
+            this.queued.clear();
+        }
+        // Already dispatched child stages retain their own real completion.
+        for (Task<T, ?> task : pending) {
+            task.result.completeExceptionally(new IllegalStateException("Restore owner has retired"));
+        }
+    }
+
+    private static final class Task<T, R> {
+        private final Function<T, CompletionStage<R>> action;
+        private final CompletableFuture<R> result = new CompletableFuture<>();
+
+        private Task(Function<T, CompletionStage<R>> action) {
+            this.action = action;
+        }
+
+        private void run(T owner) {
+            try {
+                Objects.requireNonNull(this.action.apply(owner), "Restore action returned null stage")
+                    .whenComplete((value, failure) -> {
+                        if (failure == null) {
+                            this.result.complete(value);
+                        } else {
+                            this.result.completeExceptionally(failure);
+                        }
+                    });
+            } catch (Throwable failure) {
+                this.result.completeExceptionally(failure);
+            }
+        }
+    }
+}

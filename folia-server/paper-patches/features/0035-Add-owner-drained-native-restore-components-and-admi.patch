diff --git a/src/main/java/org/bukkit/craftbukkit/world/NativePlayerRestoreState.java b/src/main/java/org/bukkit/craftbukkit/world/NativePlayerRestoreState.java
new file mode 100644
index 0000000000000000000000000000000000000000..9c87186fbf61c6ff12dbe311889f2037fc20d654
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/world/NativePlayerRestoreState.java
@@ -0,0 +1,171 @@
+package org.bukkit.craftbukkit.world;
+
+import com.google.gson.JsonElement;
+import com.mojang.authlib.GameProfile;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import net.minecraft.core.UUIDUtil;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtUtils;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.PlayerAdvancements;
+import net.minecraft.server.level.ClientInformation;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.stats.ServerStatsCounter;
+import net.minecraft.stats.Stat;
+import net.minecraft.util.ProblemReporter;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.storage.TagValueInput;
+import net.minecraft.world.level.storage.TagValueOutput;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.Location;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.event.player.PlayerTeleportEvent;
+
+/**
+ * Native per-player restore work. This is NOT a player-store transaction: the
+ * caller must own admission, validate every participant and publish/recover the
+ * stores before invoking it. The public restore service remains unavailable
+ * until that transaction and its crash/recovery contract have been verified.
+ */
+public final class NativePlayerRestoreState {
+    private final ServerPlayer preview;
+    private final CompoundTag canonical;
+    private final Map<Stat<?>, Integer> statistics;
+    private final JsonElement advancements;
+    private final Location target;
+
+    private NativePlayerRestoreState(ServerPlayer preview, CompoundTag canonical,
+                                     Map<Stat<?>, Integer> statistics, JsonElement advancements, Location target) {
+        this.preview = preview;
+        this.canonical = canonical;
+        this.statistics = statistics;
+        this.advancements = advancements.deepCopy();
+        this.target = target.clone();
+    }
+
+    /** Executed on the destination region, with immutable identity/options captured on the player owner. */
+    public static NativePlayerRestoreState prepare(MinecraftServer server, GameProfile profile, ClientInformation options,
+                                                  Location target, CompoundTag source, JsonElement stats, JsonElement advancements) {
+        target.checkFinite();
+        ServerLevel world = ((CraftWorld)target.getWorld()).getHandle();
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(world, target.getBlockX() >> 4, target.getBlockZ() >> 4,
+            "Cannot preflight player state off the destination region");
+        if (!world.tessera$isRuntimeWorldActive()) throw new IllegalStateException("Restore target world is unavailable");
+        var decodedStats = ServerStatsCounter.tessera$decodeRestore(server.getFixerUpper(), stats);
+        PlayerAdvancements.tessera$validateRestore(server.getFixerUpper(), advancements);
+        CompoundTag input = source == null ? null : ca.spottedleaf.dataconverter.minecraft.MCDataConverter.convertTag(
+            ca.spottedleaf.dataconverter.minecraft.datatypes.MCTypeRegistry.PLAYER, source.copy(), NbtUtils.getDataVersion(source),
+            ca.spottedleaf.dataconverter.minecraft.util.Version.getCurrentVersion());
+        ProblemReporter.Collector problems = new ProblemReporter.Collector();
+        ServerPlayer fresh = new ServerPlayer(server, world, profile, options, true);
+        if (input != null) {
+            // These identity hints must agree with the already resolved destination.
+            input.read("UUID", UUIDUtil.CODEC).ifPresent(id -> {
+                if (!id.equals(profile.id())) throw new IllegalArgumentException("Saved player UUID mismatch");
+            });
+            if (input.contains("WorldUUIDMost") || input.contains("WorldUUIDLeast")) {
+                UUID id = new UUID(input.getLong("WorldUUIDMost").orElseThrow(), input.getLong("WorldUUIDLeast").orElseThrow());
+                if (!id.equals(world.getWorld().getUID())) throw new IllegalArgumentException("Saved player world UUID mismatch");
+            }
+            input.getString("Dimension").ifPresent(key -> {
+                if (!key.equals(world.dimension().identifier().toString())) throw new IllegalArgumentException("Saved player dimension mismatch");
+            });
+            input.store("Pos", Vec3.CODEC, new Vec3(target.getX(), target.getY(), target.getZ()));
+            input.store("Rotation", net.minecraft.world.phys.Vec2.CODEC, new net.minecraft.world.phys.Vec2(target.getYaw(), target.getPitch()));
+            fresh.load(TagValueInput.create(problems, server.registryAccess(), input));
+        }
+        fresh.snapTo(target.getX(), target.getY(), target.getZ(), target.getYaw(), target.getPitch());
+        if (fresh.getRespawnConfig() != null && server.getLevel(fresh.getRespawnConfig().respawnData().dimension()) == null) {
+            throw new IllegalArgumentException("Saved respawn world is unavailable");
+        }
+        if (!Float.isFinite(fresh.getHealth()) || fresh.getHealth() <= 0) throw new IllegalArgumentException("Saved player must be alive");
+        TagValueOutput output = TagValueOutput.createWithContext(problems, server.registryAccess());
+        fresh.saveWithoutId(output);
+        if (!problems.isEmpty()) throw new IllegalArgumentException("Invalid player state: " + problems.getReport());
+        CompoundTag canonical = output.buildResult();
+        if (input != null) {
+            for (String field : List.of("RootVehicle", "ender_pearls", "abilities")) {
+                if (input.contains(field)) canonical.put(field, input.get(field).copy());
+            }
+        }
+        return new NativePlayerRestoreState(fresh, canonical, decodedStats, advancements, target);
+    }
+
+    /** Every dispatched child and the real client teleport acknowledgement belongs to this stage. */
+    public CompletionStage<Void> restore(ServerPlayer player, UUID operation) {
+        return player.getBukkitEntity().taskScheduler.scheduleRestore(entity -> this.begin((ServerPlayer)entity, operation));
+    }
+
+    private CompletionStage<Void> begin(ServerPlayer player, UUID operation) {
+        if (!player.getUUID().equals(this.preview.getUUID()) || player.hasDisconnected() || !player.isAlive()) {
+            return CompletableFuture.failedStage(new IllegalStateException("Restore player is unavailable"));
+        }
+        Location from = player.getBukkitEntity().getLocation();
+        PlayerTeleportEvent event = new PlayerTeleportEvent(player.getBukkitEntity(), from.clone(), this.target.clone(), PlayerTeleportEvent.TeleportCause.PLUGIN);
+        ((CraftPlayerRestoreService)org.bukkit.Bukkit.getPlayerRestoreService()).dispatchRestoreTeleport(event, operation);
+        if (event.isCancelled() || !this.target.equals(event.getTo())) {
+            return CompletableFuture.failedStage(new IllegalStateException("Restore teleport was vetoed or redirected"));
+        }
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(player) || !from.equals(player.getBukkitEntity().getLocation())) {
+            return CompletableFuture.failedStage(new IllegalStateException("Player moved during restore teleport event"));
+        }
+        player.closeContainer(org.bukkit.event.inventory.InventoryCloseEvent.Reason.PLUGIN);
+        player.stopRiding();
+        if (player.isPassenger() || player.isVehicle()) return CompletableFuture.failedStage(new IllegalStateException("Player mount refused restore detach"));
+        CompletableFuture<?>[] detached = List.copyOf(player.getEnderPearls()).stream().map(pearl ->
+            pearl.getBukkitEntity().taskScheduler.scheduleRestore(current -> {
+                ((net.minecraft.world.entity.projectile.Projectile)current).setOwner((Entity)null);
+                current.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DISCARD);
+                return CompletableFuture.completedStage(null);
+            }).toCompletableFuture()
+        ).toArray(CompletableFuture[]::new);
+        return CompletableFuture.allOf(detached).thenCompose(ignored -> player.getBukkitEntity().taskScheduler.scheduleRestore(current -> this.transfer((ServerPlayer)current)));
+    }
+
+    private CompletionStage<Void> transfer(ServerPlayer player) {
+        CompletableFuture<Void> transferred = new CompletableFuture<>();
+        if (player.hasDisconnected()) return CompletableFuture.failedStage(new IllegalStateException("Player disconnected before restore transfer"));
+        boolean accepted = player.teleportAsync(this.preview.level(),
+            new Vec3(this.target.getX(), this.target.getY(), this.target.getZ()), this.target.getYaw(), this.target.getPitch(), Vec3.ZERO,
+            PlayerTeleportEvent.TeleportCause.PLUGIN, Entity.TELEPORT_FLAG_LOAD_CHUNK, entity -> {
+                try {
+                    ServerPlayer current = (ServerPlayer)entity;
+                    current.tessera$replaceRestore(this.preview, this.canonical);
+                    current.getStats().tessera$replaceRestore(this.statistics, current);
+                    current.getAdvancements().tessera$replaceRestore(this.advancements, current.level().getServer().getAdvancements());
+                    this.restoreVehicle(current);
+                    CompletionStage<Void> pearls = current.tessera$loadAndSpawnEnderPearls(TagValueInput.create(ProblemReporter.DISCARDING, current.registryAccess(), this.canonical.copy()));
+                    CompletableFuture.allOf(pearls.toCompletableFuture(), current.connection.tessera$awaitRestoreAck().toCompletableFuture())
+                        .whenComplete((ignored, failure) -> {
+                            if (failure == null) transferred.complete(null);
+                            else transferred.completeExceptionally(failure);
+                        });
+                } catch (Throwable failure) {
+                    transferred.completeExceptionally(failure);
+                }
+            });
+        if (!accepted) transferred.completeExceptionally(new IllegalStateException("Native restore transfer rejected"));
+        return transferred.minimalCompletionStage();
+    }
+
+    private void restoreVehicle(ServerPlayer player) {
+        var root = this.canonical.getCompound("RootVehicle");
+        if (root.isEmpty()) return;
+        UUID attachment = root.get().read("Attach", UUIDUtil.CODEC).orElseThrow();
+        Entity existing = player.level().getEntity(attachment);
+        if (existing != null) {
+            ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(existing, "Saved vehicle belongs to another region");
+            if (!player.startRiding(existing, true, false)) throw new IllegalStateException("Saved vehicle rejected restore attachment");
+        } else {
+            player.loadAndSpawnParentVehicle(TagValueInput.create(ProblemReporter.DISCARDING, player.registryAccess(), this.canonical.copy()));
+        }
+        if (player.getVehicle() == null || !player.getVehicle().getUUID().equals(attachment)) {
+            throw new IllegalStateException("Saved vehicle could not be restored");
+        }
+    }
+}

Subject: [PATCH] Test Paper backport clock and block abort ownership


diff --git a/src/test/java/io/papermc/paper/porting/BlockBreakAbortOwnershipTest.java b/src/test/java/io/papermc/paper/porting/BlockBreakAbortOwnershipTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..441beae6237f29f3341affec6cd91f0648e3b7d0
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/BlockBreakAbortOwnershipTest.java
@@ -0,0 +1,168 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import io.papermc.paper.antixray.ChunkPacketBlockController;
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.concurrent.Executors;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.network.protocol.game.ServerboundPlayerActionPacket.Action;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.level.ServerPlayerGameMode;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.chunk.LevelChunk;
+import org.bukkit.craftbukkit.event.CraftEventFactory;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.mockito.MockedStatic;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@AllFeatures
+class BlockBreakAbortOwnershipTest {
+    private static final BlockPos POS = new BlockPos(16, 64, 16);
+    private static final BlockPos OLD = new BlockPos(512, 64, 512);
+
+    private static void field(Class<?> owner, String name, Object instance, Object value) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(instance, value);
+    }
+
+    private static final class Attempt implements AutoCloseable {
+        final ServerLevel level = mock(ServerLevel.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerPlayerGameMode gameMode;
+        final MockedStatic<TickThread> threads = mockStatic(TickThread.class);
+        final MockedStatic<CraftEventFactory> events = mockStatic(CraftEventFactory.class);
+
+        Attempt() throws Exception {
+            when(this.player.level()).thenReturn(this.level);
+            when(this.player.distanceToSqr(anyDouble(), anyDouble(), anyDouble())).thenReturn(16.0 * 16.0);
+            Inventory inventory = mock(Inventory.class);
+            when(inventory.getSelectedItem()).thenReturn(ItemStack.EMPTY);
+            when(this.player.getInventory()).thenReturn(inventory);
+            when(this.level.getChunkIfLoadedImmediately(1, 1)).thenReturn(mock(LevelChunk.class));
+            when(this.level.getBlockStateIfLoaded(OLD)).thenReturn(Blocks.STONE.defaultBlockState());
+            this.threads.when(() -> TickThread.isTickThreadFor((Entity) this.player)).thenReturn(true);
+            this.threads.when(() -> TickThread.isTickThreadFor(this.level, 1, 1, 8)).thenReturn(true);
+            field(Level.class, "chunkPacketBlockController", this.level, ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+            this.gameMode = new ServerPlayerGameMode(this.player);
+        }
+
+        void abort(boolean oldOwned) throws Exception {
+            field(ServerPlayerGameMode.class, "isDestroyingBlock", this.gameMode, true);
+            field(ServerPlayerGameMode.class, "destroyPos", this.gameMode, OLD);
+            this.threads.when(() -> TickThread.isTickThreadFor(this.level, OLD)).thenReturn(oldOwned);
+            this.gameMode.handleBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK, Direction.UP, 320, 1);
+        }
+
+        @Override
+        public void close() {
+            this.events.close();
+            this.threads.close();
+        }
+    }
+
+    @ParameterizedTest
+    @EnumSource(value = Action.class, names = {"START_DESTROY_BLOCK", "CHANGE_DESTROY_DIRECTION", "ABORT_DESTROY_BLOCK", "STOP_DESTROY_BLOCK"})
+    void onlyAbortMayUseTheExtendedRange(Action action) throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            assertEquals(action == Action.ABORT_DESTROY_BLOCK, attempt.gameMode.tessera$canProcessBlockBreakAction(POS, action));
+            when(attempt.player.isWithinBlockInteractionRange(POS, 1.0)).thenReturn(true);
+            assertTrue(attempt.gameMode.tessera$canProcessBlockBreakAction(POS, action));
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(doubles = {1023.0, 1024.0, 1025.0})
+    void extendedRangeHasThePaperBoundary(double squaredDistance) throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.player.distanceToSqr(anyDouble(), anyDouble(), anyDouble())).thenReturn(squaredDistance);
+            assertEquals(squaredDistance < 1024.0, attempt.gameMode.tessera$canProcessBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK));
+        }
+    }
+
+    @Test
+    void foreignRegionIsRejectedBeforeLookingUpChunks() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            attempt.threads.when(() -> TickThread.isTickThreadFor(attempt.level, 1, 1, 8)).thenReturn(false);
+            assertFalse(attempt.gameMode.tessera$canProcessBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK));
+            verify(attempt.level, never()).getChunkIfLoadedImmediately(anyInt(), anyInt());
+            attempt.abort(true);
+            verify(attempt.level, never()).getBlockStateIfLoaded(any());
+            verify(attempt.level, never()).destroyBlockProgress(anyInt(), any(), anyInt());
+            attempt.events.verifyNoInteractions();
+        }
+    }
+
+    @Test
+    void unloadedChunkIsRejectedWithoutLoadingOrReadingBlocks() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.level.getChunkIfLoadedImmediately(1, 1)).thenReturn(null);
+            assertFalse(attempt.gameMode.tessera$canProcessBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK));
+            attempt.abort(true);
+            verify(attempt.level, never()).getBlockStateIfLoaded(any());
+            verify(attempt.level, never()).getBlockState(any());
+            verify(attempt.level, never()).destroyBlockProgress(anyInt(), any(), anyInt());
+        }
+    }
+
+    @Test
+    void wrongPlayerThreadIsRejectedBeforeWorldAccess() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            attempt.threads.when(() -> TickThread.isTickThreadFor((Entity) attempt.player)).thenReturn(false);
+            assertFalse(attempt.gameMode.tessera$canProcessBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK));
+            verifyNoInteractions(attempt.level);
+        }
+    }
+
+    @Test
+    void dimensionChangeRejectsTheOldGameModeWorld() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.player.level()).thenReturn(mock(ServerLevel.class));
+            assertFalse(attempt.gameMode.tessera$canProcessBlockBreakAction(POS, Action.ABORT_DESTROY_BLOCK));
+            verifyNoInteractions(attempt.level);
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void staleBlockPositionIsReadOnlyIfStillOwned(boolean oldOwned) throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            attempt.abort(oldOwned);
+            verify(attempt.level, times(oldOwned ? 1 : 0)).getBlockStateIfLoaded(OLD);
+            verify(attempt.level, times(oldOwned ? 1 : 0)).destroyBlockProgress(attempt.player.getId(), OLD, -1);
+            verify(attempt.level).destroyBlockProgress(attempt.player.getId(), POS, -1);
+            attempt.events.verify(() -> CraftEventFactory.callBlockDamageAbortEvent(attempt.player, POS, ItemStack.EMPTY));
+        }
+    }
+
+    @Test
+    void twoIndependentRegionThreadsKeepTheirOwnWorlds() throws Exception {
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            var futures = executor.invokeAll(List.of(() -> runRegion(), () -> runRegion()));
+            for (var future : futures) assertTrue((Boolean) future.get());
+        }
+    }
+
+    private static boolean runRegion() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            attempt.abort(false);
+            verify(attempt.level, never()).getBlockStateIfLoaded(OLD);
+            verify(attempt.level).destroyBlockProgress(attempt.player.getId(), POS, -1);
+            return true;
+        }
+    }
+}
diff --git a/src/test/java/io/papermc/paper/porting/ClockCommandBackportTest.java b/src/test/java/io/papermc/paper/porting/ClockCommandBackportTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7ae2745acf69305b58f629a812c97f180e372fab
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/ClockCommandBackportTest.java
@@ -0,0 +1,156 @@
+package io.papermc.paper.porting;
+
+import io.papermc.paper.threadedregions.RegionizedServer;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.Supplier;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.core.Holder;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.contents.TranslatableContents;
+import net.minecraft.server.commands.TimeCommand;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.clock.ServerClockManager;
+import net.minecraft.world.clock.WorldClock;
+import org.bukkit.craftbukkit.event.CraftEventFactory;
+import org.bukkit.event.world.ClockTimeSkipEvent;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@AllFeatures
+class ClockCommandBackportTest {
+    private static final class Attempt implements AutoCloseable {
+        final CommandSourceStack source = mock(CommandSourceStack.class);
+        final ServerLevel level = mock(ServerLevel.class);
+        final ServerClockManager clocks = mock(ServerClockManager.class);
+        final ServerClockManager.ServerClockInstance instance = mock(ServerClockManager.ServerClockInstance.class);
+        final Holder<WorldClock> clock = Holder.direct(new WorldClock());
+        final ClockTimeSkipEvent event = mock(ClockTimeSkipEvent.class);
+        final AtomicLong ticks = new AtomicLong(100);
+        final List<Component> messages = new ArrayList<>();
+        final MockedStatic<RegionizedServer> globals = mockStatic(RegionizedServer.class);
+        final MockedStatic<CraftEventFactory> events = mockStatic(CraftEventFactory.class);
+
+        Attempt() {
+            this.globals.when(RegionizedServer::isGlobalTickThread).thenReturn(true);
+            when(this.source.getLevel()).thenReturn(this.level);
+            when(this.level.clockManager()).thenReturn(this.clocks);
+            when(this.clocks.getInstance(this.clock)).thenReturn(this.instance);
+            when(this.instance.totalTicks()).thenAnswer(invocation -> this.ticks.get());
+            when(this.event.callEvent()).thenReturn(true);
+            this.events.when(() -> CraftEventFactory.createTimeSkipEvent(eq(this.source), anyLong()))
+                .thenAnswer(invocation -> {
+                    when(this.event.getSkipAmount()).thenReturn(invocation.getArgument(1));
+                    return this.event;
+                });
+            doAnswer(invocation -> { this.ticks.set(invocation.getArgument(1)); return null; })
+                .when(this.clocks).setTotalTicks(eq(this.clock), anyLong());
+            doAnswer(invocation -> { this.messages.add(invocation.<Supplier<Component>>getArgument(0).get()); return null; })
+                .when(this.source).sendSuccess(any(), eq(true));
+        }
+
+        int set(int value) throws Exception {
+            Method method = TimeCommand.class.getDeclaredMethod("setTotalTicks", CommandSourceStack.class, Holder.class, int.class);
+            method.setAccessible(true);
+            try {
+                return (int) method.invoke(null, this.source, this.clock, value);
+            } catch (InvocationTargetException exception) {
+                throw (Exception) exception.getCause();
+            }
+        }
+
+        void expectError(String key, int value) {
+            CommandSyntaxException exception = assertThrows(CommandSyntaxException.class, () -> this.set(value));
+            assertEquals(key, ((TranslatableContents) ((Component) exception.getRawMessage()).getContents()).getKey());
+            verify(this.clocks, never()).setTotalTicks(any(), anyLong());
+            assertEquals(100, this.ticks.get());
+            assertTrue(this.messages.isEmpty());
+        }
+
+        @Override
+        public void close() {
+            this.events.close();
+            this.globals.close();
+        }
+    }
+
+    @Test
+    void changingTimeReportsSuccessAndWritesOnce() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            assertEquals(200, attempt.set(200));
+            assertEquals(200, attempt.ticks.get());
+            verify(attempt.clocks, times(1)).setTotalTicks(attempt.clock, 200);
+            assertEquals(1, attempt.messages.size());
+            TranslatableContents message = (TranslatableContents) attempt.messages.getFirst().getContents();
+            assertEquals("commands.time.set.absolute", message.getKey());
+            assertEquals(200L, message.getArgs()[1]);
+        }
+    }
+
+    @Test
+    void unchangedTimeDoesNotWriteOrBroadcast() {
+        try (Attempt attempt = new Attempt()) {
+            attempt.expectError("commands.time.set.already_at_time", 100);
+        }
+    }
+
+    @Test
+    void cancellationDoesNotChangeTheClock() {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.event.callEvent()).thenReturn(false);
+            attempt.expectError("sinopia.commands.time.cancelled", 200);
+        }
+    }
+
+    @Test
+    void pluginAdjustedAmountIsUsedForStorageAndResult() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.event.callEvent()).thenAnswer(invocation -> {
+                when(attempt.event.getSkipAmount()).thenReturn(250L);
+                return true;
+            });
+            assertEquals(350, attempt.set(200));
+            verify(attempt.clocks).setTotalTicks(attempt.clock, 350);
+        }
+    }
+
+    @Test
+    void pluginKeepingTheOldTimeDoesNotWrite() {
+        try (Attempt attempt = new Attempt()) {
+            when(attempt.event.callEvent()).thenAnswer(invocation -> {
+                when(attempt.event.getSkipAmount()).thenReturn(0L);
+                return true;
+            });
+            attempt.expectError("commands.time.set.already_at_time", 200);
+        }
+    }
+
+    @Test
+    void regionThreadQueuesWithoutReadingOrChangingTheClock() throws Exception {
+        try (Attempt attempt = new Attempt()) {
+            RegionizedServer global = mock(RegionizedServer.class);
+            List<Runnable> queued = new ArrayList<>();
+            attempt.globals.when(RegionizedServer::getInstance).thenReturn(global);
+            attempt.globals.when(RegionizedServer::isGlobalTickThread).thenReturn(false);
+            doAnswer(invocation -> { queued.add(invocation.getArgument(0)); return null; }).when(global).addTask(any());
+            assertEquals(0, attempt.set(200));
+            verifyNoInteractions(attempt.clocks);
+            verifyNoInteractions(attempt.event);
+            assertEquals(1, queued.size());
+            attempt.globals.when(RegionizedServer::isGlobalTickThread).thenReturn(true);
+            queued.getFirst().run();
+            assertEquals(200, attempt.ticks.get());
+            verify(attempt.clocks).setTotalTicks(attempt.clock, 200);
+        }
+    }
+}
+

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Mon, 26 Oct 2026 23:07:03 +0100
Subject: [PATCH] Revalidate alliance callbacks and test region-safe native
 entity access


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index cd86a87262ec54e16adeff50fdc427d61952869d..d473c0f422f4fc258df424ca8dc42c9b47618d01 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1447,10 +1447,23 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
 
     public boolean considersEntityAsAlly0(final @NotNull org.bukkit.entity.Entity entity) {
         this.tessera$ensureExtendedEntityOwner();
+        final CraftEntity other = (CraftEntity) entity;
+        other.tessera$ensureExtendedEntityOwner();
         if (this.additionalAlliedRules.isEmpty()) {
             return false;
         }
-        return this.additionalAlliedRules.values().stream().anyMatch(entityPredicate -> entityPredicate.test(entity));
+        final net.minecraft.world.level.Level ownerLevel = this.entity.level();
+        // Predicates may change rules or transfer/remove either participant. Never evaluate the next
+        // callback on a stale owner, and do not expose HashMap iteration to reentrant rule changes.
+        for (final Predicate<org.bukkit.entity.Entity> rule : new java.util.ArrayList<>(this.additionalAlliedRules.values())) {
+            if (!net.minecraft.world.entity.Entity.tessera$isOwnedEntity(this.entity, ownerLevel)
+                || !net.minecraft.world.entity.Entity.tessera$isOwnedEntity(other.entity, ownerLevel)) return false;
+            final boolean allied = rule.test(entity);
+            if (!net.minecraft.world.entity.Entity.tessera$isOwnedEntity(this.entity, ownerLevel)
+                || !net.minecraft.world.entity.Entity.tessera$isOwnedEntity(other.entity, ownerLevel)) return false;
+            if (allied) return true;
+        }
+        return false;
     }
 
     @Override
diff --git a/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java b/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java
index 617b7368f9bca2ca4c862cc09e40c553dce6e124..6d6332341058a100985209f929ac6d1243b53190 100644
--- a/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java

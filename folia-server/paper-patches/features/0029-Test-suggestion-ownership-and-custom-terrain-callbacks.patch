+++ b/src/test/java/io/papermc/paper/porting/CustomTerrainRegressionTest.java
@@ -0,0 +1,243 @@
+package io.papermc.paper.porting;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CyclicBarrier;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.core.Holder;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.LevelHeightAccessor;
+import net.minecraft.world.level.biome.BiomeSource;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.levelgen.Beardifier;
+import net.minecraft.world.level.levelgen.NoiseBasedChunkGenerator;
+import net.minecraft.world.level.levelgen.NoiseChunk;
+import net.minecraft.world.level.levelgen.NoiseGeneratorSettings;
+import net.minecraft.world.level.levelgen.NoiseSettings;
+import net.minecraft.world.level.levelgen.densityfunction.DensityVolume;
+import net.minecraft.world.level.levelgen.material.rule.MaterialRule;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.generator.CraftChunkData;
+import org.bukkit.craftbukkit.generator.CustomChunkGenerator;
+import org.bukkit.craftbukkit.generator.OldCraftChunkData;
+import org.bukkit.generator.ChunkGenerator;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@AllFeatures
+class CustomTerrainRegressionTest {
+    private static ChunkAccess chunk(int x) {
+        ChunkAccess chunk = mock(ChunkAccess.class);
+        when(chunk.getPos()).thenReturn(new ChunkPos(x, -7));
+        when(chunk.getHeightAccessorForGeneration()).thenReturn(LevelHeightAccessor.create(0, 16));
+        when(chunk.getSections()).thenReturn(new LevelChunkSection[0]);
+        when(chunk.getSection(anyInt())).thenReturn(mock(LevelChunkSection.class));
+        return chunk;
+    }
+
+    private static NoiseBasedChunkGenerator noise(int height) {
+        NoiseGeneratorSettings settings = mock(NoiseGeneratorSettings.class);
+        when(settings.noiseSettings()).thenReturn(new NoiseSettings(0, height));
+        when(settings.materialRule()).thenReturn(Holder.direct(mock(MaterialRule.class)));
+        return new NoiseBasedChunkGenerator(mock(BiomeSource.class), Holder.direct(settings));
+    }
+
+    private static final class Fixture {
+        final ServerLevel level = mock(ServerLevel.class);
+        final CraftWorld world = mock(CraftWorld.class);
+        final ChunkGenerator plugin = mock(ChunkGenerator.class);
+        final net.minecraft.world.level.chunk.ChunkGenerator delegate;
+        final CustomChunkGenerator generator;
+        final List<String> phases = new ArrayList<>();
+        final List<CraftChunkData> views = new ArrayList<>();
+        final Thread owner = Thread.currentThread();
+
+        Fixture(net.minecraft.world.level.chunk.ChunkGenerator delegate) {
+            this.delegate = delegate;
+            when(this.level.getWorld()).thenReturn(this.world);
+            when(this.level.getSeed()).thenReturn(913L);
+            when(this.world.getMinHeight()).thenReturn(0);
+            when(this.world.getMaxHeight()).thenReturn(16);
+            when(delegate.getBiomeSource()).thenReturn(mock(BiomeSource.class));
+            this.generator = new CustomChunkGenerator(this.level, delegate, this.plugin);
+            doAnswer(i -> { this.record("noise", i.getArgument(4)); return null; })
+                .when(this.plugin).generateNoise(any(), any(), anyInt(), anyInt(), any());
+            doAnswer(i -> { this.record("surface", i.getArgument(4)); return null; })
+                .when(this.plugin).generateSurface(any(), any(), anyInt(), anyInt(), any());
+            doAnswer(i -> { this.record("bedrock", i.getArgument(4)); return null; })
+                .when(this.plugin).generateBedrock(any(), any(), anyInt(), anyInt(), any());
+            doAnswer(i -> { this.record("caves", i.getArgument(4)); return null; })
+                .when(this.plugin).generateCaves(any(), any(), anyInt(), anyInt(), any());
+            doAnswer(i -> { this.phases.add("legacy"); throw new UnsupportedOperationException(); })
+                .when(this.plugin).generateChunkData(any(), any(), anyInt(), anyInt(), any());
+        }
+
+        void record(String phase, CraftChunkData view) {
+            assertSame(this.owner, Thread.currentThread(), "Callbacks must stay in the scheduled generation job");
+            this.phases.add(phase);
+            this.views.add(view);
+        }
+
+        CompletableFuture<ChunkAccess> generate(ChunkAccess chunk) {
+            return this.generator.buildTerrain(chunk, null, null, null, null, null, Set.of());
+        }
+
+        void assertViewsReleased() {
+            for (CraftChunkData view : this.views) assertThrows(IllegalStateException.class, view::getHandle);
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void flatAndOtherDelegatesRunCallbacksOnceInOrder(boolean vanillaNoise) {
+        Fixture f = new Fixture(mock(net.minecraft.world.level.chunk.ChunkGenerator.class));
+        ChunkAccess chunk = chunk(2);
+        when(f.plugin.shouldGenerateNoise(any(), any(), anyInt(), anyInt())).thenReturn(vanillaNoise);
+        doAnswer(i -> {
+            f.phases.add("vanilla");
+            return CompletableFuture.completedFuture(chunk);
+        }).when(f.delegate).buildTerrain(eq(chunk), isNull(), isNull(), isNull(), isNull(), isNull(), anySet());
+        assertSame(chunk, f.generate(chunk).join());
+        assertEquals(vanillaNoise ? List.of("vanilla", "noise", "surface", "bedrock", "legacy", "caves")
+            : List.of("noise", "surface", "bedrock", "legacy", "caves"), f.phases);
+        f.assertViewsReleased();
+    }
+
+    @Test
+    void zeroHeightNoiseStillRunsPluginPhasesWithoutMovingThreads() {
+        Fixture f = new Fixture(spy(noise(0)));
+        ChunkAccess chunk = chunk(2);
+        assertSame(chunk, f.generate(chunk).join());
+        assertEquals(List.of("noise", "surface", "bedrock", "legacy", "caves"), f.phases);
+        f.assertViewsReleased();
+    }
+
+    @Test
+    void normalNoiseHonorsDisabledVanillaPhasesButStillRunsPluginPhases() {
+        Fixture f = new Fixture(spy(noise(16)));
+        ChunkAccess chunk = chunk(2);
+        try (var beardifier = mockStatic(Beardifier.class);
+             var noiseChunks = mockConstruction(NoiseChunk.class, (noise, context) ->
+                 when(noise.volume()).thenReturn(new DensityVolume(16, 16, 16, 32, 0, -112)))) {
+            assertSame(chunk, f.generate(chunk).join());
+            assertEquals(List.of("noise", "surface", "bedrock", "legacy", "caves"), f.phases);
+            verify(f.plugin).shouldGenerateNoise(any(), any(), eq(2), eq(-7));
+            verify(f.plugin).shouldGenerateSurface(any(), any(), eq(2), eq(-7));
+            verify(f.plugin).shouldGenerateCaves(any(), any(), eq(2), eq(-7));
+            verify(noiseChunks.constructed().getFirst()).close();
+            f.assertViewsReleased();
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"noise", "surface", "bedrock", "caves"})
+    void callbackFailuresReleaseViewsAndStopLaterPhases(String failingPhase) {
+        Fixture f = new Fixture(mock(net.minecraft.world.level.chunk.ChunkGenerator.class));
+        org.mockito.stubbing.Answer<Void> failure = i -> {
+            f.record(failingPhase, i.getArgument(4));
+            throw new IllegalArgumentException("plugin failure");
+        };
+        switch (failingPhase) {
+            case "noise" -> doAnswer(failure).when(f.plugin).generateNoise(any(), any(), anyInt(), anyInt(), any());
+            case "surface" -> doAnswer(failure).when(f.plugin).generateSurface(any(), any(), anyInt(), anyInt(), any());
+            case "bedrock" -> doAnswer(failure).when(f.plugin).generateBedrock(any(), any(), anyInt(), anyInt(), any());
+            case "caves" -> doAnswer(failure).when(f.plugin).generateCaves(any(), any(), anyInt(), anyInt(), any());
+        }
+        var exception = assertThrows(java.util.concurrent.CompletionException.class, () -> f.generate(chunk(2)).join());
+        assertInstanceOf(IllegalArgumentException.class, exception.getCause());
+        assertEquals(failingPhase, f.phases.getLast());
+        f.assertViewsReleased();
+    }
+
+    @Test
+    void asynchronousDelegateFailureDoesNotRunPluginCallbacks() {
+        Fixture f = new Fixture(mock(net.minecraft.world.level.chunk.ChunkGenerator.class));
+        when(f.plugin.shouldGenerateNoise(any(), any(), anyInt(), anyInt())).thenReturn(true);
+        when(f.delegate.buildTerrain(any(), isNull(), isNull(), isNull(), isNull(), isNull(), anySet()))
+            .thenReturn(CompletableFuture.failedFuture(new IllegalStateException("delegate failure")));
+        assertThrows(java.util.concurrent.CompletionException.class, () -> f.generate(chunk(2)).join());
+        assertTrue(f.phases.isEmpty());
+    }
+
+    @Test
+    void parallelLegacyGeneratorsHaveIndependentDeterministicRandomState() throws Exception {
+        Fixture f = new Fixture(mock(net.minecraft.world.level.chunk.ChunkGenerator.class));
+        // This test runs callbacks in two separate admitted generation jobs.
+        doNothing().when(f.plugin).generateSurface(any(), any(), anyInt(), anyInt(), any());
+        doNothing().when(f.plugin).generateBedrock(any(), any(), anyInt(), anyInt(), any());
+        when(f.plugin.isParallelCapable()).thenReturn(true);
+        CyclicBarrier bothInsidePlugin = new CyclicBarrier(2);
+        doAnswer(i -> {
+            int x = i.getArgument(2);
+            int z = i.getArgument(3);
+            Random random = i.getArgument(1);
+            bothInsidePlugin.await(5, TimeUnit.SECONDS);
+            assertEquals(new Random((long) x * 341873128712L + (long) z * 132897987541L).nextLong(), random.nextLong());
+            return new OldCraftChunkData(0, 16, null);
+        }).when(f.plugin).generateChunkData(any(), any(), anyInt(), anyInt(), any());
+        ChunkAccess first = chunk(2);
+        ChunkAccess second = chunk(200);
+        try (var workers = Executors.newFixedThreadPool(2)) {
+            var a = workers.submit(() -> f.generator.buildSurface(first));
+            var b = workers.submit(() -> f.generator.buildSurface(second));
+            a.get(10, TimeUnit.SECONDS);
+            b.get(10, TimeUnit.SECONDS);
+        }
+        verify(first, never()).setBlockEntity(any());
+        verify(second, never()).setBlockEntity(any());
+    }
+
+    @Test
+    void parallelCallbacksOnlyMutateTheirOwnChunkViews() throws Exception {
+        Fixture f = new Fixture(mock(net.minecraft.world.level.chunk.ChunkGenerator.class));
+        ChunkAccess first = chunk(2);
+        ChunkAccess second = chunk(200);
+        CyclicBarrier bothInNoise = new CyclicBarrier(2);
+        var owners = new java.util.concurrent.ConcurrentHashMap<Integer, Thread>();
+        var views = new java.util.concurrent.ConcurrentLinkedQueue<CraftChunkData>();
+        org.mockito.stubbing.Answer<Void> write = i -> {
+            int x = i.getArgument(2);
+            CraftChunkData view = i.getArgument(4);
+            assertSame(x == 2 ? first : second, view.getHandle());
+            assertSame(owners.get(x), Thread.currentThread());
+            views.add(view);
+            view.setBlock(1, 1, 1, org.bukkit.Material.STONE);
+            return null;
+        };
+        doAnswer(i -> {
+            int x = i.getArgument(2);
+            owners.put(x, Thread.currentThread());
+            bothInNoise.await(5, TimeUnit.SECONDS);
+            return write.answer(i);
+        }).when(f.plugin).generateNoise(any(), any(), anyInt(), anyInt(), any());
+        doAnswer(write).when(f.plugin).generateSurface(any(), any(), anyInt(), anyInt(), any());
+        doAnswer(write).when(f.plugin).generateBedrock(any(), any(), anyInt(), anyInt(), any());
+        doAnswer(write).when(f.plugin).generateCaves(any(), any(), anyInt(), anyInt(), any());
+        doThrow(new UnsupportedOperationException()).when(f.plugin).generateChunkData(any(), any(), anyInt(), anyInt(), any());
+        try (var workers = Executors.newFixedThreadPool(2)) {
+            var a = workers.submit(() -> f.generate(first).join());
+            var b = workers.submit(() -> f.generate(second).join());
+            assertSame(first, a.get(10, TimeUnit.SECONDS));
+            assertSame(second, b.get(10, TimeUnit.SECONDS));
+        }
+        assertNotSame(owners.get(2), owners.get(200));
+        for (ChunkAccess chunk : List.of(first, second)) {
+            var pos = new net.minecraft.core.BlockPos(chunk.getPos().getMinBlockX() + 1, 1, chunk.getPos().getMinBlockZ() + 1);
+            verify(chunk, times(4)).setBlockState(pos, net.minecraft.world.level.block.Blocks.STONE.defaultBlockState());
+            verify(chunk, times(4)).setBlockState(any(), any());
+        }
+        for (CraftChunkData view : views) assertThrows(IllegalStateException.class, view::getHandle);
+    }
+}

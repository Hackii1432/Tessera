+package org.bukkit.craftbukkit.world;
+
+import io.papermc.paper.world.WorldSnapshotResult;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledOnOs;
+import org.junit.jupiter.api.condition.OS;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+import static org.mockito.Mockito.*;
+
+@Tag("Normal")
+class SnapshotFilesTest {
+    @TempDir Path temp;
+
+    private Path source() throws IOException {
+        final Path root = Files.createDirectory(this.temp.resolve("custom-level-name"));
+        Files.writeString(root.resolve("level.dat"), "current-level");
+        return root;
+    }
+
+    @Test
+    void copiesRequiredLevelDataAndCreatesStableEmptyDirectories() throws Exception {
+        final Path source = this.source();
+        final Path target = this.temp.resolve("level");
+        SnapshotFiles.copyLevelRoot(source, target);
+        assertEquals("current-level", Files.readString(target.resolve("level.dat")));
+        assertTrue(Files.isDirectory(target.resolve("data")));
+        assertTrue(Files.isDirectory(target.resolve("datapacks")));
+        assertFalse(Files.exists(target.resolve("level.dat_old")));
+        assertFalse(Files.exists(target.resolve("generated")));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"level.dat_old", "icon.png", "plugin-metadata.json"})
+    void copiesOptionalRegularRootFiles(final String name) throws Exception {
+        final Path source = this.source();
+        Files.writeString(source.resolve(name), "preserved");
+        SnapshotFiles.copyLevelRoot(source, this.temp.resolve("level"));
+        assertEquals("preserved", Files.readString(this.temp.resolve("level").resolve(name)));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"data", "datapacks", "generated", "resourcepacks"})
+    void copiesEntireAllowedTrees(final String directory) throws Exception {
+        final Path source = this.source();
+        Files.createDirectories(source.resolve(directory).resolve("nested/empty"));
+        Files.writeString(source.resolve(directory).resolve("nested/value.dat"), directory);
+        SnapshotFiles.copyLevelRoot(source, this.temp.resolve("level"));
+        assertEquals(directory, Files.readString(this.temp.resolve("level").resolve(directory).resolve("nested/value.dat")));
+        assertTrue(Files.isDirectory(this.temp.resolve("level").resolve(directory).resolve("nested/empty")));
+    }
+
+    @Test
+    void excludesLockDimensionPlayerAndUnknownDirectoryTrees() throws Exception {
+        final Path source = this.source();
+        Files.writeString(source.resolve("session.lock"), "locked");
+        for (final String directory : List.of("dimensions", "players", "unknown-plugin-cache")) {
+            Files.createDirectory(source.resolve(directory));
+            Files.writeString(source.resolve(directory).resolve("untouched"), directory);
+        }
+        SnapshotFiles.copyLevelRoot(source, this.temp.resolve("level"));
+        for (final String name : List.of("session.lock", "dimensions", "players", "unknown-plugin-cache")) {
+            assertFalse(Files.exists(this.temp.resolve("level").resolve(name)), name);
+            assertTrue(Files.exists(source.resolve(name)), name);
+        }
+    }
+
+    @Test
+    void missingLevelDataIsADiagnosedFailureBeforeTargetCreation() throws Exception {
+        final Path source = Files.createDirectory(this.temp.resolve("source"));
+        final var failure = assertThrows(SnapshotPipeline.Failure.class,
+            () -> SnapshotFiles.copyLevelRoot(source, this.temp.resolve("level")));
+        assertEquals(WorldSnapshotResult.Status.SAVE_FAILED, failure.status);
+        assertTrue(failure.getMessage().contains("LEVEL_ROOT_MISSING_LEVEL_DAT"));
+        assertFalse(Files.exists(this.temp.resolve("level")));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"level", "worlds", "players"})
+    void anyExistingOutputIsACollision(final String child) throws Exception {
+        final Path target = Files.createDirectory(this.temp.resolve("target"));
+        Files.writeString(target.resolve(child), "caller-owned");
+        final var failure = assertThrows(SnapshotPipeline.Failure.class, () -> SnapshotFiles.requireFreeOutputs(target));
+        assertEquals(WorldSnapshotResult.Status.TARGET_EXISTS, failure.status);
+        assertTrue(failure.getMessage().contains(child));
+        assertEquals("caller-owned", Files.readString(target.resolve(child)));
+    }
+
+    @Test
+    void rejectsOverlapInBothDirectionsIncludingNonexistentDescendants() throws Exception {
+        final Path source = this.source();
+        assertThrows(SnapshotPipeline.Failure.class, () -> SnapshotFiles.requireDisjoint(source, source.resolve("backups/future")));
+        assertThrows(SnapshotPipeline.Failure.class, () -> SnapshotFiles.requireDisjoint(source, this.temp));
+        assertThrows(SnapshotPipeline.Failure.class, () -> SnapshotFiles.requireDisjoint(source, source));
+    }
+
+    @Test
+    void rejectsSymlinkPointingIntoSnapshotTargetWithoutFollowingIt() throws Exception {
+        final Path source = this.source();
+        final Path outside = Files.createDirectory(this.temp.resolve("outside"));
+        final Path link = source.resolve("data");
+        try {
+            Files.createSymbolicLink(link, outside);
+        } catch (IOException | UnsupportedOperationException failure) {
+            assumeTrue(false, "Platform does not permit symbolic links: " + failure);
+        }
+        try {
+            Files.writeString(outside.resolve("marker"), "caller-owned");
+            assertThrows(IOException.class, () -> SnapshotFiles.copyLevelRoot(source, outside.resolve("level")));
+            assertEquals("caller-owned", Files.readString(outside.resolve("marker")));
+        } finally { Files.deleteIfExists(link); }
+    }
+
+    @Test
+    @EnabledOnOs(OS.WINDOWS)
+    void rejectsRealWindowsJunction() throws Exception {
+        final Path source = this.source();
+        final Path destination = Files.createDirectory(this.temp.resolve("junction-target"));
+        final Path junction = source.resolve("data");
+        assertTrue(junction.toAbsolutePath().startsWith(this.temp.toAbsolutePath()));
+        final Process process = new ProcessBuilder("cmd.exe", "/c", "mklink", "/J", junction.toString(), destination.toString())
+            .redirectErrorStream(true).start();
+        assertTrue(process.waitFor(10, TimeUnit.SECONDS));
+        assertEquals(0, process.exitValue(), new String(process.getInputStream().readAllBytes()));
+        try {
+            Files.writeString(destination.resolve("marker"), "untouched");
+            assertThrows(IOException.class, () -> SnapshotFiles.copyLevelRoot(source, this.temp.resolve("level")));
+            assertEquals("untouched", Files.readString(destination.resolve("marker")));
+        } finally { Files.deleteIfExists(junction); }
+    }
+
+    @Test
+    void specialFileAttributesAreNeverAccepted() throws Exception {
+        final Path file = Files.writeString(this.temp.resolve("special"), "placeholder");
+        final BasicFileAttributes attributes = mock(BasicFileAttributes.class);
+        when(attributes.isOther()).thenReturn(true);
+        assertThrows(IOException.class, () -> SnapshotFiles.requireRegularFile(file, attributes));
+    }
+
+    private Path stage() throws IOException {
+        final Path staging = Files.createDirectory(this.temp.resolve(".stage"));
+        for (final String name : SnapshotFiles.OUTPUTS) {
+            Files.createDirectory(staging.resolve(name));
+            Files.writeString(staging.resolve(name).resolve("marker"), name);
+        }
+        return staging;
+    }
+
+    private static void removeOutput(final Path output) throws IOException {
+        Files.delete(output.resolve("marker"));
+        Files.delete(output);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"level", "worlds", "players"})
+    void failedPublicationRollsBackSiblingsPreservesCallerAndResumes(final String failedOutput) throws Exception {
+        final Path staging = this.stage();
+        final Path target = Files.createDirectory(this.temp.resolve("snapshot"));
+        Files.createDirectory(target.resolve("runtime"));
+        Files.writeString(target.resolve("runtime/marker"), "caller");
+        final AtomicBoolean active = new AtomicBoolean(true);
+        final java.util.function.Supplier<java.util.concurrent.CompletionStage<Void>> completed = () -> CompletableFuture.completedFuture(null);
+        final var steps = new SnapshotPipeline.Steps(
+            () -> { active.set(false); return completed.get(); }, completed, completed, completed, completed,
+            () -> {
+                try {
+                    SnapshotFiles.publish(staging, target, (from, to) -> {
+                        if (to.getFileName().toString().equals(failedOutput)) throw new IOException("injected publication failure");
+                        Files.move(from, to);
+                    }, SnapshotFilesTest::removeOutput);
+                    return completed.get();
+                } catch (IOException failure) { return CompletableFuture.failedFuture(failure); }
+            }, () -> { active.set(true); return completed.get(); });
+        assertThrows(CompletionException.class, () -> SnapshotPipeline.run(steps, 1, TimeUnit.SECONDS).toCompletableFuture().join());
+        for (final String name : SnapshotFiles.OUTPUTS) assertFalse(Files.exists(target.resolve(name)), name);
+        assertEquals("caller", Files.readString(target.resolve("runtime/marker")));
+        assertTrue(active.get());
+    }
+
+    @Test
+    void successfulPublicationContainsExactlyThreeOutputsAndPreservesRuntime() throws Exception {
+        final Path staging = this.stage();
+        final Path target = Files.createDirectory(this.temp.resolve("snapshot"));
+        Files.createDirectory(target.resolve("runtime"));
+        SnapshotFiles.publish(staging, target, Files::move, SnapshotFilesTest::removeOutput);
+        for (final String name : SnapshotFiles.OUTPUTS) assertEquals(name, Files.readString(target.resolve(name).resolve("marker")));
+        assertTrue(Files.isDirectory(target.resolve("runtime")));
+    }
+
+    @Test
+    void concurrentCallerCollisionRollsBackOnlyOurPublishedOutputs() throws Exception {
+        final Path staging = this.stage();
+        final Path target = Files.createDirectory(this.temp.resolve("snapshot"));
+        assertThrows(IOException.class, () -> SnapshotFiles.publish(staging, target, (from, to) -> {
+            Files.move(from, to);
+            if (to.endsWith("level")) Files.writeString(target.resolve("players"), "caller-owned");
+        }, SnapshotFilesTest::removeOutput));
+        assertFalse(Files.exists(target.resolve("level")));
+        assertFalse(Files.exists(target.resolve("worlds")));
+        assertEquals("caller-owned", Files.readString(target.resolve("players")));
+    }
+
+    @Test
+    void rollbackAttemptsEveryOwnedSiblingEvenIfOneRemovalFails() throws Exception {
+        final Path staging = this.stage();
+        final Path target = Files.createDirectory(this.temp.resolve("snapshot"));
+        final List<String> removals = new ArrayList<>();
+        final var failure = assertThrows(SnapshotPipeline.Failure.class, () -> SnapshotFiles.publish(staging, target, (from, to) -> {
+            if (to.endsWith("players")) throw new IOException("publication failed");
+            Files.move(from, to);
+        }, owned -> {
+            removals.add(owned.getFileName().toString());
+            if (owned.endsWith("worlds")) throw new SecurityException("removal denied");
+            throw new IOException("removal failed");
+        }));
+        assertEquals(WorldSnapshotResult.Status.CLEANUP_FAILED, failure.status);
+        assertEquals(List.of("worlds", "level"), removals);
+    }
+}

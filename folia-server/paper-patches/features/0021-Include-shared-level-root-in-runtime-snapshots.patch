diff --git a/src/main/java/org/bukkit/craftbukkit/world/SnapshotFiles.java b/src/main/java/org/bukkit/craftbukkit/world/SnapshotFiles.java
new file mode 100644
index 000000000..a5e129bfe
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/world/SnapshotFiles.java
@@ -0,0 +1,162 @@
+package org.bukkit.craftbukkit.world;
+
+import io.papermc.paper.world.WorldSnapshotResult;
+import java.io.IOException;
+import java.nio.file.FileVisitResult;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.SimpleFileVisitor;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** Filesystem part of the existing frozen-world snapshot, never a live-world fallback copy. */
+final class SnapshotFiles {
+    static final List<String> OUTPUTS = List.of("level", "worlds", "players");
+    private static final Set<String> LEVEL_DIRECTORIES = Set.of("data", "datapacks", "generated", "resourcepacks");
+    private static final Set<String> EXCLUDED = Set.of("session.lock", "dimensions", "players");
+
+    static void requireFreeOutputs(final Path target) {
+        for (final String name : OUTPUTS) {
+            if (Files.exists(target.resolve(name), LinkOption.NOFOLLOW_LINKS)) {
+                throw new SnapshotPipeline.Failure(WorldSnapshotResult.Status.TARGET_EXISTS,
+                    "Snapshot path already contains " + name + "/", null);
+            }
+        }
+    }
+
+    static Path canonicalPath(final Path path) throws IOException {
+        final Path absolute = path.toAbsolutePath().normalize();
+        CraftRuntimeWorldManager.ensureNoLinkOrJunction(absolute);
+        Path existing = absolute;
+        while (!Files.exists(existing, LinkOption.NOFOLLOW_LINKS)) {
+            existing = existing.getParent();
+            if (existing == null) throw new IOException("No existing ancestor for snapshot path " + absolute);
+        }
+        return existing.toRealPath().resolve(existing.relativize(absolute)).normalize();
+    }
+
+    static void requireDisjoint(final Path source, final Path target) throws IOException {
+        final Path realSource = canonicalPath(source);
+        final Path realTarget = canonicalPath(target);
+        if (realTarget.startsWith(realSource) || realSource.startsWith(realTarget)) {
+            throw new SnapshotPipeline.Failure(WorldSnapshotResult.Status.INVALID_REQUEST,
+                "Snapshot destination overlaps source storage " + realSource, null);
+        }
+    }
+
+    static void requireLevelData(final Path root) throws IOException {
+        CraftRuntimeWorldManager.ensureNoLinkOrJunction(root);
+        final Path levelData = root.resolve("level.dat");
+        if (!Files.exists(levelData, LinkOption.NOFOLLOW_LINKS)) {
+            throw new SnapshotPipeline.Failure(WorldSnapshotResult.Status.SAVE_FAILED,
+                "LEVEL_ROOT_MISSING_LEVEL_DAT: " + levelData, new java.nio.file.NoSuchFileException(levelData.toString()));
+        }
+        requireRegularFile(levelData, Files.readAttributes(levelData, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS));
+    }
+
+    static void copyLevelRoot(final Path source, final Path target) throws IOException {
+        requireDisjoint(source, target);
+        requireLevelData(source);
+        Files.createDirectory(target);
+        try (var children = Files.newDirectoryStream(source)) {
+            for (final Path child : children) {
+                final String name = child.getFileName().toString();
+                if (EXCLUDED.contains(name.toLowerCase(java.util.Locale.ROOT))) continue;
+                final BasicFileAttributes attributes = Files.readAttributes(child, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+                CraftRuntimeWorldManager.ensureNoLinkOrJunction(child);
+                if (attributes.isRegularFile()) {
+                    copyRegularFile(child, target.resolve(name), attributes);
+                } else if (attributes.isDirectory() && !attributes.isOther()) {
+                    if (LEVEL_DIRECTORIES.contains(name)) copyLevelTree(child, target.resolve(name));
+                } else {
+                    throw new IOException("Links and special files are not allowed in level-root snapshots: " + child);
+                }
+            }
+        }
+        // Stable required layout, also when no datapacks/global saved data exist yet.
+        Files.createDirectories(target.resolve("data"));
+        Files.createDirectories(target.resolve("datapacks"));
+        requireLevelData(target);
+    }
+
+    private static void copyLevelTree(final Path source, final Path target) throws IOException {
+        requireDisjoint(source, target);
+        Files.walkFileTree(source, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult preVisitDirectory(final Path directory, final BasicFileAttributes attributes) throws IOException {
+                CraftRuntimeWorldManager.ensureNoLinkOrJunction(directory);
+                if (!attributes.isDirectory() || attributes.isOther()) throw new IOException("Unsafe snapshot directory " + directory);
+                Files.createDirectory(target.resolve(source.relativize(directory)));
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult visitFile(final Path file, final BasicFileAttributes attributes) throws IOException {
+                copyRegularFile(file, target.resolve(source.relativize(file)), attributes);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    static void requireRegularFile(final Path file, final BasicFileAttributes attributes) throws IOException {
+        if (!attributes.isRegularFile() || attributes.isSymbolicLink() || attributes.isOther() || Files.isSymbolicLink(file)) {
+            throw new IOException("Expected a safe regular snapshot file: " + file);
+        }
+        CraftRuntimeWorldManager.ensureNoLinkOrJunction(file);
+    }
+
+    private static void copyRegularFile(final Path source, final Path target, final BasicFileAttributes attributes) throws IOException {
+        requireRegularFile(source, attributes);
+        CraftRuntimeWorldManager.ensureNoLinkOrJunction(target);
+        Files.copy(source, target, LinkOption.NOFOLLOW_LINKS, StandardCopyOption.COPY_ATTRIBUTES);
+        // A raced-in symlink must not be accepted as a successful file copy either.
+        requireRegularFile(target, Files.readAttributes(target, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS));
+    }
+
+    @FunctionalInterface
+    interface DirectoryMover {
+        void move(Path source, Path target) throws IOException;
+    }
+
+    @FunctionalInterface
+    interface DirectoryRemover {
+        void remove(Path target) throws IOException;
+    }
+
+    static void publish(final Path staging, final Path target, final DirectoryMover mover, final DirectoryRemover remover) throws IOException {
+        requireFreeOutputs(target);
+        final List<Path> published = new ArrayList<>();
+        try {
+            for (final String name : OUTPUTS) {
+                final Path destination = target.resolve(name);
+                if (Files.exists(destination, LinkOption.NOFOLLOW_LINKS)) {
+                    throw new java.nio.file.FileAlreadyExistsException(destination.toString());
+                }
+                CraftRuntimeWorldManager.ensureNoLinkOrJunction(destination);
+                mover.move(staging.resolve(name), destination);
+                published.add(destination);
+            }
+        } catch (final IOException | RuntimeException | Error failure) {
+            Exception cleanupFailure = null;
+            for (final Path owned : published.reversed()) {
+                try {
+                    remover.remove(owned);
+                } catch (final IOException | RuntimeException cleanup) {
+                    if (cleanupFailure == null) cleanupFailure = cleanup;
+                    else cleanupFailure.addSuppressed(cleanup);
+                }
+            }
+            if (cleanupFailure != null) {
+                final var diagnosed = new SnapshotPipeline.Failure(WorldSnapshotResult.Status.CLEANUP_FAILED,
+                    "SNAPSHOT_PUBLISH_ROLLBACK_FAILED: could not remove all published snapshot outputs", cleanupFailure);
+                diagnosed.addSuppressed(failure);
+                throw diagnosed;
+            }
+            throw failure;
+        }
+    }
+}

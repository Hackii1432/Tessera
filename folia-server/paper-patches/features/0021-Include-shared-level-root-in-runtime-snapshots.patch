+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+@Tag("Normal")
+class SnapshotGlobalStorageTest {
+    @TempDir Path temp;
+    private static final SavedDataType<Value> TYPE = new SavedDataType<>(Identifier.fromNamespaceAndPath("tessera", "snapshot_test"),
+        () -> new Value(0), Codec.INT.xmap(Value::new, value -> value.value), DataFixTypes.SAVED_DATA_COMMAND_STORAGE);
+
+    private SavedDataStorage storage(final Path folder) {
+        return new SavedDataStorage(folder, mock(com.mojang.datafixers.DataFixer.class), RegistryAccess.EMPTY);
+    }
+
+    @Test
+    void snapshotWaitsForExistingWritesEvenWithoutNewDirtyData() throws Exception {
+        final SavedDataStorage storage = this.storage(this.temp);
+        final CompletableFuture<Void> pending = new CompletableFuture<>();
+        final var field = SavedDataStorage.class.getDeclaredField("pendingWriteFuture");
+        field.setAccessible(true);
+        field.set(storage, pending);
+        final var snapshot = storage.tessera$beginSnapshotSave();
+        assertFalse(snapshot.isDone());
+        assertFalse(storage.scheduleSave().isDone());
+        assertFalse(storage.saveMaps().isDone());
+        pending.complete(null);
+        snapshot.get(2, TimeUnit.SECONDS);
+        storage.tessera$endSnapshotSave();
+        assertTrue(storage.scheduleSave().isDone());
+    }
+
+    @Test
+    void writesFreshDataButDefersFurtherSavesUntilSnapshotEnds() throws Exception {
+        final SavedDataStorage storage = this.storage(this.temp);
+        storage.set(TYPE, new Value(73));
+        storage.tessera$beginSnapshotSave().get(5, TimeUnit.SECONDS);
+        final Path file = this.temp.resolve("tessera/snapshot_test.dat");
+        assertEquals(73, NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap()).getIntOr("data", -1));
+        storage.set(TYPE, new Value(147));
+        storage.scheduleSave().get(5, TimeUnit.SECONDS);
+        storage.saveMaps().get(5, TimeUnit.SECONDS);
+        assertEquals(73, NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap()).getIntOr("data", -1));
+        storage.tessera$endSnapshotSave();
+        storage.scheduleSave().get(5, TimeUnit.SECONDS);
+        assertEquals(147, NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap()).getIntOr("data", -1));
+    }
+
+    @Test
+    void capturesDetachedNbtBeforeWaitingForPriorIo() throws Exception {
+        final SavedDataStorage storage = this.storage(this.temp);
+        final var type = new SavedDataType<MutableValue>(Identifier.fromNamespaceAndPath("tessera", "snapshot_mutable"),
+            () -> new MutableValue(new net.minecraft.nbt.CompoundTag()),
+            net.minecraft.nbt.CompoundTag.CODEC.xmap(MutableValue::new, value -> value.tag), DataFixTypes.SAVED_DATA_COMMAND_STORAGE);
+        final var tag = new net.minecraft.nbt.CompoundTag();
+        tag.putInt("marker", 73);
+        storage.set(type, new MutableValue(tag));
+        final CompletableFuture<Void> pending = new CompletableFuture<>();
+        final var field = SavedDataStorage.class.getDeclaredField("pendingWriteFuture");
+        field.setAccessible(true);
+        field.set(storage, pending);
+        final var snapshot = storage.tessera$beginSnapshotSave();
+        tag.putInt("marker", 147);
+        pending.complete(null);
+        snapshot.get(5, TimeUnit.SECONDS);
+        storage.tessera$endSnapshotSave();
+        assertEquals(73, NbtIo.readCompressed(this.temp.resolve("tessera/snapshot_mutable.dat"), NbtAccounter.unlimitedHeap())
+            .getCompoundOrEmpty("data").getIntOr("marker", -1));
+    }
+
+    @Test
+    void failedGlobalWritePropagatesAndCanBeRetriedAfterResume() throws Exception {
+        final Path folder = Files.createDirectory(this.temp.resolve("data"));
+        final Path obstruction = Files.writeString(folder.resolve("tessera"), "not a directory");
+        final SavedDataStorage storage = this.storage(folder);
+        final Value value = new Value(73);
+        storage.set(TYPE, value);
+        assertThrows(CompletionException.class, () -> storage.tessera$beginSnapshotSave().join());
+        assertTrue(value.isDirty(), "Failed snapshot must retain data for retry");
+        storage.tessera$endSnapshotSave();
+        Files.delete(obstruction);
+        storage.tessera$beginSnapshotSave().get(5, TimeUnit.SECONDS);
+        storage.tessera$endSnapshotSave();
+        assertEquals(73, NbtIo.readCompressed(folder.resolve("tessera/snapshot_test.dat"), NbtAccounter.unlimitedHeap()).getIntOr("data", -1));
+    }
+
+    private static final class Value extends SavedData {
+        final int value;
+        Value(final int value) { this.value = value; }
+    }
+
+    private static final class MutableValue extends SavedData {
+        final net.minecraft.nbt.CompoundTag tag;
+        MutableValue(final net.minecraft.nbt.CompoundTag tag) { this.tag = tag; }
+    }
+}

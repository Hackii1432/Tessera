+    @Test
+    void overviewShowsRegionalAndGlobalUtilisationAgainstTickThreadCapacity() {
+        var view = new RegionHealthView(snapshot(7L, 9L));
+        String utilisation = "Utilisation (15 s): 180.00% / 400.00% max · Tick threads: 4 · Partial samples";
+        assertTrue(plain(view.overview(Integer.MAX_VALUE)).contains(utilisation));
+        // Limiting displayed regions must not change the server-wide total or capacity.
+        assertTrue(plain(view.overview(1)).contains(utilisation));
+        assertFalse(plain(view.overview(1)).contains("Region #9"));
+    }
+
+    @Test
+    void utilisationCapacityUsesTickThreadsNotRegionCountAndDoesNotDivideByZero() {
+        var base = snapshot(7L, 9L);
+        for (int threads : List.of(1, 8, 0)) {
+            var state = new RegionHealthSnapshot(base.regions(), base.players(), SELF, NORMAL, base.global(), threads, 0, 0);
+            String output = plain(new RegionHealthView(state).overview(Integer.MAX_VALUE));
+            assertTrue(output.contains(String.format(java.util.Locale.ROOT, " / %.2f%% max · Tick threads: %d", threads * 100.0, threads)));
+            assertFalse(output.contains("NaN"));
+            assertFalse(output.contains("Infinity"));
+        }
+    }
+
+    @Test
+    void utilisationKeepsKnownCapacityWithoutInventingMeasurements() {
+        var state = new RegionHealthSnapshot(List.of(), List.of(), null, NORMAL, null, 2, 0, 0);
+        String output = plain(new RegionHealthView(state).overview(Integer.MAX_VALUE));
+        assertTrue(output.contains("Utilisation (15 s): No measurements yet / 200.00% max · Tick threads: 2"));
+        assertFalse(output.contains("Partial samples"));
+        state = new RegionHealthSnapshot(List.of(), List.of(), null, NORMAL, metrics(20, 2), 2, 0, 0);
+        output = plain(new RegionHealthView(state).overview(Integer.MAX_VALUE));
+        assertTrue(output.contains("Utilisation (15 s): 4.00% / 200.00% max · Tick threads: 2"));
+        assertFalse(output.contains("Partial samples"));
+    }
+
+    @Test
+    void utilisationIgnoresInvalidAndHistoricalSamplesAndLabelsPartialReports() {
+        var invalid = new RegionHealthSnapshot.Metrics(20, 8, Double.NaN, 1, 8, 13, 300);
+        var region = new RegionHealthSnapshot.Region(1, "world", 1, 1, List.of(), Map.of("15 s", invalid, "1 min", metrics(20, 40)));
+        var state = new RegionHealthSnapshot(List.of(region), List.of(), null, NORMAL, metrics(20, 2), 3, 0, 0);
+        String output = plain(new RegionHealthView(state).overview(Integer.MAX_VALUE));
+        assertTrue(output.contains("Utilisation (15 s): 4.00% / 300.00% max · Tick threads: 3 · Partial samples"));
+        assertFalse(output.contains("NaN"));
+        state = new RegionHealthSnapshot(List.of(region), List.of(), null, NORMAL, invalid, 3, 0, 0);
+        output = plain(new RegionHealthView(state).overview(Integer.MAX_VALUE));
+        assertTrue(output.contains("Utilisation (15 s): No measurements yet / 300.00% max"));
+    }
+
+    @Test
+    void utilisationDoesNotMarkCompleteSamplesAsPartialOrClampMeasuredTotals() {

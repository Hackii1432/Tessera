+    @Override
+    public CompletionStage<WorldSnapshotResult> snapshotWorldsAsync(
+        final List<World> worlds,
+        final Path requestedSnapshotPath
+    ) {
+        final Path snapshotPath = requestedSnapshotPath == null
+            ? this.server.getWorldContainer().toPath().toAbsolutePath().normalize()
+            : requestedSnapshotPath.toAbsolutePath().normalize();
+        if (worlds == null || worlds.isEmpty() || requestedSnapshotPath == null) {
+            return CompletableFuture.completedFuture(new WorldSnapshotResult(
+                WorldSnapshotResult.Status.INVALID_REQUEST,
+                snapshotPath,
+                "Worlds and snapshotPath are required, and worlds must not be empty",
+                null
+            ));
+        }
+
+        final List<CraftWorld> sources = new ArrayList<>(worlds.size());
+        final Set<UUID> identities = new HashSet<>();
+        for (final World world : worlds) {
+            if (!(world instanceof CraftWorld craftWorld)) {
+                return CompletableFuture.completedFuture(new WorldSnapshotResult(
+                    WorldSnapshotResult.Status.INVALID_REQUEST,
+                    snapshotPath,
+                    "Every source must be a CraftWorld owned by this server",
+                    null
+                ));
+            }
+            if (!identities.add(craftWorld.getUID())) {
+                return CompletableFuture.completedFuture(new WorldSnapshotResult(
+                    WorldSnapshotResult.Status.INVALID_REQUEST,
+                    snapshotPath,
+                    "The source world list contains a duplicate: " + craftWorld.getKey(),
+                    null
+                ));
+            }
+            sources.add(craftWorld);
+        }
+
+        final List<LockRequest> locks = sources.stream()
+            .map(world -> new LockRequest(normalizeName(world.getName()), true))
+            .toList();
+        return this.trackOperation(this.withLocks(locks, () -> this.snapshotWorldsLocked(sources, snapshotPath)), () ->
+            new WorldSnapshotResult(
+                WorldSnapshotResult.Status.SERVER_STOPPING,
+                snapshotPath,
+                "Server stopped during runtime world snapshot",
+                null
+            )
+        );
+    }
+
+    private CompletionStage<WorldSnapshotResult> snapshotWorldsLocked(
+        final List<CraftWorld> sources,
+        final Path snapshotPath
+    ) {
+        final SnapshotPlan plan;
+        try {
+            plan = this.validateSnapshotPlan(sources, snapshotPath);
+        } catch (final SnapshotFailure failure) {
+            return CompletableFuture.completedFuture(new WorldSnapshotResult(
+                failure.status, snapshotPath, failure.getMessage(), failure.getCause()
+            ));
+        } catch (final Throwable throwable) {
+            return CompletableFuture.completedFuture(new WorldSnapshotResult(
+                WorldSnapshotResult.Status.INVALID_REQUEST,
+                snapshotPath,
+                "Could not validate snapshot destination",
+                throwable
+            ));
+        }
+
+        final List<ServerLevel> frozen = new ArrayList<>(sources.size());
+        CompletionStage<WorldSnapshotResult> operation = this.onGlobal(() -> {
+            this.ensureRunning();
+            for (final CraftWorld source : sources) {
+                final ServerLevel handle = source.getHandle();
+                if (this.server.getServer().getLevel(handle.dimension()) != handle) {
+                    throw new SnapshotFailure(
+                        WorldSnapshotResult.Status.SOURCE_NOT_LOADED,
+                        "Source world is no longer registered: " + source.getKey()
+                    );
+                }
+                if (!handle.tessera$transitionRuntimeLifecycle(
+                    ServerLevel.RuntimeLifecycleState.ACTIVE,
+                    ServerLevel.RuntimeLifecycleState.SNAPSHOTTING
+                )) {
+                    throw new SnapshotFailure(
+                        WorldSnapshotResult.Status.SOURCE_BUSY,
+                        "Source world is busy: " + source.getKey() + " (" + handle.tessera$getRuntimeLifecycleState() + ")"
+                    );
+                }
+                frozen.add(handle);
+            }
+            return null;
+        }).thenCompose(ignored -> CompletableFuture.allOf(
+            frozen.stream()
+                .map(world -> RegionizedServer.getInstance().awaitWorldRegionTasks(world))
+                .toArray(CompletableFuture[]::new)
+        ).orTimeout(30L, TimeUnit.SECONDS)).thenCompose(ignored -> this.flushSnapshotPlayers())
+            .thenCompose(ignored -> this.onGlobal(() -> {
+                for (final CraftWorld source : sources) {
+                    new WorldSaveEvent(source).callEvent();
+                }
+                return null;
+            }))
+            .thenCompose(ignored -> CompletableFuture.allOf(
+                frozen.stream()
+                    .map(RegionShutdownThread::flushRuntimeWorldSnapshot)
+                    .toArray(CompletableFuture[]::new)
+            ))
+            .thenApplyAsync(ignored -> {
+                try {
+                    this.copyAndPublishSnapshot(plan);
+                    return new WorldSnapshotResult(
+                        WorldSnapshotResult.Status.SUCCESS,
+                        snapshotPath,
+                        "Saved " + sources.size() + " world(s) and player storage to a fresh snapshot",
+                        null
+                    );
+                } catch (final IOException exception) {
+                    throw new CompletionException(new SnapshotFailure(
+                        WorldSnapshotResult.Status.COPY_FAILED,
+                        "Could not copy or publish the runtime world snapshot",
+                        exception
+                    ));
+                }
+            }, this.lifecycleExecutor);
+
+        operation = operation.handle((result, failure) -> this.onGlobal(() -> {
+            Throwable resumeFailure = null;
+            for (final ServerLevel handle : frozen) {
+                if (!handle.tessera$transitionRuntimeLifecycle(
+                    ServerLevel.RuntimeLifecycleState.SNAPSHOTTING,
+                    ServerLevel.RuntimeLifecycleState.ACTIVE
+                ) && handle.tessera$getRuntimeLifecycleState() != ServerLevel.RuntimeLifecycleState.ACTIVE) {
+                    resumeFailure = append(resumeFailure, new IllegalStateException(
+                        "Could not resume snapshot world " + handle.dimension().identifier()
+                            + " from " + handle.tessera$getRuntimeLifecycleState()
+                    ));
+                }
+            }
+            if (resumeFailure != null) {
+                if (failure != null) {
+                    resumeFailure.addSuppressed(unwrap(failure));
+                }
+                return new WorldSnapshotResult(
+                    WorldSnapshotResult.Status.CLEANUP_FAILED,
+                    snapshotPath,
+                    "Snapshot cleanup could not resume every source world",
+                    resumeFailure
+                );
+            }
+            if (failure == null) {
+                return result;
+            }
+            final Throwable cause = unwrap(failure);
+            final WorldSnapshotResult.Status status;
+            if (cause instanceof SnapshotFailure snapshotFailure) {
+                status = snapshotFailure.status;
+            } else if (cause instanceof java.util.concurrent.TimeoutException) {
+                status = WorldSnapshotResult.Status.TIMEOUT;
+            } else if (cause instanceof java.util.concurrent.CancellationException) {
+                status = WorldSnapshotResult.Status.CANCELLED;
+            } else {
+                status = WorldSnapshotResult.Status.SAVE_FAILED;
+            }
+            return new WorldSnapshotResult(status, snapshotPath, "Runtime world snapshot failed: " + cause.getMessage(), cause);
+        })).thenCompose(stage -> stage);
+
+        return operation;
+    }

+    private CompletionStage<Void> flushSnapshotPlayers() {
+        final List<net.minecraft.server.level.ServerPlayer> players = List.copyOf(
+            this.server.getServer().getPlayerList().getPlayers()
+        );
+        final List<CompletableFuture<Void>> saves = new ArrayList<>(players.size());
+        for (final net.minecraft.server.level.ServerPlayer player : players) {
+            final CompletableFuture<Void> save = new CompletableFuture<>();
+            saves.add(save);
+            final boolean scheduled = player.getBukkitEntity().taskScheduler.schedule(
+                current -> {
+                    try {
+                        this.server.getServer().getPlayerList().tessera$savePlayerSnapshot(
+                            (net.minecraft.server.level.ServerPlayer)current
+                        );
+                        save.complete(null);
+                    } catch (final Throwable throwable) {
+                        save.completeExceptionally(throwable);
+                    }
+                },
+                retired -> save.complete(null),
+                1L
+            );
+            if (!scheduled) {
+                // PlayerList#remove saves synchronously before retiring the
+                // scheduler. A scheduler which is already retired therefore
+                // has no outstanding logout write for this player.
+                save.complete(null);
+            }
+        }
+        return CompletableFuture.allOf(saves.toArray(CompletableFuture[]::new))
+            .orTimeout(30L, TimeUnit.SECONDS);
+    }
+
+    private SnapshotPlan validateSnapshotPlan(
+        final List<CraftWorld> sources,
+        final Path snapshotPath
+    ) throws IOException {
+        if (this.isStopping()) {
+            throw new SnapshotFailure(WorldSnapshotResult.Status.SERVER_STOPPING, "Server is stopping");
+        }
+        ensureNoLinkOrJunction(snapshotPath);
+        if (Files.exists(snapshotPath, LinkOption.NOFOLLOW_LINKS)
+            && !Files.isDirectory(snapshotPath, LinkOption.NOFOLLOW_LINKS)) {
+            throw new SnapshotFailure(WorldSnapshotResult.Status.INVALID_REQUEST, "Snapshot path is not a directory: " + snapshotPath);
+        }
+        final Path worldsTarget = snapshotPath.resolve("worlds");
+        final Path playersTarget = snapshotPath.resolve("players");
+        if (Files.exists(worldsTarget, LinkOption.NOFOLLOW_LINKS) || Files.exists(playersTarget, LinkOption.NOFOLLOW_LINKS)) {
+            throw new SnapshotFailure(
+                WorldSnapshotResult.Status.TARGET_EXISTS,
+                "Snapshot path already contains worlds/ or players/"
+            );
+        }
+
+        final List<Path> sourcePaths = new ArrayList<>(sources.size());
+        for (final CraftWorld source : sources) {
+            final Path sourcePath = source.getWorldPath().toRealPath(LinkOption.NOFOLLOW_LINKS);
+            ensureNoLinkOrJunction(sourcePath);
+            if (snapshotPath.startsWith(sourcePath) || sourcePath.startsWith(snapshotPath)) {
+                throw new SnapshotFailure(
+                    WorldSnapshotResult.Status.INVALID_REQUEST,
+                    "Snapshot destination overlaps source world " + source.getKey()
+                );
+            }
+            sourcePaths.add(sourcePath);
+        }
+
+        final List<Path> playerPaths = List.of(
+            this.server.getServer().getWorldPath(LevelResource.PLAYER_DATA_DIR).toAbsolutePath().normalize(),
+            this.server.getServer().getWorldPath(LevelResource.PLAYER_STATS_DIR).toAbsolutePath().normalize(),
+            this.server.getServer().getWorldPath(LevelResource.PLAYER_ADVANCEMENTS_DIR).toAbsolutePath().normalize()
+        );
+        for (final Path playerPath : playerPaths) {
+            ensureNoLinkOrJunction(playerPath);
+            if (snapshotPath.startsWith(playerPath) || playerPath.startsWith(snapshotPath)) {
+                throw new SnapshotFailure(
+                    WorldSnapshotResult.Status.INVALID_REQUEST,
+                    "Snapshot destination overlaps player storage " + playerPath
+                );
+            }
+        }
+
+        final Path staging = snapshotPath.resolve(".tessera-snapshot-" + UUID.randomUUID()).normalize();
+        if (!staging.getParent().equals(snapshotPath)) {
+            throw new SnapshotFailure(WorldSnapshotResult.Status.INVALID_REQUEST, "Invalid snapshot staging path");
+        }
+        return new SnapshotPlan(snapshotPath, staging, sourcePaths, playerPaths);
+    }
+
+    private void copyAndPublishSnapshot(final SnapshotPlan plan) throws IOException {
+        Files.createDirectories(plan.target);
+        ensureNoLinkOrJunction(plan.target);
+        if (Files.exists(plan.target.resolve("worlds"), LinkOption.NOFOLLOW_LINKS)
+            || Files.exists(plan.target.resolve("players"), LinkOption.NOFOLLOW_LINKS)) {
+            throw new SnapshotFailure(WorldSnapshotResult.Status.TARGET_EXISTS, "Snapshot target was populated while saving");
+        }
+        Files.createDirectory(plan.staging);
+        Throwable operationFailure = null;
+        try {
+            final Path stagedWorlds = plan.staging.resolve("worlds");
+            final Path stagedPlayers = plan.staging.resolve("players");
+            Files.createDirectory(stagedWorlds);
+            Files.createDirectory(stagedPlayers);
+
+            for (int index = 0; index < plan.worldSources.size(); ++index) {
+                this.copyCompleteWorldSnapshot(plan.worldSources.get(index), stagedWorlds.resolve(Integer.toString(index)));
+            }
+            this.copyPlayerSnapshotDirectory(plan.playerSources.get(0), stagedPlayers.resolve("data"));
+            this.copyPlayerSnapshotDirectory(plan.playerSources.get(1), stagedPlayers.resolve("stats"));
+            this.copyPlayerSnapshotDirectory(plan.playerSources.get(2), stagedPlayers.resolve("advancements"));
+
+            final Path publishedWorlds = plan.target.resolve("worlds");
+            final Path publishedPlayers = plan.target.resolve("players");
+            boolean worldsPublished = false;
+            boolean playersPublished = false;
+            try {
+                moveSnapshotDirectory(stagedWorlds, publishedWorlds);
+                worldsPublished = true;
+                moveSnapshotDirectory(stagedPlayers, publishedPlayers);
+                playersPublished = true;
+            } catch (final Throwable throwable) {
+                if (worldsPublished) {
+                    deleteTreeStrict(publishedWorlds);
+                }
+                if (playersPublished) {
+                    deleteTreeStrict(publishedPlayers);
+                }
+                if (throwable instanceof IOException exception) {
+                    throw exception;
+                }
+                throw new IOException("Could not publish snapshot", throwable);
+            }
+        } catch (final IOException | RuntimeException | Error failure) {
+            operationFailure = failure;
+            throw failure;
+        } finally {
+            try {
+                deleteTreeStrict(plan.staging);
+            } catch (final IOException cleanupFailure) {
+                if (operationFailure != null) {
+                    operationFailure.addSuppressed(cleanupFailure);
+                } else {
+                    throw new SnapshotFailure(
+                        WorldSnapshotResult.Status.CLEANUP_FAILED,
+                        "Could not remove snapshot staging path " + plan.staging,
+                        cleanupFailure
+                    );
+                }
+            }
+        }
+    }
+
+    static void copyCompleteWorldSnapshot(final Path source, final Path target) throws IOException {
+        Files.createDirectory(target);
+        try (var children = Files.newDirectoryStream(source)) {
+            for (final Path child : children) {
+                final BasicFileAttributes attributes = Files.readAttributes(
+                    child, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS
+                );
+                if (Files.isSymbolicLink(child) || attributes.isOther()) {
+                    throw new IOException("Links and special files are not allowed in world snapshots: " + child);
+                }
+                final String name = child.getFileName().toString();
+                if (attributes.isRegularFile()) {
+                    if (!name.equalsIgnoreCase("session.lock")) {
+                        Files.copy(child, target.resolve(name), StandardCopyOption.COPY_ATTRIBUTES);
+                    }
+                } else if (attributes.isDirectory()
+                    && (SNAPSHOT_DIRECTORIES.contains(name) || name.equals("datapacks"))) {
+                    copySnapshotTree(child, target.resolve(name), true);
+                }
+            }
+        }
+    }
+
+    static void copyPlayerSnapshotDirectory(final Path source, final Path target) throws IOException {
+        if (!Files.exists(source, LinkOption.NOFOLLOW_LINKS)) {
+            Files.createDirectories(target);
+            return;
+        }
+        copySnapshotTree(source, target, false);
+    }
+
+    static void copySnapshotTree(final Path source, final Path target, final boolean validateRegions) throws IOException {
+        Files.walkFileTree(source, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult preVisitDirectory(final Path directory, final BasicFileAttributes attributes) throws IOException {
+                if (Files.isSymbolicLink(directory) || attributes.isOther()) {
+                    throw new IOException("Links and special directories are not allowed in snapshots: " + directory);
+                }
+                Files.createDirectories(target.resolve(source.relativize(directory)));
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult visitFile(final Path file, final BasicFileAttributes attributes) throws IOException {
+                if (!attributes.isRegularFile() || Files.isSymbolicLink(file) || attributes.isOther()) {
+                    throw new IOException("Links and special files are not allowed in snapshots: " + file);
+                }
+                if (validateRegions && file.getFileName().toString().endsWith(".mca")) {
+                    validateRegionFile(file);
+                }
+                Files.copy(file, target.resolve(source.relativize(file)), StandardCopyOption.COPY_ATTRIBUTES);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    static void ensureNoLinkOrJunction(final Path path) throws IOException {
+        Path current = path.toAbsolutePath().normalize();
+        while (current != null) {
+            if (Files.exists(current, LinkOption.NOFOLLOW_LINKS)) {
+                final BasicFileAttributes attributes = Files.readAttributes(
+                    current, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS
+                );
+                if (Files.isSymbolicLink(current) || attributes.isOther()) {
+                    throw new IOException("Snapshot path contains a link or junction: " + current);
+                }
+            }
+            current = current.getParent();
+        }
+    }
+
+    private static void moveSnapshotDirectory(final Path source, final Path target) throws IOException {
+        try {
+            Files.move(source, target, StandardCopyOption.ATOMIC_MOVE);
+        } catch (final java.nio.file.AtomicMoveNotSupportedException ignored) {
+            Files.move(source, target);
+        }
+    }
+
+    private static void deleteTreeStrict(final Path path) throws IOException {
+        if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try (var entries = Files.walk(path)) {
+            for (final Path entry : entries.sorted(Comparator.reverseOrder()).toList()) {
+                Files.deleteIfExists(entry);
+            }
+        }
+    }

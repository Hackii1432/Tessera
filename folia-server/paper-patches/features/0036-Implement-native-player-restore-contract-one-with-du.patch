@@ -0,0 +1,55 @@
+package org.bukkit.craftbukkit.world;
+
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+
+/** Tracks native control work across Folia's scheduler/chunk shutdown boundary. */
+public final class NativeRestoreWork {
+    private static final Set<CompletableFuture<?>> PENDING = new HashSet<>();
+    private static volatile boolean stopping;
+    private static boolean finished;
+
+    private NativeRestoreWork() {}
+
+    public static void checkRunning() {
+        if (stopping) throw new IllegalStateException("Server stopped during native restore work");
+    }
+
+    public static synchronized <T> CompletableFuture<T> future() {
+        CompletableFuture<T> future = new CompletableFuture<>();
+        // A stage can already have dispatched children before track() is called.
+        // Do not report those children drained merely because shutdown began.
+        if (finished) {
+            future.completeExceptionally(new IllegalStateException("Native restore admission is closed for shutdown"));
+            return future;
+        }
+        PENDING.add(future);
+        future.whenComplete((ignored, failure) -> { synchronized (NativeRestoreWork.class) { PENDING.remove(future); } });
+        return future;
+    }
+
+    public static <T> CompletionStage<T> track(CompletionStage<T> stage) {
+        CompletableFuture<T> owned = future();
+        stage.whenComplete((value, failure) -> {
+            if (failure == null) owned.complete(value);
+            else owned.completeExceptionally(failure);
+        });
+        return owned.minimalCompletionStage();
+    }
+
+    public static void beginShutdown() { stopping = true; }
+
+    /** Only after region threads and chunk workers have halted and pending teleports were reconciled. */
+    public static void finishShutdown() {
+        CompletableFuture<?>[] pending;
+        synchronized (NativeRestoreWork.class) {
+            finished = true;
+            pending = PENDING.toArray(CompletableFuture[]::new);
+        }
+        for (CompletableFuture<?> future : pending) {
+            future.completeExceptionally(new IllegalStateException("Native restore work drained by server shutdown"));
+        }
+    }
+}

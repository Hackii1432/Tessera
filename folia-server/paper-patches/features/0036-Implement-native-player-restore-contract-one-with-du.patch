new file mode 100644
index 0000000000000000000000000000000000000000..2e36e7ad0740d49399b35cc68a690d63398349e7
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/world/RestoreStoragePlatform.java
@@ -0,0 +1,66 @@
+package org.bukkit.craftbukkit.world;
+
+import com.sun.jna.Platform;
+import com.sun.jna.platform.win32.Kernel32;
+import com.sun.jna.platform.win32.WinBase;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+
+/** Synchronous durability is confined to the restore I/O worker, never a tick thread. */
+final class RestoreStoragePlatform {
+    private RestoreStoragePlatform() {}
+
+    static PlayerRestoreFiles files() {
+        return new PlayerRestoreFiles(RestoreStoragePlatform::directory, RestoreStoragePlatform::move);
+    }
+
+    static void directory(Path directory) throws IOException {
+        if (Platform.isWindows()) {
+            // Windows cannot FileChannel.force a directory. Each namespace publication
+            // below is a same-volume MoveFileExW WRITE_THROUGH, with no delayed reboot
+            // action and no copy/delete fallback. Contents have already been forced.
+            return;
+        }
+        try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ)) {
+            channel.force(true);
+        }
+    }
+
+    static void move(Path source, Path target) throws IOException {
+        if (Files.exists(target, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
+            throw new IOException("Restore publication must not overwrite a destination: " + target);
+        }
+        if (Platform.isWindows()) {
+            for (int attempt = 0; ; ++attempt) {
+                if (Kernel32.INSTANCE.MoveFileEx(windowsPath(source), windowsPath(target), new com.sun.jna.platform.win32.WinDef.DWORD(WinBase.MOVEFILE_WRITE_THROUGH))) break;
+                int error = Kernel32.INSTANCE.GetLastError();
+                if (attempt >= 7 || (error != 5 && error != 32 && error != 33)
+                    || !Files.exists(source, java.nio.file.LinkOption.NOFOLLOW_LINKS)
+                    || Files.exists(target, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
+                    throw new IOException("MoveFileExW failed (" + error + "): " + source + " -> " + target);
+                }
+                // Antivirus/indexer handles can briefly deny directory renames.
+                // Retry only the same non-replacing move, only on the I/O worker.
+                try { Thread.sleep(Math.min(500L, 50L << attempt)); }
+                catch (InterruptedException interrupted) {
+                    Thread.currentThread().interrupt();
+                    throw new IOException("Restore publication interrupted", interrupted);
+                }
+            }
+        } else {
+            Files.move(source, target, StandardCopyOption.ATOMIC_MOVE);
+            directory(target.getParent());
+            if (!source.getParent().equals(target.getParent())) directory(source.getParent());
+        }
+    }
+
+    private static String windowsPath(Path path) {
+        String absolute = path.toAbsolutePath().normalize().toString();
+        if (absolute.startsWith("\\\\?\\")) return absolute;
+        return absolute.startsWith("\\\\") ? "\\\\?\\UNC\\" + absolute.substring(2) : "\\\\?\\" + absolute;
+    }
+}

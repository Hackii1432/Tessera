+    /** Call after overlays too: new file names need directory durability on POSIX. */
+    void seal(Path root) throws IOException {
+        validateTree(root);
+        for (String child : DIRECTORIES) {
+            Path directory = root.resolve(child);
+            try (var files = Files.list(directory)) {
+                for (Path file : files.toList()) {

+
+/**
+ * Owns the native transaction. Only I/O workers wait for stages. All entity
+ * reads and mutations are dispatched to the current owner, including during
+ * tick freeze. Completion is the sole ordinary admission-release point.
+ * No operation is replayed after restart: the caller owns its recovery journal.
+ */
+final class NativePlayerRestoreBackend implements PlayerRestoreCoordinator.Backend {
+    private final CraftServer server;
+    private final ExecutorService io = Executors.newVirtualThreadPerTaskExecutor();
+    private final Map<UUID, Transaction> transactions = new ConcurrentHashMap<>();
+    private volatile Transaction active;
+    private volatile boolean stopping;
+
+    private record Identity(CraftPlayer wrapper, GameProfile profile, ClientInformation options) {}
+    private record Worlds(Map<UUID, CraftWorld> ids, Map<String, CraftWorld> keys, Location fallback) {}
+    private record Raw(CompoundTag data, JsonElement stats, JsonElement advancements) {}
+
+    private static final class Transaction {
+        final PlayerRestoreCoordinator.Operation operation;
+        final Map<UUID, Identity> participants = new LinkedHashMap<>();
+        final Map<UUID, PlayerRestoreImage> disconnected = new ConcurrentHashMap<>();
+        final Map<UUID, NativePlayerRestoreState> forward = new LinkedHashMap<>();
+        Path activeStore;
+        Path forwardStore;
+        volatile boolean fenced;
+        volatile boolean captureOpen;
+        boolean backupComplete;
+        Boolean applied;
+        Throwable captureFailure;
+
+        Transaction(PlayerRestoreCoordinator.Operation operation) { this.operation = operation; }
+    }
+
+    NativePlayerRestoreBackend(CraftServer server) { this.server = server; }
+
+    @Override
+    public CompletionStage<Void> prepare(PlayerRestoreCoordinator.Operation operation) {
+        Transaction tx = new Transaction(operation);
+        this.transactions.put(operation.id, tx);
+        this.active = tx;
+        return this.phase(() -> {
+            this.ensureRunning();
+            tx.activeStore = this.server.getServer().getPlayerList().playerIo.getPlayerDir().toPath().getParent();
+            PlayerRestoreFiles.validateDisjoint(operation.request.source(), operation.request.rollback(), tx.activeStore);
+            PlayerRestoreFiles.validateTree(operation.request.source());
+            if (Files.exists(operation.request.rollback(), LinkOption.NOFOLLOW_LINKS)) {
+                throw failure(PlayerRestoreStatus.INVALID_REQUEST, "Rollback root must not already exist");
+            }
+            if (org.spigotmc.SpigotConfig.disablePlayerDataSaving || org.spigotmc.SpigotConfig.disableStatSaving
+                || org.spigotmc.SpigotConfig.disableAdvancementSaving) {
+                throw failure(PlayerRestoreStatus.SAVE_FAILED, "All three player stores must have saving enabled");
+            }
+            Worlds worlds = this.worlds(operation.request.fallback());
+            Map<UUID, Raw> source = this.readStore(operation.request.source());
+            operation.checkForward();
+            tx.captureOpen = true;
+            tx.fenced = true;
+            PlayerStoreFence.INSTANCE.close(operation.id).toCompletableFuture().join();
+            operation.checkForward();
+
+            // Admission is drained, so no previously admitted login can appear
+            // after this participant snapshot. Retirements are covered below.
+            List<CraftPlayer> online = this.onGlobal(() -> this.server.getOnlinePlayers().stream()
+                .map(player -> (CraftPlayer)player).toList()).join();
+            for (CraftPlayer wrapper : online) {
+                try {
+                    Identity identity = owner(wrapper, player -> {
+                        if (!player.getBukkitEntity().isPersistent()) throw failure(PlayerRestoreStatus.SAVE_FAILED, "Non-persistent player: " + player.getUUID());
+                        player.closeContainer(InventoryCloseEvent.Reason.PLUGIN);
+                        try (var lease = PlayerStoreFence.INSTANCE.writeOwned(operation.id);
+                             var scope = PlayerStoreFence.INSTANCE.enter(lease)) {
+                            this.server.getServer().getPlayerList().tessera$savePlayerSnapshot(player);
+                        }
+                        return new Identity(wrapper, player.getGameProfile(), player.clientInformation());
+                    }).toCompletableFuture().join();
+                    tx.participants.put(identity.profile.id(), identity);
+                } catch (RuntimeException failed) {
+                    if (!tx.disconnected.containsKey(wrapper.getUniqueId())) throw failed;
+                }
+            }
+            synchronized (tx) { tx.captureOpen = false; }
+            PlayerStoreFence.INSTANCE.awaitIdle(operation.id).toCompletableFuture().join();
+            if (tx.captureFailure != null) throw new IllegalStateException("Could not capture logout before backup", tx.captureFailure);
+            operation.checkForward();
+
+            Path backupWork = staging(operation.request.rollback());
+            RestoreStoragePlatform.files().copyNew(tx.activeStore, backupWork);
+            for (PlayerRestoreImage image : tx.disconnected.values()) image.write(backupWork);
+            RestoreStoragePlatform.files().seal(backupWork);
+            RestoreStoragePlatform.move(backupWork, operation.request.rollback());
+            tx.backupComplete = true;
+            operation.checkForward();
+
+            // Preflight every saved player, not merely the currently connected
+            // subset. Each preview is created on its resolved destination owner.
+            for (var entry : source.entrySet()) {
+                operation.checkForward();
+                Identity identity = tx.participants.get(entry.getKey());
+                GameProfile profile = identity == null ? new GameProfile(entry.getKey(), "RestorePreview") : identity.profile;
+                ClientInformation options = identity == null ? ClientInformation.createDefault() : identity.options;
+                tx.forward.put(entry.getKey(), this.preflight(worlds, profile, options, entry.getValue()));
+            }
+            for (var entry : tx.participants.entrySet()) {
+                if (!tx.forward.containsKey(entry.getKey())) {
+                    Identity identity = entry.getValue();

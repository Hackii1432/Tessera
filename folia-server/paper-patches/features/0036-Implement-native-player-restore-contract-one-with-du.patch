@@ -0,0 +1,46 @@
+package org.bukkit.craftbukkit.world;
+
+import com.google.gson.JsonElement;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.UUID;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtIo;
+import net.minecraft.nbt.NbtUtils;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.ProblemReporter;
+import net.minecraft.world.level.storage.TagValueOutput;
+
+/** An immutable owner-thread capture. No live entity is dereferenced by its file writer. */
+record PlayerRestoreImage(UUID id, CompoundTag data, JsonElement stats, JsonElement advancements) {
+    static PlayerRestoreImage capture(ServerPlayer player) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(player, "Cannot capture restore image off owner");
+        ProblemReporter.Collector problems = new ProblemReporter.Collector();
+        TagValueOutput output = TagValueOutput.createWithContext(problems, player.registryAccess());
+        player.saveWithoutId(output);
+        if (!problems.isEmpty()) throw new IllegalStateException("Invalid rollback player: " + problems.getReport());
+        CompoundTag tag = output.buildResult();
+        NbtUtils.addCurrentDataVersion(tag);
+        return new PlayerRestoreImage(player.getUUID(), tag, player.getStats().tessera$restoreImage(), player.getAdvancements().tessera$restoreImage());
+    }
+
+    void write(Path root) throws IOException {
+        Path dataFile = root.resolve("data").resolve(this.id + ".dat");
+        NbtIo.writeCompressed(this.data, dataFile);
+        force(dataFile);
+        writeJson(root.resolve("stats").resolve(this.id + ".json"), this.stats);
+        writeJson(root.resolve("advancements").resolve(this.id + ".json"), this.advancements);
+    }
+
+    private static void writeJson(Path path, JsonElement value) throws IOException {
+        Files.writeString(path, value.toString(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
+        force(path);
+    }
+
+    private static void force(Path path) throws IOException {
+        try (FileChannel channel = FileChannel.open(path, StandardOpenOption.WRITE)) { channel.force(true); }
+    }
+}

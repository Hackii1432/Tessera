+        this.coordinator = new PlayerRestoreCoordinator(new UnavailableBackend(), Runnable::run);
+    }
+
+    public CraftPlayerRestoreService(org.bukkit.craftbukkit.CraftServer server) {
+        this.nativeBackend = new NativePlayerRestoreBackend(server);
+        this.coordinator = new PlayerRestoreCoordinator(this.nativeBackend, Runnable::run);
+    }
+
+    public boolean captureFencedSave(net.minecraft.server.level.ServerPlayer player) {
+        return this.nativeBackend != null && this.nativeBackend.captureFencedSave(player);

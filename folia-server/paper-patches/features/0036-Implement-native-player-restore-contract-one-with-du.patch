--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/world/NativeRestoreAttachments.java
@@ -0,0 +1,147 @@
+package org.bukkit.craftbukkit.world;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import net.minecraft.core.UUIDUtil;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.ProblemReporter;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityProcessor;
+import net.minecraft.world.entity.EntitySpawnReason;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.projectile.Projectile;
+import net.minecraft.world.level.storage.TagValueInput;
+import net.minecraft.world.phys.Vec3;
+
+/** Detached validation and owner-dispatched replacement of a player's saved entity graph. */
+final class NativeRestoreAttachments {
+    private NativeRestoreAttachments() {}
+
+    static Map<UUID, String> identities(CompoundTag player) {
+        Map<UUID, String> result = new LinkedHashMap<>();
+        player.getCompound("RootVehicle").ifPresent(root -> {
+            UUID attach = root.read("Attach", UUIDUtil.CODEC).orElseThrow();
+            collect(root.getCompound("Entity").orElseThrow(), result);
+            if (!result.containsKey(attach)) throw new IllegalArgumentException("Vehicle attachment is absent from its entity graph");
+        });
+        for (String field : List.of("ShoulderEntityLeft", "ShoulderEntityRight")) {
+            player.getCompound(field).filter(tag -> !tag.isEmpty()).ifPresent(tag -> collect(tag, result));
+        }
+        for (var tag : player.getListOrEmpty("ender_pearls")) {
+            if (!(tag instanceof CompoundTag pearl) || !"minecraft:ender_pearl".equals(pearl.getString("id").orElseThrow())) {
+                throw new IllegalArgumentException("Invalid saved ender pearl entity");
+            }
+            collect(pearl, result);
+        }
+        return Map.copyOf(result);
+    }
+
+    private static void collect(CompoundTag entity, Map<UUID, String> ids) {
+        UUID id = entity.read("UUID", UUIDUtil.CODEC).orElseThrow();
+        String type = entity.getString("id").orElseThrow();
+        if ("minecraft:player".equals(type) || ids.putIfAbsent(id, type) != null) throw new IllegalArgumentException("Duplicate or player entity in attachment graph: " + id);
+        for (var child : entity.getListOrEmpty("Passengers")) {
+            if (!(child instanceof CompoundTag passenger)) throw new IllegalArgumentException("Invalid passenger NBT");
+            collect(passenger, ids);
+        }
+    }
+
+    static void validateLocal(CompoundTag player, ServerLevel world) {
+        player.getCompound("RootVehicle").ifPresent(root -> decode(root.getCompound("Entity").orElseThrow(), world));
+        for (String field : List.of("ShoulderEntityLeft", "ShoulderEntityRight")) {
+            player.getCompound(field).filter(tag -> !tag.isEmpty()).ifPresent(tag -> {
+                if (!(decode(tag, world) instanceof net.minecraft.world.entity.animal.parrot.Parrot)) {
+                    throw new IllegalArgumentException("Invalid shoulder entity");
+                }
+            });
+        }
+        identities(player);
+    }
+
+    /** Never register preview projectiles with a real owner. */
+    static Entity decode(CompoundTag saved, ServerLevel world) {
+        CompoundTag detached = saved.copy();
+        detachOwners(detached);
+        detached.remove("Passengers"); // Validate descendants without firing mount events on preview entities.
+        ProblemReporter.Collector problems = new ProblemReporter.Collector();
+        Entity entity = EntityType.loadEntityRecursive(TagValueInput.create(problems, world.registryAccess(), detached), world, EntitySpawnReason.LOAD, EntityProcessor.NOP);
+        if (entity == null || !problems.isEmpty()) throw new IllegalArgumentException("Invalid saved attachment: " + problems.getReport());
+        for (var child : saved.getListOrEmpty("Passengers")) decode((CompoundTag)child, world);
+        return entity;
+    }
+
+    private static void detachOwners(CompoundTag tag) {
+        // Other owner references must still be decoded/validated normally.
+        // Only pearls register themselves in a live player's owner set on load.
+        if ("minecraft:ender_pearl".equals(tag.getString("id").orElse(""))) tag.remove("Owner");
+        for (var child : tag.getListOrEmpty("Passengers")) if (child instanceof CompoundTag passenger) detachOwners(passenger);
+    }
+
+    static Vec3 pearlPosition(CompoundTag pearl, UUID owner) {
+        if (!pearl.read("Owner", UUIDUtil.CODEC).orElseThrow().equals(owner)) throw new IllegalArgumentException("Saved ender pearl has another owner");
+        Vec3 position = pearl.read("Pos", Vec3.CODEC).orElseThrow();
+        if (!Double.isFinite(position.x) || !Double.isFinite(position.y) || !Double.isFinite(position.z)
+            || !ServerLevel.isInSpawnableBounds(net.minecraft.core.BlockPos.containing(position))) {
+            throw new IllegalArgumentException("Invalid saved pearl position");
+        }
+        return position;
+    }
+
+    static CompletionStage<Void> clear(ServerPlayer player, CompoundTag saved) {
+        Map<UUID, String> ids = identities(saved);
+        List<Entity> remove = new ArrayList<>();
+        Entity root = player.getRootVehicle();
+        boolean ownedRoot = root != player && root.hasExactlyOnePlayerPassenger();
+        player.stopRiding();
+        if (player.isPassenger() || player.isVehicle()) return CompletableFuture.failedStage(new IllegalStateException("Player mount refused restore detach"));
+        if (ownedRoot) {
+            remove.add(root);
+            root.getIndirectPassengers().forEach(remove::add);
+        }
+        remove.addAll(List.copyOf(player.getEnderPearls()));
+        // Lookup is concurrent; no entity fields are inspected until its owner runs.
+        for (ServerLevel world : player.level().getServer().getAllLevels()) {
+            for (UUID id : ids.keySet()) {
+                Entity existing = world.getEntity(id);
+                if (existing != null) {
+                    // Use object identity as well: a duplicated UUID in two worlds
+                    // must not leave one world copy behind.
+                    remove.add(existing);
+                }
+            }
+        }
+        List<CompletableFuture<?>> children = new ArrayList<>();
+        java.util.Set<Entity> unique = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+        for (Entity entity : remove) {
+            if (!unique.add(entity)) continue;
+            children.add(entity.getBukkitEntity().taskScheduler.scheduleRestore(current -> {
+                NativeRestoreWork.checkRunning();
+                String expected = ids.get(current.getUUID());
+                if (current instanceof ServerPlayer || hasPlayerPassenger(current)
+                    || (expected != null && !expected.equals(BuiltInRegistries.ENTITY_TYPE.getKey(current.getType()).toString()))) {
+                    throw new IllegalStateException("Saved attachment UUID is occupied by an incompatible live entity");
+                }
+                if (current instanceof Projectile projectile) {
+                    if (projectile.owner != null && !projectile.owner.getUUID().equals(player.getUUID())) throw new IllegalStateException("Saved projectile has another live owner");
+                    projectile.setOwner((Entity)null);
+                }
+                current.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DISCARD);
+                return CompletableFuture.completedStage(null);
+            }).toCompletableFuture());
+        }
+        return CompletableFuture.allOf(children.toArray(CompletableFuture[]::new));
+    }
+
+    private static boolean hasPlayerPassenger(Entity entity) {
+        for (Entity passenger : entity.getIndirectPassengers()) if (passenger instanceof ServerPlayer) return true;
+        return false;
+    }
+}

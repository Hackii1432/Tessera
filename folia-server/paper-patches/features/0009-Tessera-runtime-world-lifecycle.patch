+/**
+ * Tessera's lifecycle actor. Global registrations and Bukkit lifecycle events
+ * are serialized on the global region; blocking storage work is isolated on
+ * lifecycle workers and per-world stamped locks never block a tick thread.
+ */
+public final class CraftRuntimeWorldManager implements RuntimeWorldManager {
+
+    private static final Pattern SAFE_WORLD_NAME = Pattern.compile("[A-Za-z0-9._-]{1,64}");
+    private static final Set<String> WINDOWS_RESERVED_NAMES = Set.of(
+        "con", "prn", "aux", "nul",
+        "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
+        "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"
+    );
+    private static final Set<String> SNAPSHOT_DIRECTORIES = Set.of("region", "entities", "poi", "data");
+
+    private final CraftServer server;
+    private final ExecutorService lifecycleExecutor;
+    private final ConcurrentHashMap<String, StampedLock> operationLocks = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<UUID, CompletableFuture<TemplateSnapshot>> templateSnapshots = new ConcurrentHashMap<>();
+    private final AtomicBoolean stopping = new AtomicBoolean();
+
+    public CraftRuntimeWorldManager(final CraftServer server) {
+        this.server = Objects.requireNonNull(server, "server");
+        final int workers = Math.max(4, Math.min(16, Runtime.getRuntime().availableProcessors()));
+        final AtomicInteger ids = new AtomicInteger();
+        final ThreadFactory factory = runnable -> {
+            final Thread thread = new Thread(runnable, "Tessera World Lifecycle #" + ids.incrementAndGet());
+            thread.setDaemon(true);
+            thread.setUncaughtExceptionHandler((ignored, throwable) ->
+                this.server.getLogger().log(java.util.logging.Level.SEVERE, "Uncaught runtime world lifecycle failure", throwable)
+            );
+            return thread;
+        };
+        this.lifecycleExecutor = Executors.newFixedThreadPool(workers, factory);
+    }
+
+    @Override
+    public boolean supportsRuntimeWorldLifecycle() {
+        return true;
+    }
+
+    @Override
+    public CompletionStage<WorldLoadResult> createWorldAsync(final WorldCreator creator) {
+        return this.loadWorld(creator, LoadMode.CREATE);
+    }
+
+    @Override
+    public CompletionStage<WorldLoadResult> loadWorldAsync(final WorldCreator creator) {
+        return this.loadWorld(creator, LoadMode.LOAD);
+    }
+
+    private CompletionStage<WorldLoadResult> loadWorld(final WorldCreator requested, final LoadMode mode) {
+        if (requested == null) {
+            return CompletableFuture.completedFuture(new WorldLoadResult(
+                WorldLoadResult.Status.INVALID_REQUEST, null, "WorldCreator cannot be null", null
+            ));
+        }
+
+        final WorldCreator creator;
+        try {
+            creator = copyCreator(requested);
+        } catch (final Throwable throwable) {
+            return CompletableFuture.completedFuture(new WorldLoadResult(
+                WorldLoadResult.Status.INVALID_REQUEST, null, "Could not snapshot WorldCreator", throwable
+            ));
+        }
+
+        final String lockName = normalizeName(creator.name());
+        return this.withLocks(List.of(new LockRequest(lockName, true)), () -> this.loadWorldLocked(creator, mode));
+    }
+
+    private CompletionStage<WorldLoadResult> loadWorldLocked(final WorldCreator creator, final LoadMode mode) {
+        final WorldLoadResult validation = this.validateLoadRequest(creator, mode);
+        if (validation != null) {
+            return CompletableFuture.completedFuture(validation);
+        }
+
+        final boolean newWorld = mode != LoadMode.LOAD;
+        if (newWorld && creator.forcedSpawnPosition() == null) {
+            // Avoid vanilla's synchronous first-chunk lookup on the global region.
+            // The surrounding chunks are prepared asynchronously before activation.
+            creator.forcedSpawnPosition(io.papermc.paper.math.Position.block(0, 64, 0), 0.0F, 0.0F);
+        }
+
+        return this.onGlobal(() -> {
+            this.ensureRunning();
+            final World duplicateByName = this.server.getWorld(creator.name());
+            final World duplicateByKey = this.server.getWorld(creator.key());
+            if (duplicateByName != null || duplicateByKey != null) {
+                throw new LifecycleFailure(WorldLoadResult.Status.ALREADY_LOADED, "World is already loaded");
+            }
+            final World created = this.server.tessera$createWorldInternal(creator);
+            if (created == null) {
+                throw new LifecycleFailure(WorldLoadResult.Status.REGISTRATION_FAILED, "CraftServer rejected world registration");
+            }
+            final Location spawn = created.getSpawnLocation();
+            return new PreparedWorld((CraftWorld) created, spawn.getBlockX() >> 4, spawn.getBlockZ() >> 4);
+        }).thenCompose(prepared -> this.prepareSpawnChunks(prepared.world, prepared.spawnChunkX, prepared.spawnChunkZ, 2)
+            .thenCompose(ignored -> this.onGlobal(() -> {
+                this.ensureRunning();
+                this.server.getServer().tessera$activateRuntimeWorld(prepared.world.getHandle());
+                return new WorldLoadResult(
+                    WorldLoadResult.Status.SUCCESS,
+                    prepared.world,
+                    (mode == LoadMode.LOAD ? "Loaded" : "Created") + " runtime world " + prepared.world.getName(),
+                    null
+                );
+            }))
+            .exceptionallyCompose(throwable -> this.rollbackFailedLoad(prepared.world, unwrap(throwable))
+                .thenApply(rollbackFailure -> {
+                    final Throwable cause = unwrap(throwable);
+                    if (rollbackFailure != null) {
+                        cause.addSuppressed(rollbackFailure);
+                        return new WorldLoadResult(
+                            WorldLoadResult.Status.ROLLBACK_FAILED,
+                            null,
+                            "World initialization failed and rollback was incomplete",
+                            cause
+                        );
+                    }
+                    return new WorldLoadResult(
+                        cause instanceof LifecycleFailure failure
+                            ? failure.loadStatus
+                            : WorldLoadResult.Status.CHUNK_PREPARATION_FAILED,
+                        null,
+                        "World initialization failed; all registrations were rolled back",
+                        cause
+                    );
+                }))
+        ).exceptionally(throwable -> {
+            final Throwable cause = unwrap(throwable);
+            if (cause instanceof LifecycleFailure failure) {
+                return new WorldLoadResult(failure.loadStatus, null, failure.getMessage(), failure.getCause());
+            }
+            return new WorldLoadResult(
+                this.isStopping() ? WorldLoadResult.Status.SERVER_STOPPING : WorldLoadResult.Status.INITIALIZATION_FAILED,
+                null,
+                "World initialization failed before activation",
+                cause
+            );
+        });
+    }
+
+    private @Nullable WorldLoadResult validateLoadRequest(final WorldCreator creator, final LoadMode mode) {
+        if (this.isStopping()) {
+            return new WorldLoadResult(WorldLoadResult.Status.SERVER_STOPPING, null, "Server is stopping", null);
+        }
+        final String invalidName = validateWorldName(creator.name());
+        if (invalidName != null) {
+            return new WorldLoadResult(WorldLoadResult.Status.INVALID_NAME, null, invalidName, null);
+        }
+        if (creator.key() == null) {
+            return new WorldLoadResult(WorldLoadResult.Status.INVALID_KEY, null, "World key cannot be null", null);
+        }
+        if (this.server.getWorld(creator.name()) != null || this.server.getWorld(creator.key()) != null) {
+            return new WorldLoadResult(WorldLoadResult.Status.ALREADY_LOADED, null, "World is already loaded", null);
+        }
+
+        final Path folder;
+        try {
+            folder = this.resolveWorldFolder(creator.name());
+        } catch (final IOException exception) {
+            return new WorldLoadResult(WorldLoadResult.Status.INVALID_NAME, null, exception.getMessage(), exception);
+        }
+        final Path levelDat = folder.resolve("level.dat");
+        if (mode == LoadMode.CREATE && Files.exists(folder, LinkOption.NOFOLLOW_LINKS)) {
+            return new WorldLoadResult(WorldLoadResult.Status.ALREADY_EXISTS, null, "Target world folder already exists: " + folder, null);
+        }
+        if (mode == LoadMode.LOAD && !Files.isRegularFile(levelDat, LinkOption.NOFOLLOW_LINKS)) {
+            return new WorldLoadResult(
+                Files.exists(folder, LinkOption.NOFOLLOW_LINKS)
+                    ? WorldLoadResult.Status.INCOMPLETE_WORLD
+                    : WorldLoadResult.Status.NOT_FOUND,
+                null,
+                "Existing world requires a regular level.dat: " + levelDat,
+                null
+            );
+        }
+        return null;
+    }
+
+    @Override
+    public CompletionStage<WorldCloneResult> cloneWorldAsync(
+        final World source,
+        final NamespacedKey target,
+        final WorldCloneOptions options
+    ) {
+        if (!(source instanceof CraftWorld craftSource) || target == null || options == null) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_REQUEST, null, "Source, target and options are required", null
+            ));
+        }
+        if (!options.requireReadOnlyTemplate()) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.SOURCE_NOT_READ_ONLY,
+                null,
+                "Template cloning requires the source to be declared read-only",
+                null
+            ));
+        }
+
+        final WorldCreator targetCreator;
+        try {
+            targetCreator = WorldCreator.ofKey(target).copy(source);
+        } catch (final Throwable throwable) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_REQUEST, null, "Could not construct target WorldCreator", throwable
+            ));
+        }
+        final String sourceName = normalizeName(source.getName());
+        final String targetName = normalizeName(targetCreator.name());
+        if (sourceName.equals(targetName) || source.key().equals(target)) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_REQUEST, null, "Clone target must differ from the source", null
+            ));
+        }
+
+        return this.withLocks(
+            List.of(new LockRequest(sourceName, false), new LockRequest(targetName, true)),
+            () -> this.cloneWorldLocked(craftSource, targetCreator, options)
+        );
+    }
+
+    private CompletionStage<WorldCloneResult> cloneWorldLocked(
+        final CraftWorld source,
+        final WorldCreator targetCreator,
+        final WorldCloneOptions options
+    ) {
+        if (this.isStopping()) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.SERVER_STOPPING, null, "Server is stopping", null
+            ));
+        }
+        final ServerLevel sourceHandle = source.getHandle();
+        if (this.server.getServer().getLevel(sourceHandle.dimension()) != sourceHandle
+            || !sourceHandle.tessera$isRuntimeWorldActive()) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_SOURCE, null, "Source world is not active", null
+            ));
+        }
+        if (!sourceHandle.players().isEmpty()) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_SOURCE, null, "Template world contains players", null
+            ));
+        }
+        if (this.server.getWorld(targetCreator.name()) != null || this.server.getWorld(targetCreator.key()) != null) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.TARGET_EXISTS, null, "Target world is already loaded", null
+            ));
+        }
+
+        final Path targetFolder;
+        try {
+            targetFolder = this.resolveWorldFolder(targetCreator.name());
+            if (Files.exists(targetFolder, LinkOption.NOFOLLOW_LINKS)) {
+                return CompletableFuture.completedFuture(new WorldCloneResult(
+                    WorldCloneResult.Status.TARGET_EXISTS, null, "Target world folder already exists: " + targetFolder, null
+                ));
+            }
+        } catch (final IOException exception) {
+            return CompletableFuture.completedFuture(new WorldCloneResult(
+                WorldCloneResult.Status.INVALID_REQUEST, null, exception.getMessage(), exception
+            ));
+        }
+
+        return this.templateSnapshot(source, options)
+            .thenCompose(snapshot -> CompletableFuture.runAsync(
+                () -> {
+                    try {
+                        this.installSnapshot(snapshot.path, targetFolder);
+                    } catch (final IOException exception) {
+                        throw new CompletionException(exception);
+                    }
+                },
+                this.lifecycleExecutor
+            ))
+            .thenCompose(ignored -> this.loadPreparedClone(targetCreator, options.spawnChunkRadius()))
+            .thenApply(loadResult -> {
+                if (!loadResult.successful()) {
+                    return new WorldCloneResult(
+                        WorldCloneResult.Status.LOAD_FAILED,
+                        null,
+                        "Template copied, but target load failed: " + loadResult.message(),
+                        loadResult.cause()
+                    );
+                }
+                return new WorldCloneResult(
+                    WorldCloneResult.Status.SUCCESS,
+                    loadResult.world(),
+                    "Cloned template " + source.getName() + " to " + targetCreator.key(),
+                    null
+                );
+            })
+            .exceptionally(throwable -> {
+                final Throwable cause = unwrap(throwable);
+                this.deleteTreeBestEffort(targetFolder);
+                return new WorldCloneResult(
+                    cause instanceof CorruptRegionFileException
+                        ? WorldCloneResult.Status.CORRUPT_TEMPLATE
+                        : WorldCloneResult.Status.COPY_FAILED,
+                    null,
+                    "Template clone failed",
+                    cause
+                );
+            });
+    }
+
+    private CompletionStage<WorldLoadResult> loadPreparedClone(final WorldCreator creator, final int spawnRadius) {
+        return this.onGlobal(() -> {
+            this.ensureRunning();
+            final World world = this.server.tessera$createWorldInternal(creator);
+            if (world == null) {
+                throw new LifecycleFailure(WorldLoadResult.Status.REGISTRATION_FAILED, "CraftServer rejected cloned world");
+            }
+            final Location spawn = world.getSpawnLocation();
+            return new PreparedWorld((CraftWorld) world, spawn.getBlockX() >> 4, spawn.getBlockZ() >> 4);
+        }).thenCompose(prepared -> this.prepareSpawnChunks(
+            prepared.world,
+            prepared.spawnChunkX,
+            prepared.spawnChunkZ,
+            spawnRadius
+        ).thenCompose(ignored -> this.onGlobal(() -> {
+            this.server.getServer().tessera$activateRuntimeWorld(prepared.world.getHandle());
+            return new WorldLoadResult(
+                WorldLoadResult.Status.SUCCESS, prepared.world, "Loaded cloned runtime world " + prepared.world.getName(), null
+            );
+        })).exceptionallyCompose(throwable -> this.rollbackFailedLoad(prepared.world, unwrap(throwable))
+            .thenApply(rollback -> new WorldLoadResult(
+                rollback == null ? WorldLoadResult.Status.CHUNK_PREPARATION_FAILED : WorldLoadResult.Status.ROLLBACK_FAILED,
+                null,
+                "Failed to activate cloned world",
+                unwrap(throwable)
+            ))
+        )).exceptionally(throwable -> new WorldLoadResult(
+            WorldLoadResult.Status.INITIALIZATION_FAILED, null, "Failed to construct cloned world", unwrap(throwable)
+        ));
+    }
+
+    private CompletableFuture<TemplateSnapshot> templateSnapshot(
+        final CraftWorld source,
+        final WorldCloneOptions options
+    ) {
+        final UUID sourceId = source.getUID();
+        return this.templateSnapshots.computeIfAbsent(sourceId, ignored -> {
+            final CompletableFuture<TemplateSnapshot> created = this.createTemplateSnapshot(source, options).toCompletableFuture();
+            created.whenComplete((result, failure) -> {
+                if (failure != null) {
+                    this.templateSnapshots.remove(sourceId, created);
+                }
+            });
+            return created;
+        });
+    }
+
+    private CompletionStage<TemplateSnapshot> createTemplateSnapshot(
+        final CraftWorld source,
+        final WorldCloneOptions options
+    ) {
+        final ServerLevel handle = source.getHandle();
+        final Path snapshotRoot;
+        try {
+            snapshotRoot = this.snapshotRoot().resolve(
+                source.getUID() + "-" + Instant.now().toEpochMilli()
+            ).normalize();
+        } catch (final IOException exception) {
+            return CompletableFuture.failedFuture(exception);
+        }
+
+        final CompletionStage<Void> quiesced = this.onGlobal(() -> {
+            this.ensureRunning();
+            if (!handle.players().isEmpty()) {
+                throw new IllegalStateException("Template acquired players before snapshot");
+            }
+            if (!handle.tessera$transitionRuntimeLifecycle(
+                ServerLevel.RuntimeLifecycleState.ACTIVE,
+                ServerLevel.RuntimeLifecycleState.QUIESCING
+            )) {
+                throw new IllegalStateException("Template is busy: " + handle.tessera$getRuntimeLifecycleState());
+            }
+            return null;
+        }).thenCompose(ignored -> RegionizedServer.getInstance().awaitWorldRegionTasks(handle));
+
+        CompletionStage<Void> flushed = quiesced;
+        if (options.flushSource()) {
+            flushed = flushed.thenCompose(ignored -> this.onGlobal(() -> {
+                new WorldSaveEvent(source).callEvent();
+                return null;
+            })).thenCompose(ignored -> RegionShutdownThread.flushRuntimeWorldSnapshot(handle));
+        }
+
+        final CompletionStage<TemplateSnapshot> copied = flushed.thenApplyAsync(ignored -> {
+            try {
+                Files.createDirectories(snapshotRoot);
+                this.copyReusableWorldData(source.getWorldPath(), snapshotRoot, options.copyDataDirectory());
+                return new TemplateSnapshot(snapshotRoot);
+            } catch (final IOException exception) {
+                throw new CompletionException(exception);
+            }
+        }, this.lifecycleExecutor);
+
+        return copied.handle((snapshot, failure) -> this.onGlobal(() -> {
+            if (!handle.tessera$transitionRuntimeLifecycle(
+                ServerLevel.RuntimeLifecycleState.QUIESCING,
+                ServerLevel.RuntimeLifecycleState.ACTIVE
+            ) && handle.tessera$getRuntimeLifecycleState() != ServerLevel.RuntimeLifecycleState.ACTIVE) {
+                throw new IllegalStateException("Could not resume template world from " + handle.tessera$getRuntimeLifecycleState());
+            }
+            if (failure != null) {
+                throw new CompletionException(unwrap(failure));
+            }
+            return snapshot;
+        })).thenCompose(stage -> stage);
+    }
+
+    @Override
+    public CompletionStage<WorldUnloadResult> unloadWorldAsync(
+        final World world,
+        final WorldUnloadOptions options
+    ) {
+        if (!(world instanceof CraftWorld craftWorld) || options == null) {
+            return CompletableFuture.completedFuture(new WorldUnloadResult(
+                WorldUnloadResult.Status.INVALID_REQUEST, "CraftWorld and options are required", null
+            ));
+        }
+        return this.withLocks(
+            List.of(new LockRequest(normalizeName(world.getName()), true)),
+            () -> this.unloadWorldLocked(craftWorld, options)
+        );
+    }
+
+    private CompletionStage<WorldUnloadResult> unloadWorldLocked(
+        final CraftWorld world,
+        final WorldUnloadOptions options
+    ) {
+        if (this.isStopping()) {
+            return CompletableFuture.completedFuture(new WorldUnloadResult(
+                WorldUnloadResult.Status.SERVER_STOPPING, "Server is stopping", null
+            ));
+        }
+        return this.beginUnload(world)
+            .thenCompose(context -> this.evacuatePlayers(context, options)
+                .thenCompose(ignored -> this.onGlobal(() -> {
+                    if (!context.handle.players().isEmpty()) {
+                        throw new UnloadFailure(
+                            WorldUnloadResult.Status.PLAYERS_PRESENT,
+                            "Players entered or remained in the world while unload was quiescing"
+                        );
+                    }
+                    return null;
+                }))
+                .thenCompose(ignored -> RegionizedServer.getInstance().awaitWorldRegionTasks(context.handle))
+                .thenCompose(ignored -> this.onGlobal(() -> {
+                    if (!context.handle.players().isEmpty()) {
+                        throw new UnloadFailure(
+                            WorldUnloadResult.Status.PLAYERS_PRESENT,
+                            "A pending cross-world teleport entered the world during unload"
+                        );
+                    }
+                    if (!context.handle.tessera$transitionRuntimeLifecycle(
+                        ServerLevel.RuntimeLifecycleState.QUIESCING,
+                        ServerLevel.RuntimeLifecycleState.UNLOADING
+                    )) {
+                        throw new UnloadFailure(
+                            WorldUnloadResult.Status.QUIESCE_FAILED,
+                            "World changed lifecycle state while quiescing"
+                        );
+                    }
+                    RegionizedServer.getInstance().deactivateWorldRegions(context.handle);
+                    if (options.save()) {
+                        new WorldSaveEvent(world).callEvent();
+                    }
+                    return null;
+                }))
+                .thenCompose(ignored -> this.closeAndUnregister(context, options.save()))
+            )
+            .exceptionallyCompose(throwable -> {
+                final Throwable cause = unwrap(throwable);
+                return this.resumeFailedUnload(world.getHandle()).thenApply(ignored -> {
+                    if (cause instanceof UnloadFailure failure) {
+                        return new WorldUnloadResult(failure.status, failure.getMessage(), failure.getCause());
+                    }
+                    return new WorldUnloadResult(
+                        WorldUnloadResult.Status.QUIESCE_FAILED,
+                        "World unload failed before storage close",
+                        cause
+                    );
+                });
+            });
+    }
+
+    private CompletionStage<UnloadContext> beginUnload(final CraftWorld world) {
+        return this.onGlobal(() -> {
+            final ServerLevel handle = world.getHandle();
+            if (this.server.getServer().getLevel(handle.dimension()) != handle) {
+                throw new UnloadFailure(WorldUnloadResult.Status.NOT_LOADED, "World is not loaded");
+            }
+            if (RegionizedServer.getInstance().isProtectedWorld(handle)) {
+                throw new UnloadFailure(WorldUnloadResult.Status.PROTECTED_WORLD, "Startup/protected worlds cannot be unloaded");
+            }
+            if (handle.tessera$getRuntimeLifecycleState() != ServerLevel.RuntimeLifecycleState.ACTIVE) {
+                throw new UnloadFailure(
+                    WorldUnloadResult.Status.ALREADY_UNLOADING,
+                    "World is already in lifecycle state " + handle.tessera$getRuntimeLifecycleState()
+                );
+            }
+
+            final WorldUnloadEvent event = new WorldUnloadEvent(world);
+            if (!event.callEvent()) {
+                throw new UnloadFailure(WorldUnloadResult.Status.EVENT_CANCELLED, "WorldUnloadEvent was cancelled");
+            }
+            if (!handle.tessera$transitionRuntimeLifecycle(
+                ServerLevel.RuntimeLifecycleState.ACTIVE,
+                ServerLevel.RuntimeLifecycleState.QUIESCING
+            )) {
+                throw new UnloadFailure(WorldUnloadResult.Status.ALREADY_UNLOADING, "World state changed during unload event");
+            }
+
+            final List<CraftPlayer> players = handle.players().stream()
+                .map(player -> player.getBukkitEntity())
+                .toList();
+            return new UnloadContext(world, handle, players);
+        });
+    }
+
+    private CompletionStage<Void> evacuatePlayers(
+        final UnloadContext context,
+        final WorldUnloadOptions options
+    ) {
+        if (context.players.isEmpty()) {
+            return CompletableFuture.completedFuture(null);
+        }
+        if (options.playerHandling() == WorldUnloadOptions.PlayerHandling.FAIL) {
+            return CompletableFuture.failedFuture(new UnloadFailure(
+                WorldUnloadResult.Status.PLAYERS_PRESENT,
+                "World contains " + context.players.size() + " player(s)"
+            ));
+        }
+
+        final Location target = options.teleportTarget();
+        if (target == null || target.getWorld() == null || target.getWorld() == context.world) {
+            return CompletableFuture.failedFuture(new UnloadFailure(
+                WorldUnloadResult.Status.INVALID_TELEPORT_TARGET,
+                "Teleport target must be in another active world"
+            ));
+        }
+        if (!(target.getWorld() instanceof CraftWorld targetWorld) || !targetWorld.getHandle().tessera$isRuntimeWorldActive()) {
+            return CompletableFuture.failedFuture(new UnloadFailure(
+                WorldUnloadResult.Status.INVALID_TELEPORT_TARGET,
+                "Teleport target world is not active"
+            ));
+        }
+
+        final CompletableFuture<?>[] teleports = context.players.stream()
+            .map(player -> player.teleportAsync(target).thenApply(success -> {
+                if (!success && player.isOnline()) {
+                    throw new CompletionException(new UnloadFailure(
+                        WorldUnloadResult.Status.PLAYER_TELEPORT_FAILED,
+                        "Failed to teleport player " + player.getName()
+                    ));
+                }
+                return null;
+            }))
+            .toArray(CompletableFuture[]::new);
+        return CompletableFuture.allOf(teleports);
+    }
+
+    private CompletionStage<Void> unregisterClosedWorld(final UnloadContext context) {
+        return this.onGlobal(() -> {
+            Throwable failure = null;
+            try {
+                RegionizedServer.getInstance().removeWorld(context.handle);
+            } catch (final Throwable throwable) {
+                failure = throwable;
+            }
+            try {
+                this.server.getServer().removeLevel(context.handle);
+            } catch (final Throwable throwable) {
+                failure = append(failure, throwable);
+            }
+            try {
+                this.server.tessera$removeWorldRegistration(context.world);
+            } catch (final Throwable throwable) {
+                failure = append(failure, throwable);
+            }
+            if (failure != null) {
+                throw new CompletionException(failure);
+            }
+            return null;
+        });
+    }
+
+    private CompletionStage<WorldUnloadResult> closeAndUnregister(
+        final UnloadContext context,
+        final boolean save
+    ) {
+        return RegionShutdownThread.closeRuntimeWorld(context.handle, save)
+            .handle((ignored, closeFailure) -> new CloseOutcome(
+                closeFailure == null ? null : unwrap(closeFailure)
+            ))
+            .thenCompose(closeOutcome -> this.unregisterClosedWorld(context)
+                .handle((ignored, unregisterFailure) -> {
+                    final Throwable unregisterCause =
+                        unregisterFailure == null ? null : unwrap(unregisterFailure);
+                    if (closeOutcome.failure != null && unregisterCause != null) {
+                        closeOutcome.failure.addSuppressed(unregisterCause);
+                    }
+                    if (unregisterCause != null) {
+                        return new WorldUnloadResult(
+                            WorldUnloadResult.Status.UNREGISTRATION_FAILED,
+                            "World storage was closed, but one or more registrations could not be removed",
+                            unregisterCause
+                        );
+                    }
+                    if (closeOutcome.failure != null) {
+                        return new WorldUnloadResult(
+                            WorldUnloadResult.Status.STORAGE_CLOSE_FAILED,
+                            "World was unregistered after a storage close failure",
+                            closeOutcome.failure
+                        );
+                    }
+                    return new WorldUnloadResult(
+                        WorldUnloadResult.Status.SUCCESS,
+                        "World fully unloaded and all storage handles released",
+                        null
+                    );
+                })
+            );
+    }
+
+    private CompletionStage<Void> resumeFailedUnload(final ServerLevel handle) {
+        if (handle.tessera$getRuntimeLifecycleState() != ServerLevel.RuntimeLifecycleState.QUIESCING) {
+            return CompletableFuture.completedFuture(null);
+        }
+        return this.<Void>onGlobal(() -> {
+            handle.tessera$transitionRuntimeLifecycle(
+                ServerLevel.RuntimeLifecycleState.QUIESCING,
+                ServerLevel.RuntimeLifecycleState.ACTIVE
+            );
+            return null;
+        }).exceptionally(ignored -> (Void)null);
+    }
+
+    private CompletionStage<@Nullable Throwable> rollbackFailedLoad(
+        final CraftWorld world,
+        final Throwable originalFailure
+    ) {
+        final ServerLevel handle = world.getHandle();
+        return RegionizedServer.getInstance().awaitWorldRegionTasks(handle)
+            .exceptionally(throwable -> null)
+            .thenCompose(ignored -> this.onGlobal(() -> {
+                handle.tessera$setRuntimeLifecycle(ServerLevel.RuntimeLifecycleState.UNLOADING);
+                RegionizedServer.getInstance().deactivateWorldRegions(handle);
+                return null;
+            }))
+            .thenCompose(ignored -> RegionShutdownThread.closeRuntimeWorld(handle, false))
+            .handle((ignored, closeFailure) -> new CloseOutcome(
+                closeFailure == null ? null : unwrap(closeFailure)
+            ))
+            .thenCompose(closeOutcome -> this.unregisterClosedWorld(new UnloadContext(world, handle, List.of()))
+                .handle((unused, unregisterFailure) -> {
+                    Throwable failure = closeOutcome.failure;
+                    if (unregisterFailure != null) {
+                        failure = append(failure, unwrap(unregisterFailure));
+                    }
+                    return failure;
+                })
+            )
+            .exceptionally(throwable -> {
+                originalFailure.addSuppressed(unwrap(throwable));
+                return unwrap(throwable);
+            });
+    }
+
+    private CompletableFuture<Void> prepareSpawnChunks(
+        final CraftWorld world,
+        final int centerX,
+        final int centerZ,
+        final int radius
+    ) {
+        final List<CompletableFuture<Chunk>> chunks = new ArrayList<>((radius * 2 + 1) * (radius * 2 + 1));
+        for (int dz = -radius; dz <= radius; ++dz) {
+            for (int dx = -radius; dx <= radius; ++dx) {
+                chunks.add(world.getChunkAtAsync(centerX + dx, centerZ + dz, true, true));
+            }
+        }
+        return CompletableFuture.allOf(chunks.toArray(CompletableFuture[]::new));
+    }
+
+    private void copyReusableWorldData(
+        final Path sourceRoot,
+        final Path targetRoot,
+        final boolean copyDataDirectory
+    ) throws IOException {
+        final Path normalizedSource = sourceRoot.toRealPath(LinkOption.NOFOLLOW_LINKS);
+        for (final String name : SNAPSHOT_DIRECTORIES) {
+            if (!copyDataDirectory && name.equals("data")) {
+                continue;
+            }
+            final Path source = normalizedSource.resolve(name);
+            if (!Files.exists(source, LinkOption.NOFOLLOW_LINKS)) {
+                continue;
+            }
+            if (!Files.isDirectory(source, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(source)) {
+                throw new IOException("Unsafe template path: " + source);
+            }
+            final Path target = targetRoot.resolve(name);
+            this.copyTree(source, target, true);
+        }
+    }
+
+    private void installSnapshot(final Path snapshot, final Path target) throws IOException {
+        final Path parent = target.getParent();
+        Files.createDirectories(parent);
+        final Path staging = parent.resolve("." + target.getFileName() + ".tessera-staging-" + UUID.randomUUID()).normalize();
+        if (!staging.getParent().equals(parent)) {
+            throw new IOException("Invalid staging path " + staging);
+        }
+        try {
+            Files.createDirectory(staging);
+            this.copyTree(snapshot, staging, false);
+            try {
+                Files.move(staging, target, StandardCopyOption.ATOMIC_MOVE);
+            } catch (final java.nio.file.AtomicMoveNotSupportedException ignored) {
+                Files.move(staging, target);
+            }
+        } catch (final Throwable throwable) {
+            this.deleteTreeBestEffort(staging);
+            if (throwable instanceof IOException ioException) {
+                throw ioException;
+            }
+            throw new IOException("Failed to install world snapshot", throwable);
+        }
+    }
+
+    private void copyTree(final Path source, final Path target, final boolean validateRegions) throws IOException {
+        Files.walkFileTree(source, new SimpleFileVisitor<>() {
+            @Override
+            public FileVisitResult preVisitDirectory(final Path directory, final BasicFileAttributes attributes) throws IOException {
+                if (Files.isSymbolicLink(directory)) {
+                    throw new IOException("Symbolic links are not allowed in world templates: " + directory);
+                }
+                Files.createDirectories(target.resolve(source.relativize(directory)));
+                return FileVisitResult.CONTINUE;
+            }
+
+            @Override
+            public FileVisitResult visitFile(final Path file, final BasicFileAttributes attributes) throws IOException {
+                if (!attributes.isRegularFile() || Files.isSymbolicLink(file)) {
+                    throw new IOException("Non-regular file in world template: " + file);
+                }
+                final Path relative = source.relativize(file);
+                if (isIdentityOrPlayerData(relative)) {
+                    return FileVisitResult.CONTINUE;
+                }
+                if (validateRegions && file.getFileName().toString().endsWith(".mca")) {
+                    validateRegionFile(file);
+                }
+                Files.copy(file, target.resolve(relative), StandardCopyOption.COPY_ATTRIBUTES);
+                return FileVisitResult.CONTINUE;
+            }
+        });
+    }
+
+    private static boolean isIdentityOrPlayerData(final Path relative) {
+        if (relative.getNameCount() == 0) {
+            return false;
+        }
+        final String first = relative.getName(0).toString().toLowerCase(Locale.ROOT);
+        final String file = relative.getFileName().toString().toLowerCase(Locale.ROOT);
+        return first.equals("playerdata")
+            || first.equals("players")
+            || first.equals("stats")
+            || first.equals("advancements")
+            || file.equals("uid.dat")
+            || file.equals("session.lock")
+            || file.equals("level.dat")
+            || file.equals("level.dat_old")
+            || file.equals("paper_world_pdc.dat");
+    }
+
+    private static void validateRegionFile(final Path file) throws IOException {
+        final long size = Files.size(file);
+        if (size < 8192L) {
+            throw new CorruptRegionFileException(file, "region header is shorter than 8192 bytes");
+        }
+        final ByteBuffer locations = ByteBuffer.allocate(4096);
+        try (SeekableByteChannel channel = Files.newByteChannel(file, StandardOpenOption.READ)) {
+            while (locations.hasRemaining()) {
+                if (channel.read(locations) < 0) {
+                    throw new CorruptRegionFileException(file, "truncated location table");
+                }
+            }
+        }
+        locations.flip();
+        for (int index = 0; index < 1024; ++index) {
+            final int location = locations.getInt();
+            final int offset = (location >>> 8) & 0x00FF_FFFF;
+            final int sectors = location & 0xFF;
+            if (offset == 0 && sectors == 0) {
+                continue;
+            }
+            if (offset < 2 || sectors == 0 || ((long) offset + sectors) * 4096L > size) {
+                throw new CorruptRegionFileException(file, "invalid sector allocation at header entry " + index);
+            }
+        }
+    }
+
+    private Path resolveWorldFolder(final String name) throws IOException {
+        final Path container = this.server.getWorldContainer().toPath().toAbsolutePath().normalize();
+        final Path resolved = container.resolve(name).normalize();
+        if (!resolved.getParent().equals(container)) {
+            throw new IOException("World folder escapes the configured world container: " + name);
+        }
+        return resolved;
+    }
+
+    private Path snapshotRoot() throws IOException {
+        final Path container = this.server.getWorldContainer().toPath().toAbsolutePath().normalize();
+        final Path root = container.resolve(".tessera").resolve("template-snapshots").normalize();
+        if (!root.startsWith(container)) {
+            throw new IOException("Snapshot path escapes world container");
+        }
+        Files.createDirectories(root);
+        return root;
+    }
+
+    private void deleteTreeBestEffort(final Path path) {
+        if (path == null || !Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try {
+            final Path container = this.server.getWorldContainer().toPath().toAbsolutePath().normalize();
+            final Path normalized = path.toAbsolutePath().normalize();
+            if (!normalized.startsWith(container) || normalized.equals(container)) {
+                throw new IOException("Refusing to delete path outside the world container: " + normalized);
+            }
+            try (var stream = Files.walk(normalized)) {
+                for (final Path entry : stream.sorted(Comparator.reverseOrder()).toList()) {
+                    Files.deleteIfExists(entry);
+                }
+            }
+        } catch (final IOException exception) {
+            this.server.getLogger().log(java.util.logging.Level.WARNING, "Could not clean lifecycle staging path " + path, exception);
+        }
+    }
+
+    private <T> CompletableFuture<T> onGlobal(final Supplier<T> action) {
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        final Runnable run = () -> {
+            if (future.isDone()) {
+                return;
+            }
+            try {
+                future.complete(action.get());
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        };
+        if (RegionizedServer.isGlobalTickThread()) {
+            run.run();
+        } else if (this.isStopping()) {
+            future.completeExceptionally(new IllegalStateException("Server is stopping"));
+        } else {
+            RegionizedServer.getInstance().addTask(run);
+        }
+        return future;
+    }
+
+    private <T> CompletableFuture<T> withLocks(
+        final List<LockRequest> requests,
+        final Supplier<? extends CompletionStage<T>> operation
+    ) {
+        final List<LockRequest> ordered = requests.stream()
+            .sorted(Comparator.comparing(LockRequest::name))
+            .toList();
+        return CompletableFuture.supplyAsync(() -> {
+            final List<HeldLock> held = new ArrayList<>(ordered.size());
+            try {
+                for (final LockRequest request : ordered) {
+                    final StampedLock lock = this.operationLocks.computeIfAbsent(request.name, ignored -> new StampedLock());
+                    final long stamp = request.write ? lock.writeLock() : lock.readLock();
+                    held.add(new HeldLock(lock, stamp, request.write));
+                }
+                return held;
+            } catch (final Throwable throwable) {
+                releaseLocks(held);
+                throw throwable;
+            }
+        }, this.lifecycleExecutor).thenCompose(held -> {
+            final CompletionStage<T> stage;
+            try {
+                stage = operation.get();
+            } catch (final Throwable throwable) {
+                releaseLocks(held);
+                return CompletableFuture.failedFuture(throwable);
+            }
+            return stage.whenComplete((ignored, throwable) -> releaseLocks(held)).toCompletableFuture();
+        });
+    }
+
+    private static void releaseLocks(final List<HeldLock> held) {
+        for (int index = held.size() - 1; index >= 0; --index) {
+            final HeldLock lock = held.get(index);
+            if (lock.write) {
+                lock.lock.unlockWrite(lock.stamp);
+            } else {
+                lock.lock.unlockRead(lock.stamp);
+            }
+        }
+    }
+
+    private static WorldCreator copyCreator(final WorldCreator original) {
+        final WorldCreator copy = WorldCreator.ofKey(original.key()).copy(original);
+        if (original.forcedSpawnPosition() != null) {
+            copy.forcedSpawnPosition(
+                original.forcedSpawnPosition(),
+                Objects.requireNonNullElse(original.forcedSpawnYaw(), 0.0F),
+                Objects.requireNonNullElse(original.forcedSpawnPitch(), 0.0F)
+            );
+        }
+        return copy;
+    }
+
+    private static @Nullable String validateWorldName(final String name) {
+        if (name == null || !SAFE_WORLD_NAME.matcher(name).matches() || name.equals(".") || name.equals("..")) {
+            return "World name must contain 1-64 characters from A-Z, a-z, 0-9, '.', '_' or '-'";
+        }
+        final String stem = name.split("\\.", 2)[0].toLowerCase(Locale.ROOT);
+        if (WINDOWS_RESERVED_NAMES.contains(stem)) {
+            return "World name is reserved on Windows: " + name;
+        }
+        return null;
+    }
+
+    private static String normalizeName(final String name) {
+        return name.toLowerCase(Locale.ROOT);
+    }
+
+    private boolean isStopping() {
+        return this.stopping.get() || !this.server.getServer().isRunning();
+    }
+
+    private void ensureRunning() {
+        if (this.isStopping()) {
+            throw new IllegalStateException("Server is stopping");
+        }
+    }
+
+    public void shutdown() {
+        if (!this.stopping.compareAndSet(false, true)) {
+            return;
+        }
+        this.templateSnapshots.clear();
+        this.lifecycleExecutor.shutdown();
+    }
+
+    private static Throwable unwrap(final Throwable throwable) {
+        Throwable current = throwable;
+        while ((current instanceof CompletionException || current instanceof java.util.concurrent.ExecutionException)
+            && current.getCause() != null) {
+            current = current.getCause();
+        }
+        return current;
+    }
+
+    private static Throwable append(final @Nullable Throwable existing, final Throwable additional) {
+        if (existing == null) {
+            return additional;
+        }
+        existing.addSuppressed(additional);
+        return existing;
+    }

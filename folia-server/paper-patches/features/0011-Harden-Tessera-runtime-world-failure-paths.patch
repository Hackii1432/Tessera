-    public void shutdown() {
+    public void beginServerShutdown() {
         if (!this.stopping.compareAndSet(false, true)) {
             return;
         }
+        this.lifecycleExecutor.shutdownNow();
+    }
+
+    public void completeServerShutdown() {
+        this.beginServerShutdown();
+        try {
+            if (!this.lifecycleExecutor.awaitTermination(30L, TimeUnit.SECONDS)) {
+                this.server.getLogger().warning("Runtime world lifecycle workers did not terminate within 30 seconds");
+            }
+        } catch (final InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+        }
         this.templateSnapshots.clear();
-        this.lifecycleExecutor.shutdown();
+        this.shutdownComplete.set(true);
+        for (final PendingOperation<?> pending : List.copyOf(this.pendingOperations)) {
+            pending.completeForShutdown();
+        }
+        this.pendingOperations.clear();
+    }
+
+    private <T> CompletionStage<T> trackOperation(
+        final CompletionStage<T> internal,
+        final Supplier<T> stoppedResult
+    ) {
+        if (this.stopping.get() && internal.toCompletableFuture().isDone()) {
+            return CompletableFuture.completedFuture(stoppedResult.get());
+        }
+        if (internal.toCompletableFuture().isDone() && !this.stopping.get()) {
+            return internal;
+        }
+        final PendingOperation<T> pending = new PendingOperation<>(stoppedResult);
+        this.pendingOperations.add(pending);
+        internal.whenComplete((result, failure) -> {
+            if (this.stopping.get()) {
+                if (this.shutdownComplete.get()) {
+                    pending.completeForShutdown();
+                    this.pendingOperations.remove(pending);
+                }
+                return;
+            }
+            if (failure == null) {
+                pending.exposed.complete(result);
+            } else {
+                pending.exposed.completeExceptionally(failure);
+            }
+            this.pendingOperations.remove(pending);
+        });
+        if (this.shutdownComplete.get()) {
+            pending.completeForShutdown();
+            this.pendingOperations.remove(pending);
+        }
+        return pending.exposed;
     }
 
     private static Throwable unwrap(final Throwable throwable) {
@@ -1050,6 +1175,19 @@ public final class CraftRuntimeWorldManager implements RuntimeWorldManager {
     private record HeldLock(StampedLock lock, long stamp, boolean write) {

+package org.bukkit.craftbukkit.world;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class CraftRuntimeWorldManagerTest {
+
+    @TempDir
+    Path tempDir;
+
+    @Test
+    void acceptsWellFormedRegionAllocationAndChunkHeader() throws Exception {
+        final Path region = this.writeRegion(false, 2, 3);
+        assertDoesNotThrow(() -> CraftRuntimeWorldManager.validateRegionFile(region));
+    }
+
+    @Test
+    void rejectsTruncatedRegionHeader() throws Exception {
+        final Path region = this.tempDir.resolve("r.0.0.mca");
+        Files.write(region, new byte[4096]);
+        assertThrows(IOException.class, () -> CraftRuntimeWorldManager.validateRegionFile(region));
+    }
+
+    @Test
+    void rejectsOverlappingSectorAllocations() throws Exception {
+        final Path region = this.writeRegion(true, 2, 3);
+        assertThrows(IOException.class, () -> CraftRuntimeWorldManager.validateRegionFile(region));
+    }
+
+    @Test
+    void rejectsUnknownCompression() throws Exception {
+        final Path region = this.writeRegion(false, 2, 42);
+        assertThrows(IOException.class, () -> CraftRuntimeWorldManager.validateRegionFile(region));
+    }
+
+    @Test
+    void rejectsChunkLengthOutsideAllocatedSectors() throws Exception {
+        final Path region = this.writeRegion(false, 5000, 3);
+        assertThrows(IOException.class, () -> CraftRuntimeWorldManager.validateRegionFile(region));
+    }
+
+    private Path writeRegion(
+        final boolean overlap,
+        final int chunkLength,
+        final int compression
+    ) throws Exception {
+        final Path region = this.tempDir.resolve("r.0.0.mca");
+        try (FileChannel channel = FileChannel.open(
+            region,
+            StandardOpenOption.CREATE_NEW,
+            StandardOpenOption.WRITE
+        )) {
+            final ByteBuffer header = ByteBuffer.allocate(8192);
+            header.putInt((2 << 8) | 1);
+            if (overlap) {
+                header.putInt((2 << 8) | 1);
+            }
+            header.position(8192);
+            header.flip();
+            while (header.hasRemaining()) {
+                channel.write(header);
+            }
+
+            final ByteBuffer chunk = ByteBuffer.allocate(4096);
+            chunk.putInt(chunkLength);
+            chunk.put((byte)compression);
+            chunk.position(4096);
+            chunk.flip();
+            while (chunk.hasRemaining()) {
+                channel.write(chunk);
+            }
+        }
+        return region;
+    }
+}

+    private static final class PendingOperation<T> {
+        private final CompletableFuture<T> exposed = new CompletableFuture<>();
+        private final Supplier<T> stoppedResult;
+
+        private PendingOperation(final Supplier<T> stoppedResult) {
+            this.stoppedResult = stoppedResult;
+        }
+
+        private void completeForShutdown() {
+            this.exposed.complete(this.stoppedResult.get());
+        }
+    }
+

Subject: [PATCH] Test Vanilla falling-block End arrival geometry


diff --git a/src/test/java/io/papermc/paper/porting/EndPortalArrivalTest.java b/src/test/java/io/papermc/paper/porting/EndPortalArrivalTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..0da5b4741b8772f0a0290d58b3e5301c89b6cd7d
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/EndPortalArrivalTest.java
@@ -0,0 +1,78 @@
+package io.papermc.paper.porting;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.PositionMoveRotation;
+import net.minecraft.world.entity.Relative;
+import net.minecraft.world.entity.item.FallingBlockEntity;
+import net.minecraft.world.level.dimension.LevelStem;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@VanillaFeature
+class EndPortalArrivalTest {
+    private static BlockPos spawn(Entity entity) throws Exception {
+        var method = Entity.class.getDeclaredMethod("tessera$getEndPortalSpawnPoint");
+        method.setAccessible(true);
+        return (BlockPos) method.invoke(entity);
+    }
+
+    private static BlockPos platform(Entity entity, ServerLevel origin, Vec3 target) throws Exception {
+        var method = Entity.class.getDeclaredMethod("tessera$getEndPortalPlatformOrigin", ServerLevel.class, Vec3.class);
+        method.setAccessible(true);
+        return (BlockPos) method.invoke(entity, origin, target);
+    }
+
+    @Test void fallingBlockHasVanillaClearanceAboveUnmovedPlatform() throws Exception {
+        var falling = mock(FallingBlockEntity.class, CALLS_REAL_METHODS);
+        var origin = mock(ServerLevel.class);
+        when(origin.getTypeKey()).thenReturn(LevelStem.OVERWORLD);
+        BlockPos arrival = spawn(falling);
+        assertEquals(new BlockPos(100, 50, 0), arrival);
+        BlockPos platformOrigin = platform(falling, origin, Vec3.atBottomCenterOf(arrival));
+        assertEquals(new BlockPos(100, 49, 0), platformOrigin);
+        assertEquals(new BlockPos(100, 48, 0), platformOrigin.below(), "Vanilla obsidian floor stays at y=48");
+    }
+
+    @Test void playerAndUnrelatedEntityArrivalsStayUnchanged() throws Exception {
+        assertEquals(ServerLevel.END_SPAWN_POINT.below(), spawn(mock(ServerPlayer.class, CALLS_REAL_METHODS)));
+        assertEquals(ServerLevel.END_SPAWN_POINT.below(), spawn(mock(Entity.class, CALLS_REAL_METHODS)));
+    }
+
+    @Test void explicitPluginDestinationKeepsItsPlatformGeometry() throws Exception {
+        var origin = mock(ServerLevel.class);
+        when(origin.getTypeKey()).thenReturn(LevelStem.OVERWORLD);
+        Vec3 target = new Vec3(120.5, 70, 8.5);
+        assertEquals(BlockPos.containing(target), platform(mock(FallingBlockEntity.class, CALLS_REAL_METHODS), origin, target));
+    }
+
+    @Test void endOriginDoesNotAcquireEntranceOffset() throws Exception {
+        var origin = mock(ServerLevel.class);
+        when(origin.getTypeKey()).thenReturn(LevelStem.END);
+        assertEquals(ServerLevel.END_SPAWN_POINT, platform(mock(FallingBlockEntity.class, CALLS_REAL_METHODS), origin, Vec3.atBottomCenterOf(ServerLevel.END_SPAWN_POINT)));
+    }
+
+    @Test void unrelatedEntityPlatformGeometryDoesNotChange() throws Exception {
+        var origin = mock(ServerLevel.class);
+        Vec3 target = Vec3.atBottomCenterOf(ServerLevel.END_SPAWN_POINT);
+        assertEquals(ServerLevel.END_SPAWN_POINT, platform(mock(Entity.class, CALLS_REAL_METHODS), origin, target));
+        verifyNoInteractions(origin);
+    }
+
+    @Test void relativeDeltaRetainsVanillaRotationOfCardinalLaunchVelocity() {
+        for (Vec3 velocity : new Vec3[]{new Vec3(1, 0, 0), new Vec3(-1, 0, 0), new Vec3(0, 0, 1), new Vec3(0, 0, -1)}) {
+            var source = new PositionMoveRotation(Vec3.ZERO, velocity, 0, 0);
+            var change = new PositionMoveRotation(Vec3.atBottomCenterOf(ServerLevel.END_SPAWN_POINT), Vec3.ZERO, 90, 0);
+            // Vanilla Relative.DELTA includes ROTATE_DELTA: source yaw 0 to
+            // exit yaw 90 rotates east -> south, west -> north and vice versa.
+            Vec3 expected = new Vec3(-velocity.z, 0, velocity.x);
+            assertTrue(expected.distanceTo(PositionMoveRotation.calculateAbsolute(source, change, Relative.DELTA).deltaMovement()) < 1.0E-6);
+        }
+    }
+}

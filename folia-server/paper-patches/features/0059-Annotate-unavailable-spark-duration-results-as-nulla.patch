From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Sat, 17 Oct 2026 22:24:07 +0200
Subject: [PATCH] Annotate unavailable spark duration results as nullable


diff --git a/src/main/java/io/papermc/paper/spark/RegionTickStatistics.java b/src/main/java/io/papermc/paper/spark/RegionTickStatistics.java
index a585241a3b034e8db07ec3ce923f967ba12be683..1e17494f59c936e41c4acd9610d1013999bde4e9 100644
--- a/src/main/java/io/papermc/paper/spark/RegionTickStatistics.java
+++ b/src/main/java/io/papermc/paper/spark/RegionTickStatistics.java
@@ -163,7 +163,7 @@ public final class RegionTickStatistics implements TickStatistics {
     // TickData publishes median/min/max but no p95. Do not manufacture a percentile.
     // spark's WindowStatisticsCollector asks duration1Min even when duration is
     // unsupported, and explicitly accepts null. Throwing kills sampler insertion.
-    @Override public org.jetbrains.annotations.Nullable DoubleAverageInfo duration10Sec() { return null; }
-    @Override public org.jetbrains.annotations.Nullable DoubleAverageInfo duration1Min() { return null; }
-    @Override public org.jetbrains.annotations.Nullable DoubleAverageInfo duration5Min() { return null; }
+    @Override public @org.jetbrains.annotations.Nullable DoubleAverageInfo duration10Sec() { return null; }
+    @Override public @org.jetbrains.annotations.Nullable DoubleAverageInfo duration1Min() { return null; }
+    @Override public @org.jetbrains.annotations.Nullable DoubleAverageInfo duration5Min() { return null; }
 }

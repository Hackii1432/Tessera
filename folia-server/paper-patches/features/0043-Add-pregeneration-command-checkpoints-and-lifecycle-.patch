diff --git a/src/main/java/io/papermc/paper/pregeneration/PregenerationArea.java b/src/main/java/io/papermc/paper/pregeneration/PregenerationArea.java
new file mode 100644
index 0000000000000000000000000000000000000000..a6959d0201e16456138be887b15e64153b55c4a6
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pregeneration/PregenerationArea.java
@@ -0,0 +1,132 @@
+package io.papermc.paper.pregeneration;
+
+/** Internal, immutable selection. Coordinates are inclusive block coordinates. */
+public record PregenerationArea(Shape shape, int centerX, int centerZ, int radius,
+                               int minX, int maxX, int minZ, int maxZ) {
+    public static final int MAX_COORDINATE = 29_999_983;
+
+    public enum Shape { CIRCLE, SQUARE, RECTANGLE }
+
+    public PregenerationArea {
+        if (shape == null || radius < 0 || minX > maxX || minZ > maxZ
+            || minX < -MAX_COORDINATE || maxX > MAX_COORDINATE
+            || minZ < -MAX_COORDINATE || maxZ > MAX_COORDINATE) {
+            throw new IllegalArgumentException("Selection exceeds Minecraft coordinates or has invalid bounds");
+        }
+        if (shape != Shape.RECTANGLE && ((long) centerX - radius != minX
+            || (long) centerX + radius != maxX || (long) centerZ - radius != minZ
+            || (long) centerZ + radius != maxZ)) {
+            throw new IllegalArgumentException("Selection bounds do not match its center and radius");
+        }
+    }
+
+    public static PregenerationArea centered(Shape shape, int x, int z, int radius) {
+        if (shape == Shape.RECTANGLE || radius < 1) {
+            throw new IllegalArgumentException("Choose circle or square and a positive radius in blocks");
+        }
+        return new PregenerationArea(shape, x, z, radius, coordinate((long) x - radius),
+            coordinate((long) x + radius), coordinate((long) z - radius), coordinate((long) z + radius));
+    }
+
+    public static PregenerationArea rectangle(int x1, int z1, int x2, int z2) {
+        return new PregenerationArea(Shape.RECTANGLE, 0, 0, 0,
+            Math.min(x1, x2), Math.max(x1, x2), Math.min(z1, z2), Math.max(z1, z2));
+    }
+
+    private static int coordinate(long coordinate) {
+        if (coordinate < -MAX_COORDINATE || coordinate > MAX_COORDINATE) {
+            throw new IllegalArgumentException("Selection exceeds Minecraft coordinate limits");
+        }
+        return (int) coordinate;
+    }
+
+    public boolean contains(int chunkX, int chunkZ) {
+        if (chunkX < (minX >> 4) || chunkX > (maxX >> 4)
+            || chunkZ < (minZ >> 4) || chunkZ > (maxZ >> 4)) {
+            return false;
+        }
+        if (shape != Shape.CIRCLE) {
+            return true;
+        }
+        long dx = centerX - Math.clamp((long) centerX, (long) chunkX * 16, (long) chunkX * 16 + 15);
+        long dz = centerZ - Math.clamp((long) centerZ, (long) chunkZ * 16, (long) chunkZ * 16 + 15);
+        return dx * dx + dz * dz <= (long) radius * radius;
+    }
+
+    /** O(rows), never materialises all chunks. Run large plans off tick threads. */
+    public long chunkCount() {
+        if (shape != Shape.CIRCLE) {
+            return ((long) (maxX >> 4) - (minX >> 4) + 1)
+                * ((long) (maxZ >> 4) - (minZ >> 4) + 1);
+        }
+        long total = 0;
+        for (int z = minZ >> 4; z <= maxZ >> 4; z++) {
+            long dz = centerZ - Math.clamp((long) centerZ, (long) z * 16, (long) z * 16 + 15);
+            long span = (long) Math.sqrt((long) radius * radius - dz * dz);
+            // Correct floating point rounding at an exact integer boundary.
+            while ((span + 1) * (span + 1) + dz * dz <= (long) radius * radius) {
+                span++;
+            }
+            while (span * span + dz * dz > (long) radius * radius) {
+                span--;
+            }
+            total += ((centerX + span) >> 4) - ((centerX - span) >> 4) + 1;
+        }
+        return total;
+    }
+
+    public long scanLimit() {
+        return ((long) (maxX >> 9) - (minX >> 9) + 1)
+            * ((long) (maxZ >> 9) - (minZ >> 9) + 1) * 1024L;
+    }
+
+    public Cursor cursor(long position) {
+        if (position < 0 || position > scanLimit()) {
+            throw new IllegalArgumentException("Invalid cursor");
+        }
+        return new Cursor(position);
+    }
+
+    public record Point(int x, int z, long nextCursor) {}
+
+    /** MCA-local order, bounded memory even for multi-trillion-chunk selections. */
+    public final class Cursor {
+        private long position;
+
+        private Cursor(long position) {
+            this.position = position;
+        }
+
+        public Point next() {
+            long columns = (long) (maxX >> 9) - (minX >> 9) + 1;
+            while (position < scanLimit()) {
+                long cell = position++;
+                long tile = cell >>> 10;
+                if (shape == Shape.CIRCLE && (cell & 1023) == 0) {
+                    long tileZ = (minZ >> 9) + tile / columns;
+                    long dz = centerZ - Math.clamp((long) centerZ, tileZ * 512, tileZ * 512 + 511);
+                    long span = (long) Math.sqrt((long) radius * radius - dz * dz);
+                    while ((span + 1) * (span + 1) + dz * dz <= (long) radius * radius) span++;
+                    while (span * span + dz * dz > (long) radius * radius) span--;
+                    long first = ((centerX - span) >> 9) - (minX >> 9);
+                    long last = ((centerX + span) >> 9) - (minX >> 9);
+                    long column = tile % columns;
+                    if (column < first) {
+                        position = (tile + first - column) * 1024;
+                        continue;
+                    }
+                    if (column > last) {
+                        position = (tile + columns - column) * 1024;
+                        continue;
+                    }
+                }
+                int x = (int) (((minX >> 9) + tile % columns) * 32 + (cell & 31));
+                int z = (int) (((minZ >> 9) + tile / columns) * 32 + ((cell >>> 5) & 31));
+                if (contains(x, z)) {
+                    return new Point(x, z, position);
+                }
+            }
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/pregeneration/PregenerationCheckpoint.java b/src/main/java/io/papermc/paper/pregeneration/PregenerationCheckpoint.java
new file mode 100644
index 0000000000000000000000000000000000000000..f7d360a765e6528355e97cc53df27b2db9ebf3de
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pregeneration/PregenerationCheckpoint.java
@@ -0,0 +1,44 @@
+package io.papermc.paper.pregeneration;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+
+/** Internal job metadata only. Does not replace Minecraft's region-file storage. */
+public final class PregenerationCheckpoint {
+    private PregenerationCheckpoint() {
+    }
+
+    public static void write(Path target, String content) throws IOException {
+        Path directory = target.toAbsolutePath().normalize().getParent();
+        Files.createDirectories(directory);
+        if (Files.isSymbolicLink(directory) || Files.isSymbolicLink(target)
+            || (Files.exists(target, LinkOption.NOFOLLOW_LINKS) && !Files.isRegularFile(target, LinkOption.NOFOLLOW_LINKS))) {
+            throw new IOException("Unsafe pregeneration checkpoint path: " + target);
+        }
+        Path temporary = Files.createTempFile(directory, ".pregen-", ".tmp");
+        try {
+            try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
+                ByteBuffer buffer = StandardCharsets.UTF_8.encode(content);
+                while (buffer.hasRemaining()) {
+                    channel.write(buffer);
+                }
+                channel.force(true);
+            }
+            try {
+                Files.move(temporary, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+            } catch (AtomicMoveNotSupportedException ignored) {
+                Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING);
+            }
+        } finally {
+            Files.deleteIfExists(temporary);
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/pregeneration/PregenerationCommand.java b/src/main/java/io/papermc/paper/pregeneration/PregenerationCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..a01df62d59ef399075ca190023ff41a08916e507
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pregeneration/PregenerationCommand.java
@@ -0,0 +1,295 @@
+package io.papermc.paper.pregeneration;
+
+import io.papermc.paper.threadedregions.RegionizedServer;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.entity.Player;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+
+/** Internal administrative command; all asynchronous replies return to the sender's owner. */
+public final class PregenerationCommand extends Command {
+    public static final String PERMISSION = "tessera.command.pregen";
+    private final WorldPregenerator service;
+    private final Map<UUID, Selection> players = new ConcurrentHashMap<>();
+    private final Map<CommandSender, Selection> others = new WeakHashMap<>();
+    private static final List<String> SUBCOMMANDS = List.of("dimension", "shape", "center", "radius", "corners", "border",
+        "plan", "start", "status", "pause", "resume", "cancel", "mode", "help");
+
+    private static final class Selection {
+        UUID world;
+        PregenerationArea.Shape shape = PregenerationArea.Shape.CIRCLE;
+        int x;
+        int z;
+        int radius = 1000;
+        PregenerationArea rectangle;
+        WorldPregenerator.Mode mode = WorldPregenerator.Mode.BALANCED;
+        WorldPregenerator.Plan confirmation;
+        long confirmationUntil;
+        synchronized PregenerationArea area() {
+            return shape == PregenerationArea.Shape.RECTANGLE
+                ? java.util.Objects.requireNonNull(rectangle, "Use /pregen corners or /pregen border first")
+                : PregenerationArea.centered(shape, x, z, radius);
+        }
+    }
+
+    public PregenerationCommand(MinecraftServer server) {
+        super("pregen");
+        setDescription("Native, region-safe dimension pregeneration");
+        setUsage("/pregen help");
+        setPermission(PERMISSION);
+        if (server.server.getPluginManager().getPermission(PERMISSION) == null) {
+            server.server.getPluginManager().addPermission(new Permission(PERMISSION, "Manage native Tessera pregeneration", PermissionDefault.OP));
+        }
+        service = WorldPregenerator.get(server);
+    }
+
+    private Selection selection(CommandSender sender) {
+        if (sender instanceof Player player) {
+            return players.computeIfAbsent(player.getUniqueId(), ignored -> new Selection());
+        }
+        synchronized (others) {
+            return others.computeIfAbsent(sender, ignored -> new Selection());
+        }
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+        if (args.length == 0 || args[0].equalsIgnoreCase("help")) {
+            help(sender);
+            return true;
+        }
+        Selection selection = selection(sender);
+        String action = args[0].toLowerCase(Locale.ROOT);
+        try {
+            synchronized (selection) {
+                switch (action) {
+                    case "dimension" -> {
+                        if (args.length == 1) {
+                            World selected = selection.world == null ? null : Bukkit.getWorld(selection.world);
+                            reply(sender, "Selected dimension: " + (selected == null ? "none" : selected.getKey()));
+                            reply(sender, "Loaded dimensions: " + String.join(", ", PregenerationDimensions.keys(Bukkit.getWorlds())));
+                        } else {
+                            exact(args, 2, "dimension <overworld|nether|end|namespace:key>");
+                            World world = PregenerationDimensions.resolve(Bukkit.getWorlds(), args[1]);
+                            selection.world = world.getUID();
+                            selection.confirmation = null;
+                            reply(sender, "Selected dimension: " + world.getKey() + ". Running jobs are unchanged.");
+                        }
+                    }
+                    case "shape" -> {
+                        exact(args, 2, "shape <circle|square>");
+                        PregenerationArea.Shape shape = PregenerationArea.Shape.valueOf(args[1].toUpperCase(Locale.ROOT));
+                        if (shape == PregenerationArea.Shape.RECTANGLE) {
+                            throw new IllegalArgumentException("Use /pregen corners for a rectangle");
+                        }
+                        selection.shape = shape;
+                        selection.confirmation = null;
+                        reply(sender, "Shape: " + shape);
+                    }
+                    case "center" -> {
+                        if (args.length == 2 && args[1].equalsIgnoreCase("here") && sender instanceof Player player) {
+                            if (!Bukkit.isOwnedByCurrentRegion(player)) {
+                                throw new IllegalStateException("Use center here on your entity's owning region");
+                            }
+                            selection.x = player.getLocation().getBlockX();
+                            selection.z = player.getLocation().getBlockZ();
+                        } else {
+                            exact(args, 3, "center <x> <z> | center here");
+                            selection.x = Integer.parseInt(args[1]);
+                            selection.z = Integer.parseInt(args[2]);
+                        }
+                        selection.confirmation = null;
+                        reply(sender, "Center: " + selection.x + ", " + selection.z + " blocks");
+                    }
+                    case "radius" -> {
+                        exact(args, 2, "radius <blocks>");
+                        int radius = Integer.parseInt(args[1]);
+                        if (radius < 1) throw new IllegalArgumentException("Radius must be positive, in blocks");
+                        selection.radius = radius;
+                        selection.confirmation = null;
+                        reply(sender, "Radius: " + radius + " blocks");
+                    }
+                    case "corners" -> {
+                        exact(args, 5, "corners <x1> <z1> <x2> <z2>");
+                        selection.rectangle = PregenerationArea.rectangle(Integer.parseInt(args[1]), Integer.parseInt(args[2]),
+                            Integer.parseInt(args[3]), Integer.parseInt(args[4]));
+                        selection.shape = PregenerationArea.Shape.RECTANGLE;
+                        selection.confirmation = null;
+                        reply(sender, "Rectangle selected (inclusive block coordinates)");
+                    }
+                    case "border" -> {
+                        exact(args, 1, "border");
+                        World world = requiredWorld(selection);
+                        double half = world.getWorldBorder().getSize() / 2.0;
+                        org.bukkit.Location center = world.getWorldBorder().getCenter();
+                        selection.rectangle = PregenerationArea.rectangle(borderCoordinate(center.getX() - half),
+                            borderCoordinate(center.getZ() - half), borderCoordinate(center.getX() + half), borderCoordinate(center.getZ() + half));
+                        selection.shape = PregenerationArea.Shape.RECTANGLE;
+                        selection.confirmation = null;
+                        reply(sender, "Current worldborder captured for " + world.getKey() + " (Minecraft coordinate limits respected)");
+                    }
+                    case "plan", "start" -> {
+                        if (action.equals("start") && args.length == 2 && args[1].equalsIgnoreCase("confirm")) {
+                            WorldPregenerator.Plan plan = selection.confirmation;
+                            if (plan == null || System.nanoTime() - selection.confirmationUntil >= 0) {
+                                throw new IllegalStateException("No current confirmation; run /pregen start again");
+                            }
+                            selection.confirmation = null;
+                            service.start(plan).whenComplete((view, failure) -> complete(sender, failure, () -> show(sender, view)));
+                            break;
+                        }
+                        exact(args, 1, action);
+                        UUID world = requiredWorld(selection).getUID();
+                        PregenerationArea area = selection.area();
+                        WorldPregenerator.Mode mode = selection.mode;
+                        service.plan(world, area, mode).whenComplete((plan, failure) -> {
+                            if (failure != null) {
+                                error(sender, failure);
+                            } else if (action.equals("plan")) {
+                                reply(sender, "Plan: " + plan.worldKey() + " | " + area.shape() + " | " + plan.total() + " target chunks | " + mode);
+                            } else if (plan.total() > 10_000_000L) {
+                                synchronized (selection) {
+                                    if (!world.equals(selection.world) || !area.equals(selection.area()) || mode != selection.mode) {
+                                        error(sender, new IllegalStateException("Selection changed during planning; start again"));
+                                        return;
+                                    }
+                                    selection.confirmation = plan;
+                                    selection.confirmationUntil = System.nanoTime() + TimeUnit.MINUTES.toNanos(1);
+                                }
+                                reply(sender, "Large job: " + plan.total() + " chunks in " + plan.worldKey() + ". Confirm within 60s: /pregen start confirm");
+                            } else {
+                                service.start(plan).whenComplete((view, startFailure) -> complete(sender, startFailure, () -> show(sender, view)));
+                            }
+                        });
+                    }
+                    case "status" -> {
+                        if (args.length > 2) throw new IllegalArgumentException("Usage: /pregen status [job-id|all]");
+                        Long id = args.length == 2 && !args[1].equalsIgnoreCase("all") ? Long.valueOf(args[1]) : null;
+                        service.views().whenComplete((views, failure) -> complete(sender, failure, () -> {
+                            List<WorldPregenerator.View> selected = views.stream().filter(view -> id == null || view.id() == id).toList();
+                            if (selected.isEmpty()) reply(sender, "No matching pregeneration jobs");
+                            else selected.forEach(view -> show(sender, view));
+                        }));
+                    }
+                    case "pause", "resume", "cancel" -> {
+                        exact(args, 2, action + " <job-id>");
+                        service.control(Long.parseLong(args[1]), action, null)
+                            .whenComplete((view, failure) -> complete(sender, failure, () -> show(sender, view)));
+                        reply(sender, "Job operation requested: " + action + ". Admitted work is drained before confirmation.");
+                    }
+                    case "mode" -> {
+                        if (args.length == 2) {
+                            selection.mode = WorldPregenerator.Mode.valueOf(args[1].toUpperCase(Locale.ROOT));
+                            selection.confirmation = null;
+                            reply(sender, "Selected mode: " + selection.mode);
+                        } else {
+                            exact(args, 3, "mode [job-id] <balanced|fast>");
+                            service.control(Long.parseLong(args[1]), "mode", WorldPregenerator.Mode.valueOf(args[2].toUpperCase(Locale.ROOT)))
+                                .whenComplete((view, failure) -> complete(sender, failure, () -> show(sender, view)));
+                        }
+                    }
+                    default -> help(sender);
+                }
+            }
+        } catch (RuntimeException failure) {
+            error(sender, failure);
+        }
+        return true;
+    }
+
+    private static int borderCoordinate(double coordinate) {
+        return (int) Math.clamp(Math.floor(coordinate), -PregenerationArea.MAX_COORDINATE, PregenerationArea.MAX_COORDINATE);
+    }
+
+    private static World requiredWorld(Selection selection) {
+        World world = selection.world == null ? null : Bukkit.getWorld(selection.world);
+        if (world == null) throw new IllegalStateException("Select a loaded dimension first: /pregen dimension <overworld|nether|end|namespace:key>");
+        return world;
+    }
+
+    private static void exact(String[] args, int length, String usage) {
+        if (args.length != length) throw new IllegalArgumentException("Usage: /pregen " + usage);
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (!sender.hasPermission(PERMISSION)) return List.of();
+        List<String> candidates = List.of();
+        if (args.length == 1) candidates = SUBCOMMANDS;
+        else if (args.length == 2 && args[0].equalsIgnoreCase("dimension")) candidates = PregenerationDimensions.suggestions(Bukkit.getWorlds());
+        else if (args.length == 2 && args[0].equalsIgnoreCase("shape")) candidates = List.of("circle", "square");
+        else if (args.length == 2 && args[0].equalsIgnoreCase("center")) candidates = List.of("here");
+        else if (args.length == 2 && args[0].equalsIgnoreCase("start")) candidates = List.of("confirm");
+        else if (args[0].equalsIgnoreCase("mode") && (args.length == 2 || args.length == 3)) candidates = List.of("balanced", "fast");
+        String prefix = args[args.length - 1].toLowerCase(Locale.ROOT);
+        return candidates.stream().filter(value -> value.toLowerCase(Locale.ROOT).startsWith(prefix)).toList();
+    }
+
+    private static void help(CommandSender sender) {
+        reply(sender, "Tessera pregeneration — coordinates/radius are in blocks");
+        reply(sender, "/pregen dimension <overworld|nether|end|namespace:key>");
+        reply(sender, "/pregen shape <circle|square> | center <x> <z> | radius <blocks>");
+        reply(sender, "/pregen corners <x1> <z1> <x2> <z2> | border | mode <balanced|fast>");
+        reply(sender, "/pregen plan | start [confirm] | status [job-id|all]");
+        reply(sender, "/pregen pause <id> | resume <id> | cancel <id> | mode <id> <balanced|fast>");
+        reply(sender, "Each sender has a separate selection. /tick freeze does not stop pregeneration.");
+    }
+
+    private static void show(CommandSender sender, WorldPregenerator.View view) {
+        reply(sender, Component.text("Pregeneration #" + view.id() + " — " + view.dimension(), NamedTextColor.AQUA)
+            .clickEvent(ClickEvent.runCommand("/pregen status " + view.id())));
+        reply(sender, "State: " + view.state() + " | Simulation: " + (view.frozen() ? "FROZEN" : "RUNNING") + " | Mode: " + view.mode());
+        double percent = view.total() == 0 ? 0 : 100.0 * (view.generated() + view.existing()) / view.total();
+        reply(sender, String.format(Locale.ROOT, "Progress: %.2f%% | Generated/finalized: %d | Already complete: %d | Total: %d",
+            percent, view.generated(), view.existing(), view.total()));
+        reply(sender, String.format(Locale.ROOT, "Rate: %.1f chunks/s | In flight: %d", view.rate(), view.inFlight()));
+        if (view.rate() > 0 && view.state().equals("RUNNING")) {
+            long seconds = (long) Math.ceil((view.total() - view.generated() - view.existing()) / view.rate());
+            reply(sender, "Estimated remaining: " + seconds / 3600 + "h " + seconds / 60 % 60 + "m " + seconds % 60 + "s");
+        }
+        if (!view.detail().isBlank()) reply(sender, view.detail());
+        reply(sender, Component.text("[Pause] ", NamedTextColor.YELLOW).clickEvent(ClickEvent.runCommand("/pregen pause " + view.id()))
+            .append(Component.text("[Resume] ", NamedTextColor.GREEN).clickEvent(ClickEvent.runCommand("/pregen resume " + view.id())))
+            .append(Component.text("[Cancel]", NamedTextColor.RED).clickEvent(ClickEvent.suggestCommand("/pregen cancel " + view.id()))));
+    }
+
+    private static void complete(CommandSender sender, Throwable failure, Runnable success) {
+        if (failure != null) error(sender, failure); else success.run();
+    }
+
+    private static void error(CommandSender sender, Throwable failure) {
+        reply(sender, Component.text("Pregeneration: " + WorldPregenerator.rootMessage(failure), NamedTextColor.RED));
+    }
+
+    private static void reply(CommandSender sender, String message) {
+        reply(sender, Component.text(message, NamedTextColor.GRAY));
+    }
+
+    private static void reply(CommandSender sender, Component message) {
+        if (sender instanceof CraftPlayer player) {
+            player.taskScheduler.schedule(entity -> sender.sendMessage(message), null, 1L);
+        } else if (RegionizedServer.isGlobalTickThread()) {
+            sender.sendMessage(message);
+        } else {
+            RegionizedServer.getInstance().addTask(() -> sender.sendMessage(message));
+        }
+    }
+}

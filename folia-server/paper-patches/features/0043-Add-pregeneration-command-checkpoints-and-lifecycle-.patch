@@ -0,0 +1,55 @@
+package io.papermc.paper.pregeneration;
+
+import java.util.List;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PregenerationDimensionsTest {
+    @Test
+    void vanillaAliasesResolveTheExactDimensionNotTheFolderOrEnvironment() {
+        World overworld = world("minecraft:overworld", "renamed", World.Environment.NORMAL);
+        World nether = world("minecraft:the_nether", "different_folder", World.Environment.NETHER);
+        World end = world("minecraft:the_end", "another_folder", World.Environment.THE_END);
+        World extra = world("tessera:extra", "overworld", World.Environment.NORMAL);
+        List<World> worlds = List.of(extra, nether, end, overworld);
+        assertSame(overworld, PregenerationDimensions.resolve(worlds, "overworld"));
+        assertSame(nether, PregenerationDimensions.resolve(worlds, "NeThEr"));
+        assertSame(end, PregenerationDimensions.resolve(worlds, "end"));
+        assertSame(nether, PregenerationDimensions.resolve(worlds, "minecraft:the_nether"));
+        assertSame(extra, PregenerationDimensions.resolve(worlds, "tessera:extra"));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(worlds, "renamed"));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(worlds, "different_folder"));
+    }
+
+    @Test
+    void unknownUnloadedInvalidAndAmbiguousKeysFailClosed() {
+        World extra = world("tessera:extra", "world", World.Environment.NORMAL);
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(List.of(extra), "overworld"));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(List.of(extra), "tessera:missing"));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(List.of(extra), "tessera:BAD KEY"));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationDimensions.resolve(List.of(extra), "world"));
+        assertThrows(IllegalStateException.class, () -> PregenerationDimensions.resolve(
+            List.of(extra, world("tessera:extra", "other", World.Environment.NORMAL)), "tessera:extra"));
+    }
+
+    @Test
+    void suggestionsContainOnlyLoadedDimensionKeysAndAvailableVanillaAliases() {
+        List<World> worlds = List.of(world("tessera:extra", "world", World.Environment.NORMAL),
+            world("minecraft:the_nether", "world_nether", World.Environment.NETHER));
+        assertEquals(List.of("nether", "minecraft:the_nether", "tessera:extra"), PregenerationDimensions.suggestions(worlds));
+        assertEquals(List.of(), PregenerationDimensions.suggestions(List.of()));
+        assertEquals(List.of("minecraft:the_nether", "tessera:extra"), PregenerationDimensions.keys(worlds));
+    }
+
+    private static World world(String key, String folderName, World.Environment environment) {
+        World world = mock(World.class);
+        when(world.getKey()).thenReturn(NamespacedKey.fromString(key));
+        when(world.getName()).thenReturn(folderName);
+        when(world.getEnvironment()).thenReturn(environment);
+        return world;
+    }
+}

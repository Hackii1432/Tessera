new file mode 100644
index 0000000000000000000000000000000000000000..edb88d1bf96d818162ea8ea491727e6b3c94df1f
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pregeneration/PregenerationAreaTest.java
@@ -0,0 +1,79 @@
+package io.papermc.paper.pregeneration;
+
+import java.time.Duration;
+import java.util.HashSet;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PregenerationAreaTest {
+    @Test
+    void cursorMatchesExactGeometryAndCountAtNegativeCoordinatesAndMcaEdges() {
+        for (PregenerationArea.Shape shape : new PregenerationArea.Shape[]{PregenerationArea.Shape.CIRCLE, PregenerationArea.Shape.SQUARE}) {
+            for (int center : new int[]{-513, -512, -17, -16, -1, 0, 15, 16, 511, 512}) {
+                for (int radius : new int[]{1, 16, 33, 513}) {
+                    PregenerationArea area = PregenerationArea.centered(shape, center, -center, radius);
+                    Set<Long> expected = new HashSet<>();
+                    for (int x = area.minX() >> 4; x <= area.maxX() >> 4; x++) {
+                        for (int z = area.minZ() >> 4; z <= area.maxZ() >> 4; z++) {
+                            if (area.contains(x, z)) expected.add(key(x, z));
+                        }
+                    }
+                    Set<Long> actual = new HashSet<>();
+                    PregenerationArea.Cursor cursor = area.cursor(0);
+                    PregenerationArea.Point point;
+                    long last = 0;
+                    while ((point = cursor.next()) != null) {
+                        assertTrue(point.nextCursor() > last);
+                        last = point.nextCursor();
+                        assertTrue(actual.add(key(point.x(), point.z())), "Duplicate chunk");
+                    }
+                    assertEquals(expected, actual);
+                    assertEquals(expected.size(), area.chunkCount());
+                    assertNull(cursor.next());
+                }
+            }
+        }
+    }
+
+    @Test
+    void resumesExactlyAfterRecordedCursor() {
+        PregenerationArea area = PregenerationArea.centered(PregenerationArea.Shape.CIRCLE, -500, 1025, 600);
+        PregenerationArea.Cursor cursor = area.cursor(0);
+        for (int i = 0; i < 250; i++) {
+            PregenerationArea.Point point = cursor.next();
+            assertNotNull(point);
+            PregenerationArea.Cursor resumed = area.cursor(point.nextCursor());
+            assertEquals(cursor.next(), resumed.next());
+        }
+    }
+
+    @Test
+    void rectangleAndVeryLargeSelectionsDoNotOverflowOrMaterializeChunks() {
+        PregenerationArea area = PregenerationArea.rectangle(-PregenerationArea.MAX_COORDINATE,
+            -PregenerationArea.MAX_COORDINATE, PregenerationArea.MAX_COORDINATE, PregenerationArea.MAX_COORDINATE);
+        assertTrue(area.chunkCount() > Integer.MAX_VALUE);
+        assertTrue(area.scanLimit() > area.chunkCount());
+        assertTimeoutPreemptively(Duration.ofSeconds(2), () -> {
+            assertNotNull(area.cursor(0).next());
+            PregenerationArea circle = PregenerationArea.centered(PregenerationArea.Shape.CIRCLE, 0, 0, PregenerationArea.MAX_COORDINATE);
+            assertNotNull(circle.cursor(0).next());
+            assertNotNull(circle.cursor(circle.scanLimit() / 2).next());
+        });
+    }
+
+    @Test
+    void invalidCoordinatesAndCursorsFailClosed() {
+        assertThrows(IllegalArgumentException.class, () -> PregenerationArea.centered(PregenerationArea.Shape.CIRCLE, 0, 0, 0));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationArea.centered(PregenerationArea.Shape.SQUARE, Integer.MAX_VALUE, 0, 100));
+        assertThrows(IllegalArgumentException.class, () -> PregenerationArea.rectangle(Integer.MIN_VALUE, 0, 0, 0));
+        PregenerationArea area = PregenerationArea.centered(PregenerationArea.Shape.CIRCLE, 0, 0, 1);
+        assertThrows(IllegalArgumentException.class, () -> area.cursor(-1));
+        assertThrows(IllegalArgumentException.class, () -> area.cursor(area.scanLimit() + 1));
+    }
+
+    private static long key(int x, int z) {
+        return (long) x << 32 | z & 0xffffffffL;
+    }
+}

@@ -0,0 +1,43 @@
+package io.papermc.paper.pregeneration;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import org.bukkit.NamespacedKey;
+import org.bukkit.World;
+
+/** Internal command selection. Environment/type is not a unique loaded dimension identity. */
+final class PregenerationDimensions {
+    private PregenerationDimensions() {
+    }
+
+    static World resolve(List<World> worlds, String input) {
+        String key = switch (input.toLowerCase(Locale.ROOT)) {
+            case "overworld" -> "minecraft:overworld";
+            case "nether" -> "minecraft:the_nether";
+            case "end" -> "minecraft:the_end";
+            default -> input;
+        };
+        if (!key.contains(":") || NamespacedKey.fromString(key) == null) {
+            throw new IllegalArgumentException("Use overworld, nether, end or a namespaced dimension key");
+        }
+        List<World> matches = worlds.stream().filter(world -> world.getKey().toString().equals(key)).toList();
+        if (matches.isEmpty()) throw new IllegalArgumentException("Dimension is not loaded: " + key);
+        if (matches.size() != 1) throw new IllegalStateException("Dimension key is ambiguous: " + key);
+        return matches.getFirst();
+    }
+
+    static List<String> keys(List<World> worlds) {
+        return worlds.stream().map(world -> world.getKey().toString()).distinct().sorted().toList();
+    }
+
+    static List<String> suggestions(List<World> worlds) {
+        List<String> keys = keys(worlds);
+        List<String> result = new ArrayList<>();
+        if (keys.contains("minecraft:overworld")) result.add("overworld");
+        if (keys.contains("minecraft:the_nether")) result.add("nether");
+        if (keys.contains("minecraft:the_end")) result.add("end");
+        result.addAll(keys);
+        return List.copyOf(result);
+    }
+}

+        if (mode == LoadMode.LOAD) {
+            if (Files.exists(dimensionFolder, LinkOption.NOFOLLOW_LINKS)) {
+                final Path worldGenSettings = dimensionFolder.resolve("data/minecraft/world_gen_settings.dat");

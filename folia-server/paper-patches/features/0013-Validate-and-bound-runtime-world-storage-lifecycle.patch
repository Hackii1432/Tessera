+                    || !Files.isRegularFile(metadata, LinkOption.NOFOLLOW_LINKS)) {
+                    return new WorldLoadResult(
+                        WorldLoadResult.Status.INCOMPLETE_WORLD,
+                        null,
+                        "Existing dimension storage is incomplete; expected regular metadata files under " + dimensionFolder.resolve("data"),
+                        null
+                    );
+                }
+                return null;
+            }
+
+            // Paper 26.2 stores API-created worlds as independent dimension
+            // roots below the primary level. A legacy Bukkit world directory
+            // is nevertheless accepted here and atomically migrated by the
+            // normal Paper world loader before any registration occurs.
+            final Path legacyLevelDat = legacyFolder.resolve("level.dat");
+            if (Files.isRegularFile(legacyLevelDat, LinkOption.NOFOLLOW_LINKS)) {
+                return null;
+            }
+            final boolean partialLegacy = Files.exists(legacyFolder, LinkOption.NOFOLLOW_LINKS);

+    private CompletionStage<Void> awaitWorldRegionTasks(
+        final ServerLevel handle,
+        final WorldUnloadOptions options
+    ) {
+        return RegionizedServer.getInstance().awaitWorldRegionTasks(handle)
+            .orTimeout(options.timeout().toMillis(), TimeUnit.MILLISECONDS)
+            .exceptionallyCompose(throwable -> {
+                final Throwable cause = unwrap(throwable);
+                if (cause instanceof java.util.concurrent.TimeoutException) {
+                    return CompletableFuture.failedFuture(new UnloadFailure(
+                        WorldUnloadResult.Status.TIMEOUT,
+                        "World unload timed out while draining region task queues"
+                    ));
+                }
+                return CompletableFuture.failedFuture(cause);
+            });
+    }

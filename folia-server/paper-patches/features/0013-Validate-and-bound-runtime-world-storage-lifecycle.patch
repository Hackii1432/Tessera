+    private Path resolveDimensionFolder(final NamespacedKey key) throws IOException {
+        final Path container = this.server.getWorldContainer().toPath().toAbsolutePath().normalize();
+        final net.minecraft.resources.ResourceKey<net.minecraft.world.level.Level> dimension =
+            org.bukkit.craftbukkit.util.CraftNamespacedKey.toResourceKey(
+                net.minecraft.core.registries.Registries.DIMENSION,
+                key
+            );
+        final Path resolved = this.server.getServer().storageSource
+            .getDimensionPath(dimension)
+            .toAbsolutePath()
+            .normalize();
+        if (!resolved.startsWith(container) || resolved.equals(container)) {
+            throw new IOException("Dimension folder escapes the configured world container: " + key);
+        }
+        return resolved;
+    }

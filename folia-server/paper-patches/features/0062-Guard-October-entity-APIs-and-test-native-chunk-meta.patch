diff --git a/src/test/java/io/papermc/paper/porting/PaperOctober22ChunkStateTest.java b/src/test/java/io/papermc/paper/porting/PaperOctober22ChunkStateTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..cc68ea5b2cf5c525fa212b74668f90a21b617b08
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/PaperOctober22ChunkStateTest.java
@@ -0,0 +1,95 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkTaskScheduler;
+import io.papermc.paper.FeatureHooks;
+import io.papermc.paper.world.chunk.ChunkGenerationState;
+import java.lang.reflect.InvocationTargetException;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.SharedConstants;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class PaperOctober22ChunkStateTest {
+    private static ChunkGenerationState classify(CompoundTag tag) throws Exception {
+        var method = FeatureHooks.class.getDeclaredMethod("classifyChunkGenerationState", CompoundTag.class, int.class, int.class);
+        method.setAccessible(true);
+        try { return (ChunkGenerationState)method.invoke(null, tag, 5, -3); }
+        catch (InvocationTargetException ex) { if (ex.getCause() instanceof RuntimeException cause) throw cause; throw ex; }
+    }
+
+    private static CompoundTag tag(String status) {
+        var tag = new CompoundTag();
+        tag.putInt("DataVersion", SharedConstants.getCurrentVersion().dataVersion().version());
+        tag.putInt("xPos", 5);
+        tag.putInt("zPos", -3);
+        tag.putString("Status", status);
+        return tag;
+    }
+
+    @Test void absentPartialAndFullMetadataAreDistinguished() throws Exception {
+        assertEquals(ChunkGenerationState.NOT_GENERATED, classify(null));
+        assertEquals(ChunkGenerationState.PARTIAL, classify(tag("minecraft:noise")));
+        assertEquals(ChunkGenerationState.GENERATED, classify(tag("minecraft:full")));
+    }
+
+    @Test void oldRelocatedAndFutureVersionsAreNotSilentlyTreatedAsCurrent() throws Exception {
+        var old = tag("minecraft:full");
+        old.putInt("DataVersion", 100);
+        assertEquals(ChunkGenerationState.OUTDATED, classify(old));
+        var relocated = tag("minecraft:full");
+        relocated.putInt("xPos", 9);
+        assertEquals(ChunkGenerationState.OUTDATED, classify(relocated));
+        var future = tag("minecraft:full");
+        future.putInt("DataVersion", Integer.MAX_VALUE);
+        assertThrows(IllegalStateException.class, () -> classify(future));
+    }
+
+    private static ServerLevel unloadedWorld() throws Exception {
+        var world = mock(ServerLevel.class);
+        var scheduler = mock(ChunkTaskScheduler.class);
+        var field = ChunkTaskScheduler.class.getDeclaredField("chunkHolderManager");
+        field.setAccessible(true);
+        field.set(scheduler, mock(ChunkHolderManager.class));
+        when(world.moonrise$getChunkTaskScheduler()).thenReturn(scheduler);
+        return world;
+    }
+
+    @Test void tickAndNettyThreadsRejectDiskFallbackWithoutSubmittingIo() throws Exception {
+        var world = unloadedWorld();
+        var tick = new CompletableFuture<Throwable>();
+        var thread = new TickThread(() -> {
+            try { FeatureHooks.getChunkGenerationState(world, 5, -3); tick.complete(null); }
+            catch (Throwable failure) { tick.complete(failure); }
+        }, "chunk-state-tick-test");
+        thread.start();
+        assertInstanceOf(IllegalStateException.class, tick.get(5, TimeUnit.SECONDS));
+        thread.join(5000);
+        var netty = new CompletableFuture<Throwable>();
+        var network = new io.netty.util.concurrent.FastThreadLocalThread(() -> {
+            try { FeatureHooks.getChunkGenerationState(world, 5, -3); netty.complete(null); }
+            catch (Throwable failure) { netty.complete(failure); }
+        });
+        network.start();
+        assertInstanceOf(IllegalStateException.class, netty.get(5, TimeUnit.SECONDS));
+        network.join(5000);
+        verify(world, never()).tessera$admitChunkStateQuery(any());
+    }
+
+    @Test void rejectedLifecycleAdmissionCompletesTheAsyncFutureExceptionally() {
+        var world = mock(ServerLevel.class);
+        doThrow(new IllegalStateException("world unloading")).when(world).tessera$admitChunkStateQuery(any());
+        var future = FeatureHooks.getChunkGenerationStateAsync(world, 0, 0);
+        assertTrue(future.isCompletedExceptionally());
+        var error = assertThrows(java.util.concurrent.CompletionException.class, future::join);
+        assertEquals("world unloading", error.getCause().getMessage());
+    }
+}
diff --git a/src/test/java/io/papermc/paper/porting/PaperOctober22NbtAndRegionTest.java b/src/test/java/io/papermc/paper/porting/PaperOctober22NbtAndRegionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7834b260945a745bad9e556dab2b045a17f75969
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/PaperOctober22NbtAndRegionTest.java
@@ -0,0 +1,157 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.patches.nbt_rw.FastNBTParser;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Arrays;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.NbtAccounter;
+import net.minecraft.nbt.NbtIo;
+import net.minecraft.nbt.StringTag;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.chunk.storage.RegionFile;
+import net.minecraft.world.level.chunk.storage.RegionFileVersion;
+import net.minecraft.world.level.chunk.storage.RegionStorageInfo;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.AdditionalAnswers.delegatesTo;
+import static org.mockito.Mockito.mock;
+
+@Normal
+class PaperOctober22NbtAndRegionTest {
+    @TempDir Path folder;
+
+    private static CompoundTag payload() {
+        var tag = new CompoundTag();
+        tag.putByte("byte", (byte)-5);
+        tag.putShort("short", (short)32001);
+        tag.putInt("int", Integer.MIN_VALUE);
+        tag.putLong("long", Long.MAX_VALUE);
+        tag.putFloat("float", -1.25F);
+        tag.putDouble("double", Math.PI);
+        tag.putString("utf", "null\0 snowman\u2603 surrogate\uD83D\uDE00");
+        tag.putByteArray("bytes", new byte[] {0, -1, 42});
+        tag.putIntArray("ints", new int[] {0, -1, Integer.MAX_VALUE});
+        tag.putLongArray("longs", new long[] {0, -1, Long.MIN_VALUE});
+        var list = new ListTag();
+        list.add(StringTag.valueOf("first"));
+        list.add(StringTag.valueOf("second"));
+        tag.put("list", list);
+        tag.put("emptyList", new ListTag());
+        var nested = new CompoundTag();
+        nested.putString("inside", "value");
+        tag.put("compound", nested);
+        return tag;
+    }
+
+    private static byte[] encode(CompoundTag tag) throws Exception {
+        var bytes = new ByteArrayOutputStream();
+        try (var output = new DataOutputStream(bytes)) { NbtIo.write(tag, output); }
+        return bytes.toByteArray();
+    }
+
+    @Test
+    void everyTagAndModifiedUtfMatchTheVanillaDataInputFallback() throws Exception {
+        CompoundTag tag = payload();
+        byte[] bytes = encode(tag);
+        DataInput fallback = mock(DataInput.class, delegatesTo(new DataInputStream(new ByteArrayInputStream(bytes))));
+        assertEquals(tag, NbtIo.read(fallback));
+        assertEquals(tag, FastNBTParser.nbtIoReadStream(new ByteArrayInputStream(bytes), NbtAccounter.unlimitedHeap()));
+    }
+
+    @Test
+    void truncatedStreamsAndHeapQuotasNeverReturnPartialData() throws Exception {
+        byte[] bytes = encode(payload());
+        for (int length = 0; length < bytes.length; ++length) {
+            byte[] truncated = Arrays.copyOf(bytes, length);
+            assertThrows(Exception.class, () -> FastNBTParser.nbtIoReadStream(new ByteArrayInputStream(truncated), NbtAccounter.unlimitedHeap()), "length " + length);
+        }
+        assertThrows(net.minecraft.nbt.NbtAccounterException.class,
+            () -> FastNBTParser.nbtIoReadStream(new ByteArrayInputStream(bytes), NbtAccounter.create(8)));
+    }
+
+    @Test
+    void nestingLimitStillProtectsTheOptimizedParser() throws Exception {
+        var root = new CompoundTag();
+        var next = root;
+        for (int depth = 0; depth < 520; ++depth) {
+            var child = new CompoundTag();
+            next.put("n", child);
+            next = child;
+        }
+        byte[] bytes = encode(root);
+        assertThrows(net.minecraft.nbt.NbtAccounterException.class,
+            () -> FastNBTParser.nbtIoReadStream(new ByteArrayInputStream(bytes), NbtAccounter.unlimitedHeap()));
+    }
+
+    private static CompoundTag chunk(ChunkPos pos) {
+        var tag = payload();
+        tag.putInt("DataVersion", 5023);
+        tag.putInt("xPos", pos.x());
+        tag.putInt("zPos", pos.z());
+        tag.putLong("LastUpdate", 99);
+        tag.putString("Status", "minecraft:full");
+        return tag;
+    }
+
+    private RegionFile open(Path path, RegionFileVersion version) throws Exception {
+        return new RegionFile(new RegionStorageInfo("unit", Level.OVERWORLD, "chunk"), path, this.folder, version, true);
+    }
+
+    @Test
+    void normalAndExternalOversizedChunksSurviveCloseAndReopen() throws Exception {
+        Path path = this.folder.resolve("r.0.0.mca");
+        var smallPos = new ChunkPos(1, 1);
+        var largePos = new ChunkPos(2, 2);
+        var small = chunk(smallPos);
+        var large = chunk(largePos);
+        large.putByteArray("large", new byte[2 * 1024 * 1024]);
+        try (var file = open(path, RegionFileVersion.VERSION_NONE)) {
+            try (var output = file.getChunkDataOutputStream(smallPos)) { NbtIo.write(small, output); }
+            try (var output = file.getChunkDataOutputStream(largePos)) { NbtIo.write(large, output); }
+        }
+        assertTrue(Files.isRegularFile(this.folder.resolve("c.2.2.mcc")));
+        try (var file = open(path, RegionFileVersion.VERSION_NONE)) {
+            try (var input = file.getChunkDataInputStream(smallPos)) { assertEquals(small, NbtIo.read(input)); }
+            try (var input = file.getChunkDataInputStream(largePos)) { assertEquals(large, NbtIo.read(input)); }
+            file.clear(largePos);
+            assertNull(file.getChunkDataInputStream(largePos));
+        }
+        assertFalse(Files.exists(this.folder.resolve("c.2.2.mcc")));
+    }
+
+    @Test
+    void corruptHeaderRecoveryKeepsPayloadAndBacksUpOriginalBytes() throws Exception {
+        Path path = this.folder.resolve("r.0.0.mca");
+        var pos = new ChunkPos(0, 0);
+        var tag = chunk(pos);
+        try (var file = open(path, RegionFileVersion.VERSION_DEFLATE)) {
+            try (var output = file.getChunkDataOutputStream(pos)) { NbtIo.write(tag, output); }
+        }
+        try (var file = FileChannel.open(path, StandardOpenOption.WRITE)) {
+            file.write(ByteBuffer.allocate(4).putInt(0x7fffffff).flip(), 0);
+            file.force(true);
+        }
+        try (var file = open(path, RegionFileVersion.VERSION_DEFLATE)) {
+            try (var input = file.getChunkDataInputStream(pos)) { assertEquals(tag, NbtIo.read(input)); }
+        }
+        try (var paths = Files.list(this.folder)) {
+            var backups = paths.filter(file -> file.getFileName().toString().endsWith(".backup")).toList();
+            assertEquals(1, backups.size());
+            assertEquals(0x7fffffff, ByteBuffer.wrap(Files.readAllBytes(backups.getFirst())).getInt());
+        }
+    }
+}

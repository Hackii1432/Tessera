--- /dev/null
+++ b/src/test/java/net/minecraft/server/commands/LootContextRegionTestSuite.java
@@ -0,0 +1,50 @@
+package net.minecraft.server.commands;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class LootContextRegionTestSuite {
+    @Test
+    void globalOrUnownedPositionFailsBeforeAnyWorldRead() {
+        ServerLevel level = mock(ServerLevel.class);
+        Entity entity = mock(Entity.class);
+        try (var threads = mockStatic(TickThread.class)) {
+            assertThrows(CommandSyntaxException.class, () -> LootContextSources.checkRegion(level, Vec3.ZERO, entity));
+            verifyNoInteractions(level, entity);
+        }
+    }
+
+    @Test
+    void foreignEntityFailsEvenWhenOriginIsOwned() {
+        ServerLevel level = mock(ServerLevel.class);
+        Entity entity = mock(Entity.class);
+        try (var threads = mockStatic(TickThread.class)) {
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(true);
+            assertThrows(CommandSyntaxException.class, () -> LootContextSources.checkRegion(level, Vec3.ZERO, entity));
+            verifyNoInteractions(level, entity);
+        }
+    }
+
+    @Test
+    void ownedOriginWithNoEntityOrOwnedEntityIsAccepted() throws Exception {
+        ServerLevel level = mock(ServerLevel.class);
+        Entity entity = mock(Entity.class);
+        try (var threads = mockStatic(TickThread.class)) {
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(true);
+            threads.when(() -> TickThread.isTickThreadFor(entity)).thenReturn(true);
+            LootContextSources.checkRegion(level, Vec3.ZERO, null);
+            LootContextSources.checkRegion(level, Vec3.ZERO, entity);
+            verifyNoInteractions(level, entity);
+        }
+    }
+}

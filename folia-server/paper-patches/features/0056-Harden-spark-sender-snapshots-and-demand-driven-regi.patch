+        return sender instanceof CraftPlayer || sender instanceof org.bukkit.command.ConsoleCommandSender
+            || sender instanceof org.bukkit.command.RemoteConsoleCommandSender;
     }
 
     static String unsupportedReason(final String[] args) {
@@ -113,34 +129,21 @@ public final class TesseraSparkPlugin extends PaperSparkPlugin {
     }
 
     private CommandSender wrap(final CommandSender sender) {
-        if (!(sender instanceof CraftPlayer player)) return sender;
-        TickThread.ensureTickThread(player.getHandleRaw(), "Spark player commands must start on the owning region");
-        final Collection<String> permissions = this.getPermissions();
-        final Set<String> granted = permissions.stream().filter(sender::hasPermission).collect(Collectors.toUnmodifiableSet());
-        final String name = player.getName();
-        final UUID id = player.getUniqueId();
-        // The pinned PaperCommandSender calls only these four methods. Preserve
-        // player identity without exposing any live Player operation to spark's workers.
-        return (CommandSender)java.lang.reflect.Proxy.newProxyInstance(Player.class.getClassLoader(), new Class<?>[]{Player.class},
-            (proxy, method, arguments) -> switch (method.getName()) {
-                case "getName", "toString" -> name;
-                case "getUniqueId" -> id;
-                case "hasPermission" -> granted.contains((String)arguments[0]);
-                case "hashCode" -> id.hashCode();
-                case "equals" -> proxy == arguments[0];
-                case "sendMessage" -> {
-                    if (arguments.length != 1 || !(arguments[0] instanceof Component message)) {
-                        throw new UnsupportedOperationException("Unexpected spark message signature: " + method);
-                    }
-                    // Owner maintenance follows transfers and also runs during freeze.
-                    // Retirement drops replies; disable invalidates queued responses.
-                    player.taskScheduler.scheduleRestore(entity -> {
-                        if (this.active.get()) entity.getBukkitEntity().sendMessage(message);
-                        return CompletableFuture.completedFuture(null);
-                    });
-                    yield null;
-                }
-                default -> throw new UnsupportedOperationException("Unexpected spark player operation: " + method);
+        if (sender instanceof CraftPlayer player) {
+            TickThread.ensureTickThread(player.getHandleRaw(), "Spark player commands must start on the owning region");
+            return SparkCommandSender.snapshot(sender, this.getPermissions(), message -> {
+                // Owner maintenance follows transfers and also runs during freeze.
+                // Retirement drops replies; disable invalidates queued responses.
+                player.taskScheduler.scheduleRestore(entity -> {
+                    if (this.active.get()) entity.getBukkitEntity().sendMessage(message);
+                    return CompletableFuture.completedFuture(null);
+                });
             });
+        }
+        // Console/RCON permission maps are captured in their original command context,
+        // and their asynchronous responses are delivered through global coordination.
+        return SparkCommandSender.snapshot(sender, this.getPermissions(), message -> this.executeSync(() -> {
+            if (this.active.get()) sender.sendMessage(message);
+        }));
     }
 }
diff --git a/src/test/java/io/papermc/paper/spark/SparkCommandSenderTest.java b/src/test/java/io/papermc/paper/spark/SparkCommandSenderTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb48c3f99a4de4fc1dd4f2e659d218fe8d807ad6
--- /dev/null
+++ b/src/test/java/io/papermc/paper/spark/SparkCommandSenderTest.java
@@ -0,0 +1,82 @@
+package io.papermc.paper.spark;
+
+import io.papermc.paper.SparksFly;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import me.lucko.spark.paper.PaperCommandSender;
+import net.kyori.adventure.text.Component;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class SparkCommandSenderTest {
+    @Test void permissionsAndIdentityAreCopiedBeforeAsyncWork() {
+        final Player source = mock(Player.class);
+        final UUID id = UUID.randomUUID();
+        when(source.getName()).thenReturn("SparkPlayer");
+        when(source.getUniqueId()).thenReturn(id);
+        when(source.hasPermission("spark.profiler")).thenReturn(true);
+        final var snapshot = SparkCommandSender.snapshot(source, List.of("spark.profiler", "spark.ping"), ignored -> { });
+        clearInvocations(source);
+        when(source.hasPermission("spark.profiler")).thenThrow(new AssertionError("late permission access"));
+        clearInvocations(source);
+        final var wrapper = new PaperCommandSender(snapshot);
+        assertEquals("SparkPlayer", wrapper.getName());
+        assertEquals(id, wrapper.getUniqueId());
+        assertTrue(wrapper.isPlayer());
+        assertTrue(wrapper.hasPermission("spark.profiler"));
+        assertFalse(wrapper.hasPermission("spark.ping"));
+        assertFalse(wrapper.hasPermission("spark.unregistered"));
+        verifyNoInteractions(source);
+    }
+
+    @Test void consoleHasNoPlayerIdentityAndNoLatePermissionRead() {
+        final CommandSender source = mock(CommandSender.class);
+        when(source.getName()).thenReturn("CONSOLE");
+        when(source.hasPermission("spark")).thenReturn(true);
+        final var snapshot = SparkCommandSender.snapshot(source, List.of("spark"), ignored -> { });
+        clearInvocations(source);
+        final var wrapper = new PaperCommandSender(snapshot);
+        assertNull(wrapper.getUniqueId());
+        assertFalse(wrapper.isPlayer());
+        assertTrue(wrapper.hasPermission("spark"));
+        verifyNoInteractions(source);
+    }
+
+    @Test void repliesUseExplicitDeliveryInsteadOfOriginalSender() {
+        final CommandSender source = mock(CommandSender.class);
+        when(source.getName()).thenReturn("CONSOLE");
+        final List<Component> replies = new ArrayList<>();
+        final var snapshot = SparkCommandSender.snapshot(source, List.of(), replies::add);
+        final Component message = Component.text("native delivery");
+        new PaperCommandSender(snapshot).sendMessage(message);
+        assertEquals(List.of(message), replies);
+        verify(source, never()).sendMessage(any(Component.class));
+    }
+
+    @Test void unexpectedFutureSparkPlayerOperationsFailClosed() {
+        final Player source = mock(Player.class);
+        when(source.getName()).thenReturn("SparkPlayer");
+        final var snapshot = (Player)SparkCommandSender.snapshot(source, List.of(), ignored -> { });
+        assertThrows(UnsupportedOperationException.class, snapshot::getLocation);
+    }
+
+    @Test void pluginPreferencePropertyRetainsSafeDefault() {
+        final String previous = System.getProperty("paper.preferSparkPlugin");
+        try {
+            System.clearProperty("paper.preferSparkPlugin");
+            assertTrue(SparksFly.isPluginPreferred());
+            System.setProperty("paper.preferSparkPlugin", "false");
+            assertFalse(SparksFly.isPluginPreferred());
+            System.setProperty("paper.preferSparkPlugin", "true");
+            assertTrue(SparksFly.isPluginPreferred());
+        } finally {
+            if (previous == null) System.clearProperty("paper.preferSparkPlugin");
+            else System.setProperty("paper.preferSparkPlugin", previous);
+        }
+    }
+}

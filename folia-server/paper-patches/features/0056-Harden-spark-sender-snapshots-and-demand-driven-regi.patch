diff --git a/src/main/java/io/papermc/paper/spark/SparkCommandSender.java b/src/main/java/io/papermc/paper/spark/SparkCommandSender.java
new file mode 100644
index 0000000000000000000000000000000000000000..72333de1f4c0913e40a1e454b2c42afbf1b1cfed
--- /dev/null
+++ b/src/main/java/io/papermc/paper/spark/SparkCommandSender.java
@@ -0,0 +1,41 @@
+package io.papermc.paper.spark;
+
+import java.lang.reflect.Proxy;
+import java.util.Collection;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.Consumer;
+import java.util.stream.Collectors;
+import net.kyori.adventure.text.Component;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+/** Narrow adapter for the four methods used by spark-paper 1.10.191's sender. */
+final class SparkCommandSender {
+    private SparkCommandSender() { }
+
+    static CommandSender snapshot(final CommandSender sender, final Collection<String> permissions, final Consumer<Component> reply) {
+        final String name = sender.getName();
+        final UUID id = sender instanceof Player player ? player.getUniqueId() : null;
+        final Set<String> granted = permissions.stream().filter(sender::hasPermission).collect(Collectors.toUnmodifiableSet());
+        final Class<?> type = sender instanceof Player ? Player.class : CommandSender.class;
+        // No native entity, permission map or mutable sender state is read later.
+        // Keeping Player as the proxy type preserves spark's requester UUID.
+        return (CommandSender)Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type},
+            (proxy, method, arguments) -> switch (method.getName()) {
+                case "getName", "toString" -> name;
+                case "getUniqueId" -> id;
+                case "hasPermission" -> granted.contains((String)arguments[0]);
+                case "hashCode" -> System.identityHashCode(proxy);
+                case "equals" -> proxy == arguments[0];
+                case "sendMessage" -> {
+                    if (arguments.length != 1 || !(arguments[0] instanceof Component message)) {
+                        throw new UnsupportedOperationException("Unexpected spark message signature: " + method);
+                    }
+                    reply.accept(message);
+                    yield null;
+                }
+                default -> throw new UnsupportedOperationException("Unexpected spark sender operation: " + method);
+            });
+    }
+}

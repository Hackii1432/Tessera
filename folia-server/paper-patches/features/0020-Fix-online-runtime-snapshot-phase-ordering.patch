+package org.bukkit.craftbukkit.world;
+
+import io.papermc.paper.threadedregions.SnapshotTaskGate;
+import io.papermc.paper.world.WorldSnapshotResult;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import static org.junit.jupiter.api.Assertions.*;
+
+@Tag("Normal")
+class SnapshotPipelineTest {
+    @TempDir Path temp;
+
+    @ParameterizedTest
+    @ValueSource(ints = {0, 1, 4})
+    void allPlayerSavesMustFinishBeforeBarrierAndCopy(final int count) throws Exception {
+        final List<String> order = new ArrayList<>();
+        final List<CompletableFuture<Void>> players = new ArrayList<>();
+        for (int i = 0; i < count; i++) players.add(new CompletableFuture<>());
+        final SnapshotTaskGate gate = new SnapshotTaskGate();
+        final var result = SnapshotPipeline.run(new SnapshotPipeline.Steps(
+            step(order, "freeze"),
+            () -> { order.add("players"); return CompletableFuture.allOf(players.toArray(CompletableFuture[]::new)); },
+            step(order, "barrier"),
+            () -> { order.add("seal"); return gate.seal(); },
+            step(order, "flush"),
+            () -> {
+                order.add("copy");
+                assertFalse(gate.enter());
+                try {
+                    CraftRuntimeWorldManager.copyPlayerSnapshotDirectory(this.temp.resolve("source"), this.temp.resolve("players/data"));
+                } catch (IOException failure) { return CompletableFuture.failedFuture(failure); }
+                return CompletableFuture.completedFuture(null);
+            },
+            () -> { gate.reopen(); order.add("resume"); return CompletableFuture.completedFuture(null); }
+        ), 1, TimeUnit.SECONDS).toCompletableFuture();
+        for (int i = 0; i < count; i++) {
+            assertFalse(result.isDone());
+            assertFalse(order.contains("barrier"));
+            Files.createDirectories(this.temp.resolve("source"));
+            Files.writeString(this.temp.resolve("source/player-" + i + ".dat"), "region/world " + i);
+            players.get(i).complete(null);
+        }
+        result.get(2, TimeUnit.SECONDS);
+        assertEquals(List.of("freeze", "players", "barrier", "seal", "flush", "copy", "resume"), order);
+        for (int i = 0; i < count; i++) {
+            assertEquals("region/world " + i, Files.readString(this.temp.resolve("players/data/player-" + i + ".dat")));
+        }
+        assertTrue(gate.enter());
+        gate.exit();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"PLAYER_SAVE", "REGION_BARRIER", "REGION_SEAL"})
+    void timeoutNamesTheBlockedPhaseAndAlwaysResumes(final String blocked) {
+        final List<String> order = new ArrayList<>();
+        final Supplier<CompletionStage<Void>> never = CompletableFuture::new;
+        final var steps = new SnapshotPipeline.Steps(step(order, "freeze"),
+            blocked.equals("PLAYER_SAVE") ? never : step(order, "players"),
+            blocked.equals("REGION_BARRIER") ? never : step(order, "barrier"),
+            blocked.equals("REGION_SEAL") ? never : step(order, "seal"),
+            step(order, "flush"), step(order, "copy"), step(order, "resume"));
+        final CompletionException exception = assertThrows(CompletionException.class,
+            () -> SnapshotPipeline.run(steps, 10, TimeUnit.MILLISECONDS).toCompletableFuture().join());
+        final SnapshotPipeline.Failure failure = (SnapshotPipeline.Failure)exception.getCause();
+        assertEquals(WorldSnapshotResult.Status.TIMEOUT, failure.status);
+        assertTrue(failure.getMessage().startsWith(blocked + "_TIMEOUT"));
+        assertInstanceOf(java.util.concurrent.TimeoutException.class, failure.getCause());
+        assertFalse(order.contains("copy"));
+        assertEquals("resume", order.getLast());
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"PLAYER_SAVE_REJECTED", "PLAYER_SAVE_FAILED", "SNAPSHOT_COPY_FAILED"})
+    void exceptionsAndRejectedTasksAreTerminalAndResume(final String code) {
+        final List<String> order = new ArrayList<>();
+        final Supplier<CompletionStage<Void>> failed = () -> { throw new SnapshotPipeline.Failure(
+            code.startsWith("SNAPSHOT_COPY") ? WorldSnapshotResult.Status.COPY_FAILED : WorldSnapshotResult.Status.SAVE_FAILED,
+            code, new IOException("disk or queue")); };
+        final var steps = new SnapshotPipeline.Steps(step(order, "freeze"),
+            code.startsWith("PLAYER") ? failed : step(order, "players"), step(order, "barrier"),
+            step(order, "seal"), step(order, "flush"),
+            code.startsWith("SNAPSHOT_COPY") ? failed : step(order, "copy"), step(order, "resume"));
+        final var failure = assertThrows(CompletionException.class,
+            () -> SnapshotPipeline.run(steps, 1, TimeUnit.SECONDS).toCompletableFuture().join());
+        assertEquals(code, failure.getCause().getMessage());
+        assertEquals("resume", order.getLast());
+    }
+
+    @Test
+    void partialPrepareFailureStillResumes() {
+        final List<String> order = new ArrayList<>();
+        final var steps = new SnapshotPipeline.Steps(
+            () -> { order.add("freeze-first-world"); throw new IllegalStateException("second world busy"); },
+            step(order, "players"), step(order, "barrier"), step(order, "seal"),
+            step(order, "flush"), step(order, "copy"), step(order, "resume"));
+        assertThrows(CompletionException.class, () -> SnapshotPipeline.run(steps, 1, TimeUnit.SECONDS).toCompletableFuture().join());
+        assertEquals(List.of("freeze-first-world", "resume"), order);
+    }
+
+    private static Supplier<CompletionStage<Void>> step(final List<String> order, final String name) {
+        return () -> { order.add(name); return CompletableFuture.completedFuture(null); };
+    }
+}

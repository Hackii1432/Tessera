index 0000000000000000000000000000000000000000..c13f7204b304e8891e919fd8b651a6e74df9dbae
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/SnapshotTaskGate.java
@@ -0,0 +1,48 @@
+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.CompletableFuture;
+
+/** Snapshot-only admission barrier; never holds a monitor while region work runs. */
+public final class SnapshotTaskGate {
+    private int running;
+    private boolean sealed;
+    private CompletableFuture<Void> drained;
+
+    public synchronized boolean enter() {
+        if (this.sealed) {
+            return false;
+        }
+        ++this.running;
+        return true;
+    }
+
+    public void exit() {
+        final CompletableFuture<Void> complete;
+        synchronized (this) {
+            if (--this.running < 0) {
+                throw new IllegalStateException("Unbalanced snapshot gate");
+            }
+            complete = this.running == 0 ? this.drained : null;
+        }
+        if (complete != null) {
+            complete.complete(null);
+        }
+    }
+
+    public synchronized CompletableFuture<Void> seal() {
+        this.sealed = true;
+        this.drained = new CompletableFuture<>();
+        if (this.running == 0) {
+            this.drained.complete(null);
+        }
+        return this.drained;
+    }
+
+    public synchronized boolean isSealed() {
+        return this.sealed;
+    }
+
+    public synchronized void reopen() {
+        this.sealed = false;
+    }
+}

diff --git a/src/main/java/org/bukkit/craftbukkit/world/SnapshotPipeline.java b/src/main/java/org/bukkit/craftbukkit/world/SnapshotPipeline.java
new file mode 100644
index 0000000000000000000000000000000000000000..e0f1c8d947fb1d3c4a0647dbbdd2be165efedd87
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/world/SnapshotPipeline.java
@@ -0,0 +1,92 @@
+package org.bukkit.craftbukkit.world;
+
+import io.papermc.paper.world.WorldSnapshotResult;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.function.Supplier;
+
+/** The snapshot ordering is shared by the live implementation and deterministic regression tests. */
+final class SnapshotPipeline {
+    record Steps(
+        Supplier<CompletionStage<Void>> freeze,
+        Supplier<CompletionStage<Void>> savePlayers,
+        Supplier<CompletionStage<Void>> regionBarrier,
+        Supplier<CompletionStage<Void>> seal,
+        Supplier<CompletionStage<Void>> flush,
+        Supplier<CompletionStage<Void>> copy,
+        Supplier<CompletionStage<Void>> resume
+    ) {}
+
+    static CompletionStage<Void> run(final Steps steps, final long timeout, final TimeUnit unit) {
+        return phase("SNAPSHOT_PREPARE", steps.freeze, 0, unit)
+            .thenCompose(ignored -> phase("PLAYER_SAVE", steps.savePlayers, timeout, unit))
+            .thenCompose(ignored -> phase("REGION_BARRIER", steps.regionBarrier, timeout, unit))
+            .thenCompose(ignored -> phase("REGION_SEAL", steps.seal, timeout, unit))
+            .thenCompose(ignored -> phase("SNAPSHOT_FLUSH", steps.flush, 0, unit))
+            .thenCompose(ignored -> phase("SNAPSHOT_COPY", steps.copy, 0, unit))
+            .handle((ignored, failure) -> phase("SNAPSHOT_RESUME", steps.resume, 0, unit)
+                .handle((resumed, resumeFailure) -> {
+                    if (resumeFailure != null) {
+                        final Failure cleanup = new Failure(WorldSnapshotResult.Status.CLEANUP_FAILED,
+                            "SNAPSHOT_RESUME_FAILED", unwrap(resumeFailure));
+                        if (failure != null) {
+                            cleanup.addSuppressed(unwrap(failure));
+                        }
+                        throw cleanup;
+                    }
+                    if (failure != null) {
+                        throw new CompletionException(unwrap(failure));
+                    }
+                    return (Void)null;
+                }))
+            .thenCompose(stage -> stage);
+    }
+
+    private static CompletionStage<Void> phase(final String name, final Supplier<CompletionStage<Void>> action,
+                                               final long timeout, final TimeUnit unit) {
+        final CompletableFuture<Void> work;
+        try {
+            work = action.get().toCompletableFuture();
+        } catch (final Throwable failure) {
+            return CompletableFuture.failedFuture(describe(name, failure));
+        }
+        // Timeout the observer, not the underlying storage operation.
+        final CompletableFuture<Void> observed = work.copy();
+        if (timeout > 0) {
+            observed.orTimeout(timeout, unit);
+        }
+        return observed.exceptionallyCompose(failure -> CompletableFuture.failedFuture(describe(name, failure)));
+    }
+
+    private static Failure describe(final String phase, final Throwable failure) {
+        final Throwable cause = unwrap(failure);
+        if (cause instanceof Failure diagnosed) {
+            return diagnosed;
+        }
+        final boolean timeout = cause instanceof TimeoutException;
+        return new Failure(timeout ? WorldSnapshotResult.Status.TIMEOUT
+            : phase.equals("SNAPSHOT_COPY") ? WorldSnapshotResult.Status.COPY_FAILED : WorldSnapshotResult.Status.SAVE_FAILED,
+            phase + (timeout ? "_TIMEOUT" : "_FAILED") + ": "
+                + (cause.getMessage() == null ? cause.getClass().getSimpleName() : cause.getMessage()), cause);
+    }
+
+    static Throwable unwrap(final Throwable throwable) {
+        Throwable result = throwable;
+        while (result instanceof CompletionException && result.getCause() != null) {
+            result = result.getCause();
+        }
+        return result;
+    }
+
+    static class Failure extends RuntimeException {
+        final WorldSnapshotResult.Status status;
+
+        Failure(final WorldSnapshotResult.Status status, final String message, final Throwable cause) {
+            super(message, cause);
+            this.status = status;
+        }
+    }
+}

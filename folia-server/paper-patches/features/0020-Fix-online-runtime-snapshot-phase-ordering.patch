+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import java.io.UncheckedIOException;
+import java.io.IOException;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.players.PlayerList;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Tag("Normal")
+class SnapshotPlayerSchedulerTest {
+    @Test
+    void publicSchedulerStillRejectsFrozenWorld() {
+        final CraftEntity entity = mock(CraftEntity.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerLevel world = mock(ServerLevel.class);
+        when(entity.getHandleRaw()).thenReturn(player);
+        when(player.level()).thenReturn(world);
+        doThrow(new IllegalStateException("World is snapshotting")).when(world)
+            .tessera$ensureAcceptingApiTasks("new entity scheduler tasks");
+        final var scheduler = new io.papermc.paper.threadedregions.scheduler.FoliaEntityScheduler(entity);
+        assertThrows(IllegalStateException.class, () -> scheduler.run(mock(org.bukkit.plugin.Plugin.class), task -> fail("ran"), null));
+    }
+
+    @Test
+    void saveRunsWithoutAdvancingNormalSchedulerAndChecksOwner() {
+        final CraftEntity entity = mock(CraftEntity.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerLevel world = mock(ServerLevel.class);
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final PlayerList players = mock(PlayerList.class);
+        when(entity.getHandleRaw()).thenReturn(player);
+        when(player.level()).thenReturn(world);
+        when(world.getServer()).thenReturn(server);
+        when(server.getPlayerList()).thenReturn(players);
+        final EntityScheduler scheduler = new EntityScheduler(entity);
+        final java.util.concurrent.atomic.AtomicBoolean normalTask = new java.util.concurrent.atomic.AtomicBoolean();
+        scheduler.schedule(ignored -> normalTask.set(true), null, 1L);
+        final var saved = scheduler.scheduleSnapshotSave();
+        assertFalse(saved.isDone());
+        try (var threads = mockStatic(TickThread.class)) {
+            scheduler.executeSnapshotSaves();
+            threads.verify(() -> TickThread.ensureTickThread(player, "Cannot execute snapshot player save off the owning region"));
+        }
+        assertTrue(saved.isDone());
+        assertFalse(saved.isCompletedExceptionally());
+        assertFalse(normalTask.get());
+        verify(players).tessera$savePlayerSnapshot(player);
+    }
+
+    @Test
+    void retiredCallbackAndAlreadyRetiredSchedulerCompleteSave() {
+        final CraftEntity entity = mock(CraftEntity.class);
+        when(entity.getHandleRaw()).thenReturn(mock(ServerPlayer.class));
+        final EntityScheduler scheduler = new EntityScheduler(entity);
+        final var saved = scheduler.scheduleSnapshotSave();
+        scheduler.retire();
+        assertTrue(saved.isDone());
+        assertFalse(saved.isCompletedExceptionally());
+        assertTrue(scheduler.scheduleSnapshotSave().isDone());
+    }
+
+    @Test
+    void saveExceptionCompletesEveryFutureAndCancelledSaveNeverRunsLate() {
+        final CraftEntity entity = mock(CraftEntity.class);
+        final ServerPlayer player = mock(ServerPlayer.class);
+        final ServerLevel world = mock(ServerLevel.class);
+        final MinecraftServer server = mock(MinecraftServer.class);
+        final PlayerList players = mock(PlayerList.class);
+        when(entity.getHandleRaw()).thenReturn(player);
+        when(player.level()).thenReturn(world);
+        when(world.getServer()).thenReturn(server);
+        when(server.getPlayerList()).thenReturn(players);
+        doThrow(new UncheckedIOException(new IOException("disk failure"))).when(players).tessera$savePlayerSnapshot(player);
+        final EntityScheduler scheduler = new EntityScheduler(entity);
+        final var a = scheduler.scheduleSnapshotSave();
+        final var b = scheduler.scheduleSnapshotSave();
+        final var cancelled = scheduler.scheduleSnapshotSave();
+        cancelled.cancel(false);
+        try (var threads = mockStatic(TickThread.class)) {
+            scheduler.executeSnapshotSaves();
+            scheduler.executeSnapshotSaves();
+        }
+        assertTrue(a.isCompletedExceptionally());
+        assertTrue(b.isCompletedExceptionally());
+        verify(players, times(2)).tessera$savePlayerSnapshot(player);
+    }
+}

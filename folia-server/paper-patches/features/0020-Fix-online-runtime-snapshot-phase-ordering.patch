+package io.papermc.paper.threadedregions;
+
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+@Tag("Normal")
+class SnapshotTaskGateTest {
+    @Test
+    void concurrentOwnerMustLeaveBeforeCopyCanStart() throws Exception {
+        final SnapshotTaskGate gate = new SnapshotTaskGate();
+        final java.util.concurrent.CountDownLatch entered = new java.util.concurrent.CountDownLatch(1);
+        final java.util.concurrent.CountDownLatch release = new java.util.concurrent.CountDownLatch(1);
+        try (var executor = java.util.concurrent.Executors.newSingleThreadExecutor()) {
+            final var owner = executor.submit(() -> {
+                assertTrue(gate.enter());
+                entered.countDown();
+                try { assertTrue(release.await(2, java.util.concurrent.TimeUnit.SECONDS)); }
+                catch (InterruptedException failure) { throw new AssertionError(failure); }
+                finally { gate.exit(); }
+            });
+            assertTrue(entered.await(2, java.util.concurrent.TimeUnit.SECONDS));
+            final var sealed = gate.seal();
+            try { assertFalse(sealed.isDone()); assertFalse(gate.enter()); }
+            finally { release.countDown(); }
+            owner.get(2, java.util.concurrent.TimeUnit.SECONDS);
+            sealed.get(2, java.util.concurrent.TimeUnit.SECONDS);
+        }
+    }
+
+    @Test
+    void sealWaitsForBothRunningOwnersAndRejectsNewWork() {
+        final SnapshotTaskGate gate = new SnapshotTaskGate();
+        assertTrue(gate.enter());
+        assertTrue(gate.enter());
+        final var drained = gate.seal();
+        assertFalse(drained.isDone());
+        assertFalse(gate.enter());
+        gate.exit();
+        assertFalse(drained.isDone());
+        gate.exit();
+        assertTrue(drained.isDone());
+        assertFalse(gate.enter());
+        gate.reopen();
+        assertTrue(gate.enter());
+        gate.exit();
+    }
+
+    @Test
+    void emptyAndRepeatedSnapshotsCanSealAndResume() {
+        final SnapshotTaskGate gate = new SnapshotTaskGate();
+        for (int i = 0; i < 3; i++) {
+            assertTrue(gate.seal().isDone());
+            assertFalse(gate.enter());
+            gate.reopen();
+            assertTrue(gate.enter());
+            gate.exit();
+        }
+    }
+}

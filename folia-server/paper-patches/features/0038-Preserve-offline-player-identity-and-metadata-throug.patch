diff --git a/src/main/java/org/bukkit/craftbukkit/world/PlayerRestoreImage.java b/src/main/java/org/bukkit/craftbukkit/world/PlayerRestoreImage.java
index a0bae375bf85090202a7ca82341b6c464b80ef14..03b99f599c5b0563cd394b15e73f47d7da3d4ae6 100644
--- a/src/main/java/org/bukkit/craftbukkit/world/PlayerRestoreImage.java
+++ b/src/main/java/org/bukkit/craftbukkit/world/PlayerRestoreImage.java
@@ -14,7 +14,7 @@ import net.minecraft.server.level.ServerPlayer;
 import net.minecraft.util.ProblemReporter;
 import net.minecraft.world.level.storage.TagValueOutput;
 
-/** An immutable owner-thread capture. No live entity is dereferenced by its file writer. */
+/** An owner-thread image. Null JSON means an absent store file, not an empty store. */
 record PlayerRestoreImage(UUID id, CompoundTag data, JsonElement stats, JsonElement advancements) {
     static PlayerRestoreImage capture(ServerPlayer player) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(player, "Cannot capture restore image off owner");
@@ -28,14 +28,27 @@ record PlayerRestoreImage(UUID id, CompoundTag data, JsonElement stats, JsonElem
     }
 
     void write(Path root) throws IOException {
+        this.write(root, false);
+    }
+
+    /** Overlay converted NBT onto a source copy, retaining offline activity and JSON bytes. */
+    void writePrepared(Path root) throws IOException {
+        this.write(root, true);
+    }
+
+    private void write(Path root, boolean prepared) throws IOException {
         Path dataFile = root.resolve("data").resolve(this.id + ".dat");
+        var modified = prepared && Files.exists(dataFile) ? Files.getLastModifiedTime(dataFile) : null;
         NbtIo.writeCompressed(this.data, dataFile);
+        // CraftOfflinePlayer falls back to mtime for missing historical fields.
+        if (modified != null) Files.setLastModifiedTime(dataFile, modified);
         force(dataFile);
-        writeJson(root.resolve("stats").resolve(this.id + ".json"), this.stats);
-        writeJson(root.resolve("advancements").resolve(this.id + ".json"), this.advancements);
+        writeJson(root.resolve("stats").resolve(this.id + ".json"), this.stats, prepared);
+        writeJson(root.resolve("advancements").resolve(this.id + ".json"), this.advancements, prepared);
     }
 
-    private static void writeJson(Path path, JsonElement value) throws IOException {
+    private static void writeJson(Path path, JsonElement value, boolean prepared) throws IOException {
+        if (value == null || prepared && Files.exists(path)) return;
         Files.writeString(path, value.toString(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
         force(path);
     }

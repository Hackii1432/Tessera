@@ -0,0 +1,76 @@
+package org.bukkit.craftbukkit.world;
+
+import com.google.gson.JsonObject;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.UUID;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtAccounter;
+import net.minecraft.nbt.NbtIo;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@Tag("Normal")
+class PlayerRestoreImageTest {
+    @TempDir Path root;
+
+    private void directories() throws Exception {
+        for (String directory : PlayerRestoreFiles.DIRECTORIES) Files.createDirectory(this.root.resolve(directory));
+    }
+
+    @Test
+    void preparedOverlayPreservesUnknownTagsAbsentStoresAndFileTime() throws Exception {
+        this.directories();
+        UUID id = UUID.randomUUID();
+        Path file = this.root.resolve("data/" + id + ".dat");
+        CompoundTag data = new CompoundTag();
+        CompoundTag extra = new CompoundTag();
+        extra.putString("opaque", "not understood by ServerPlayer");
+        data.put("third-party", extra);
+        data.put("bukkit", new CompoundTag());
+        NbtIo.writeCompressed(data, file);
+        FileTime time = FileTime.fromMillis(1_600_000_000_000L);
+        Files.setLastModifiedTime(file, time);
+        new PlayerRestoreImage(id, data.copy(), null, null).writePrepared(this.root);
+        assertEquals(data, NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap()));
+        assertEquals(time, Files.getLastModifiedTime(file));
+        assertFalse(Files.exists(this.root.resolve("stats/" + id + ".json")));
+        assertFalse(Files.exists(this.root.resolve("advancements/" + id + ".json")));
+        assertFalse(data.getCompound("bukkit").orElseThrow().contains("lastKnownName"));
+    }
+
+    @Test
+    void preparedJsonIsNotReformattedOrMarkedActive() throws Exception {
+        this.directories();
+        UUID id = UUID.randomUUID();
+        FileTime time = FileTime.fromMillis(1_600_000_000_000L);
+        for (String directory : new String[]{"stats", "advancements"}) {
+            Path file = this.root.resolve(directory).resolve(id + ".json");
+            Files.writeString(file, "{\n  \"opaque\": 42\n}\n");
+            Files.setLastModifiedTime(file, time);
+        }
+        new PlayerRestoreImage(id, new CompoundTag(), new JsonObject(), new JsonObject()).writePrepared(this.root);
+        for (String directory : new String[]{"stats", "advancements"}) {
+            Path file = this.root.resolve(directory).resolve(id + ".json");
+            assertEquals("{\n  \"opaque\": 42\n}\n", Files.readString(file));
+            assertEquals(time, Files.getLastModifiedTime(file));
+        }
+    }
+
+    @Test
+    void liveCaptureStillReplacesExistingJsonAndFreshParticipantsGetStores() throws Exception {
+        this.directories();
+        UUID id = UUID.randomUUID();
+        var image = new PlayerRestoreImage(id, new CompoundTag(), new JsonObject(), new JsonObject());
+        image.writePrepared(this.root);
+        Path stats = this.root.resolve("stats/" + id + ".json");
+        Files.writeString(stats, "{\"obsolete\": 42}");
+        image.write(this.root);
+        assertEquals("{}", Files.readString(stats));
+        assertEquals("{}", Files.readString(this.root.resolve("advancements/" + id + ".json")));
+    }
+}

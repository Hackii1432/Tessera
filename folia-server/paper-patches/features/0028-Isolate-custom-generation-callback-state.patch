From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tessera <development@tessera.local>
Date: Tue, 15 Sep 2026 16:00:00 +0200
Subject: [PATCH] Isolate custom generation callback state

Selective backport of Paper 2307f8f477997c9dbe17f789007c22356070e3a9,
adapted for Sinopia and Tessera. See docs/PAPER-BACKPORTS-2026-09-15.md.

diff --git a/src/main/java/org/bukkit/craftbukkit/generator/CustomChunkGenerator.java b/src/main/java/org/bukkit/craftbukkit/generator/CustomChunkGenerator.java
--- a/src/main/java/org/bukkit/craftbukkit/generator/CustomChunkGenerator.java
+++ b/src/main/java/org/bukkit/craftbukkit/generator/CustomChunkGenerator.java
@@ -58,3 +58,3 @@
-    private final Random random = new Random();
-    private boolean newApi;
+    // Tessera - a generator is shared by concurrent generation jobs.
+    private volatile boolean newApi;
     private boolean implementBaseHeight = true;
@@ -157,19 +157,22 @@
         int z = protoChunk.getPos().z();
 
-        CraftChunkData chunkData = new CraftChunkData(this.world.getWorld(), protoChunk);
-
-        random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
-        this.generator.generateSurface(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
-
-        if (false && this.generator.shouldGenerateBedrock()) {
-            random = getSeededRandom();
-            random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
-            // this.delegate.buildBedrock(protoChunk, random);
-        }
-
-        random = getSeededRandom();
-        random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
-        this.generator.generateBedrock(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
-        chunkData.breakLink();
+        CraftChunkData chunkData = new CraftChunkData(this.world.getWorld(), protoChunk);
+
+        try { // Tessera - invalidate plugin chunk views even if a callback throws
+            random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
+            this.generator.generateSurface(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
+
+            if (false && this.generator.shouldGenerateBedrock()) {
+                random = getSeededRandom();
+                random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
+                // this.delegate.buildBedrock(protoChunk, random);
+            }
+
+            random = getSeededRandom();
+            random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
+            this.generator.generateBedrock(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
+        } finally {
+            chunkData.breakLink();
+        }
 
         // return if new api is used
@@ -185,3 +189,4 @@
-        this.random.setSeed((long) x * 341873128712L + (long) z * 132897987541L);
+        // Tessera - same legacy seed, independent random state per chunk (including parallel-capable plugins).
+        final Random legacyRandom = new Random((long) x * 341873128712L + (long) z * 132897987541L);
 
         // Get default biome data for chunk
@@ -193,7 +198,7 @@
             if (this.generator.isParallelCapable()) {
-                data = this.generator.generateChunkData(this.world.getWorld(), this.random, x, z, biomeGrid);
+                data = this.generator.generateChunkData(this.world.getWorld(), legacyRandom, x, z, biomeGrid);
             } else {
                 synchronized (this) {
-                    data = this.generator.generateChunkData(this.world.getWorld(), this.random, x, z, biomeGrid);
+                    data = this.generator.generateChunkData(this.world.getWorld(), legacyRandom, x, z, biomeGrid);
                 }
             }
@@ -259,3 +264,6 @@
-        this.generator.generateCaves(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
-        chunkData.breakLink();
+        try {
+            this.generator.generateCaves(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
+        } finally {
+            chunkData.breakLink();
+        }
     }
@@ -293,2 +301,3 @@
-        return future == null ? CompletableFuture.supplyAsync(() -> work.apply(chunk), io.papermc.paper.FeatureHooks.getWorldgenExecutor()) : future.thenApply(work); // Paper - chunk system
+        // Tessera - Moonrise's executor is inline: keep callbacks in the admitted generation job, never enqueue a global/region task.
+        return future == null ? CompletableFuture.supplyAsync(() -> work.apply(chunk), io.papermc.paper.FeatureHooks.getWorldgenExecutor()) : future.thenApply(work); // Paper - chunk system
     }
@@ -311,4 +320,7 @@
         random.setLargeFeatureWithSalt(INITIAL_SEED, x, z, 0);
-        this.generator.generateNoise(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
-        chunkData.breakLink();
+        try {
+            this.generator.generateNoise(this.world.getWorld(), new RandomSourceWrapper.RandomWrapper(random), x, z, chunkData);
+        } finally {
+            chunkData.breakLink();
+        }
     }

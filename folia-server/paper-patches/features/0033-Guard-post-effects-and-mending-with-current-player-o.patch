+++ b/src/test/java/io/papermc/paper/porting/TesseraMainOwnershipTest.java
@@ -0,0 +1,201 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerChunkCache;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.CompoundContainer;
+import net.minecraft.world.Container;
+import net.minecraft.world.entity.ai.behavior.TransportItemsBetweenContainers;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import static org.mockito.ArgumentMatchers.*;
+
+@Normal
+class TesseraMainOwnershipTest {
+    @org.junit.jupiter.params.ParameterizedTest
+    @org.junit.jupiter.params.provider.ValueSource(strings = {"send", "empty", "cancel", "transfer", "removed", "replaced"})
+    void serverSuggestionEventRevalidatesStateBeforeSending(String outcome) throws Exception {
+        var player = mock(net.minecraft.server.level.ServerPlayer.class);
+        var listener = mock(net.minecraft.server.network.ServerGamePacketListenerImpl.class, CALLS_REAL_METHODS);
+        listener.player = player;
+        player.connection = listener;
+        doReturn(true).when(listener).isAcceptingMessages();
+        doNothing().when(listener).send(any(net.minecraft.network.protocol.Packet.class));
+        var range = com.mojang.brigadier.context.StringRange.at(1);
+        var empty = new com.mojang.brigadier.suggestion.Suggestions(range, java.util.List.of());
+        var filled = new com.mojang.brigadier.suggestion.Suggestions(range,
+            java.util.List.of(new com.mojang.brigadier.suggestion.Suggestion(range, "help")));
+        var owner = new java.util.concurrent.atomic.AtomicBoolean(true);
+        try (var threads = mockStatic(TickThread.class);
+             var events = mockConstruction(com.destroystokyo.paper.event.brigadier.AsyncPlayerSendSuggestionsEvent.class, (event, context) -> {
+                 when(event.getSuggestions()).thenReturn(outcome.equals("empty") ? empty : filled);
+                 when(event.callEvent()).thenAnswer(call -> {
+                     if (outcome.equals("transfer")) owner.set(false);
+                     if (outcome.equals("removed")) when(player.isRemoved()).thenReturn(true);
+                     if (outcome.equals("replaced")) listener.player = mock(net.minecraft.server.level.ServerPlayer.class);
+                     return !outcome.equals("cancel");
+                 });
+             })) {
+            threads.when(() -> TickThread.isTickThreadFor(player)).thenAnswer(call -> owner.get());
+            Method send = net.minecraft.server.network.ServerGamePacketListenerImpl.class.getDeclaredMethod(
+                "tessera$sendServerSuggestions", net.minecraft.server.level.ServerPlayer.class,
+                net.minecraft.network.protocol.game.ServerboundCommandSuggestionPacket.class,
+                com.mojang.brigadier.suggestion.Suggestions.class);
+            send.setAccessible(true);
+            send.invoke(listener, player, new net.minecraft.network.protocol.game.ServerboundCommandSuggestionPacket(1, "/help"), empty);
+            assertEquals(1, events.constructed().size());
+            verify(events.constructed().getFirst()).callEvent();
+            verify(listener, times(outcome.equals("send") ? 1 : 0)).send(any(net.minecraft.network.protocol.Packet.class));
+        }
+    }
+
+    @Test
+    void asynchronousSuggestionsWaitForThePlayersScheduler() throws Exception {
+        var player = mock(net.minecraft.server.level.ServerPlayer.class);
+        var craft = mock(org.bukkit.craftbukkit.entity.CraftPlayer.class);
+        var scheduler = mock(io.papermc.paper.threadedregions.EntityScheduler.class);
+        Field schedulerField = org.bukkit.craftbukkit.entity.CraftEntity.class.getDeclaredField("taskScheduler");
+        schedulerField.setAccessible(true);
+        schedulerField.set(craft, scheduler);
+        var listener = mock(net.minecraft.server.network.ServerGamePacketListenerImpl.class, CALLS_REAL_METHODS);
+        listener.player = player;
+        doReturn(craft).when(listener).getCraftPlayer();
+        var provider = mock(net.minecraft.server.network.ServerCommandSuggestionsProvider.class);
+        var future = new java.util.concurrent.CompletableFuture<com.mojang.brigadier.suggestion.Suggestions>();
+        when(provider.request("/help")).thenReturn(future);
+        Field providerField = net.minecraft.server.network.ServerGamePacketListenerImpl.class.getDeclaredField("commandSuggestionsProvider");
+        providerField.setAccessible(true);
+        providerField.set(listener, provider);
+        try (var threads = mockStatic(TickThread.class)) {
+            listener.sendServerSuggestions(new net.minecraft.network.protocol.game.ServerboundCommandSuggestionPacket(1, "/help"));
+            verifyNoInteractions(scheduler);
+            future.complete(new com.mojang.brigadier.suggestion.Suggestions(com.mojang.brigadier.context.StringRange.at(1), java.util.List.of()));
+            verify(scheduler).schedule(any(), isNull(), eq(1L));
+            verify(listener, never()).isAcceptingMessages();
+        }
+    }
+
+    @Test
+    void cushionRecordsFluidPositionBeforeApplyingEffects() throws Exception {
+        var cushion = mock(net.minecraft.world.entity.decoration.Cushion.class, CALLS_REAL_METHODS);
+        var level = mock(ServerLevel.class, RETURNS_DEEP_STUBS);
+        var pos = new BlockPos(32, 70, 48);
+        doReturn(level).when(cushion).level();
+        doReturn(pos).when(cushion).blockPosition();
+        doReturn(net.minecraft.world.phys.Vec3.ZERO).when(cushion).position();
+        doReturn(true).when(cushion).collidedWithFluid(any(), any(), any(), any());
+        doReturn(false).when(cushion).canFreeze();
+        doNothing().when(cushion).destroyIfInFire(level);
+        var collector = spy(new net.minecraft.world.entity.InsideBlockEffectApplier.StepBasedCollector());
+        Field field = net.minecraft.world.entity.Entity.class.getDeclaredField("insideEffectCollector");
+        field.setAccessible(true);
+        field.set(cushion, collector);
+        var fluid = level.getBlockState(pos).getFluidState();
+        doAnswer(call -> {
+            // This used to throw because currentBlockPos had never been set.
+            collector.apply(net.minecraft.world.entity.InsideBlockEffectType.values()[0]);
+            return null;
+        }).when(fluid).entityInside(level, pos, cushion, collector);
+        Method tick = net.minecraft.world.entity.decoration.Cushion.class.getDeclaredMethod("tickAtCheckInterval");
+        tick.setAccessible(true);
+        assertDoesNotThrow(() -> tick.invoke(cushion));
+        var order = inOrder(collector, fluid);
+        order.verify(collector).advanceStep(0, pos);
+        order.verify(fluid).entityInside(level, pos, cushion, collector);
+        order.verify(collector).applyAndClear(cushion);
+    }
+
+    @Test
+    void compoundContainerRejectsForeignHalfWithoutReadingIt() throws Exception {
+        ServerLevel level = mock(ServerLevel.class, RETURNS_DEEP_STUBS);
+        ChestBlockEntity first = mock(ChestBlockEntity.class);
+        ChestBlockEntity second = mock(ChestBlockEntity.class);
+        BlockPos foreign = new BlockPos(512, 64, 512);
+        when(first.getBlockPos()).thenReturn(BlockPos.ZERO);
+        when(second.getBlockPos()).thenReturn(foreign);
+        when(first.getLevel()).thenReturn(level);
+        when(second.getLevel()).thenReturn(level);
+        when(level.getBlockEntity(BlockPos.ZERO)).thenReturn(first);
+        when(level.getChunkSource().getChunkAtIfLoadedImmediately(0, 0)).thenReturn(mock(LevelChunk.class));
+        when(level.getChunkSource().getChunkAtIfLoadedImmediately(32, 32)).thenReturn(mock(LevelChunk.class));
+        when(level.getBlockEntity(foreign)).thenReturn(second);
+        Method check = TransportItemsBetweenContainers.class.getDeclaredMethod("isContainerRemoved", Level.class, Container.class);
+        check.setAccessible(true);
+        CompoundContainer compound = new CompoundContainer(first, second);
+        try (var threads = mockStatic(TickThread.class)) {
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(true);
+            assertEquals(true, check.invoke(null, level, compound));
+            verify(second, never()).isRemoved();
+            verify(level, never()).getBlockEntity(foreign);
+            threads.when(() -> TickThread.isTickThreadFor(level, foreign)).thenReturn(true);
+            assertEquals(false, check.invoke(null, level, compound));
+            when(second.isRemoved()).thenReturn(true);
+            assertEquals(true, check.invoke(null, level, compound));
+        }
+    }
+
+    @Test
+    void targetDiscoveryRejectsUnloadedAndForeignPositions() {
+        ServerLevel level = mock(ServerLevel.class, RETURNS_DEEP_STUBS);
+        try (var threads = mockStatic(TickThread.class)) {
+            assertNull(TransportItemsBetweenContainers.TransportItemTarget.tryCreatePossibleTarget(BlockPos.ZERO, level));
+            verify(level, never()).getBlockEntity(any());
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(true);
+            when(level.getChunkSource().getChunkAtIfLoadedImmediately(0, 0)).thenReturn(null);
+            assertNull(TransportItemsBetweenContainers.TransportItemTarget.tryCreatePossibleTarget(BlockPos.ZERO, level));
+            verify(level, never()).getBlockEntity(any());
+        }
+    }
+
+    @Test
+    void unloadBroadcastRemovalUsesOnlyTheOwningRegionsSet() throws Exception {
+        ServerLevel level = mock(ServerLevel.class);
+        var own = mock(io.papermc.paper.threadedregions.RegionizedWorldData.class);
+        var other = mock(io.papermc.paper.threadedregions.RegionizedWorldData.class);
+        Field broadcasts = io.papermc.paper.threadedregions.RegionizedWorldData.class.getDeclaredField("chunkHoldersToBroadcast");
+        broadcasts.setAccessible(true);
+        broadcasts.set(own, new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>());
+        broadcasts.set(other, new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>());
+        NewChunkHolder holder = mock(NewChunkHolder.class);
+        var vanilla = mock(net.minecraft.server.level.ChunkHolder.class);
+        Field vanillaField = NewChunkHolder.class.getDeclaredField("vanillaChunkHolder");
+        vanillaField.setAccessible(true);
+        vanillaField.set(holder, vanilla);
+        own.chunkHoldersToBroadcast.add(vanilla);
+        other.chunkHoldersToBroadcast.add(vanilla);
+        when(level.getCurrentWorldData()).thenReturn(own);
+        ServerChunkCache cache = mock(ServerChunkCache.class, CALLS_REAL_METHODS);
+        Field world = ServerChunkCache.class.getDeclaredField("level");
+        world.setAccessible(true);
+        world.set(cache, level);
+        try (var threads = mockStatic(TickThread.class)) {
+            cache.moonrise$chunkHolderUnload(holder);
+            assertTrue(own.chunkHoldersToBroadcast.isEmpty());
+            assertTrue(other.chunkHoldersToBroadcast.contains(vanilla));
+            threads.verify(() -> TickThread.ensureTickThread(level, 0, 0, "Cannot remove chunk broadcasts off-region"));
+        }
+    }
+
+    @Test
+    void loadedChunkCannotTransferSectionsToAsyncSaving() {
+        ServerLevel level = mock(ServerLevel.class);
+        LevelChunk chunk = mock(LevelChunk.class);
+        when(chunk.getPos()).thenReturn(new net.minecraft.world.level.ChunkPos(0, 0));
+        when(chunk.isLoaded()).thenReturn(true);
+        try (var threads = mockStatic(TickThread.class)) {
+            assertThrows(IllegalStateException.class, () -> SerializableChunkData.copyOfForUnload(level, chunk));
+            verify(chunk, never()).getSections();
+        }
+    }
+}

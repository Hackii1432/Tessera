@@ -0,0 +1,115 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import io.papermc.paper.entity.PaperPlayerPostEffects;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+import net.kyori.adventure.key.Key;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.level.ServerPlayer;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class TesseraPostEffectsTest {
+    private static ServerPlayer player() throws Exception {
+        ServerPlayer player = mock(ServerPlayer.class, CALLS_REAL_METHODS);
+        Class<?> type = ServerPlayer.class;
+        while (type != null) {
+            try {
+                Field field = type.getDeclaredField("postEffects");
+                field.setAccessible(true);
+                field.set(player, new ArrayList<Identifier>());
+                break;
+            } catch (NoSuchFieldException ignored) {
+                type = type.getSuperclass();
+            }
+        }
+        assertNotNull(type);
+        doReturn(false).when(player).isRemoved();
+        doReturn(false).when(player).hasDisconnected();
+        return player;
+    }
+
+    @Test
+    void retainedApiResolvesTheCurrentPlayerAfterRespawn() throws Exception {
+        ServerPlayer first = player();
+        ServerPlayer replacement = player();
+        AtomicReference<ServerPlayer> current = new AtomicReference<>(first);
+        CraftPlayer craft = mock(CraftPlayer.class);
+        when(craft.getHandle()).thenAnswer(call -> current.get());
+        var effects = new PaperPlayerPostEffects(craft);
+        try (var threads = mockStatic(TickThread.class)) {
+            assertTrue(effects.add(Key.key("minecraft", "blur")));
+            List<Key> snapshot = effects.values();
+            current.set(replacement);
+            assertTrue(effects.add(Key.key("minecraft", "invert")));
+            assertEquals(List.of(Key.key("minecraft", "invert")), effects.values());
+            assertEquals(List.of(Key.key("minecraft", "blur")), snapshot);
+            assertThrows(UnsupportedOperationException.class, () -> snapshot.add(Key.key("minecraft", "test")));
+            assertEquals(List.of(Identifier.withDefaultNamespace("blur")), first.getPostEffects());
+            threads.verify(() -> TickThread.ensureTickThread(replacement, "Cannot access player post effects off-region"), atLeastOnce());
+        }
+    }
+
+    @Test
+    void allOperationsRejectForeignRegionAccess() throws Exception {
+        ServerPlayer player = player();
+        CraftPlayer craft = mock(CraftPlayer.class);
+        when(craft.getHandle()).thenReturn(player);
+        var effects = new PaperPlayerPostEffects(craft);
+        try (var threads = mockStatic(TickThread.class)) {
+            threads.when(() -> TickThread.ensureTickThread(player, "Cannot access player post effects off-region"))
+                .thenThrow(new IllegalStateException("foreign region"));
+            assertThrows(IllegalStateException.class, effects::values);
+            assertThrows(IllegalStateException.class, () -> effects.set(List.of(Key.key("minecraft", "blur"))));
+            assertThrows(IllegalStateException.class, () -> effects.add(Key.key("minecraft", "blur")));
+            assertThrows(IllegalStateException.class, () -> effects.remove(Key.key("minecraft", "blur")));
+            assertThrows(IllegalStateException.class, effects::clear);
+        }
+        assertTrue(player.getPostEffects().isEmpty());
+    }
+
+    @Test
+    void orderingDuplicateValidationAndDirtyFlagMatchPaper() throws Exception {
+        ServerPlayer player = player();
+        CraftPlayer craft = mock(CraftPlayer.class);
+        when(craft.getHandle()).thenReturn(player);
+        var effects = new PaperPlayerPostEffects(craft);
+        Key blur = Key.key("minecraft", "blur");
+        Key invert = Key.key("minecraft", "invert");
+        Field dirty = ServerPlayer.class.getDeclaredField("postEffectsDirty");
+        dirty.setAccessible(true);
+        try (var threads = mockStatic(TickThread.class)) {
+            assertTrue(effects.set(List.of(blur, invert)));
+            assertTrue(dirty.getBoolean(player));
+            dirty.setBoolean(player, false);
+            assertFalse(effects.set(List.of(blur, invert)));
+            assertFalse(dirty.getBoolean(player));
+            assertTrue(effects.set(List.of(invert, blur)));
+            assertEquals(List.of(invert, blur), effects.values());
+            assertThrows(IllegalArgumentException.class, () -> effects.set(List.of(blur, blur)));
+            assertThrows(IllegalArgumentException.class, () -> effects.set(null));
+            assertThrows(IllegalArgumentException.class, () -> effects.add(null));
+            assertThrows(IllegalArgumentException.class, () -> effects.remove(null));
+            assertEquals(List.of(invert, blur), effects.values());
+            assertFalse(effects.add(blur));
+            assertTrue(effects.remove(blur));
+            assertFalse(effects.remove(blur));
+            assertTrue(effects.clear());
+            assertFalse(effects.clear());
+            doReturn(true).when(player).isRemoved();
+            assertThrows(IllegalStateException.class, effects::values);
+            doReturn(false).when(player).isRemoved();
+            doReturn(true).when(player).hasDisconnected();
+            assertThrows(IllegalStateException.class, () -> effects.add(blur));
+        }
+    }
+}
+

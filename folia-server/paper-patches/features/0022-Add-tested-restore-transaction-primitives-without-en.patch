+package org.bukkit.craftbukkit.world;
+
+import java.util.UUID;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("Normal")
+class PlayerStoreFenceTest {
+    @Test
+    void waitsForEveryRunningWriterWithoutBlockingNewCallers() {
+        PlayerStoreFence fence = new PlayerStoreFence();
+        UUID id = UUID.randomUUID();
+        var first = fence.tryWrite(fence.generation());
+        var second = fence.tryWrite(fence.generation());
+        var drained = fence.close(id).toCompletableFuture();
+        assertFalse(drained.isDone());
+        assertNull(fence.tryWrite(fence.generation()));
+        assertThrows(IllegalStateException.class, () -> fence.advance(id));
+        first.close();
+        first.close(); // Idempotent close must not release the other writer.
+        assertFalse(drained.isDone());
+        second.close();
+        assertTrue(drained.isDone());
+        fence.open(id);
+        assertFalse(fence.isClosed());
+    }
+
+    @Test
+    void oldCacheGenerationsCannotWriteAfterPublicationOrRollback() {
+        PlayerStoreFence fence = new PlayerStoreFence();
+        UUID id = UUID.randomUUID();
+        long old = fence.generation();
+        fence.close(id);
+        long forward = fence.advance(id);
+        long rollback = fence.advance(id);
+        fence.open(id);
+        assertNull(fence.tryWrite(old));
+        assertNull(fence.tryWrite(forward));
+        try (var lease = fence.tryWrite(rollback)) {
+            assertNotNull(lease);
+        }
+    }
+
+    @Test
+    void otherOperationsCannotOpenOrAdvanceTheFence() {
+        PlayerStoreFence fence = new PlayerStoreFence();
+        fence.close(UUID.randomUUID());
+        UUID wrong = UUID.randomUUID();
+        assertThrows(IllegalStateException.class, () -> fence.close(wrong));
+        assertThrows(IllegalStateException.class, () -> fence.advance(wrong));
+        assertThrows(IllegalStateException.class, () -> fence.open(wrong));
+        assertTrue(fence.isClosed());
+    }
+}

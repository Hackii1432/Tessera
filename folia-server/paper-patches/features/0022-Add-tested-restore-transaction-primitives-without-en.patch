@@ -0,0 +1,35 @@
+package org.bukkit.craftbukkit.world;
+
+import java.util.IdentityHashMap;
+import java.util.UUID;
+import org.bukkit.event.player.PlayerTeleportEvent;
+
+/** Event identity capability, valid only on the dispatching owner thread. */
+final class RestoreTeleportScope {
+    private final ThreadLocal<IdentityHashMap<PlayerTeleportEvent, UUID>> events = new ThreadLocal<>();
+
+    boolean matches(PlayerTeleportEvent event, UUID operation) {
+        var active = this.events.get();
+        return event != null && operation != null && active != null && operation.equals(active.get(event));
+    }
+
+    void dispatch(PlayerTeleportEvent event, UUID operation, Runnable dispatch) {
+        var active = this.events.get();
+        if (active == null) {
+            active = new IdentityHashMap<>();
+            this.events.set(active);
+        }
+        if (active.containsKey(event)) {
+            throw new IllegalStateException("Restore teleport event is already being dispatched");
+        }
+        active.put(event, operation);
+        try {
+            dispatch.run();
+        } finally {
+            active.remove(event);
+            if (active.isEmpty()) {
+                this.events.remove();
+            }
+        }
+    }
+}

diff --git a/src/test/java/org/bukkit/craftbukkit/world/PlayerRestoreCoordinatorTest.java b/src/test/java/org/bukkit/craftbukkit/world/PlayerRestoreCoordinatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..810da5cb824189620b696caa8ad7ba8dede5f1fb
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/world/PlayerRestoreCoordinatorTest.java
@@ -0,0 +1,257 @@
+package org.bukkit.craftbukkit.world;
+
+import io.papermc.paper.world.PlayerRestoreResult;
+import io.papermc.paper.world.PlayerRestoreStatus;
+import java.nio.file.Path;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.Executor;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTimeoutPreemptively;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("Normal")
+class PlayerRestoreCoordinatorTest {
+    private final UUID id = UUID.randomUUID();
+    private final PlayerRestoreCoordinator.Request request = new PlayerRestoreCoordinator.Request(Path.of("source"), Path.of("rollback"), UUID.randomUUID());
+    private final QueueExecutor executor = new QueueExecutor();
+    private final Backend backend = new Backend();
+    private final PlayerRestoreCoordinator coordinator = new PlayerRestoreCoordinator(this.backend, this.executor);
+
+    @Test
+    void workerContinuationCanAwaitRollbackWithoutWaitingOnItsOwnCompletionStack() {
+        var actor = new PlayerRestoreCoordinator(this.backend, Runnable::run);
+        var prepare = actor.prepare(this.id, this.request);
+        this.backend.rolledBack.complete(null);
+        var cleanup = prepare.thenApply(ignored -> actor.apply(this.id, false).toCompletableFuture().join());
+        assertTimeoutPreemptively(java.time.Duration.ofSeconds(3), () -> this.backend.prepared.complete(null));
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, cleanup);
+    }
+
+    @Test
+    void latePrepareCannotOutliveConfirmedRollback() {
+        var prepare = this.coordinator.prepare(this.id, this.request);
+        this.executor.drain();
+        var rollback = this.coordinator.apply(this.id, false);
+        assertFalse(rollback.toCompletableFuture().isDone());
+        this.backend.prepared.complete(null);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.CANCELLED, prepare);
+        assertEquals(List.of("prepare", "rollback"), this.backend.calls);
+        assertFalse(rollback.toCompletableFuture().isDone());
+        this.backend.rolledBack.complete(null);
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, rollback);
+        var complete = this.coordinator.complete(this.id, false);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.COMPLETED, complete);
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.apply(this.id, true));
+    }
+
+    @Test
+    void rollbackBeforeDispatchNeverStartsPrepare() {
+        var prepare = this.coordinator.prepare(this.id, this.request);
+        var rollback = this.coordinator.apply(this.id, false);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.CANCELLED, prepare);
+        assertEquals(List.of("rollback"), this.backend.calls);
+        this.backend.rolledBack.complete(null);
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, rollback);
+    }
+
+    @Test
+    void unknownRollbackCreatesPermanentTombstoneWithoutTakingOtherFence() {
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, this.coordinator.apply(this.id, false));
+        UUID other = UUID.randomUUID();
+        var prepareOther = this.coordinator.prepare(other, this.request);
+        var completed = this.coordinator.complete(this.id, false);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.COMPLETED, completed);
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.prepare(this.id, this.request));
+        assertFalse(prepareOther.toCompletableFuture().isDone());
+        assertStatus(PlayerRestoreStatus.BUSY, this.coordinator.prepare(UUID.randomUUID(), this.request));
+    }
+
+    @Test
+    void rollbackDrainsAnAlreadyStartedForwardTransfer() {
+        this.prepareSuccessfully();
+        var apply = this.coordinator.apply(this.id, true);
+        this.executor.drain();
+        var rollback = this.coordinator.apply(this.id, false);
+        this.executor.drain();
+        assertEquals(List.of("prepare", "forward"), this.backend.calls);
+        assertFalse(rollback.toCompletableFuture().isDone());
+        this.backend.applied.complete(null);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.CANCELLED, apply);
+        assertEquals(List.of("prepare", "forward", "rollback"), this.backend.calls);
+        this.backend.rolledBack.complete(null);
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, rollback);
+    }
+
+    @Test
+    void callerTimeoutAndCancellationDoNotCompleteOwnedWork() {
+        var prepare = this.coordinator.prepare(this.id, this.request);
+        this.executor.drain();
+        var callerView = prepare.toCompletableFuture();
+        callerView.completeExceptionally(new java.util.concurrent.TimeoutException("MCC timeout"));
+        assertFalse(this.backend.prepared.isDone());
+        var second = this.coordinator.prepare(this.id, this.request);
+        assertFalse(second.toCompletableFuture().isDone());
+        this.backend.prepared.complete(null);
+        assertStatus(PlayerRestoreStatus.PREPARED, second);
+        var apply = this.coordinator.apply(this.id, true);
+        apply.toCompletableFuture().cancel(false);
+        this.executor.drain();
+        assertFalse(this.backend.applied.isDone());
+        this.backend.applied.complete(null);
+        assertStatus(PlayerRestoreStatus.APPLIED, this.coordinator.apply(this.id, true));
+    }
+
+    @Test
+    void mismatchedPrepareDoesNotReplaceTheOriginalOperation() {
+        this.coordinator.prepare(this.id, this.request);
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.prepare(this.id,
+            new PlayerRestoreCoordinator.Request(Path.of("another"), this.request.rollback(), this.request.fallback())));
+        this.executor.drain();
+        assertEquals(List.of("prepare"), this.backend.calls);
+    }
+
+    @Test
+    void completionFailureAfterCommitCannotBeRolledBackAndCanBeRetried() {
+        this.applySuccessfully();
+        this.backend.completion = CompletableFuture.failedFuture(new IllegalStateException("injected complete failure"));
+        var complete = this.coordinator.complete(this.id, true);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.COMPLETE_FAILED, complete);
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.apply(this.id, false));
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.complete(this.id, false));
+        assertStatus(PlayerRestoreStatus.BUSY, this.coordinator.prepare(UUID.randomUUID(), this.request));
+        this.backend.completion = CompletableFuture.completedFuture(null);
+        var retry = this.coordinator.complete(this.id, true);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.COMPLETED, retry);
+        assertStatus(PlayerRestoreStatus.APPLIED, this.coordinator.apply(this.id, true));
+        assertStatus(PlayerRestoreStatus.COMPLETED, this.coordinator.complete(this.id, true));
+        assertEquals(List.of("prepare", "forward", "complete-true", "complete-true"), this.backend.calls);
+    }
+
+    @Test
+    void inFlightFinalDecisionRejectsConcurrentOppositeDecision() {
+        this.applySuccessfully();
+        this.backend.completion = new CompletableFuture<>();
+        var complete = this.coordinator.complete(this.id, true);
+        this.executor.drain();
+        assertFalse(complete.toCompletableFuture().isDone());
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.apply(this.id, false));
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.complete(this.id, false));
+        this.backend.completion.complete(null);
+        assertStatus(PlayerRestoreStatus.COMPLETED, complete);
+    }
+
+    @Test
+    void prepareFailureRetainsFenceUntilRollbackAndComplete() {
+        var prepare = this.coordinator.prepare(this.id, this.request);
+        this.executor.drain();
+        this.backend.prepared.completeExceptionally(new IllegalStateException("injected copy failure"));
+        assertStatus(PlayerRestoreStatus.SAVE_FAILED, prepare);
+        assertStatus(PlayerRestoreStatus.BUSY, this.coordinator.prepare(UUID.randomUUID(), this.request));
+        assertStatus(PlayerRestoreStatus.CONFLICT, this.coordinator.complete(this.id, true));
+        var rollback = this.coordinator.apply(this.id, false);
+        this.executor.drain();
+        this.backend.rolledBack.complete(null);
+        assertStatus(PlayerRestoreStatus.ROLLED_BACK, rollback);
+        var complete = this.coordinator.complete(this.id, false);
+        this.executor.drain();
+        assertStatus(PlayerRestoreStatus.COMPLETED, complete);
+        this.coordinator.prepare(UUID.randomUUID(), this.request);
+        this.executor.drain();
+        assertEquals(2, this.backend.calls.stream().filter("prepare"::equals).count());
+    }
+
+    @Test
+    void duplicateRequestsDoNotDispatchDuplicateWork() {
+        var one = this.coordinator.prepare(this.id, this.request);
+        var two = this.coordinator.prepare(this.id, this.request);
+        this.executor.drain();
+        this.backend.prepared.complete(null);
+        assertStatus(PlayerRestoreStatus.PREPARED, one);
+        assertStatus(PlayerRestoreStatus.PREPARED, two);
+        this.coordinator.apply(this.id, true);
+        this.coordinator.apply(this.id, true);
+        this.executor.drain();
+        this.backend.applied.complete(null);
+        this.coordinator.complete(this.id, true);
+        this.coordinator.complete(this.id, true);
+        this.executor.drain();
+        assertEquals(List.of("prepare", "forward", "complete-true"), this.backend.calls);
+    }
+
+    private void prepareSuccessfully() {
+        var stage = this.coordinator.prepare(this.id, this.request);
+        this.executor.drain();
+        this.backend.prepared.complete(null);
+        assertStatus(PlayerRestoreStatus.PREPARED, stage);
+    }
+
+    private void applySuccessfully() {
+        this.prepareSuccessfully();
+        var stage = this.coordinator.apply(this.id, true);
+        this.executor.drain();
+        this.backend.applied.complete(null);
+        assertStatus(PlayerRestoreStatus.APPLIED, stage);
+    }
+
+    private static void assertStatus(PlayerRestoreStatus expected, CompletionStage<PlayerRestoreResult> stage) {
+        assertTrue(stage.toCompletableFuture().isDone(), "Operation unexpectedly still running");
+        assertEquals(expected, stage.toCompletableFuture().join().status());
+    }
+
+    private static final class QueueExecutor implements Executor {
+        private final ArrayDeque<Runnable> tasks = new ArrayDeque<>();
+
+        @Override
+        public void execute(Runnable command) {
+            this.tasks.add(command);
+        }
+
+        void drain() {
+            for (Runnable task; (task = this.tasks.poll()) != null;) {
+                task.run();
+            }
+        }
+    }
+
+    private static final class Backend implements PlayerRestoreCoordinator.Backend {
+        final List<String> calls = new ArrayList<>();
+        final CompletableFuture<Void> prepared = new CompletableFuture<>();
+        final CompletableFuture<Void> applied = new CompletableFuture<>();
+        final CompletableFuture<Void> rolledBack = new CompletableFuture<>();
+        CompletableFuture<Void> completion = CompletableFuture.completedFuture(null);
+
+        @Override
+        public CompletionStage<Void> prepare(PlayerRestoreCoordinator.Operation operation) {
+            this.calls.add("prepare");
+            return this.prepared;
+        }
+
+        @Override
+        public CompletionStage<Void> apply(PlayerRestoreCoordinator.Operation operation, boolean forward) {
+            this.calls.add(forward ? "forward" : "rollback");
+            return forward ? this.applied : this.rolledBack;
+        }
+
+        @Override
+        public CompletionStage<Void> complete(PlayerRestoreCoordinator.Operation operation, boolean committed) {
+            this.calls.add("complete-" + committed);
+            return this.completion;
+        }
+    }
+}

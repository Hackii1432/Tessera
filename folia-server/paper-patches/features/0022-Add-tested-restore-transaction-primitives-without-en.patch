+package org.bukkit.craftbukkit.world;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("Normal")
+class PlayerRestoreFilesTest {
+    @TempDir
+    Path root;
+
+    @Test
+    void copiesAllPlayersWithoutModifyingSourceAndForcesEveryDirectory() throws Exception {
+        Path source = this.store("source", "saved");
+        Path target = this.root.resolve("rollback");
+        List<Path> forced = new ArrayList<>();
+        new PlayerRestoreFiles(forced::add).copyNew(source, target);
+        for (String directory : PlayerRestoreFiles.DIRECTORIES) {
+            assertEquals("saved", Files.readString(target.resolve(directory).resolve("offline.dat")));
+            assertEquals("saved", Files.readString(source.resolve(directory).resolve("offline.dat")));
+        }
+        assertEquals(List.of(target.resolve("data"), target.resolve("stats"), target.resolve("advancements"), target, target.getParent()), forced);
+        assertThrows(IOException.class, () -> new PlayerRestoreFiles(forced::add).copyNew(source, target));
+    }
+
+    @Test
+    void incompleteSourceAndOverlappingPathsAreRejectedBeforeCreatingOutput() throws Exception {
+        Path source = Files.createDirectory(this.root.resolve("incomplete"));
+        Path target = this.root.resolve("backup");
+        var files = new PlayerRestoreFiles(ignored -> {});
+        assertThrows(IOException.class, () -> files.copyNew(source, target));
+        assertFalse(Files.exists(target));
+        Path valid = this.store("valid", "old");
+        assertThrows(IOException.class, () -> files.copyNew(valid, valid.resolve("nested")));
+        assertThrows(IOException.class, () -> files.copyNew(valid, this.root));
+        assertThrows(IOException.class, () -> files.copyNew(valid, valid));
+    }
+
+    @Test
+    void publicationRetainsOriginalAndReplacesAllThreeStores() throws Exception {
+        Path active = this.store("players", "original");
+        Path prepared = this.store("staged", "new");
+        Path retained = new PlayerRestoreFiles(ignored -> {}).publish(prepared, active, UUID.randomUUID(), "forward");
+        assertFalse(Files.exists(prepared));
+        for (String directory : PlayerRestoreFiles.DIRECTORIES) {
+            assertEquals("new", Files.readString(active.resolve(directory).resolve("offline.dat")));
+            assertEquals("original", Files.readString(retained.resolve(directory).resolve("offline.dat")));
+        }
+    }
+
+    @Test
+    void failedPublicationRestoresOriginalAndPreservesStaging() throws Exception {
+        Path active = this.store("players", "original");
+        Path prepared = this.store("staged", "new");
+        AtomicInteger moves = new AtomicInteger();
+        var files = new PlayerRestoreFiles(ignored -> {}, (from, to) -> {
+            if (moves.incrementAndGet() == 2) {
+                throw new IOException("injected publication failure");
+            }
+            Files.move(from, to);
+        });
+        assertThrows(IOException.class, () -> files.publish(prepared, active, UUID.randomUUID(), "forward"));
+        assertEquals("original", Files.readString(active.resolve("data/offline.dat")));
+        assertEquals("new", Files.readString(prepared.resolve("data/offline.dat")));
+        assertEquals(3, moves.get());
+    }
+
+    @Test
+    void failedCompensationKeepsBothTreesAndReportsBothErrors() throws Exception {
+        Path active = this.store("players", "original");
+        Path prepared = this.store("staged", "new");
+        AtomicInteger moves = new AtomicInteger();
+        var files = new PlayerRestoreFiles(ignored -> {}, (from, to) -> {
+            if (moves.incrementAndGet() > 1) {
+                throw new IOException("injected move failure");
+            }
+            Files.move(from, to);
+        });
+        IOException failure = assertThrows(IOException.class, () -> files.publish(prepared, active, UUID.randomUUID(), "forward"));
+        assertEquals(1, failure.getSuppressed().length);
+        assertTrue(Files.exists(prepared.resolve("data/offline.dat")));
+        try (var children = Files.list(this.root)) {
+            Path retained = children.filter(path -> path.getFileName().toString().startsWith(".tessera-players-")).findFirst().orElseThrow();
+            assertEquals("original", Files.readString(retained.resolve("data/offline.dat")));
+        }
+    }
+
+    @Test
+    void durabilityFailureNeverReturnsSuccessfulBackup() throws Exception {
+        Path source = this.store("source", "saved");
+        Path target = this.root.resolve("rollback");
+        var files = new PlayerRestoreFiles(ignored -> { throw new IOException("cannot force directory"); });
+        assertThrows(IOException.class, () -> files.copyNew(source, target));
+        assertEquals("saved", Files.readString(source.resolve("data/offline.dat")));
+        assertTrue(Files.exists(target)); // Failed output is retained for diagnosis, never sealed as PREPARED.
+    }
+
+    @Test
+    void unexpectedTreesAreNotSilentlyOmittedFromBackup() throws Exception {
+        Path source = this.store("source", "saved");
+        Files.createDirectory(source.resolve("unexpected"));
+        assertThrows(IOException.class, () -> PlayerRestoreFiles.validateTree(source));
+    }
+
+    private Path store(String name, String content) throws IOException {
+        Path path = Files.createDirectory(this.root.resolve(name));
+        for (String directory : PlayerRestoreFiles.DIRECTORIES) {
+            Files.createDirectory(path.resolve(directory));
+            Files.writeString(path.resolve(directory).resolve("offline.dat"), content);
+        }
+        return path;
+    }
+}
diff --git a/src/test/java/org/bukkit/craftbukkit/world/PlayerStoreFenceTest.java b/src/test/java/org/bukkit/craftbukkit/world/PlayerStoreFenceTest.java

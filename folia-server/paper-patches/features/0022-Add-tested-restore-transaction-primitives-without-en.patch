+package org.bukkit.craftbukkit.world;
+
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.bukkit.event.player.PlayerTeleportEvent;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+
+@Tag("Normal")
+class RestoreTeleportScopeTest {
+    @Test
+    void onlyTheExactEventOnTheDispatchingThreadIsAdmitted() {
+        var scope = new RestoreTeleportScope();
+        UUID id = UUID.randomUUID();
+        Player player = mock(Player.class);
+        var event = new PlayerTeleportEvent(player, new Location(null, 0, 0, 0), new Location(null, 1, 1, 1));
+        var unrelated = new PlayerTeleportEvent(player, event.getFrom(), event.getTo());
+        assertFalse(scope.matches(event, id));
+        scope.dispatch(event, id, () -> {
+            assertTrue(scope.matches(event, id));
+            assertFalse(scope.matches(unrelated, id));
+            assertFalse(scope.matches(event, UUID.randomUUID()));
+            assertFalse(CompletableFuture.supplyAsync(() -> scope.matches(event, id)).join());
+        });
+        assertFalse(scope.matches(event, id));
+    }
+
+    @Test
+    void eventDispatchFailureNeverLeavesAPermissionWindow() {
+        var scope = new RestoreTeleportScope();
+        UUID id = UUID.randomUUID();
+        var event = new PlayerTeleportEvent(mock(Player.class), new Location(null, 0, 0, 0), new Location(null, 1, 1, 1));
+        assertThrows(IllegalStateException.class, () -> scope.dispatch(event, id, () -> {
+            assertTrue(scope.matches(event, id));
+            throw new IllegalStateException("injected listener failure");
+        }));
+        assertFalse(scope.matches(event, id));
+    }
+}

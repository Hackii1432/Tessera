From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Tue, 6 Oct 2026 17:20:23 +0200
Subject: [PATCH] Guard October Paper passenger spawns and API dragon respawns
 by ownership


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
index 1e0c05d3ad3378dc5810c340a2828b61aae43f7f..0dff0c046eb43b370ba02eb9c4beff65c2a9f004 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
@@ -968,9 +968,21 @@ public class CraftWorld extends CraftRegionAccessor implements World {
     public void addEntityWithPassengers(net.minecraft.world.entity.Entity entity, SpawnReason reason) {
         // Be more lenient than ServerLevel#tryAddFreshEntityWithPassengers and ignore already added entities instead of failing completely.
         // This otherwise causes problems when an entity already added to the world is added as a passenger inside of the pre-spawn consumer.
-        entity.getSelfAndPassengers()
-            .filter(e -> !e.valid)
-            .forEach(e -> this.getHandle().addFreshEntity(e, reason));
+        // Tessera - validate the entire group before any spawn event can mutate the world.
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.world, entity.blockPosition(), "Spawning an entity group off its owning region");
+        List<net.minecraft.world.entity.Entity> group = entity.getSelfAndPassengers().toList();
+        for (net.minecraft.world.entity.Entity member : group) {
+            Preconditions.checkArgument(member.level() == this.world, "Spawn passengers must belong to the target world");
+            ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(member, "Spawning a passenger off its owning region");
+        }
+        for (net.minecraft.world.entity.Entity member : group) {
+            // A spawn listener can cancel, remove, move or detach entities. Do not spawn stale descendants.
+            if (entity.isRemoved()) return;
+            if (member.isRemoved() || entity.getSelfAndPassengers().noneMatch(attached -> attached == member)) continue;
+            Preconditions.checkArgument(member.level() == this.world, "A spawn listener moved a passenger to another world");
+            ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(member, "A spawn listener moved a passenger off its owning region");
+            if (!member.valid && !this.world.addFreshEntity(member, reason) && member == entity) return;
+        }
     }
 
     @Override
diff --git a/src/main/java/org/bukkit/craftbukkit/boss/CraftDragonBattle.java b/src/main/java/org/bukkit/craftbukkit/boss/CraftDragonBattle.java
index 0c8e88dcc10a1004f7289bcd30fda434d4c86bc5..b0b64a34ed40bed4732cc6f37e5a1f8d215256cb 100644
--- a/src/main/java/org/bukkit/craftbukkit/boss/CraftDragonBattle.java
+++ b/src/main/java/org/bukkit/craftbukkit/boss/CraftDragonBattle.java
@@ -1,7 +1,6 @@
 package org.bukkit.craftbukkit.boss;
 
 import com.google.common.base.Preconditions;
-import com.google.common.collect.Lists;
 import io.papermc.paper.math.Position;
 import io.papermc.paper.util.MCUtil;
 import java.util.ArrayList;
@@ -16,7 +15,6 @@ import net.minecraft.world.level.dimension.end.EnderDragonFight;
 import org.bukkit.Location;
 import org.bukkit.boss.BossBar;
 import org.bukkit.boss.DragonBattle;
-import org.bukkit.craftbukkit.CraftWorld;
 import org.bukkit.craftbukkit.entity.CraftEnderCrystal;
 import org.bukkit.craftbukkit.util.CraftLocation;
 import org.bukkit.entity.EnderCrystal;
@@ -77,7 +75,23 @@ public class CraftDragonBattle implements DragonBattle {
 
     @Override
     public boolean initiateRespawn(Collection<EnderCrystal> crystals) {
+        // Tessera - portal discovery scans the arena. Never start by synchronously loading a foreign region.
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.handle.level, this.handle.origin, "Dragon respawn requires the arena's owning region");
+        net.minecraft.world.level.ChunkPos origin = net.minecraft.world.level.ChunkPos.containing(this.handle.origin);
+        Preconditions.checkState(ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.handle.level,
+            origin.x(), origin.z(), 8 + this.handle.level.regioniser.regionSectionChunkSize), "Dragon respawn requires the loaded arena on one owning region");
         if (this.hasBeenPreviouslyKilled() && this.getRespawnPhase() == RespawnPhase.NONE) {
+            // Resolve every crystal before portal mutation; getHandle checks its actual entity owner.
+            List<EndCrystal> ownedCrystals = new ArrayList<>();
+            if (crystals != null) {
+                for (EnderCrystal crystal : crystals) {
+                    if (crystal != null && crystal.getWorld().equals(this.handle.level.getWorld())) {
+                        EndCrystal owned = ((CraftEnderCrystal) crystal).getHandle();
+                        Preconditions.checkArgument(!owned.isRemoved() && owned.valid, "Respawn crystals must be live world entities");
+                        ownedCrystals.add(owned);
+                    }
+                }
+            }
             // Copy from EnderDragonFight#tryRespawn for generate exit portal if not exists
             if (this.handle.exitPortalLocation == null) {
                 BlockPattern.BlockPatternMatch match = this.handle.findExitPortal();
@@ -86,19 +100,14 @@ public class CraftDragonBattle implements DragonBattle {
                 }
             }
 
-            List<EnderCrystal> filteredCrystals = crystals != null ? new ArrayList<>(crystals) : new ArrayList<>();
-            filteredCrystals.removeIf(crystal -> {
-                if (crystal == null) {
-                    return true;
-                }
-                return !((CraftWorld) crystal.getWorld()).getHandle().equals(this.handle.level);
-            });
-
-            this.handle.emptyCrystalRespawnAllowed = filteredCrystals.isEmpty();
-
-            return this.handle.respawnDragon(
-                Lists.transform(filteredCrystals, crystal -> ((CraftEnderCrystal) crystal).getHandle())
-            );
+            this.handle.emptyCrystalRespawnAllowed = ownedCrystals.isEmpty();
+            boolean started = false;
+            try {
+                started = this.handle.respawnDragon(ownedCrystals);
+                return started;
+            } finally {
+                if (!started) this.handle.emptyCrystalRespawnAllowed = false;
+            }
         }
         return false;
     }

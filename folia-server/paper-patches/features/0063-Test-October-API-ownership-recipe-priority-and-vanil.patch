diff --git a/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java b/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..617b7368f9bca2ca4c862cc09e40c553dce6e124
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/PaperOctober22OwnershipTest.java
@@ -0,0 +1,86 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.Predicate;
+import net.kyori.adventure.key.Key;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.Container;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.entity.HopperBlockEntity;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class PaperOctober22OwnershipTest {
+    private static CraftPlayer player(Map<Key, Predicate<org.bukkit.entity.Entity>> rules) throws Exception {
+        var player = mock(CraftPlayer.class, CALLS_REAL_METHODS);
+        var entity = CraftEntity.class.getDeclaredField("entity");
+        entity.setAccessible(true);
+        entity.set(player, mock(ServerPlayer.class));
+        var map = CraftEntity.class.getDeclaredField("additionalAlliedRules");
+        map.setAccessible(true);
+        map.set(player, rules);
+        return player;
+    }
+
+    @Test
+    void playerHandleOverrideDoesNotBypassNewRuleAndDamageOwnerChecks() throws Exception {
+        var rules = new HashMap<Key, Predicate<org.bukkit.entity.Entity>>();
+        var player = player(rules);
+        var key = Key.key("test", "ally");
+        try (var ticks = mockStatic(TickThread.class)) {
+            ticks.when(() -> TickThread.ensureTickThread(any(Entity.class), anyString())).thenThrow(new IllegalStateException("wrong owner"));
+            assertThrows(IllegalStateException.class, player::getAdditionalAlliedRules);
+            assertThrows(IllegalStateException.class, () -> player.addAdditionalAlliedRule(key, ignored -> true));
+            assertThrows(IllegalStateException.class, () -> player.removeAdditionalAlliedRule(key));
+            assertThrows(IllegalStateException.class, () -> player.considersEntityAsAlly0(player));
+            assertThrows(IllegalStateException.class, () -> player.isAlliedTo(player));
+            assertThrows(IllegalStateException.class, player::isMarkedInvulnerable);
+            assertTrue(rules.isEmpty());
+        }
+    }
+
+    @Test
+    void ownerRuleViewRemainsLiveUnmodifiableAndNamespaceRemovalIsScoped() throws Exception {
+        var rules = new HashMap<Key, Predicate<org.bukkit.entity.Entity>>();
+        var player = player(rules);
+        var key = Key.key("test", "ally");
+        var other = Key.key("other", "ally");
+        try (var ticks = mockStatic(TickThread.class)) {
+            var view = player.getAdditionalAlliedRules();
+            player.addAdditionalAlliedRule(key, ignored -> true);
+            player.addAdditionalAlliedRule(other, ignored -> false);
+            assertEquals(2, view.size());
+            assertTrue(player.considersEntityAsAlly0(player));
+            assertThrows(UnsupportedOperationException.class, view::clear);
+            player.removeAdditionalAlliedRule((net.kyori.adventure.key.Namespaced)key);
+            assertEquals(java.util.Set.of(other), view.keySet());
+            assertFalse(player.considersEntityAsAlly0(player));
+        }
+    }
+
+    @Test
+    void staleBlockContainersAreRejectedBeforeWorldReads() {
+        var world = mock(ServerLevel.class);
+        var block = mock(HopperBlockEntity.class);
+        when(block.isRemoved()).thenReturn(true);
+        assertFalse(HopperBlockEntity.tessera$isOwnedContainer(world, block));
+        verify(world, never()).getBlockEntity(any());
+        when(block.isRemoved()).thenReturn(false);
+        when(block.getLevel()).thenReturn(world);
+        when(block.getBlockPos()).thenReturn(net.minecraft.core.BlockPos.ZERO);
+        try (var ticks = mockStatic(TickThread.class)) {
+            assertFalse(HopperBlockEntity.tessera$isOwnedContainer(world, block));
+            verify(world, never()).getBlockEntity(any());
+        }
+    }
+}

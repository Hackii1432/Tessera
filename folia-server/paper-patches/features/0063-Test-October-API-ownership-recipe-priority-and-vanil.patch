@@ -102,6 +102,38 @@ class RegionSafeRecipeCatalogTest {
         assertTrue(manager.getLearnableRecipes().isEmpty());
     }
 
+    @Test
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    void vanillaOrderAndRuntimeInsertionPriorityUseThePublishedCatalog() {
+        var manager = manager();
+        var vanillaFirst = recipe("vanilla_first", false);
+        var vanillaSecond = recipe("vanilla_second", false);
+        var input = mock(net.minecraft.world.item.crafting.CraftingInput.class);
+        var level = mock(net.minecraft.world.level.Level.class);
+        for (var holder : List.of(vanillaFirst, vanillaSecond)) when(((Recipe)holder.value()).matches(input, level)).thenReturn(true);
+        var map = manager.recipes.tessera$mutableCopy();
+        for (var holder : List.of(vanillaFirst, vanillaSecond)) {
+            map.byType.put(RecipeType.CRAFTING, holder);
+            map.byKey.put(holder.id(), holder);
+        }
+        manager.recipes = map;
+        manager.finalizeRecipeLoading();
+        assertSame(vanillaFirst, manager.getRecipeFor(RecipeType.CRAFTING, input, level).orElseThrow());
+        var runtimeFirst = recipe("runtime_first", false);
+        var runtimeLast = recipe("runtime_last", false);
+        for (var holder : List.of(runtimeFirst, runtimeLast)) when(((Recipe)holder.value()).matches(input, level)).thenReturn(true);
+        manager.tessera$addRecipes(List.of(runtimeFirst, runtimeLast));
+        var selected = manager.getRecipeFor(RecipeType.CRAFTING, input, level).orElseThrow();
+        assertEquals(runtimeLast.id(), selected.id());
+        assertSame(runtimeLast.value(), selected.value());
+        assertTrue(selected.runtimeAddedRecipe());
+        assertFalse(vanillaFirst.runtimeAddedRecipe());
+        manager.removeRecipe(runtimeLast.id());
+        assertEquals(runtimeFirst.id(), manager.getRecipeFor(RecipeType.CRAFTING, input, level).orElseThrow().id());
+        manager.removeRecipe(runtimeFirst.id());
+        assertSame(vanillaFirst, manager.getRecipeFor(RecipeType.CRAFTING, input, level).orElseThrow());
+    }
+
     @Test
     void removedDisplayIdsCannotResolveToAnUnrelatedRecipe() {
         var manager = manager();

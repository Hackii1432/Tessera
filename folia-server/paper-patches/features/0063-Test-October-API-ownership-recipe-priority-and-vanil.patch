diff --git a/src/test/java/io/papermc/paper/porting/PaperOctober22GenerationTest.java b/src/test/java/io/papermc/paper/porting/PaperOctober22GenerationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d6baac27fc5c4c01458f68018d25b5187d151397
--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/PaperOctober22GenerationTest.java
@@ -0,0 +1,54 @@
+package io.papermc.paper.porting;
+
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.world.level.biome.Biomes;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.chunk.PalettedContainerFactory;
+import net.minecraft.world.level.levelgen.structure.Structure;
+import net.minecraft.world.level.levelgen.structure.pieces.StructurePiecesBuilder;
+import org.bukkit.support.RegistryHelper;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@AllFeatures
+class PaperOctober22GenerationTest {
+    @Test
+    void statefulBiomeSamplerUsesExactlyVanillaXyzOrderWithoutSamplingOriginTwice() {
+        var registries = RegistryHelper.registryAccess();
+        var biomes = registries.lookupOrThrow(Registries.BIOME);
+        var plains = biomes.getOrThrow(Biomes.PLAINS);
+        var desert = biomes.getOrThrow(Biomes.DESERT);
+        var section = new LevelChunkSection(PalettedContainerFactory.create(registries), null, null, 0);
+        List<BlockPos> calls = new ArrayList<>();
+        AtomicInteger sequence = new AtomicInteger();
+        section.fillBiomesFromNoise((x, y, z) -> {
+            calls.add(new BlockPos(x, y, z));
+            return (sequence.getAndIncrement() & 1) == 0 ? plains : desert;
+        }, -8, 4, -16);
+        List<BlockPos> vanilla = new ArrayList<>();
+        for (int x = 0; x < 4; ++x) for (int y = 0; y < 4; ++y) for (int z = 0; z < 4; ++z) {
+            vanilla.add(new BlockPos(x - 8, y + 4, z - 16));
+            assertSame((vanilla.size() & 1) == 1 ? plains : desert, section.getNoiseBiome(x, y, z));
+        }
+        assertEquals(vanilla, calls);
+        assertEquals(64, sequence.get());
+    }
+
+    @Test
+    void bothStaticStructurePieceWeightOwnersAreSerialized() throws Exception {
+        for (Class<?> structure : List.of(
+            net.minecraft.world.level.levelgen.structure.structures.StrongholdStructure.class,
+            net.minecraft.world.level.levelgen.structure.structures.NetherFortressStructure.class)) {
+            var method = structure.getDeclaredMethod("generatePieces", StructurePiecesBuilder.class, Structure.GenerationContext.class);
+            assertTrue(Modifier.isStatic(method.getModifiers()));
+            assertTrue(Modifier.isSynchronized(method.getModifiers()), structure.getSimpleName());
+        }
+    }
+}

+    // Tessera start - diagnose stable-key/display-name confusion
+    static @Nullable NamespacedKey findStoredKeyByDisplayName(
+        final Path dimensionsRoot,
+        final String displayName,
+        final NamespacedKey requestedKey
+    ) {
+        if (!Files.isDirectory(dimensionsRoot, LinkOption.NOFOLLOW_LINKS)) {
+            return null;
+        }
+
+        NamespacedKey match = null;
+        try (var namespaces = Files.newDirectoryStream(dimensionsRoot)) {
+            for (final Path namespacePath : namespaces) {
+                if (!Files.isDirectory(namespacePath, LinkOption.NOFOLLOW_LINKS)) {
+                    continue;
+                }
+                try (var keys = Files.newDirectoryStream(namespacePath)) {
+                    for (final Path keyPath : keys) {
+                        if (!Files.isDirectory(keyPath, LinkOption.NOFOLLOW_LINKS)) {
+                            continue;
+                        }
+                        final NamespacedKey candidate = NamespacedKey.fromString(
+                            namespacePath.getFileName() + ":" + keyPath.getFileName()
+                        );
+                        if (candidate == null
+                            || candidate.equals(requestedKey)
+                            || !displayNameForKey(candidate).equals(displayName)) {
+                            continue;
+                        }
+                        if (match != null && !match.equals(candidate)) {
+                            return null;
+                        }
+                        match = candidate;
+                    }
+                }
+            }
+        } catch (final IOException ignored) {
+            // This is an optional diagnostic. The authoritative requested-key
+            // validation and its NOT_FOUND result remain available.
+            return null;
+        }
+        return match;
+    }
+
+    private static String displayNameForKey(final NamespacedKey key) {
+        return key.getNamespace().equals(NamespacedKey.MINECRAFT)
+            ? key.getKey()
+            : key.getNamespace() + "_" + key.getKey();
+    }
+    // Tessera end - diagnose stable-key/display-name confusion
+
     private Path snapshotRoot() throws IOException {
         final Path container = this.server.getWorldContainer().toPath().toAbsolutePath().normalize();
         final Path root = container.resolve(".tessera").resolve("template-snapshots").normalize();

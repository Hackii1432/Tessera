+++ b/src/test/java/io/papermc/paper/threadedregions/commands/RegionHealthSnapshotTest.java
@@ -0,0 +1,125 @@
+package io.papermc.paper.threadedregions.commands;
+
+import ca.spottedleaf.common.time.TickData;
+import io.papermc.paper.threadedregions.RegionizedServer;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@Normal
+class RegionHealthSnapshotTest {
+    private static void field(Object target, Class<?> owner, String name, Object value) throws Exception {
+        var field = owner.getField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    @Test
+    void convertsNanosecondsAndRejectsEmptyOrInvalidReports() {
+        assertNull(RegionHealthSnapshot.Metrics.from(null));
+        var report = mock(TickData.TickReportData.class, RETURNS_DEEP_STUBS);
+        assertNull(RegionHealthSnapshot.Metrics.from(report));
+        when(report.collectedTicks()).thenReturn(200);
+        when(report.tpsData().segmentAll().average()).thenReturn(19.5);
+        when(report.timePerTickData().segmentAll().average()).thenReturn(12_000_000.0);
+        when(report.timePerTickData().segmentAll().least()).thenReturn(1_000_000.0);
+        when(report.timePerTickData().segmentAll().median()).thenReturn(10_000_000.0);
+        when(report.timePerTickData().segmentAll().greatest()).thenReturn(25_000_000.0);
+        when(report.utilisation()).thenReturn(0.5);
+        var result = RegionHealthSnapshot.Metrics.from(report);
+        assertNotNull(result);
+        assertEquals(19.5, result.tps());
+        assertEquals(12, result.mspt());
+        assertEquals(1, result.minMspt());
+        assertEquals(10, result.medianMspt());
+        assertEquals(25, result.maxMspt());
+        assertEquals(200, result.ticks());
+        when(report.tpsData().segmentAll().average()).thenReturn(Double.NaN);
+        assertNull(RegionHealthSnapshot.Metrics.from(report));
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void collectionUsesPublishedOwnershipFiltersHiddenPlayersAndRejectsRemovedRegions() throws Exception {
+        MinecraftServer server = mock(MinecraftServer.class, RETURNS_DEEP_STUBS);
+        ServerLevel world = mock(ServerLevel.class);
+        CraftWorld craftWorld = mock(CraftWorld.class);
+        when(world.getWorld()).thenReturn(craftWorld);
+        when(craftWorld.getName()).thenReturn("world");
+        when(server.getAllLevels()).thenReturn(List.of(world));
+        when(server.tickRateManager().tickrate()).thenReturn(20.0F);
+        ThreadedRegionizer<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> regionizer = mock(ThreadedRegionizer.class);
+        field(world, ServerLevel.class, "regioniser", regionizer);
+        ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region = mock(ThreadedRegionizer.ThreadedRegion.class);
+        field(region, ThreadedRegionizer.ThreadedRegion.class, "id", 42L);
+        TickRegions.TickRegionData data = mock(TickRegions.TickRegionData.class);
+        field(data, TickRegions.TickRegionData.class, "region", region);
+        var handle = mock(TickRegions.ConcreteRegionTickHandle.class);
+        var stats = mock(TickRegions.RegionStats.class);
+        when(region.getData()).thenReturn(data);
+        when(data.getRegionSchedulingHandle()).thenReturn(handle);
+        when(data.getRegionStats()).thenReturn(stats);
+        when(stats.getChunkCount()).thenReturn(100);
+        when(stats.getEntityCount()).thenReturn(5);
+        var pass = new AtomicInteger();
+        doAnswer(invocation -> {
+            Consumer<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> visitor = invocation.getArgument(0);
+            // Passes 1/2: stable snapshot. Pass 3: collected reference, removed before pass 4.
+            if (pass.incrementAndGet() <= 3) {
+                visitor.accept(region);
+            }
+            return null;
+        }).when(regionizer).computeForAllRegions(any());
+        CraftPlayer visible = mock(CraftPlayer.class);
+        CraftPlayer hidden = mock(CraftPlayer.class);
+        when(visible.getName()).thenReturn("Alice");
+        when(visible.getUniqueId()).thenReturn(UUID.randomUUID());
+        when(visible.canSee(visible)).thenReturn(true);

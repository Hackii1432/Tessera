@@ -30,6 +38,70 @@ class EndPortalContinuationTest {
         return field.get(entity);
     }
 
+    private static GlobalConfiguration configuration(boolean enabled) {
+        GlobalConfiguration config = new GlobalConfiguration();
+        config.unsupportedSettings = config.new UnsupportedSettings();
+        config.unsupportedSettings.allowUnsafeEndPortalTeleportation = enabled;
+        return config;
+    }
+
+    private static Stream<Arguments> fallingBlockStates() {
+        return BuiltInRegistries.BLOCK.stream()
+            .filter(block -> block instanceof net.minecraft.world.level.block.FallingBlock)
+            .flatMap(block -> Stream.of(Arguments.of(block.defaultBlockState(), false), Arguments.of(block.defaultBlockState(), true)));
+    }
+
+    @ParameterizedTest
+    @MethodSource("fallingBlockStates")
+    void onlyDragonEggIsExcludedFromConfiguredDuplication(BlockState state, boolean enabled) throws Exception {
+        FallingBlockEntity entity = mock(FallingBlockEntity.class, CALLS_REAL_METHODS);
+        field(entity, "blockState", state);
+        var method = FallingBlockEntity.class.getDeclaredMethod("tessera$canDuplicateThroughEndPortal");
+        method.setAccessible(true);
+        try (var settings = mockStatic(GlobalConfiguration.class)) {
+            settings.when(GlobalConfiguration::get).thenReturn(configuration(enabled));
+            assertEquals(enabled && !state.is(Blocks.DRAGON_EGG), method.invoke(entity));
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void dragonEggCannotCaptureASourceContinuationInEitherDirection(boolean reverse) throws Exception {
+        FallingBlockEntity entity = mock(FallingBlockEntity.class, CALLS_REAL_METHODS);
+        field(entity, "blockState", Blocks.DRAGON_EGG.defaultBlockState());
+        field(entity, "tessera$insidePortalTick", true);
+        ServerLevel source = mock(ServerLevel.class);
+        ServerLevel end = mock(ServerLevel.class);
+        Class<?> portalType = Class.forName("net.minecraft.world.entity.Entity$PortalType");
+        var endType = portalType.getDeclaredField("END");
+        endType.setAccessible(true);
+        var method = FallingBlockEntity.class.getDeclaredMethod("tessera$portalTransferQueued", ServerLevel.class, ServerLevel.class, portalType);
+        method.setAccessible(true);
+        try (var settings = mockStatic(GlobalConfiguration.class)) {
+            settings.when(GlobalConfiguration::get).thenReturn(configuration(true));
+            method.invoke(entity, reverse ? end : source, reverse ? source : end, endType.get(null));
+        }
+        assertNull(field(entity, "tessera$portalContinuation"));
+        verifyNoInteractions(source, end);
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void dragonEggInEitherPendingStateCannotPublishASourceCopy(boolean capturedEgg) throws Exception {
+        FallingBlockEntity entity = mock(FallingBlockEntity.class, CALLS_REAL_METHODS);
+        FallingBlockEntity continuation = mock(FallingBlockEntity.class);
+        field(entity, "blockState", (capturedEgg ? Blocks.SAND : Blocks.DRAGON_EGG).defaultBlockState());
+        field(continuation, "blockState", (capturedEgg ? Blocks.DRAGON_EGG : Blocks.SAND).defaultBlockState());
+        field(entity, "tessera$portalContinuation", continuation);
+        try (var settings = mockStatic(GlobalConfiguration.class)) {
+            settings.when(GlobalConfiguration::get).thenReturn(configuration(true));
+            assertNull(finish(entity, true));
+        }
+        assertNull(field(entity, "tessera$portalContinuation"));
+        verifyNoInteractions(continuation);
+        assertNull(finish(entity, true));
+    }
+

--- /dev/null
+++ b/src/test/java/io/papermc/paper/porting/TesseraSeptemberOwnershipTest.java
@@ -0,0 +1,177 @@
+package io.papermc.paper.porting;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import io.papermc.paper.event.entity.EntityCollideWithEntityEvent;
+import io.papermc.paper.threadedregions.RegionizedWorldData;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.level.ServerPlayerGameMode;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.monster.cubemob.SulfurCube;
+import net.minecraft.world.entity.SulfurCubeArchetype;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.flag.FeatureFlags;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.item.ItemCooldowns;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.GameType;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Portal;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.craftbukkit.event.CraftEventFactory;
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.player.PlayerInteractEvent;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+/** Executes real branches with mocked scheduler boundaries; no live multi-region simulation. */
+@AllFeatures
+class TesseraSeptemberOwnershipTest {
+    private static void set(Class<?> owner, Object target, String name, Object value) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    @Test
+    void loginGameModeInitializesWithoutAnActiveRegion() throws Exception {
+        ServerPlayer player = mock(ServerPlayer.class);
+        ServerLevel level = mock(ServerLevel.class);
+        when(player.level()).thenReturn(level);
+        long before = ServerLevel.currentLagCompensationTick();
+        ServerPlayerGameMode mode = new ServerPlayerGameMode(player);
+        Field ticks = ServerPlayerGameMode.class.getDeclaredField("gameTicks");
+        ticks.setAccessible(true);
+        int actual = ticks.getInt(mode);
+        assertTrue(actual >= (int) before && actual <= (int) ServerLevel.currentLagCompensationTick());
+        verify(level, never()).getLagCompensationTick();
+        verify(level, never()).getCurrentWorldData();
+    }
+
+    @ParameterizedTest
+    @CsvSource({"true,true,0.01,false", "true,true,0.1,true", "false,true,0.1,false", "true,false,0.1,false"})
+    void delayedDestructionUsesElapsedTicksAndStillRejectsForeignOrUnloadedBlocks(boolean owner, boolean loaded, float speed, boolean destroyed) throws Exception {
+        ServerPlayer player = mock(ServerPlayer.class);
+        ServerLevel level = mock(ServerLevel.class);
+        when(player.level()).thenReturn(level);
+        when(level.getLagCompensationTick()).thenReturn(1000L);
+        BlockState state = mock(BlockState.class);
+        when(level.getBlockStateIfLoaded(BlockPos.ZERO)).thenReturn(loaded ? state : null);
+        when(state.getDestroyProgress(player, level, BlockPos.ZERO)).thenReturn(speed);
+        ServerPlayerGameMode mode = spy(new ServerPlayerGameMode(player));
+        doReturn(true).when(mode).destroyBlock(any());
+        mode.hasDelayedDestroy = true;
+        set(ServerPlayerGameMode.class, mode, "delayedTickStart", 990);
+        try (var threads = mockStatic(TickThread.class)) {
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(owner);
+            mode.tick();
+        }
+        verify(mode, times(destroyed ? 1 : 0)).destroyBlock(BlockPos.ZERO);
+        verify(level, times(owner ? 1 : 0)).getBlockStateIfLoaded(BlockPos.ZERO);
+        assertEquals(owner && loaded && !destroyed, mode.hasDelayedDestroy);
+    }
+
+    @ParameterizedTest
+    @CsvSource({"false,true,false", "true,true,false", "false,false,false", "false,true,true"})
+    void spectatorPortalUsesAsyncPipelineAndRechecksPluginSideEffects(boolean denied, boolean owner, boolean removed) throws Exception {
+        ServerLevel level = mock(ServerLevel.class);
+        ServerPlayer player = mock(ServerPlayer.class);
+        when(player.level()).thenReturn(level);
+        when(player.getCamera()).thenReturn(player);
+        when(player.getCooldowns()).thenReturn(mock(ItemCooldowns.class));
+        when(player.isRemoved()).thenReturn(removed);
+        set(Player.class, player, "containerMenu", mock(AbstractContainerMenu.class));
+        ServerPlayerGameMode mode = new ServerPlayerGameMode(player);
+        set(ServerPlayerGameMode.class, mode, "gameModeForPlayer", GameType.SPECTATOR);
+        Block block = mock(Block.class, withSettings().extraInterfaces(Portal.class));
+        Portal portal = (Portal) block;
+        when(level.enabledFeatures()).thenReturn(FeatureFlags.REGISTRY.allFlags());
+        when(block.isEnabled(any())).thenReturn(true);
+        BlockState state = mock(BlockState.class);
+        when(state.getBlock()).thenReturn(block);
+        when(level.getBlockState(BlockPos.ZERO)).thenReturn(state);
+        when(portal.portalAsync(level, player, BlockPos.ZERO)).thenReturn(true);
+        PlayerInteractEvent event = mock(PlayerInteractEvent.class);
+        when(event.useInteractedBlock()).thenReturn(denied ? Event.Result.DENY : Event.Result.DEFAULT);
+        when(event.useItemInHand()).thenReturn(Event.Result.DEFAULT);
+        BlockHitResult hit = new BlockHitResult(Vec3.ZERO, Direction.UP, BlockPos.ZERO, false);
+        try (var events = mockStatic(CraftEventFactory.class);
+             var threads = mockStatic(TickThread.class);
+             var utility = mockStatic(io.papermc.paper.util.MCUtil.class)) {
+            events.when(() -> CraftEventFactory.callPlayerInteractEvent(eq(player), any(), eq(BlockPos.ZERO), eq(Direction.UP),
+                same(ItemStack.EMPTY), eq(false), eq(false), eq(InteractionHand.MAIN_HAND), eq(Vec3.ZERO))).thenReturn(event);
+            threads.when(() -> TickThread.isTickThreadFor(player)).thenReturn(owner);
+            threads.when(() -> TickThread.isTickThreadFor(level, BlockPos.ZERO)).thenReturn(owner);
+            assertDoesNotThrow(() -> mode.useItemOn(player, level, ItemStack.EMPTY, InteractionHand.MAIN_HAND, hit));
+            verify(portal, times(!denied && owner && !removed ? 1 : 0)).portalAsync(level, player, BlockPos.ZERO);
+            verify(portal, never()).getPortalDestination(any(), any(), any());
+            verify(player, never()).teleportToPortalDestination(any(), any());
+        }
+    }
+
+    @ParameterizedTest
+    @CsvSource({"false,true,false", "true,true,false", "false,false,false", "false,true,true"})
+    void sulfurCubeCollisionStopsOnCancellationOrOwnerLoss(boolean cancelled, boolean owner, boolean transferDuringEvent) throws Exception {
+        ServerLevel level = mock(ServerLevel.class);
+        SulfurCube cube = mock(SulfurCube.class, CALLS_REAL_METHODS);
+        Player player = mock(Player.class);
+        doReturn(level).when(cube).level();
+        when(player.level()).thenReturn(level);
+        doReturn(false).when(cube).isRemoved();
+        doReturn(true).when(cube).hasBodyItem();
+        doReturn(Vec3.ZERO).when(cube).position();
+        doReturn(0.0).when(cube).getY();
+        doReturn(1.0F).when(cube).getBbHeight();
+        doReturn(0.0).when(cube).getAttributeValue(any());
+        doReturn(false).when(cube).onGround();
+        doReturn(mock(CraftEntity.class)).when(cube).getBukkitEntity();
+        when(player.getBukkitEntity()).thenReturn(mock(CraftPlayer.class));
+        when(player.position()).thenReturn(new Vec3(0.1, 0, 0));
+        when(player.getBbHeight()).thenReturn(1.8F);
+        when(player.getKnownSpeed()).thenReturn(Vec3.ZERO);
+        doNothing().when(cube).addDeltaMovement(any());
+        set(SulfurCube.class, cube, "soundSettings", SulfurCubeArchetype.DEFAULT_SOUND_SETTINGS);
+        set(SulfurCube.class, cube, "contactDamages", List.of());
+        AtomicBoolean owns = new AtomicBoolean(owner);
+        HandlerList handlers = mock(HandlerList.class);
+        when(handlers.getRegisteredListeners()).thenReturn(new RegisteredListener[] {mock(RegisteredListener.class)});
+        Method push = SulfurCube.class.getDeclaredMethod("playerPush", Player.class);
+        push.setAccessible(true);
+        try (var threads = mockStatic(TickThread.class);
+             var events = mockStatic(EntityCollideWithEntityEvent.class);
+             var collisions = mockConstruction(EntityCollideWithEntityEvent.class, (event, context) -> {
+                 when(event.callEvent()).thenAnswer(ignored -> {
+                     if (transferDuringEvent) owns.set(false);
+                     return !cancelled;
+                 });
+             })) {
+            threads.when(() -> TickThread.isTickThreadFor(any(Entity.class))).thenAnswer(ignored -> owns.get());
+            events.when(EntityCollideWithEntityEvent::getHandlerList).thenReturn(handlers);
+            push.invoke(cube, player);
+            verify(cube, times(owner && !cancelled && !transferDuringEvent ? 1 : 0)).addDeltaMovement(any());
+            assertEquals(owner ? 1 : 0, collisions.constructed().size());
+        }
+    }
+}

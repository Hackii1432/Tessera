diff --git a/dev/tessera/x/RegionRecalculation.java b/dev/tessera/x/RegionRecalculation.java
new file mode 100644
index 0000000000000000000000000000000000000000..555d58b3387fe35529ffd3679cd831c6fa8071e8
--- /dev/null
+++ b/dev/tessera/x/RegionRecalculation.java
@@ -0,0 +1,45 @@
+package dev.tessera.x;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+
+/** Experimental cleanup deadline. Does not change connectivity or ownership rules. */
+public final class RegionRecalculation {
+    private static final long DELAY_MS = Math.max(0L, Math.min(60_000L,
+        Long.getLong("tessera-x.region-recalc-max-delay-ms", 0L)));
+    // Avoid a breadth-first search on every release during continuous chunk churn.
+    public static final long MAX_DELAY_NANOS = DELAY_MS == 0L ? 0L : Math.max(100L, DELAY_MS) * 1_000_000L;
+    private static final LongAdder passes = new LongAdder();
+    private static final LongAdder deadlinePasses = new LongAdder();
+    private static final LongAdder splitPasses = new LongAdder();
+    private static final LongAdder examinedSections = new LongAdder();
+    private static final LongAdder removedSections = new LongAdder();
+    private static final LongAdder analysisNanos = new LongAdder();
+    private static final AtomicLong maxAnalysisNanos = new AtomicLong();
+
+    private RegionRecalculation() {}
+
+    public static void record(final long start, final int examined, final int removed,
+                              final int components, final boolean deadline) {
+        if (MAX_DELAY_NANOS == 0L) {
+            return;
+        }
+        final long elapsed = System.nanoTime() - start;
+        passes.increment();
+        if (deadline) deadlinePasses.increment();
+        if (components > 1) splitPasses.increment();
+        examinedSections.add(examined);
+        removedSections.add(removed);
+        analysisNanos.add(elapsed);
+        maxAnalysisNanos.accumulateAndGet(elapsed, Math::max);
+    }
+
+    /** Process-wide diagnostic counters; no world or entity state is exposed. */
+    public static Map<String, Long> diagnostics() {
+        return Map.of("maxDelayNanos", MAX_DELAY_NANOS, "passes", passes.sum(),
+            "deadlinePasses", deadlinePasses.sum(), "splitPasses", splitPasses.sum(),
+            "examinedSections", examinedSections.sum(), "removedSections", removedSections.sum(),
+            "analysisNanos", analysisNanos.sum(), "maxAnalysisNanos", maxAnalysisNanos.get());
+    }
+}

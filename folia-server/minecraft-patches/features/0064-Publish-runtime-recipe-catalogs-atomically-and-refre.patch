+    // Tessera - immutable shared catalogs, mutable per-player state only on its current owner.
+    // Internal tasks follow transfers and run during tick freeze; no plugin task is used.
+    private void tessera$runOnPlayerOwner(final ServerPlayer player, final java.util.function.Consumer<ServerPlayer> action) {
+        player.getBukkitEntity().taskScheduler.scheduleRestore(entity -> {
+            final ServerPlayer current = (ServerPlayer)entity;
+            if (!current.hasDisconnected()) action.accept(current);
+            return java.util.concurrent.CompletableFuture.completedFuture(null);
+        }).whenComplete((ignored, failure) -> {
+            if (failure != null) LOGGER.debug("Player resource update skipped after owner retirement or failure", failure);
+        });
+    }
 }

@@ -169,26 +175,48 @@ public class EntitySelector {
 
             Predicate<Entity> predicate = this.getPredicate(pos, absoluteAabb, sender.enabledFeatures());
             List<Entity> result = new ObjectArrayList<>();
-            if (this.isWorldLimited()) {
-                this.addEntities(result, sender.getLevel(), absoluteAabb, predicate);
-            } else {
-                for (ServerLevel level : sender.getServer().getAllLevels()) {
-                    this.addEntities(result, level, absoluteAabb, predicate);
+            try {
+                if (this.isWorldLimited()) {
+                    this.addEntities(result, sender.getLevel(), absoluteAabb, predicate);
+                } else {
+                    for (ServerLevel level : sender.getServer().getAllLevels()) {
+                        this.addEntities(result, level, absoluteAabb, predicate);
+                    }
                 }
+            } catch (final CommandSyntaxException failure) {
+                // Brigadier suppresses exceptions raised by forked execute conditions. Send the
+                // actionable region-safety error before rethrowing so console and RCON still see it.
+                if (failure.getType() == ERROR_CROSS_REGION_QUERY) {
+                    sender.sendFailure(ComponentUtils.fromMessage(failure.getRawMessage()));
+                }
+                throw failure;
             }
 
             return this.sortAndLimit(pos, result);

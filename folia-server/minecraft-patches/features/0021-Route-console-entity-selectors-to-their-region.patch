+    private CompletableFuture<Void> tessera$scheduleRegionCommand(
+        final ParseResults<CommandSourceStack> command,
+        final String commandString,
+        final boolean throwCommandError,
+        final CommandSourceStack sender,
+        final CommandSourceStack target
+    ) {
+        final ServerLevel level = target.getLevel();
+        final int chunkX = net.minecraft.util.Mth.floor(target.getPosition().x()) >> 4;
+        final int chunkZ = net.minecraft.util.Mth.floor(target.getPosition().z()) >> 4;
+        if (level.regioniser.getRegionAtSynchronised(chunkX, chunkZ) == null) {
+            sender.sendFailure(Component.literal(
+                "Cannot run a region-bound entity selector: target region "
+                    + level.dimension().identifier() + " [" + chunkX + ", " + chunkZ + "] is not loaded"
+            ));
+            return CompletableFuture.completedFuture(null);
+        }
+
+        final CompletableFuture<Void> completion = new CompletableFuture<>();
+        final ca.spottedleaf.concurrentutil.executor.PrioritisedExecutor.PrioritisedTask task =
+            io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.createTickTaskQueue(
+                level,
+                chunkX,
+                chunkZ,
+                () -> {
+                    try {
+                        this.performCommand(command, commandString, throwCommandError);
+                        completion.complete(null);
+                    } catch (final Throwable throwable) {
+                        completion.completeExceptionally(throwable);
+                    }
+                }
+            );
+        if (!task.queue()) {
+            sender.sendFailure(Component.literal(
+                "Cannot run a region-bound entity selector: target region "
+                    + level.dimension().identifier() + " [" + chunkX + ", " + chunkZ + "] is no longer available"
+            ));
+            completion.complete(null);
+        }
+        return completion;
+    }
+
+    private static @Nullable CommandSourceStack tessera$findRegionTarget(
+        final ContextChain<CommandSourceStack> command,
+        final CommandSourceStack sender
+    ) {
+        if ((sender.source != sender.getServer()
+            && !(sender.source instanceof net.minecraft.server.rcon.RconConsoleSource))
+            || !tessera$containsEntityArgument(command)) {
+            return null;
+        }
+
+        ContextChain<CommandSourceStack> stage = command;
+        CommandSourceStack target = sender;
+        boolean explicitDimension = false;
+        try {
+            while (true) {
+                final com.mojang.brigadier.context.CommandContext<CommandSourceStack> context = stage.getTopContext();
+                if (tessera$hasArgumentType(context, EntityArgument.class)) {
+                    break;
+                }
+                if (tessera$hasArgumentType(context, DimensionArgument.class)) {
+                    target = target.withLevel(DimensionArgument.getDimension(context.copyFor(target), "dimension"));
+                    explicitDimension = true;
+                } else if (tessera$hasNode(context, "positioned")
+                    && tessera$hasArgumentType(context, Vec3Argument.class)) {
+                    target = target.withPosition(Vec3Argument.getVec3(context.copyFor(target), "pos"));
+                }
+
+                if (stage.getStage() == ContextChain.Stage.EXECUTE) {
+                    break;
+                }
+                stage = stage.nextStage();
+            }
+        } catch (final CommandSyntaxException | IllegalArgumentException ignored) {
+            // Let normal command execution report invalid dimensions/coordinates.
+            return null;
+        }
+        return explicitDimension ? target : null;
+    }
+
+    private static boolean tessera$containsEntityArgument(final ContextChain<CommandSourceStack> command) {
+        ContextChain<CommandSourceStack> stage = command;
+        while (true) {
+            if (tessera$hasArgumentType(stage.getTopContext(), EntityArgument.class)) {
+                return true;
+            }
+            if (stage.getStage() == ContextChain.Stage.EXECUTE) {
+                return false;
+            }
+            stage = stage.nextStage();
+        }
+    }
+
+    private static boolean tessera$hasNode(
+        final com.mojang.brigadier.context.CommandContext<CommandSourceStack> context,
+        final String name
+    ) {
+        return context.getNodes().stream().anyMatch(node -> node.getNode().getName().equals(name));
+    }
+
+    private static boolean tessera$hasArgumentType(
+        final com.mojang.brigadier.context.CommandContext<CommandSourceStack> context,
+        final Class<? extends ArgumentType<?>> type
+    ) {
+        return context.getNodes().stream().anyMatch(node ->
+            node.getNode() instanceof ArgumentCommandNode<?, ?> argument && type.isInstance(argument.getType())
+        );
+    }
+    // Tessera end - route spatial console entity selectors to their region

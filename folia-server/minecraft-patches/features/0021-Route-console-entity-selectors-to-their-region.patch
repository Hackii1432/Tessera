-    private void addEntities(final List<Entity> result, final ServerLevel level, final @Nullable AABB absoluteAABB, final Predicate<Entity> predicate) {
+    private void addEntities(
+        final List<Entity> result,
+        final ServerLevel level,
+        final @Nullable AABB absoluteAABB,
+        final Predicate<Entity> predicate
+    ) throws CommandSyntaxException {
         int limit = this.getResultLimit();
         if (result.size() < limit) {
+            // Tessera start - reject unsafe cross-region entity selectors cleanly
             if (absoluteAABB != null) {
+                if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(level, absoluteAABB)) {
+                    throw ERROR_CROSS_REGION_QUERY.create();
+                }
                 level.getEntities(this.type, absoluteAABB, predicate, result, limit);
             } else {
+                // The unbounded ServerLevel lookup is backed by Moonrise's concurrent
+                // entity index. Commands such as kill schedule mutations on each
+                // selected entity's owning region.
                 level.getEntities(this.type, predicate, result, limit);
             }
+            // Tessera end - reject unsafe cross-region entity selectors cleanly
         }
     }
 

diff --git a/net/minecraft/world/entity/EntityReference.java b/net/minecraft/world/entity/EntityReference.java
index 55a80fbb0a57ce6b930effcf421e48191f233309..11c57e5a00177b8360b13b2221579987d8378bb9 100644
--- a/net/minecraft/world/entity/EntityReference.java
+++ b/net/minecraft/world/entity/EntityReference.java
@@ -113,6 +113,20 @@ public final class EntityReference<StoredEntityType extends Entity> { // Folia -
         return get(reference, level, LivingEntity.class);
     }
 
+    // Tessera - owner-sensitive AI must check admission BEFORE even reading cached lifecycle state.
+    // This does not alter general reference resolution (pearls, persistence and transfers keep their contracts).
+    public static @Nullable LivingEntity tessera$getOwnedLivingEntity(final @Nullable EntityReference<LivingEntity> reference, final Level level) {
+        if (reference == null) return null;
+        final org.bukkit.craftbukkit.entity.CraftEntity cached = reference.entity.right().orElse(null);
+        if (cached != null) {
+            final Entity candidate = cached.getHandleRaw();
+            if (candidate instanceof LivingEntity living && Entity.tessera$isOwnedEntity(living, level)) return living;
+        }
+        // UUID lookup reads the concurrent entity index, not chunks or a foreign entity's mutable state.
+        final Entity candidate = level.getEntity(reference.getUUID());
+        return candidate instanceof LivingEntity living && Entity.tessera$isOwnedEntity(living, level) ? living : null;
+    }
+
     public static @Nullable Player getPlayer(final @Nullable EntityReference<Player> reference, final Level level) {
         return get(reference, level, Player.class);
     }

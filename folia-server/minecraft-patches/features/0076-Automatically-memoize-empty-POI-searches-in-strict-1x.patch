+    static BehaviorControl<PathfinderMob> createForShop(
+        final Predicate<Holder<PoiType>> poiType, final MemoryModuleType<GlobalPos> memoryToAcquire,
+        final boolean onlyIfAdult, final Optional<Byte> onPoiAcquisitionEvent,
+        final BiPredicate<ServerLevel, BlockPos> validPoi
+    ) {
+        return createInternal(poiType, memoryToAcquire, memoryToAcquire, onlyIfAdult, onPoiAcquisitionEvent, validPoi, true);
+    }
+

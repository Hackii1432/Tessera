diff --git a/dev/tessera/x/ExperimentalOptions.java b/dev/tessera/x/ExperimentalOptions.java
new file mode 100644
index 0000000000000000000000000000000000000000..d1b992febdc6353a2f5b779a4994c8de991cb740
--- /dev/null
+++ b/dev/tessera/x/ExperimentalOptions.java
@@ -0,0 +1,134 @@
+package dev.tessera.x;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.EnumSet;
+import java.util.Properties;
+import java.util.Set;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+/** Immutable startup configuration. Feature classes retain their constant hot-path switches. */
+public final class ExperimentalOptions {
+    private static final Logger LOGGER = LoggerFactory.getLogger("Tessera-X");
+    public enum Feature {
+        SENSOR_SORTING("sensor-sorting", "sensors", "Experimental distance sorting. Enable adaptive preparation and reuse when testing workers."),
+        SENSOR_ADAPTIVE("sensor-adaptive", "sensor-adaptive", "Avoid unused or repeatedly discarded speculative sensor jobs."),
+        SENSOR_REUSE("sensor-reuse", "sensor-reuse", "Reuse bounded primitive sensor sorting buffers."),
+        VERIFY_SENSORS("verify-sensors", "verify-sensors", "Diagnostic native sorting oracle; adds work and allocations."),
+        REGION_RECALCULATION("region-recalculation", null, "Clean aged dead sections at a safe region release. Does not expire active tickets."),
+        REGION_COVERED_SEARCH("region-covered-search", "region-covered-search", "Avoid repeated coordinate probes in large region connectivity searches."),
+        BRAIN_SCRATCH("brain-scratch", "brain-scratch", "Experimental running-behavior snapshot reuse; no general AI speed gain established."),
+        SENSOR_LOCAL_CONDITIONS("sensor-local-conditions", "sensor-local-conditions", "Fix targeting ranges shared between sensor callers and region threads."),
+        POI_SCRATCH("poi-scratch", "poi-scratch", "Reuse bounded primitive POI search buffers; queries and reservations remain fresh."),
+        POI_RESERVATION_CHECK("poi-reservation-check", "poi-reservation-check", "Save acquired POI memory only after the final reservation succeeds."),
+        WORK_TIMINGS("work-timings", "work-timings", "Process-wide inclusive diagnostics. Enable only while investigating workload.");
+
+        public final String key;
+        final String legacyProperty;
+        final String description;
+        Feature(String key, String legacySuffix, String description) {
+            this.key = key;
+            this.legacyProperty = legacySuffix == null ? null : "tessera-x." + legacySuffix;
+            this.description = description;
+        }
+    }
+    public record Settings(boolean enabled, Set<Feature> selected, int workers, int delayMillis) {
+        public Settings { selected = Set.copyOf(selected); }
+        public boolean isEnabled(Feature feature) { return enabled && selected.contains(feature); }
+        public long effectiveDelayMillis() { return isEnabled(Feature.REGION_RECALCULATION) ? delayMillis : 0L; }
+    }
+    private static Settings settings = legacyDefaults(System.getProperties());
+    private static boolean accessed;
+    private static boolean initialized;
+    private ExperimentalOptions() {}
+
+    public static synchronized Settings current() {
+        accessed = true;
+        return settings;
+    }
+    public static boolean enabled(Feature feature) { return current().isEnabled(feature); }
+    public static int sensorWorkers() { Settings value = current(); return value.enabled() ? value.workers() : 0; }
+    public static long regionRecalcMaxDelayMillis() { return current().effectiveDelayMillis(); }
+
+    /** Must run before bootstrap, plugin initialization and any experimental feature class. No live reload. */
+    public static synchronized void initialize(Path path) throws IOException {
+        if (initialized || accessed) throw new IllegalStateException("Tessera-X options must load before feature initialization; restart required");
+        Settings loaded = load(path, settings);
+        settings = loaded;
+        initialized = true;
+        LOGGER.info("Experimental options loaded from {} (restart required after changes): enabled={}, active={}",
+            path.toAbsolutePath().normalize(), loaded.enabled(),
+            java.util.Arrays.stream(Feature.values()).filter(loaded::isEnabled).map(feature -> feature.key).toList());
+    }
+
+    // Package-private for isolated config regression tests. Loading does not publish or reload settings.
+    static Settings legacyDefaults(Properties properties) {
+        Set<Feature> selected = EnumSet.noneOf(Feature.class);
+        for (Feature feature : Feature.values()) {
+            if (feature.legacyProperty != null && Boolean.parseBoolean(properties.getProperty(feature.legacyProperty))) selected.add(feature);
+        }
+        long delay = legacyLong(properties, "tessera-x.region-recalc-max-delay-ms", 0L);
+        delay = Math.clamp(delay, 0L, 60_000L);
+        if (delay > 0L) selected.add(Feature.REGION_RECALCULATION);
+        int workers;
+        try { workers = Integer.decode(properties.getProperty("tessera-x.sensor-workers")); }
+        catch (NumberFormatException | NullPointerException invalid) { workers = 4; }
+        workers = Math.clamp(workers, 0, 8);
+        return new Settings(true, selected, workers, delay > 0L ? (int)Math.max(100L, delay) : 1000);
+    }
+    private static long legacyLong(Properties properties, String key, long fallback) {
+        try { return Long.decode(properties.getProperty(key)); }
+        catch (NumberFormatException | NullPointerException invalid) { return fallback; }
+    }
+
+    static Settings load(Path path, Settings defaults) throws IOException {
+        YamlConfigurationLoader loader = YamlConfigurationLoader.builder().path(path)
+            .defaultOptions(options -> options.header("Tessera-X experimental options. All changes require a full server restart.\n"
+                + "The enabled switch permits selected features; false disables every experiment.\n"
+                + "Explicit YAML values override legacy -Dtessera-x.* properties. Missing values inherit startup defaults.\n"
+                + "Fresh installs without legacy properties have every individual feature disabled."))
+            .build();
+        CommentedConfigurationNode root = loader.load();
+        if (root.raw() != null && !root.isMap()) throw new IOException("Tessera-X configuration root must be a mapping: " + path);
+        Fill fill = new Fill();
+        integer(root, "_version", 1, 1, 1, "Configuration format version.", fill);
+        CommentedConfigurationNode options = root.node("experimental-options");
+        if (options.raw() != null && !options.isMap()) throw new IOException("experimental-options must be a mapping: " + path);
+        boolean enabled = bool(options, "enabled", defaults.enabled(), "Master switch: false disables every experimental feature, including legacy JVM flags.", fill);
+        Set<Feature> selected = EnumSet.noneOf(Feature.class);
+        for (Feature feature : Feature.values()) {
+            if (bool(options, feature.key, defaults.selected().contains(feature), feature.description, fill)) selected.add(feature);
+        }
+        int workers = integer(options, "sensor-workers", defaults.workers(), 0, 8, "Compute workers, 0..8. A pool exists only when sensor-sorting is enabled.", fill);
+        int delay = integer(options, "region-recalc-max-delay-ms", defaults.delayMillis(), 100, 60_000,
+            "Maximum age of dead-section batches, 100..60000 ms; used only with region-recalculation enabled.", fill);
+        Settings result = new Settings(enabled, selected, workers, delay);
+        if (fill.changed) {
+            Path parent = path.toAbsolutePath().getParent();
+            if (parent != null) Files.createDirectories(parent);
+            loader.save(root); // Validate the entire document before writing defaults. Unknown entries are preserved.
+        }
+        return result;
+    }
+    private static final class Fill { boolean changed; }
+    private static Object value(CommentedConfigurationNode parent, String key, Object fallback, String comment, Fill fill) throws IOException {
+        CommentedConfigurationNode node = parent.node(key);
+        if (node.virtual()) { node.set(fallback); node.comment(comment); fill.changed = true; }
+        return node.raw();
+    }
+    private static boolean bool(CommentedConfigurationNode parent, String key, boolean fallback, String comment, Fill fill) throws IOException {
+        Object raw = value(parent, key, fallback, comment, fill);
+        if (!(raw instanceof Boolean flag)) throw new IOException("experimental-options." + key + " must be true or false");
+        return flag;
+    }
+    private static int integer(CommentedConfigurationNode parent, String key, int fallback, int min, int max, String comment, Fill fill) throws IOException {
+        Object raw = value(parent, key, fallback, comment, fill);
+        if (!(raw instanceof Integer || raw instanceof Long) || ((Number)raw).longValue() < min || ((Number)raw).longValue() > max)
+            throw new IOException(key + " must be an integer in " + min + ".." + max);
+        return ((Number)raw).intValue();
+    }
+}

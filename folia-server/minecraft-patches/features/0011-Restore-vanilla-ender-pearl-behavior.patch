+    // Tessera start - restore vanilla ender pearl ownership
+    private void tessera$scheduleLoadedEnderPearl(final ServerLevel pearlLevel, final ThrownEnderpearl enderPearl) {
+        Runnable queueSpawn = () -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueOrExecuteTickTask(
+            pearlLevel,
+            enderPearl.chunkPosition().x(),
+            enderPearl.chunkPosition().z(),
+            () -> this.tessera$addLoadedEnderPearl(pearlLevel, enderPearl)
+        );
+        if (!ThrownEnderpearl.tessera$afterPendingOwnerUnload(enderPearl.getUUID(), queueSpawn)) {
+            queueSpawn.run();
+        }
+    }
+
+    private void tessera$addLoadedEnderPearl(final ServerLevel pearlLevel, final ThrownEnderpearl enderPearl) {
+        if (pearlLevel.tryAddFreshEntityWithPassengers(enderPearl) && enderPearl.valid) {
+            enderPearl.tessera$restoreOwnerRegistration();
+            ServerPlayer.placeEnderPearlTicket(pearlLevel, enderPearl.chunkPosition());
+            return;
+        }
+
+        enderPearl.tessera$detachFailedOwnerLoad();
+        if (ThrownEnderpearl.tessera$afterPendingOwnerUnload(
+            enderPearl.getUUID(),
+            () -> this.tessera$scheduleLoadedEnderPearl(pearlLevel, enderPearl)
+        )) {
+            return;
+        }
+
+        Entity existing = pearlLevel.getEntity(enderPearl.getUUID());
+        if (existing instanceof ThrownEnderpearl existingEnderPearl) {
+            // The saved player copy raced an already-active world copy. Keep
+            // exactly one entity and reconnect that copy to the current player.
+            existingEnderPearl.tessera$restoreOwnerRegistration();
+            LOGGER.debug("Reused already-loaded player ender pearl {}", enderPearl.getUUID());
+        } else {
+            LOGGER.warn("Unable to restore player ender pearl {} because its entity UUID is already in use", enderPearl.getUUID());
+        }
+    }
+    // Tessera end - restore vanilla ender pearl ownership

+    // Tessera start - restore vanilla ender pearl ownership
+    private void tessera$updateOwnerSaveData() {
+        if (!(this.level() instanceof ServerLevel serverLevel)
+            || serverLevel.paperConfig().misc.legacyEnderPearlBehavior
+            || this.isRemoved()) {
+            this.tessera$ownerSaveData = null;
+            return;
+        }
+
+        TagValueOutput output = TagValueOutput.createWithContext(net.minecraft.util.ProblemReporter.DISCARDING, this.registryAccess());
+        if (this.save(output)) {
+            output.store("ender_pearl_dimension", Level.RESOURCE_KEY_CODEC, serverLevel.dimension());
+            this.tessera$ownerSaveData = output.buildResult();
+        }
+    }
+
+    public @Nullable CompoundTag tessera$getOwnerSaveData() {
+        if (this.tessera$ownerSaveData == null && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            this.tessera$updateOwnerSaveData();
+        }
+
+        CompoundTag snapshot = this.tessera$ownerSaveData;
+        return snapshot == null ? null : snapshot.copy();
+    }
+
+    public void tessera$unloadWithOwner() {
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            this.getBukkitEntity().taskScheduler.schedule(
+                entity -> ((ThrownEnderpearl)entity).tessera$unloadWithOwner(),
+                null,
+                1L
+            );
+            return;
+        }
+
+        if (!this.level().paperConfig().misc.legacyEnderPearlBehavior && !this.isRemoved()) {
+            this.setRemoved(
+                Entity.RemovalReason.UNLOADED_WITH_PLAYER,
+                org.bukkit.event.entity.EntityRemoveEvent.Cause.PLAYER_QUIT
+            );
+        }
+    }
+
+    @Override
+    protected void readAdditionalSaveData(final ValueInput input) {
+        super.readAdditionalSaveData(input);
+        this.tessera$updateOwnerSaveData();
+    }
+
+    @Override
+    public void shoot(final double xd, final double yd, final double zd, final float pow, final float uncertainty) {
+        super.shoot(xd, yd, zd, pow, uncertainty);
+        this.tessera$updateOwnerSaveData();
+    }
+    // Tessera end - restore vanilla ender pearl ownership
+
     @Override
     protected void onHitEntity(final EntityHitResult hitResult) {
         super.onHitEntity(hitResult);

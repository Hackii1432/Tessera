+    // Tessera start - restore vanilla ender pearl ownership
+    private @Nullable ServerPlayer tessera$getPlayerOwnerIncludingTransitions() {
+        if (this.owner != null
+            && this.level() instanceof ServerLevel serverLevel
+            && findOwnerIncludingDeadPlayer(serverLevel, this.owner.getUUID()) instanceof ServerPlayer serverPlayer) {
+            return serverPlayer;
+        }
+
+        return null;
+    }
+
+    private void tessera$updateOwnerSaveData() {
+        if (!(this.level() instanceof ServerLevel serverLevel)
+            || serverLevel.paperConfig().misc.legacyEnderPearlBehavior
+            || this.isRemoved()) {
+            this.tessera$ownerSaveData = null;
+            return;
+        }
+
+        TagValueOutput output = TagValueOutput.createWithContext(net.minecraft.util.ProblemReporter.DISCARDING, this.registryAccess());
+        if (this.save(output)) {
+            output.store("ender_pearl_dimension", Level.RESOURCE_KEY_CODEC, serverLevel.dimension());
+            this.tessera$ownerSaveData = output.buildResult();
+        }
+    }
+
+    public @Nullable CompoundTag tessera$getOwnerSaveData() {
+        if (this.tessera$ownerSaveData == null && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            this.tessera$updateOwnerSaveData();
+        }
+
+        CompoundTag snapshot = this.tessera$ownerSaveData;
+        return snapshot == null ? null : snapshot.copy();
+    }
+
+    public static boolean tessera$afterPendingOwnerUnload(final UUID pearlUuid, final Runnable task) {
+        CompletableFuture<Void> pendingUnload = TESSERA_PENDING_OWNER_UNLOADS.get(pearlUuid);
+        if (pendingUnload == null) {
+            return false;
+        }
+
+        // Do not run chunk-ticket work inline from an EntityScheduler retired
+        // callback. Such callbacks execute inside critical scheduler cleanup.
+        pendingUnload.whenCompleteAsync((ignored, throwable) -> task.run());
+        return true;
+    }
+
+    public void tessera$restoreOwnerRegistration() {
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            this.getBukkitEntity().taskScheduler.schedule(
+                entity -> ((ThrownEnderpearl)entity).tessera$restoreOwnerRegistration(),
+                null,
+                1L
+            );
+            return;
+        }
+
+        if (!this.isRemoved()) {
+            this.registerToCurrentOwner();
+        }
+    }
+
+    public void tessera$detachFailedOwnerLoad() {
+        this.deregisterFromCurrentOwner();
+        this.tessera$ownerSaveData = null;
+    }
+
+    public void tessera$unloadWithOwner() {
+        CompletableFuture<Void> pendingUnload = TESSERA_PENDING_OWNER_UNLOADS.computeIfAbsent(
+            this.getUUID(),
+            ignored -> new CompletableFuture<>()
+        );
+
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            boolean scheduled = this.getBukkitEntity().taskScheduler.schedule(
+                entity -> ((ThrownEnderpearl)entity).tessera$unloadWithOwner(),
+                entity -> ((ThrownEnderpearl)entity).tessera$completeOwnerUnload(pendingUnload),
+                1L
+            );
+            if (!scheduled) {
+                this.tessera$completeOwnerUnload(pendingUnload);
+            }
+            return;
+        }
+
+        try {
+            if (!this.level().paperConfig().misc.legacyEnderPearlBehavior && !this.isRemoved()) {
+                this.setRemoved(
+                    Entity.RemovalReason.UNLOADED_WITH_PLAYER,
+                    org.bukkit.event.entity.EntityRemoveEvent.Cause.PLAYER_QUIT
+                );
+            }
+        } finally {
+            this.tessera$completeOwnerUnload(pendingUnload);
+        }
+    }
+
+    private void tessera$completeOwnerUnload(final CompletableFuture<Void> pendingUnload) {
+        if (TESSERA_PENDING_OWNER_UNLOADS.remove(this.getUUID(), pendingUnload)) {
+            pendingUnload.complete(null);
+        }
+    }
+
+    @Override
+    protected void readAdditionalSaveData(final ValueInput input) {
+        super.readAdditionalSaveData(input);
+        this.tessera$updateOwnerSaveData();
+    }

--- /dev/null
+++ b/io/papermc/paper/threadedregions/commands/RegionHealthView.java
@@ -0,0 +1,293 @@
+package io.papermc.paper.threadedregions.commands;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.TextComponent;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.Style;
+import net.kyori.adventure.text.format.TextDecoration;
+import org.jspecify.annotations.Nullable;
+
+/** Tessera - presentation only. Measurements and player filtering come from the server snapshot. */
+final class RegionHealthView {
+    private static final String COMMAND = "/paper:tps";
+    private final RegionHealthSnapshot snapshot;
+
+    RegionHealthView(final RegionHealthSnapshot snapshot) {
+        this.snapshot = snapshot;
+    }
+
+    /** Bound each chat packet, including very long player lists; preserve inherited click/hover styles. */
+    static List<Component> lines(final Component output) {
+        final Lines lines = new Lines();
+        lines.append(output, Style.empty());
+        lines.result.add(lines.current.build());
+        return List.copyOf(lines.result);
+    }
+
+    private static final class Lines {
+        private final List<Component> result = new ArrayList<>();
+        private TextComponent.Builder current = Component.text();
+        private int length;
+
+        private void next() {
+            this.result.add(this.current.build());
+            this.current = Component.text();
+            this.length = 0;
+        }
+
+        private void append(final Component component, final Style parent) {
+            final Style style = component.style().merge(parent, Style.Merge.Strategy.IF_ABSENT_ON_TARGET);
+            // All presentation components in this view are literal text.
+            if (component instanceof TextComponent text) {
+                final String[] parts = text.content().split("\n", -1);
+                for (int i = 0; i < parts.length; ++i) {
+                    if (i != 0) {
+                        this.next();
+                    }
+                    for (int start = 0; start < parts[i].length();) {
+                        if (this.length == 512) {
+                            this.next();
+                        }
+                        final int end = Math.min(parts[i].length(), start + 512 - this.length);
+                        this.current.append(Component.text(parts[i].substring(start, end)).style(style));
+                        this.length += end - start;
+                        start = end;
+                    }
+                }
+            }
+            for (final Component child : component.children()) {
+                this.append(child, style);
+            }
+        }
+    }
+
+    enum Status {
+        OK(NamedTextColor.GREEN), BUSY(NamedTextColor.YELLOW), LAG(NamedTextColor.RED),
+        PAUSED(NamedTextColor.AQUA), SPRINT(NamedTextColor.AQUA), NO_DATA(NamedTextColor.GRAY);
+        final NamedTextColor colour;
+
+        Status(final NamedTextColor colour) {
+            this.colour = colour;
+        }
+
+        Component label() {
+            return Component.text("[" + name().replace('_', ' ') + "] ", this.colour, TextDecoration.BOLD);
+        }
+    }
+
+    static Status status(final RegionHealthSnapshot.@Nullable Metrics metrics, final RegionHealthSnapshot.TickMode mode) {
+        if (mode.frozen()) {
+            return Status.PAUSED;
+        }
+        if (mode.sprinting()) {
+            return Status.SPRINT;
+        }
+        if (metrics == null || !metrics.valid() || !Double.isFinite(mode.target()) || mode.target() <= 0.0) {
+            return Status.NO_DATA;
+        }
+        if (metrics.tps() < mode.target() * 0.95) {
+            return Status.LAG;
+        }
+        return metrics.mspt() >= (1000.0 / mode.target()) * 0.75 || metrics.utilisation() >= 0.85 ? Status.BUSY : Status.OK;
+    }
+
+    private static String number(final double value) {
+        return String.format(Locale.ROOT, "%.2f", value);
+    }
+
+    private static Component text(final String text) {
+        return Component.text(text, NamedTextColor.WHITE).decoration(TextDecoration.BOLD, false);
+    }
+
+    private static Component hint(final String text) {
+        return Component.text(text, NamedTextColor.GRAY).decoration(TextDecoration.BOLD, false);
+    }
+
+    private static Component action(final String label, final String arguments) {
+        return Component.text("[" + label + "]", NamedTextColor.AQUA)
+            .clickEvent(ClickEvent.runCommand(COMMAND + arguments))
+            .hoverEvent(hint("Open view – no teleport"));
+    }
+
+    private static Component footer() {
+        return Component.newline().append(action("My region", " region")).append(hint(" "))
+            .append(Component.text("[Find player]", NamedTextColor.AQUA)
+                .clickEvent(ClickEvent.suggestCommand(COMMAND + " player ")))
+            .append(hint(" ")).append(action("Overview", " list")).append(hint(" "))
+            .append(action("All details", " all"));
+    }
+
+    private Component heading(final String title) {
+        return Component.text("Tessera · " + title, NamedTextColor.AQUA, TextDecoration.BOLD)
+            .append(Component.newline())
+            .append(hint("Target: " + number(snapshot.mode().target()) + " TPS"
+                + (snapshot.mode().frozen() ? " · Simulation frozen" : snapshot.mode().sprinting() ? " · Tick sprint active" : "")))
+            .append(Component.newline());
+    }
+
+    private Component values(final RegionHealthSnapshot.@Nullable Metrics metrics) {
+        if (metrics == null || !metrics.valid()) {
+            return hint("No measurements yet");
+        }
+        return text(number(metrics.tps()) + " TPS · " + number(metrics.mspt()) + " ms/tick");
+    }
+
+    private Component players(final RegionHealthSnapshot.Region region) {
+        final TextComponent.Builder out = Component.text();
+        out.append(hint(snapshot.viewer() == null ? "Players: " : "Visible players: "));
+        if (region.players().isEmpty()) {
+            out.append(hint("none"));
+        }
+        for (int i = 0; i < region.players().size(); ++i) {
+            final RegionHealthSnapshot.Person player = region.players().get(i);
+            if (i != 0) {
+                out.append(hint(", "));
+            }
+            out.append(Component.text(player.id().equals(snapshot.viewer()) ? player.name() + " (you)" : player.name(), NamedTextColor.WHITE)
+                .clickEvent(ClickEvent.runCommand(COMMAND + " player " + player.name()))
+                .hoverEvent(hint("Compare this player's region")));
+        }
+        return out.build();
+    }
+
+    private Component regionTitle(final RegionHealthSnapshot.Region region) {
+        final boolean own = region == snapshot.ownRegion();
+        return Component.text((own ? "▶ " : "") + "Region #" + region.id(), own ? NamedTextColor.AQUA : NamedTextColor.WHITE, TextDecoration.BOLD)
+            .clickEvent(ClickEvent.runCommand(COMMAND + " region " + region.id()))
+            .hoverEvent(hint("Details · " + region.chunks() + " chunks · " + region.entities() + " entities"))
+            .append(hint(" · " + region.world())).append(own ? Component.text(" · YOUR REGION", NamedTextColor.AQUA) : Component.empty());
+    }
+
+    private Component summary(final RegionHealthSnapshot.Region region) {
+        return regionTitle(region).append(Component.newline())
+            .append(status(region.recent(), snapshot.mode()).label()).append(values(region.recent()))
+            .append(hint(" · " + region.players().size() + (snapshot.viewer() == null ? " " : " visible ")
+                + (region.players().size() == 1 ? "player" : "players")))
+            .append(Component.newline()).append(players(region));
+    }
+
+    Component overview(final int limit) {
+        final TextComponent.Builder out = Component.text().append(heading("Your region & overview"));
+        final RegionHealthSnapshot.Region own = snapshot.ownRegion();
+        if (snapshot.viewer() != null) {
+            if (own == null) {
+                out.append(hint("Your region is not assigned right now (login/region transfer).")).append(Component.newline());
+            } else {
+                final Status state = status(own.recent(), snapshot.mode());
+                out.append(text(switch (state) {
+                    case OK -> "Your region is running normally.";
+                    case BUSY -> "Your region has little tick-time headroom.";
+                    case LAG -> "Your region is not keeping up with the target tick rate.";
+                    case PAUSED -> "The simulation is intentionally frozen.";
+                    case SPRINT -> "Tick sprint active – normal load assessment disabled.";
+                    case NO_DATA -> "No measurements are available for your region yet.";
+                })).append(Component.newline());
+            }
+        }
+        out.append(hint(snapshot.regions().size() + " regions · 15 s averages")).append(Component.newline());
+        int shown = 0;
+        for (final RegionHealthSnapshot.Region region : snapshot.orderedRegions()) {
+            if (shown++ >= limit) {
+                break;
+            }
+            out.append(Component.newline()).append(summary(region)).append(Component.newline());
+        }
+        if (snapshot.regions().isEmpty()) {
+            out.append(hint("No regions currently available.")).append(Component.newline());
+        } else if (snapshot.regions().size() > limit) {
+            out.append(hint("More regions: ")).append(action("Show all", " list")).append(Component.newline());
+        }
+        out.append(hint("Snapshot · Player assignments can change."))
+            .append(footer()).append(hint(" ")).append(action("Refresh", " list"));
+        return out.build();
+    }
+
+    private Component detailBlock(final RegionHealthSnapshot.Region region) {
+        final TextComponent.Builder out = Component.text().append(regionTitle(region)).append(Component.newline())
+            .append(players(region)).append(Component.newline())
+            .append(hint("Chunks: " + region.chunks() + " · entities: " + region.entities())).append(Component.newline());
+        out.append(status(region.recent(), snapshot.mode()).label()).append(hint("Region metrics, not individual player performance")).append(Component.newline());
+        for (final String window : RegionHealthSnapshot.WINDOWS) {
+            final RegionHealthSnapshot.Metrics metrics = region.history().get(window);
+            out.append(text(window + ": ")).append(values(metrics));
+            if (metrics != null && metrics.valid()) {
+                out.append(hint(" · Utilisation " + number(metrics.utilisation() * 100.0) + "%"))
+                    .append(Component.newline())
+                    .append(hint("  Tick time min/median/max: " + number(metrics.minMspt()) + " / " + number(metrics.medianMspt())
+                        + " / " + number(metrics.maxMspt()) + " ms · " + metrics.ticks() + " ticks"));
+            }
+            out.append(Component.newline());
+        }
+        out.append(action("Refresh region", " region " + region.id())).append(Component.newline());
+        return out.build();
+    }
+
+    Component details(final @Nullable Long id) {
+        final RegionHealthSnapshot.Region region = id == null ? snapshot.ownRegion() : snapshot.region(id);
+        if (region == null) {
+            return heading("Region").append(hint(id == null
+                ? "No current region assigned. Console users must specify a region ID."
+                : "This region no longer exists or its world was unloaded."))
+                .append(footer());
+        }
+        return heading("Region details").append(detailBlock(region))
+            .append(hint("Windows contain available samples only; utilisation is not CPU usage."))
+            .append(footer());
+    }
+
+    Component player(final String name) {
+        final RegionHealthSnapshot.Person target = snapshot.player(name);
+        if (target == null) {
+            // Identical response for hidden and offline players, without revealing a region.
+            return heading("Player lookup").append(hint("Player is offline or not visible.")).append(footer());
+        }
+        final RegionHealthSnapshot.Region targetRegion = snapshot.region(target.regionId());
+        if (targetRegion == null) {
+            return heading("Player lookup").append(text(target.name()))
+                .append(hint(": no region assignment currently available (login/region transfer)."))
+                .append(Component.newline()).append(action("Retry lookup", " player " + target.name())).append(footer());
+        }
+        final TextComponent.Builder out = Component.text().append(heading("Player comparison"))
+            .append(text(target.name() + ": ")).append(values(targetRegion.recent())).append(Component.newline());
+        final RegionHealthSnapshot.Region own = snapshot.ownRegion();
+        if (snapshot.viewer() != null && own != null) {
+            out.append(text("You: ")).append(values(own.recent())).append(Component.newline())
+                .append(Component.text(own.id() == targetRegion.id() ? "You are in the same region." : "You are in different regions.",
+                    own.id() == targetRegion.id() ? NamedTextColor.AQUA : NamedTextColor.YELLOW)).append(Component.newline());
+        } else if (snapshot.viewer() != null) {
+            out.append(hint("Your region assignment is unavailable; comparison is not possible.")).append(Component.newline());
+        }
+        out.append(hint("15 s averages · These values do not identify who causes load.")).append(Component.newline())
+            .append(detailBlock(targetRegion)).append(action("Refresh player", " player " + target.name())).append(footer());
+        return out.build();
+    }
+
+    Component all() {
+        final TextComponent.Builder out = Component.text().append(heading("All region details"))
+            .append(hint("Global tick: ")).append(values(snapshot.global())).append(Component.newline())
+            .append(hint("Tick threads: " + snapshot.threads() + " · Chunk load rate: " + number(snapshot.loadRate())
+                + "/s · Generation rate: " + number(snapshot.generationRate()) + "/s (server-wide)")).append(Component.newline());
+        for (final RegionHealthSnapshot.Region region : snapshot.orderedRegions()) {
+            out.append(Component.newline()).append(detailBlock(region));
+        }
+        if (snapshot.regions().isEmpty()) {
+            out.append(hint("No regions currently available.")).append(Component.newline());
+        }
+        return out.append(hint("Snapshot · Available samples only · Utilisation is not CPU usage."))
+            .append(footer()).build();
+    }
+
+    static Component help() {
+        return Component.text("Tessera · TPS help\n", NamedTextColor.AQUA, TextDecoration.BOLD)
+            .append(text("/tps – your region and all regions\n"
+                + "/tps player <name> or /tps <name> – compare players\n"
+                + "/tps region [ID] – your region or a selected region\n"
+                + "/tps list – overview\n/tps all – all region details\n"
+                + "/tps server [count] – overview, optionally limited"))
+            .append(footer());
+    }
+}

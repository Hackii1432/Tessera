+/** Tessera - immutable, viewer-filtered copies of existing measurements. No sampling tasks. */
+record RegionHealthSnapshot(List<Region> regions, List<Person> players, @Nullable UUID viewer,
+                            TickMode mode, @Nullable Metrics global, int threads,
+                            double loadRate, double generationRate) {
+    static final List<String> WINDOWS = List.of("5 s", "15 s", "1 min", "5 min", "15 min");
+
+    RegionHealthSnapshot {
+        regions = List.copyOf(regions);
+        players = List.copyOf(players);
+    }
+
+    record Metrics(double tps, double mspt, double utilisation, double minMspt, double medianMspt,
+                   double maxMspt, long ticks) {
+        static @Nullable Metrics from(final TickData.@Nullable TickReportData report) {
+            if (report == null || report.collectedTicks() <= 0L) {
+                return null;
+            }
+            final var times = report.timePerTickData().segmentAll();
+            final Metrics result = new Metrics(report.tpsData().segmentAll().average(), times.average() / 1.0E6,
+                report.utilisation(), times.least() / 1.0E6, times.median() / 1.0E6, times.greatest() / 1.0E6,
+                report.collectedTicks());
+            return result.valid() ? result : null;
+        }
+
+        boolean valid() {
+            return ticks > 0L && Double.isFinite(tps) && tps >= 0.0 && Double.isFinite(mspt) && mspt >= 0.0
+                && Double.isFinite(utilisation) && utilisation >= 0.0 && Double.isFinite(minMspt)
+                && Double.isFinite(medianMspt) && Double.isFinite(maxMspt);
+        }
+    }
+
+    record TickMode(double target, boolean frozen, boolean sprinting) {}
+    record Person(UUID id, String name, @Nullable Long regionId) {}
+    record Region(long id, String world, int chunks, int entities, List<Person> players, Map<String, Metrics> history) {
+        Region {
+            players = List.copyOf(players);
+            history = Map.copyOf(history);
+        }
+
+        @Nullable Metrics recent() {
+            return history.get("15 s");
+        }
+    }
+
+    @Nullable Region region(final @Nullable Long id) {
+        return id == null ? null : regions.stream().filter(region -> region.id() == id).findFirst().orElse(null);
+    }
+
+    @Nullable Person player(final String name) {
+        return players.stream().filter(player -> player.name().equalsIgnoreCase(name)).findFirst().orElse(null);
+    }
+
+    @Nullable Region ownRegion() {
+        return players.stream().filter(player -> player.id().equals(viewer))
+            .map(player -> region(player.regionId())).filter(Objects::nonNull).findFirst().orElse(null);
+    }
+
+    List<Region> orderedRegions() {
+        final Region own = ownRegion();
+        return regions.stream().sorted(Comparator
+            .comparing((Region region) -> region != own)
+            .thenComparingDouble(region -> region.recent() == null ? Double.POSITIVE_INFINITY : region.recent().tps())
+            .thenComparing(Comparator.comparingDouble((Region region) -> region.recent() == null ? 0.0 : region.recent().mspt()).reversed())
+            .thenComparing(Region::world).thenComparingLong(Region::id)).toList();
+    }
+
+    static List<Player> visiblePlayers(final CommandSender sender, final Collection<? extends Player> online) {
+        // Player senders must be on their owner thread when reading their visibility map.
+        return online.stream().filter(player -> !(sender instanceof Player viewer) || viewer.canSee(player))
+            .sorted(Comparator.comparing(Player::getName, String.CASE_INSENSITIVE_ORDER)).map(player -> (Player)player).toList();
+    }
+
+    static RegionHealthSnapshot collect(final CommandSender sender, final boolean detailed) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        final long now = System.nanoTime();
+        final List<Region> regions = new ArrayList<>();
+        for (final net.minecraft.server.level.ServerLevel world : server.getAllLevels()) {
+            final List<io.papermc.paper.threadedregions.ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> refs = new ArrayList<>();
+            // Hold the topology lock only while copying references, never while generating reports.
+            world.regioniser.computeForAllRegions(refs::add);
+            for (final var region : refs) {
+                final TickRegions.TickRegionData data = region.getData();
+                final TickRegionScheduler.RegionScheduleHandle handle = data.getRegionSchedulingHandle();
+                final Map<String, Metrics> history = new HashMap<>();
+                put(history, "15 s", handle.getTickReport15s(now));
+                if (detailed) {
+                    put(history, "5 s", handle.getTickReport5s(now));
+                    put(history, "1 min", handle.getTickReport1m(now));
+                    put(history, "5 min", handle.getTickReport5m(now));
+                    put(history, "15 min", handle.getTickReport15m(now));
+                }
+                final TickRegions.RegionStats stats = data.getRegionStats();
+                regions.add(new Region(region.id, world.getWorld().getName(), stats.getChunkCount(), stats.getEntityCount(), List.of(), history));
+            }
+        }
+
+        // Reject stale links after a split/merge or world unload.
+        final java.util.Set<Long> live = new java.util.HashSet<>();
+        for (final net.minecraft.server.level.ServerLevel world : server.getAllLevels()) {
+            world.regioniser.computeForAllRegions(region -> live.add(region.id));
+        }
+        regions.removeIf(region -> !live.contains(region.id()));
+
+        final List<Person> players = new ArrayList<>();
+        for (final Player player : visiblePlayers(sender, Bukkit.getOnlinePlayers())) {
+            final TickRegions.TickRegionData association = ((CraftPlayer)player).tessera$getHealthRegion();
+            final Long id = association == null || !live.contains(association.region.id) ? null : association.region.id;
+            players.add(new Person(player.getUniqueId(), player.getName(), id));
+        }
+        final Map<Long, List<Person>> byRegion = new HashMap<>();
+        for (final Person player : players) {
+            if (player.regionId() != null) {
+                byRegion.computeIfAbsent(player.regionId(), ignored -> new ArrayList<>()).add(player);
+            }
+        }
+        final List<Region> populated = regions.stream().map(region -> new Region(region.id(), region.world(),
+            region.chunks(), region.entities(), byRegion.getOrDefault(region.id(), List.of()), region.history())).toList();
+        final var manager = server.tickRateManager();
+        return new RegionHealthSnapshot(populated, players, sender instanceof Player player ? player.getUniqueId() : null,
+            new TickMode(manager.tickrate(), manager.isFrozen(), manager.isSprinting()),
+            Metrics.from(RegionizedServer.getGlobalTickData().getTickReport15s(now)), TickRegions.getScheduler().getTotalThreadCount(),
+            ca.spottedleaf.moonrise.patches.chunk_system.scheduling.task.ChunkFullTask.loadRate(now),
+            ca.spottedleaf.moonrise.patches.chunk_system.scheduling.task.ChunkFullTask.genRate(now));
+    }
+
+    private static void put(final Map<String, Metrics> into, final String window, final TickData.@Nullable TickReportData report) {
+        final Metrics metrics = Metrics.from(report);
+        if (metrics != null) {
+            into.put(window, metrics);
+        }
+    }
+}
diff --git a/io/papermc/paper/threadedregions/commands/RegionHealthView.java b/io/papermc/paper/threadedregions/commands/RegionHealthView.java

+    private static @Nullable String tessera$findLocalBlockReadPosition(
+        final com.mojang.brigadier.context.CommandContext<CommandSourceStack> context
+    ) {
+        final boolean blockConditional = tessera$hasArgumentType(context, BlockPredicateArgument.class);
+        final boolean blockDataGet = tessera$hasNode(context, "data")
+            && tessera$hasNode(context, "get")
+            && tessera$hasNode(context, "block");
+        if (!blockConditional && !blockDataGet) {
+            return null;
         }
+
+        return context.getNodes().stream()
+            .map(com.mojang.brigadier.context.ParsedCommandNode::getNode)
+            .filter(node -> node instanceof ArgumentCommandNode<?, ?> argument && argument.getType() instanceof BlockPosArgument)
+            .map(CommandNode::getName)
+            .findFirst()
+            .orElse(null);
     }
 

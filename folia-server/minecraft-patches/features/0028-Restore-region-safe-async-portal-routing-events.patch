+    private void completePortalTransferAsync(
+        final ServerLevel originWorld,
+        final ServerLevel destination,
+        final TeleportTransition info,
+        final boolean takePassengers,
+        final PortalType type,
+        final java.util.function.Consumer<Entity> teleportComplete
+    ) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot complete portal transfer off the owning region");
+        final EntityTreeNode passengerTree = this.detachPassengers();
+        final List<EntityTreeNode> fullPassengerTree = passengerTree.getFullTree();
+        for (final EntityTreeNode node : fullPassengerTree) {
+            node.root.preChangeDimension();
+            node.root.prePortalLogic(originWorld, destination, type);
+        }
+        for (final EntityTreeNode node : fullPassengerTree) {
+            node.root = node.root.transformForAsyncTeleport(destination, null, null, null, null);
+            node.root.transform(info);
+            node.root.setPortalCooldown();
+        }
+        passengerTree.root.placeInAsync(
+            originWorld,
+            destination,
+            Entity.TELEPORT_FLAG_LOAD_CHUNK | (takePassengers ? Entity.TELEPORT_FLAG_TELEPORT_PASSENGERS : 0L),
+            passengerTree,
+            teleported -> {
+                if (info.postTeleportTransition() != null) {
+                    info.postTeleportTransition().onTransition(teleported);
+                }
+                if (teleportComplete != null) {
+                    teleportComplete.accept(teleported);
+                }
+            }
+        );
+    }

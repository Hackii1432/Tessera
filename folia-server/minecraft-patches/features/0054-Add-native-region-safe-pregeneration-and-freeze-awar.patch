+    public static CompletableFuture<LifecycleLease> pauseForLifecycle(final List<ServerLevel> worlds) {
+        final WorldPregenerator service = instance;
+        if (service == null) {
+            return CompletableFuture.completedFuture(new LifecycleLease(null, List.of()));
+        }
+        final CompletableFuture<LifecycleLease> result = new CompletableFuture<>();
+        service.controller.execute(() -> {
+            final List<ServerLevel> distinct = worlds.stream().distinct().toList();
+            distinct.forEach(world -> service.blockedWorlds.merge(world, 1, Integer::sum));
+            service.drains.add(new Drain(distinct, result));
+            service.checkDrains();
+        });
+        return result;
+    }
+
+    public static final class LifecycleLease implements AutoCloseable {
+        private final @Nullable WorldPregenerator service;
+        private final List<ServerLevel> worlds;
+        private final AtomicBoolean closed = new AtomicBoolean();
+        private LifecycleLease(final @Nullable WorldPregenerator service, final List<ServerLevel> worlds) {
+            this.service = service;
+            this.worlds = worlds;
+        }
+        @Override public void close() {
+            if (service != null && closed.compareAndSet(false, true)) {
+                if (service.controller.isShutdown()) return;
+                service.controller.execute(() -> worlds.forEach(world -> {
+                    service.blockedWorlds.compute(world, (key, count) -> count == null || count <= 1 ? null : count - 1);
+                    if (world.tessera$getRuntimeLifecycleState() == ServerLevel.RuntimeLifecycleState.CLOSED) {
+                        for (final Job job : service.jobs.values()) {
+                            if (job.world != world) continue;
+                            job.retiredWorld = true;
+                            job.world = null;
+                            if (job.state == State.RUNNING || job.state == State.STARTING || job.state == State.PAUSED) {
+                                job.state = State.PAUSED;
+                                job.detail = "World was unloaded; cancel and create a new job";
+                            }
+                        }
+                    }
+                }));
+            }
+        }
+    }
+
+    private void checkDrains() {
+        final var iterator = drains.iterator();
+        while (iterator.hasNext()) {
+            final Drain drain = iterator.next();
+            if (jobs.values().stream().anyMatch(job -> drain.worlds().contains(job.world) && !job.slots.isEmpty())) {
+                continue;
+            }
+            iterator.remove();
+            // All write receipts and owner cleanup preceded the empty slot set.
+            final List<Checkpoint> snapshots = jobs.values().stream().filter(job -> drain.worlds().contains(job.world))
+                .map(Job::checkpoint).toList();
+            CompletableFuture.allOf(snapshots.stream().map(this::persist).toArray(CompletableFuture[]::new))
+                .whenComplete((ignored, failure) -> {
+                    final LifecycleLease lease = new LifecycleLease(this, drain.worlds());
+                    if (failure == null) {
+                        if (!drain.result().complete(lease)) lease.close();
+                    } else {
+                        lease.close();
+                        drain.result().completeExceptionally(failure);
+                    }
+                });
+        }
+    }
+
+    public static CompletableFuture<Void> shutdownIfRunning() {
+        final WorldPregenerator service = instance;
+        if (service == null) {
+            return CompletableFuture.completedFuture(null);
+        }
+        service.stopping = true; // Close admission immediately, before deferring scheduler shutdown.
+        service.controller.execute(() -> {
+            service.jobs.values().stream().filter(job -> job.state == State.RUNNING || job.state == State.STARTING)
+                .forEach(job -> { job.state = State.PAUSED; job.detail = "Server stopped; resume explicitly"; });
+        });
+        return service.stopped;
+    }
+
+    /** Called before Folia's first non-blocking scheduler halt, never waits on a tick thread. */
+    public static boolean deferSchedulerHaltForShutdown() {
+        if (instance == null || TickThread.isShutdownThread()) return false;
+        shutdownIfRunning();
+        return true;
+    }
+
+    private void pumpSafely() {
+        if (!ready.isDone() || ready.isCompletedExceptionally()) {
+            if (stopping) {
+                stopped.complete(null);
+            }
+            return;
+        }
+        try {
+            pump();
+        } catch (final Throwable failure) {
+            LOGGER.error("Pregeneration admission paused after controller failure", failure);
+            jobs.values().stream().filter(job -> job.state == State.RUNNING).forEach(job -> fail(job, failure));
+        }
+    }
+
+    private void pump() {
+        checkDrains();
+        if (stopping && !publishingShutdown && jobs.values().stream().allMatch(job -> job.slots.isEmpty() && job.state != State.COMPLETING)) {
+            publishingShutdown = true;
+            final List<Checkpoint> snapshots = jobs.values().stream().map(Job::checkpoint).toList();
+            CompletableFuture.allOf(snapshots.stream().map(this::persist).toArray(CompletableFuture[]::new))
+                .whenComplete((ignored, failure) -> {
+                    if (failure == null) stopped.complete(null); else stopped.completeExceptionally(failure);
+                });
+            return;
+        }
+        if (stopping) return;
+        if (jobs.values().stream().noneMatch(job -> job.state == State.RUNNING)) return;
+        final long now = System.nanoTime();
+        if (now - lastPressureSample > TimeUnit.SECONDS.toNanos(1)) {
+            pressure = samplePressure(now);
+            lastPressureSample = now;
+        }
+        final int fastBudget = Math.clamp(Runtime.getRuntime().availableProcessors() * 2, 4, 64);
+        final int balancedBudget = Math.max(2, fastBudget / 4);
+        final int budget = pressure ? 1 : jobs.values().stream().anyMatch(job -> job.state == State.RUNNING && job.plan.mode() == Mode.FAST)
+            ? fastBudget : balancedBudget;
+        int outstanding = jobs.values().stream().mapToInt(job -> job.slots.size()).sum();
+        final List<Job> active = jobs.values().stream().filter(job -> job.state == State.RUNNING).toList();
+        for (int i = 0; i < active.size() * budget; i++) {
+            if (stopping) break;
+            final Job job = active.get((fairStart + i) % active.size());
+            if (job.state != State.RUNNING) continue;
+            final ServerLevel world = job.world;
+            if (world == null || blockedWorlds.containsKey(world)) continue;
+            if (!world.tessera$isRuntimeWorldActive()) {
+                if (world.tessera$getRuntimeLifecycleState() == ServerLevel.RuntimeLifecycleState.CLOSED
+                    || world.tessera$getRuntimeLifecycleState() == ServerLevel.RuntimeLifecycleState.UNLOADING) {
+                    job.state = State.PAUSED;
+                    job.detail = "World was unloaded; explicit resume and identity validation required";
+                }
+                continue;
+            }
+            final int worldBudget = job.plan.mode() == Mode.FAST ? fastBudget : balancedBudget;
+            if (!memoryCritical && outstanding < budget && job.slots.size() < worldBudget && !job.exhausted) {
+                final PregenerationArea.Point point = job.scan.next();
+                if (point == null) {
+                    job.exhausted = true;
+                } else {
+                    final Slot slot = new Slot(point);
+                    job.slots.put(point.nextCursor(), slot);
+                    outstanding++;
+                    processChunk(job, point).whenComplete((generated, failure) -> controller.execute(() -> finishSlot(job, slot, generated, failure)));
+                }
+            }
+            if (job.exhausted && job.slots.isEmpty()) {
+                if (job.generated + job.existing != job.plan.total()) {
+                    fail(job, new IllegalStateException("Chunk count does not match selection"));
+                } else {
+                    job.cursor = job.plan.area().scanLimit();
+                    job.state = State.COMPLETING;
+                    final Checkpoint complete = new Checkpoint(1, job.id, job.plan, State.COMPLETED,
+                        job.cursor, job.generated, job.existing, "");
+                    persist(complete).whenComplete((ignored, failure) -> controller.execute(() -> {
+                        if (failure != null) fail(job, failure);
+                        else {
+                            job.state = State.COMPLETED;
+                            job.world = null;
+                            LOGGER.info("Pregeneration job #{} completed in {}: generated={}, already complete={}",
+                                job.id, job.plan.worldName(), job.generated, job.existing);
+                        }
+                    }));
+                }
+            }
+        }
+        fairStart = active.isEmpty() ? 0 : (fairStart + 1) % active.size();
+        if (now - lastCheckpoint > TimeUnit.SECONDS.toNanos(5)) {
+            lastCheckpoint = now;
+            for (final Job job : jobs.values()) {
+                if (job.state == State.RUNNING || !job.slots.isEmpty()) {
+                    persist(job.checkpoint()).whenComplete((ignored, failure) -> {
+                        if (failure != null) controller.execute(() -> fail(job, failure));
+                    });
+                }
+            }
+        }
+    }
+
+    private boolean samplePressure(final long now) {
+        final var memory = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+        memoryCritical = memory.getMax() > 0 && memory.getUsed() > memory.getMax() * 0.90;
+        if (memory.getMax() > 0 && memory.getUsed() > memory.getMax() * 0.80) return true;
+        // Reports are immutable copies. Never inspect live foreign-region entity/chunk collections.
+        for (final org.bukkit.World bukkit : server.server.getWorlds()) {
+            final ServerLevel world = ((CraftWorld)bukkit).getHandle();
+            final List<TickRegions.TickRegionData> regions = new ArrayList<>();
+            world.regioniser.computeForAllRegions(region -> regions.add(region.getData()));
+            for (final TickRegions.TickRegionData region : regions) {
+                final var report = region.getRegionSchedulingHandle().getTickReport5s(now);
+                if (report != null && report.collectedTicks() > 0 && report.timePerTickData().segmentAll().average() > 40_000_000L) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private CompletableFuture<Boolean> processChunk(final Job job, final PregenerationArea.Point point) {
+        final ServerLevel world = Objects.requireNonNull(job.world);
+        final CompletableFuture<Boolean> result = new CompletableFuture<>();
+        // Native I/O already deduplicates reads and observes queued saves. A region-file
+        // header or mere file existence does NOT establish that a chunk is FULL.
+        try {
+        MoonriseRegionFileIO.loadDataAsync(world, point.x(), point.z(), MoonriseRegionFileIO.RegionFileType.CHUNK_DATA,
+            (tag, failure) -> {
+                try {
+                if (failure != null) {
+                    result.completeExceptionally(failure);
+                } else if (tag != null && NbtUtils.getDataVersion(tag) == SharedConstants.getCurrentVersion().dataVersion().version()
+                    && SerializableChunkData.getChunkStatusFromTag(tag).isOrAfter(ChunkStatus.FULL)) {
+                    MoonriseRegionFileIO.tessera$awaitChunkWrites(world, point.x(), point.z()).whenComplete((ignored, writeFailure) -> {
+                        if (writeFailure == null) result.complete(false); else result.completeExceptionally(writeFailure);
+                    });
+                } else {
+                    generateOwned(world, point, result);
+                }
+                } catch (final Throwable callbackFailure) {
+                    result.completeExceptionally(callbackFailure);
+                }
+            }, false, Priority.LOW);
+        } catch (final Throwable failure) {
+            result.completeExceptionally(failure);
+        }
+        return result;
+    }
+
+    private void generateOwned(final ServerLevel world, final PregenerationArea.Point point, final CompletableFuture<Boolean> result) {
+        final ChunkTaskScheduler scheduler = world.moonrise$getChunkTaskScheduler();
+        final ChunkHolderManager holders = scheduler.chunkHolderManager;
+        final int radius = ChunkTaskScheduler.getAccessRadius(ChunkStatus.FULL);
+        final AutoCloseable footprint = holders.tessera$admitPregenerationFootprint(point.x(), point.z(), radius);
+        result.whenComplete((generated, failure) -> {
+            try { footprint.close(); } catch (final Exception cleanupFailure) { LOGGER.error("Could not release generation footprint", cleanupFailure); }
+        });
+        // Only holder identities absent before admission may opt into our unload retry.
+        // This is thread-safe job bookkeeping, NOT cross-region block/entity access.
+        final Map<Long, NewChunkHolder> before = new HashMap<>();
+        for (int z = point.z() - radius; z <= point.z() + radius; z++) {
+            for (int x = point.x() - radius; x <= point.x() + radius; x++) {
+                final NewChunkHolder holder = holders.getChunkHolder(x, z);
+                if (holder != null) before.put(CoordinateUtils.getChunkKey(x, z), holder);
+            }
+        }
+        final long key = CoordinateUtils.getChunkKey(point.x(), point.z());
+        final Long ticket = ChunkTaskScheduler.getNextChunkLoadId();
+        final int level = ChunkLevel.byStatus(FullChunkStatus.FULL);
+        final AtomicBoolean acquired = new AtomicBoolean();
+        final CompletableFuture<Void> saved = new CompletableFuture<>();
+        try {
+            scheduler.scheduleChunkTask(point.x(), point.z(), () -> {
+                try {
+                    TickThread.ensureTickThread(world, point.x(), point.z(), "Pregeneration admission off-region");
+                    world.tessera$ensureAcceptingChunkRequests("native pregeneration");
+                    holders.addTicketAtLevel(PREGEN_TICKET, key, level, ticket);
+                    acquired.set(true);
+                    holders.processTicketUpdates();
+                    scheduler.scheduleChunkLoad(point.x(), point.z(), ChunkStatus.FULL, false, Priority.LOW, chunk -> {
+                        // Defer: FULL consumers may run during ticket propagation/full-status processing.
+                        scheduler.scheduleChunkTaskEventually(point.x(), point.z(), () -> {
+                            try {
+                                if (chunk == null) throw new IllegalStateException("Chunk generation was not completed");
+                                final NewChunkHolder holder = holders.getChunkHolder(key);
+                                if (holder == null) throw new IllegalStateException("Generated chunk lost its holder");
+                                for (int z = point.z() - radius; z <= point.z() + radius; z++) {
+                                    for (int x = point.x() - radius; x <= point.x() + radius; x++) {
+                                        final long neighbourKey = CoordinateUtils.getChunkKey(x, z);
+                                        final NewChunkHolder neighbour = holders.getChunkHolder(neighbourKey);
+                                        if (neighbour != null && !before.containsKey(neighbourKey)) {
+                                            holders.tessera$claimPregenerationUnload(neighbour);
+                                        }
+                                    }

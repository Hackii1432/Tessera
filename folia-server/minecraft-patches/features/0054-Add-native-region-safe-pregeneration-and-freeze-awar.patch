+    private void finishSlot(final Job job, final Slot slot, final @Nullable Boolean generated, final @Nullable Throwable failure) {
+        slot.done = true;
+        slot.generated = Boolean.TRUE.equals(generated);
+        if (failure != null) {
+            fail(job, failure);
+            // Failed work cannot advance the durable frontier. Other admitted slots still drain.
+            job.slots.remove(slot.point.nextCursor());
+            job.recovered = true;
+        }
+        while (!job.slots.isEmpty() && job.slots.firstEntry().getValue().done) {
+            final Slot completed = job.slots.pollFirstEntry().getValue();
+            if (!job.recovered) {
+                job.cursor = completed.point.nextCursor();
+                if (completed.generated) job.generated++; else job.existing++;
+                job.sessionCompleted++;
+            }
+        }
+        checkDrains();
+        pumpSafely();
+    }
+
+    private void fail(final Job job, final Throwable failure) {
+        job.state = State.FAILED;
+        job.detail = rootMessage(failure);
+        LOGGER.error("Pregeneration job #{} failed in {}: {}", job.id, job.plan.worldName(), job.detail, failure);
+        persist(job.checkpoint()).whenComplete((ignored, metadataFailure) -> {

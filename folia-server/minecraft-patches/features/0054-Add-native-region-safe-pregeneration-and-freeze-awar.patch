+
+    private static boolean terminal(final State state) {
+        return state == State.COMPLETED || state == State.CANCELLED;
+    }
+
+    private static void verifyIdentity(final Plan expected, final Plan actual) {
+        if (!expected.worldId().equals(actual.worldId()) || !expected.worldKey().equals(actual.worldKey())
+            || !expected.folder().equals(actual.folder()) || expected.seed() != actual.seed()
+            || !expected.generator().equals(actual.generator())) {
+            throw new IllegalStateException("World identity/seed/generator changed; create a new job instead");
+        }
+    }
+
+    public static String rootMessage(final Throwable failure) {
+        Throwable root = failure;
+        while (root.getCause() != null && root.getCause() != root) root = root.getCause();
+        return Objects.toString(root.getMessage(), root.getClass().getSimpleName());
+    }
+
+    private CompletableFuture<Void> persist(final Checkpoint checkpoint) {
+        return CompletableFuture.runAsync(() -> {
+            try {
+                PregenerationCheckpoint.write(directory.resolve(checkpoint.id() + ".json"), JSON.toJson(checkpoint));
+            } catch (final IOException failure) {
+                throw new java.io.UncheckedIOException(failure);
+            }
+        }, storage);
+    }
+
+    public static void finishShutdown() {
+        final WorldPregenerator service = instance;
+        if (service != null) {
+            service.controller.shutdown();
+            service.storage.shutdown();
+        }
+    }
+
+    private List<Job> readCheckpoints() {
+        final List<Job> result = new ArrayList<>();
+        if (!Files.exists(directory, LinkOption.NOFOLLOW_LINKS)) return result;
+        try {
+            if (!Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(directory)) {
+                throw new IOException("Unsafe pregeneration directory");
+            }
+            try (final var files = Files.newDirectoryStream(directory, "*.json")) {
+                for (final Path path : files) {
+                    if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || Files.size(path) > 64 * 1024) {
+                        throw new IOException("Unsafe or oversized checkpoint: " + path);
+                    }
+                    final Checkpoint checkpoint = JSON.fromJson(Files.readString(path), Checkpoint.class);
+                    if (checkpoint.format() != 1 || checkpoint.id() < 1 || checkpoint.id() == Long.MAX_VALUE
+                        || !path.getFileName().toString().equals(checkpoint.id() + ".json")
+                        || checkpoint.plan().total() != checkpoint.plan().area().chunkCount()
+                        || checkpoint.cursor() < 0 || checkpoint.cursor() > checkpoint.plan().area().scanLimit()
+                        || checkpoint.generated() < 0 || checkpoint.existing() < 0
+                        || checkpoint.generated() > checkpoint.plan().total() - checkpoint.existing()) {
+                        throw new IOException("Invalid pregeneration checkpoint: " + path);
+                    }
+                    final State state = terminal(checkpoint.state()) ? checkpoint.state() : State.PAUSED;
+                    final Job job = new Job(checkpoint.id(), checkpoint.plan(), null, state);
+                    job.cursor = checkpoint.cursor();
+                    job.generated = checkpoint.generated();
+                    job.existing = checkpoint.existing();
+                    job.recovered = true;
+                    job.detail = terminal(state) ? checkpoint.detail() : "Recovered paused; resume revalidates persisted chunks";
+                    result.add(job);
+                }
+            }
+        } catch (final Throwable failure) {
+            throw new IllegalStateException("Could not recover pregeneration jobs", failure);
+        }
+        result.sort(java.util.Comparator.comparingLong(job -> job.id));
+        return result;
+    }
+
+    private <T> CompletableFuture<T> submit(final Supplier<T> action) {
+        final CompletableFuture<T> future = new CompletableFuture<>();
+        controller.execute(() -> {
+            try { future.complete(action.get()); } catch (final Throwable failure) { future.completeExceptionally(failure); }
+        });
+        return future;
+    }
+
+    private <T> CompletableFuture<T> onGlobal(final Supplier<T> action) {
+        final CompletableFuture<T> result = new CompletableFuture<>();
+        if (server.hasStopped()) return CompletableFuture.failedFuture(new IllegalStateException("Server stopped"));
+        final Runnable run = () -> {
+            try { result.complete(action.get()); } catch (final Throwable failure) { result.completeExceptionally(failure); }
+        };
+        if (RegionizedServer.isGlobalTickThread()) run.run(); else RegionizedServer.getInstance().addTask(run);
+        return result;
+    }
+}

+    private View view(final Job job) {
+        String state = job.state.name();
+        if (!job.slots.isEmpty() && job.state == State.PAUSED) state = "PAUSING";
+        else if (!job.slots.isEmpty() && job.state == State.CANCELLED) state = "CANCELLING";
+        else if (job.state == State.RUNNING && blockedWorlds.containsKey(job.world)) state = "WAITING_FOR_WORLD";
+        else if (job.state == State.RUNNING && memoryCritical) state = "WAITING_FOR_MEMORY";
+        final double rate = job.sessionCompleted / Math.max(0.001, (System.nanoTime() - job.started) / 1.0E9);
+        return new View(job.id, job.plan.worldName(), job.plan.worldKey(), state, job.plan.mode(), job.plan.total(), job.generated,

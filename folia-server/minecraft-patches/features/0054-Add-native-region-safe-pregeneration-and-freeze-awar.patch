+    private WorldPregenerator(final MinecraftServer server) {
+        this.server = server;
+        this.directory = server.server.getWorldContainer().toPath().toAbsolutePath().normalize()
+            .resolve(".tessera").resolve("pregeneration");
+        CompletableFuture.supplyAsync(this::readCheckpoints, storage).whenComplete((loaded, failure) -> controller.execute(() -> {
+            if (failure != null) {
+                ready.completeExceptionally(failure);
+                LOGGER.error("Pregeneration checkpoints could not be read; service fails closed", failure);
+                return;
+            }
+            for (final Job job : loaded) {
+                jobs.put(job.id, job);
+                nextId = Math.max(nextId, Math.addExact(job.id, 1));
+            }
+            ready.complete(null);
+        }));
+        controller.scheduleWithFixedDelay(this::pumpSafely, 100, 100, TimeUnit.MILLISECONDS);
+    }
+
+    public static synchronized WorldPregenerator get(final MinecraftServer server) {
+        if (instance == null) {
+            instance = new WorldPregenerator(server);
+        }
+        if (instance.server != server) {
+            throw new IllegalStateException("Pregenerator belongs to a different server");
+        }
+        return instance;
+    }
+
+    public CompletableFuture<Plan> plan(final UUID worldId, final PregenerationArea area, final Mode mode) {
+        return ready.thenCompose(ignored -> onGlobal(() -> resolve(worldId, area, mode)))
+            .thenCompose(resolved -> CompletableFuture.supplyAsync(() -> withTotal(resolved.plan()), storage));
+    }
+
+    private static Plan withTotal(final Plan plan) {
+        return new Plan(plan.worldId(), plan.worldName(), plan.worldKey(), plan.folder(), plan.seed(),
+            plan.generator(), plan.area(), plan.area().chunkCount(), plan.mode());
+    }
+
+    private Resolved resolve(final UUID id, final PregenerationArea area, final Mode mode) {
+        final org.bukkit.World bukkit = server.server.getWorld(id);
+        if (!(bukkit instanceof CraftWorld craft) || !craft.getHandle().tessera$isRuntimeWorldActive()) {
+            throw new IllegalStateException("Selected world is not loaded and active");
+        }
+        final ServerLevel world = craft.getHandle();
+        final String generator = world.getChunkSource().getGenerator().getClass().getName() + "/"
+            + world.getChunkSource().getGenerator().getBiomeSource().getClass().getName();
+        return new Resolved(new Plan(id, bukkit.getName(), world.dimension().identifier().toString(),
+            bukkit.getWorldFolder().toPath().toAbsolutePath().normalize().toString(), world.getSeed(), generator, area, 0, mode), world);
+    }
+
+    public CompletableFuture<View> start(final Plan plan) {
+        return onGlobal(() -> resolve(plan.worldId(), plan.area(), plan.mode())).thenCompose(resolved -> submit(() -> {
+            ensureRunning();
+            verifyIdentity(plan, resolved.plan());
+            if (plan.total() <= 0) {
+                throw new IllegalArgumentException("Plan has no chunks");
+            }
+            if (blockedWorlds.containsKey(resolved.world())) {
+                throw new IllegalStateException("World is busy with a lifecycle operation");
+            }
+            if (jobs.values().stream().anyMatch(job -> job.plan.worldId().equals(plan.worldId()) && (!terminal(job.state) || !job.slots.isEmpty()))) {
+                throw new IllegalStateException("This world already has an unfinished job; resume or cancel it first");
+            }
+            final Job job = new Job(nextId++, plan, resolved.world(), State.STARTING);
+            jobs.put(job.id, job);
+            return job;
+        })).thenCompose(this::activateAfterPublication);
+    }
+
+    private CompletableFuture<View> activateAfterPublication(final Job job) {
+        return submit(job::checkpoint).thenCompose(this::persist).exceptionallyCompose(failure -> submit(() -> {
+            fail(job, failure);
+            throw new java.util.concurrent.CompletionException(failure);
+        })).thenCompose(ignored -> submit(() -> {
+            // A stop/cancel during initial publication must not reopen admission.
+            if (job.state == State.STARTING && !stopping) {
+                if (job.recovered) {
+                    // Checkpoints are not atomic with Minecraft's many region files.
+                    // Reset only after publication succeeds; a failed resume preserves its old progress.
+                    job.cursor = job.generated = job.existing = 0;
+                    job.scan = job.plan.area().cursor(0);
+                    job.exhausted = false;
+                    job.recovered = false;
+                }
+                job.state = State.RUNNING;
+                LOGGER.info("Pregeneration job #{} started in {} ({} chunks)", job.id, job.plan.worldName(), job.plan.total());
+            }
+            return view(job);
+        }));
+    }
+
+    public CompletableFuture<List<View>> views() {
+        return submit(() -> jobs.values().stream().map(this::view).toList());
+    }
+
+    public CompletableFuture<View> control(final long id, final String action, final @Nullable Mode mode) {
+        if (action.equals("resume")) {
+            return submit(() -> requireJob(id).plan).thenCompose(plan -> onGlobal(() -> resolve(plan.worldId(), plan.area(), plan.mode())))
+                .thenCompose(resolved -> submit(() -> {
+                    ensureRunning();
+                    final Job job = requireJob(id);
+                    if (job.state != State.PAUSED && job.state != State.FAILED) {
+                        throw new IllegalStateException("Job must be paused or failed before resuming");
+                    }
+                    if (!job.slots.isEmpty()) {
+                        throw new IllegalStateException("Job is still draining admitted work");
+                    }
+                    verifyIdentity(job.plan, resolved.plan());
+                    if (job.retiredWorld || (job.world != null && job.world != resolved.world())) {
+                        throw new IllegalStateException("World instance was replaced; cancel this job and create a new one");
+                    }
+                    if (blockedWorlds.containsKey(resolved.world())) {
+                        throw new IllegalStateException("World has an active lifecycle barrier");
+                    }
+                    job.world = resolved.world();
+                    if (job.recovered || job.state == State.FAILED) {
+                        job.recovered = true;
+                    }
+                    job.started = System.nanoTime();
+                    job.sessionCompleted = 0;
+                    job.detail = "";
+                    job.state = State.STARTING;
+                    return job;
+                })).thenCompose(this::activateAfterPublication);
+        }
+        return submit(() -> {
+            ensureRunning();
+            final Job job = requireJob(id);
+            if (terminal(job.state) || job.state == State.COMPLETING) {
+                throw new IllegalStateException("Job is already finished or publishing its completion");
+            }
+            switch (action) {
+                case "pause" -> job.state = State.PAUSED;
+                case "cancel" -> job.state = State.CANCELLED;
+                case "mode" -> job.plan = new Plan(job.plan.worldId(), job.plan.worldName(), job.plan.worldKey(),
+                    job.plan.folder(), job.plan.seed(), job.plan.generator(), job.plan.area(), job.plan.total(), Objects.requireNonNull(mode));
+                default -> throw new IllegalArgumentException("Unknown job operation");
+            }
+            return job;
+        }).thenCompose(job -> action.equals("mode") ? persistView(job) : awaitJobDrain(job).thenCompose(ignored -> persistView(job))
+            .thenCompose(ignored -> submit(() -> {
+                if (job.state == State.CANCELLED) job.world = null; // Keep history, not an unloaded world's object graph.
+                return view(job);
+            })));
+    }
+
+    private CompletableFuture<View> persistView(final Job job) {
+        return submit(job::checkpoint).thenCompose(this::persist).exceptionallyCompose(failure -> submit(() -> {
+            fail(job, failure);
+            throw new java.util.concurrent.CompletionException(failure);
+        })).thenCompose(ignored -> submit(() -> view(job)));
+    }
+
+    private CompletableFuture<Void> awaitJobDrain(final Job job) {
+        final CompletableFuture<Void> result = new CompletableFuture<>();
+        class Wait implements Runnable {
+            @Override public void run() {
+                if (job.slots.isEmpty()) {
+                    result.complete(null);
+                } else {
+                    controller.schedule(this, 100, TimeUnit.MILLISECONDS);
+                }
+            }
+        }
+        controller.execute(new Wait());
+        return result;
+    }

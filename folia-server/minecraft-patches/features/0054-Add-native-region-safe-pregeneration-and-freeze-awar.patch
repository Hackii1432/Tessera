     public static final int MAX_TICKET_LEVEL = ChunkLevel.MAX_LEVEL; // inclusive
 
     public static final TicketType UNLOAD_COOLDOWN = ChunkSystemTicketType.create("chunk_system:unload_cooldown", null, 5L * 20L);
+    // Tessera - own retry ticket; never expire another loader's tickets during /tick freeze.
+    private static final TicketType PREGEN_UNLOAD_COOLDOWN = ChunkSystemTicketType.create("tessera:pregen_unload_retry", null);
+    private record PregenerationRetryKey(long coordinate, int level) {}
+    private static final class PregenerationRetry {
+        volatile long deadline;
+        final java.util.concurrent.CompletableFuture<Void> released = new java.util.concurrent.CompletableFuture<>();
+        PregenerationRetry(final long deadline) { this.deadline = deadline; }
+    }
+    private final java.util.concurrent.ConcurrentHashMap<Long, java.util.concurrent.ConcurrentHashMap<PregenerationRetryKey, PregenerationRetry>> tessera$pregenUnloadRetries =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    private final java.util.concurrent.ConcurrentHashMap<Long, java.util.concurrent.atomic.AtomicInteger> tessera$pregenFootprints =
+        new java.util.concurrent.ConcurrentHashMap<>();
+
+    public AutoCloseable tessera$admitPregenerationFootprint(final int x, final int z, final int radius) {
+        final java.util.Set<Long> keys = new java.util.HashSet<>();
+        final int shift = ((ChunkSystemServerLevel)this.world).moonrise$getRegionChunkShift();
+        for (int dz = -radius; dz <= radius; dz++) {
+            for (int dx = -radius; dx <= radius; dx++) {
+                keys.add(CoordinateUtils.getChunkKey(x + dx, z + dz));
+                // Native task queues retain a section anchor, which need not be a target chunk.
+                keys.add(CoordinateUtils.getChunkKey(((x + dx) >> shift) << shift, ((z + dz) >> shift) << shift));
+            }
+        }
+        keys.forEach(key -> this.tessera$pregenFootprints.compute(key, (ignored, count) -> {
+            if (count == null) count = new java.util.concurrent.atomic.AtomicInteger();
+            count.incrementAndGet();
+            return count;
+        }));
+        final java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean();
+        return () -> {
+            if (closed.compareAndSet(false, true)) keys.forEach(key -> this.tessera$pregenFootprints.computeIfPresent(key,
+                (ignored, count) -> count.decrementAndGet() == 0 ? null : count));
+        };
+    }
+
+    public void tessera$tickPregenerationUnloads() {
+        final var region = TickRegionScheduler.getCurrentRegion();
+        if (region == null || region.regioniser.world != this.world) {
+            throw new IllegalStateException("Pregeneration unload maintenance must run on the owner");
+        }
+        if (this.tessera$pregenUnloadRetries.isEmpty()) return;
+        final long now = System.nanoTime();
+        for (final LongIterator iterator = region.getOwnedSectionsUnsynchronised(); iterator.hasNext();) {
+            final long section = iterator.nextLong();
+            final java.util.concurrent.ConcurrentHashMap<PregenerationRetryKey, PregenerationRetry> retries = this.tessera$pregenUnloadRetries.get(section);
+            if (retries == null) {
+                continue;
+            }
+            retries.forEach((key, retry) -> {
+                if (now - retry.deadline >= 0) {
+                    boolean retired = false;
+                    final ReentrantAreaLock.Node lock = this.ticketLockArea.lock(
+                        CoordinateUtils.getChunkX(key.coordinate()), CoordinateUtils.getChunkZ(key.coordinate()));
+                    try {
+                        // Registration takes this same ticket lock. Keep the receipt visible until
+                        // the ticket is gone, and recheck a concurrently extended deadline.
+                        if (retries.get(key) == retry && now - retry.deadline >= 0) {
+                            this.removeTicketAtLevel(PREGEN_UNLOAD_COOLDOWN, key.coordinate(), key.level(), null, false);
+                            retries.remove(key, retry);
+                            retired = true;
+                        }
+                    } catch (final Throwable failure) {
+                        retry.released.completeExceptionally(failure);
+                        throw failure;
+                    } finally {
+                        this.ticketLockArea.unlock(lock);
+                    }
+                    // Never run continuation code while holding a native ticket lock.
+                    if (retired) retry.released.complete(null);
+                }
+            });
+            this.tessera$pregenUnloadRetries.computeIfPresent(section, (ignored, current) -> current.isEmpty() ? null : current);
+        }
+    }
+
+    private void tessera$addPregenerationUnloadRetry(final NewChunkHolder holder) {
+        final long key = CoordinateUtils.getChunkKey(holder.chunkX, holder.chunkZ);
+        this.addTicketAtLevel(PREGEN_UNLOAD_COOLDOWN, key, MAX_TICKET_LEVEL, null, false);
+        this.tessera$registerPregenerationRelease(key, MAX_TICKET_LEVEL);
+    }
+
+    private void tessera$registerPregenerationRelease(final long key, final int level) {
+        final int shift = ((ChunkSystemServerLevel)this.world).moonrise$getRegionChunkShift();
+        final long section = CoordinateUtils.getChunkKey(CoordinateUtils.getChunkX(key) >> shift, CoordinateUtils.getChunkZ(key) >> shift);
+        this.tessera$pregenUnloadRetries.compute(section, (ignoredSection, retries) -> {
+            if (retries == null) retries = new java.util.concurrent.ConcurrentHashMap<>();
+            retries.compute(new PregenerationRetryKey(key, level), (ignored, retry) -> {
+                if (retry == null) retry = new PregenerationRetry(System.nanoTime() + 50_000_000L);
+                else retry.deadline = System.nanoTime() + 50_000_000L;
+                return retry;
+            });
+            return retries;
+        });
+    }
+
+    public java.util.concurrent.CompletableFuture<Void> tessera$awaitPregenerationRelease(final int x, final int z) {
+        final java.util.List<java.util.concurrent.CompletableFuture<Void>> pending = new java.util.ArrayList<>();
+        final int shift = ((ChunkSystemServerLevel)this.world).moonrise$getRegionChunkShift();
+        final long key = CoordinateUtils.getChunkKey(x, z);
+        final long section = CoordinateUtils.getChunkKey(x >> shift, z >> shift);
+        final long anchor = CoordinateUtils.getChunkKey((x >> shift) << shift, (z >> shift) << shift);
+        final var retries = this.tessera$pregenUnloadRetries.get(section);
+        if (retries != null) retries.forEach((retryKey, retry) -> {
+            if (retryKey.coordinate() == key || retryKey.coordinate() == anchor) pending.add(retry.released);
+        });
+        return java.util.concurrent.CompletableFuture.allOf(pending.toArray(java.util.concurrent.CompletableFuture[]::new));
+    }
+
+    /** Thread-safe holder metadata only; does not read or mutate a foreign live chunk. */
+    public void tessera$claimPregenerationUnload(final NewChunkHolder holder) {
+        final ReentrantAreaLock.Node lock = this.ticketLockArea.lock(holder.chunkX, holder.chunkZ);
+        try {
+            final TicketSet current = this.tickets.get(CoordinateUtils.getChunkKey(holder.chunkX, holder.chunkZ));
+            if (current != null) {
+                for (final Ticket ticket : current) {
+                    if (!tessera$isPregenerationMaintenanceTicket(ticket.getType())) return;
+                }
+            }
+            holder.tessera$pregenerationUnload = true;
+        } finally {
+            this.ticketLockArea.unlock(lock);
+        }
+    }
+
+    private static boolean tessera$isPregenerationMaintenanceTicket(final TicketType type) {
+        return type == PREGEN_UNLOAD_COOLDOWN
+            || type == io.papermc.paper.pregeneration.WorldPregenerator.PREGEN_TICKET
+            || type == io.papermc.paper.threadedregions.RegionizedTaskQueue.TASK_QUEUE_TICKET;
+    }
 

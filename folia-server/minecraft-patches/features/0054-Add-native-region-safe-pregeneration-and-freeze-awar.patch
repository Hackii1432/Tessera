+    // Tessera start - acknowledge actual pregeneration writes, not just NBT serialization
+    private static final ThreadLocal<java.util.List<Throwable>> PREGEN_SAVE_FAILURES = new ThreadLocal<>();
+
+    public static void tessera$reportPregenerationSaveFailure(final Throwable failure) {
+        final java.util.List<Throwable> failures = PREGEN_SAVE_FAILURES.get();
+        if (failures != null) {
+            failures.add(failure);
+        }
+    }
+
+    public static CompletableFuture<Void> tessera$saveForPregeneration(
+        final ServerLevel world, final int chunkX, final int chunkZ, final Runnable save
+    ) {
+        if (PREGEN_SAVE_FAILURES.get() != null) {
+            return CompletableFuture.failedFuture(new IllegalStateException("Recursive pregeneration save"));
+        }
+        final java.util.List<Throwable> failures = new java.util.ArrayList<>();
+        PREGEN_SAVE_FAILURES.set(failures);
+        try {
+            save.run();
+        } catch (final Throwable failure) {
+            failures.add(failure);
+        } finally {
+            PREGEN_SAVE_FAILURES.remove();
+        }
+        final CompletableFuture<Void> writes = tessera$awaitChunkWrites(world, chunkX, chunkZ);
+        if (failures.isEmpty()) return writes;
+        final Throwable saveFailure = failures.getFirst();
+        for (int i = 1; i < failures.size(); i++) {
+            if (failures.get(i) != saveFailure) saveFailure.addSuppressed(failures.get(i));
+        }
+        // A synchronous failure in one store must not bypass other stores' queued writes.
+        return writes.handle((ignored, writeFailure) -> {
+            if (writeFailure != null && writeFailure != saveFailure) saveFailure.addSuppressed(writeFailure);
+            throw new java.util.concurrent.CompletionException(saveFailure);
+        });
+    }
+
+    public static CompletableFuture<Void> tessera$awaitChunkWrites(final ServerLevel world, final int chunkX, final int chunkZ) {
+        final java.util.List<CompletableFuture<Void>> writes = new java.util.ArrayList<>();
+        for (final RegionFileType type : CACHED_REGIONFILE_TYPES) {
+            final RegionDataController controller = getControllerFor(world, type);
+            controller.chunkTasks.compute(CoordinateUtils.getChunkKey(chunkX, chunkZ), (key, task) -> {
+                if (task != null && task.inProgressWrite != null) {
+                    if (task.failedWrite) {
+                        writes.add(CompletableFuture.failedFuture(new IOException("Previous write failed: " + task)));
+                    } else {
+                        if (task.tessera$writeWaiters == null) {
+                            task.tessera$writeWaiters = new java.util.ArrayList<>();
+                        }
+                        final CompletableFuture<Void> future = new CompletableFuture<>();
+                        task.tessera$writeWaiters.add(future);
+                        writes.add(future);
+                    }
+                }
+                return task;
+            });
+        }
+        return CompletableFuture.allOf(writes.toArray(CompletableFuture[]::new));
+    }
+    // Tessera end - acknowledge actual pregeneration writes
+
     public static void flushRegionStorages(final ServerLevel world, final RegionFileType type) throws IOException {
         getControllerFor(world, type).getCache().flush();
     }

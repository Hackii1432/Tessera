diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 00ebe5c20950c67446c48fc61034c51655ee6ac8..ec83bd835e22a08f4a9adfbcbe3ee365afa01616 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -958,19 +958,35 @@ public class ServerGamePacketListenerImpl
     }
     public void sendServerSuggestions(final ServerboundCommandSuggestionPacket packet) {
         // Paper end - Async TabComplete Event
-        int clientId = packet.id();
+        final org.bukkit.craftbukkit.entity.CraftPlayer target = this.getCraftPlayer(); // Tessera - stable across respawn
         this.commandSuggestionsProvider
             .request(packet.command())
             .thenAccept(suggestions -> {
-                if (!this.isAcceptingMessages()) return;
-                // Paper - fire the suggestions event for the server completion path as well.
-                final var event = new com.destroystokyo.paper.event.brigadier.AsyncPlayerSendSuggestionsEvent(this.getCraftPlayer(), suggestions, packet.command());
-                if (event.callEvent() && !event.getSuggestions().isEmpty() && this.isAcceptingMessages()) {
-                    this.send(new ClientboundCommandSuggestionsPacket(clientId, ServerCommandSuggestionsProvider.limitSuggestionCount(event.getSuggestions())));
+                // Tessera - plugin suggestion futures may complete on any thread.
+                if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.player)) {
+                    this.tessera$sendServerSuggestions(this.player, packet, suggestions);
+                } else {
+                    target.taskScheduler.schedule(current -> {
+                        if (current instanceof ServerPlayer currentPlayer) {
+                            this.tessera$sendServerSuggestions(currentPlayer, packet, suggestions);
+                        }
+                    }, null, 1L);
                 }
             });
     }
 
+    private void tessera$sendServerSuggestions(final ServerPlayer currentPlayer, final ServerboundCommandSuggestionPacket packet,
+                                              final com.mojang.brigadier.suggestion.Suggestions suggestions) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(currentPlayer, "Cannot deliver server suggestions off-region");
+        if (this.player != currentPlayer || currentPlayer.connection != this || currentPlayer.isRemoved() || !this.isAcceptingMessages()) return;
+        final var event = new com.destroystokyo.paper.event.brigadier.AsyncPlayerSendSuggestionsEvent(currentPlayer.getBukkitEntity(), suggestions, packet.command());
+        if (event.callEvent() && !event.getSuggestions().isEmpty()
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(currentPlayer)
+            && this.player == currentPlayer && currentPlayer.connection == this && !currentPlayer.isRemoved() && this.isAcceptingMessages()) {
+            this.send(new ClientboundCommandSuggestionsPacket(packet.id(), ServerCommandSuggestionsProvider.limitSuggestionCount(event.getSuggestions())));
+        }
+    }
+
     @Override
     public void handleSetCommandBlock(final ServerboundSetCommandBlockPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());

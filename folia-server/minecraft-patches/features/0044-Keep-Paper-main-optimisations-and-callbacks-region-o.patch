     }
 
     // Paper start - validate compound targets
-    private static boolean isContainerRemoved(final Container container) {
+    private static boolean isContainerRemoved(final Level level, final Container container) {
         if (container instanceof net.minecraft.world.CompoundContainer compoundContainer) {
-            return isContainerRemoved(compoundContainer.container1) || isContainerRemoved(compoundContainer.container2);
+            return isContainerRemoved(level, compoundContainer.container1) || isContainerRemoved(level, compoundContainer.container2);
         }
-        return container instanceof BlockEntity blockEntity && blockEntity.isRemoved();
+        return container instanceof BlockEntity blockEntity
+            && (!tessera$ownsLoadedPosition(level, blockEntity.getBlockPos())
+                || blockEntity.isRemoved() || blockEntity.getLevel() != level
+                || level.getBlockEntity(blockEntity.getBlockPos()) != blockEntity);
     }
     // Paper end - validate compound targets
 
+    // Tessera - never load or inspect a foreign region while validating a remembered container.
+    private static boolean tessera$ownsLoadedPosition(final Level level, final BlockPos pos) {
+        return level instanceof ServerLevel serverLevel
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(serverLevel, pos)
+            && serverLevel.getChunkSource().getChunkAtIfLoadedImmediately(pos.getX() >> 4, pos.getZ() >> 4) != null;
+    }
+

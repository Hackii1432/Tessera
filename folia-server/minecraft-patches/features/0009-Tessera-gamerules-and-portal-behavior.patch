     // Folia end - region threading
 
+    // Tessera start - eyes of ender gamerule
+    /**
+     * Returns a player to the source world's spawn when end portal use is disabled.
+     * End-side portals remain disabled without returning the player, allowing the
+     * gamerule to be configured independently in the End.
+     */
+    private static void sendToSpawn(final ServerPlayer player, final ServerLevel world) {
+        if (world.dimension() == Level.END || !END_PORTAL_PUNISHMENT.add(player.getUUID())) {
+            return;
+        }
+
+        // set a portal cooldown, so we won't be portaled through any other means
+        player.setPortalCooldown(60);
+
+        player.addEffect(new MobEffectInstance(MobEffects.SLOW_FALLING, 60, 200, false, false, false));
+        player.addEffect(new MobEffectInstance(MobEffects.REGENERATION, 60, 200, false, false, false));
+
+        Location spawn = world.getWorld().getSpawnLocation();
+        spawn.setX(spawn.getBlockX() + 0.50);
+        spawn.setY(spawn.getBlockY() + 1.0);
+        spawn.setZ(spawn.getBlockZ() + 0.50);
+
+        // play the enderman teleport sound at the players location
+        world.playSound(null, player.getX(), player.getY(), player.getZ(), SoundEvents.ENDERMAN_TELEPORT, SoundSource.PLAYERS);
+
+        runTeleportToSpawnAnimationAsync(player, spawn, 0);
+    }
+
+    private static void runTeleportToSpawnAnimationAsync(final ServerPlayer player, final Location spawn, final int phase) {
+        if (player.isRemoved() || !player.isAlive()) {
+            END_PORTAL_PUNISHMENT.remove(player.getUUID());
+            return;
+        }
+
+        // remove the fire ticks,
+        //  hopefully this will keep us alive
+        player.getBukkitEntity().setFireTicks(0);
+
+        // spawn the portal animation
+        spawnPortalAnimation(player, phase);
+
+        if (phase < 3) {
+            player.getBukkitEntity().taskScheduler.schedule(
+                scheduledPlayer -> runTeleportToSpawnAnimationAsync((ServerPlayer)scheduledPlayer, spawn, phase + 1),
+                retired -> END_PORTAL_PUNISHMENT.remove(player.getUUID()),
+                2L
+            );
+            return;
+        }
+
+        ServerLevel currentLevel = (ServerLevel) player.level();
+        currentLevel.playSound(null, player.getX(), player.getY(), player.getZ(),
+                SoundEvents.ENDERMAN_TELEPORT, SoundSource.PLAYERS, 1.0F, 1.15F
+        );
+
+        // remove portal fall movement
+        player.setDeltaMovement(Vec3.ZERO);
+        player.resetFallDistance();
+
+        player.addEffect(new MobEffectInstance(MobEffects.SLOW_FALLING, 60, 200, false, false, false));
+
+        player.getBukkitEntity().teleportAsync(spawn, PlayerTeleportEvent.TeleportCause.END_PORTAL)
+            .whenComplete((success, throwable) -> player.getBukkitEntity().taskScheduler.schedule(
+                scheduledPlayer -> {
+                    END_PORTAL_PUNISHMENT.remove(scheduledPlayer.getUUID());
+                    scheduledPlayer.getBukkitEntity().setFireTicks(0);
+                },
+                retired -> END_PORTAL_PUNISHMENT.remove(player.getUUID()),
+                1L
+            ));
+    }
+
+    private static void spawnPortalAnimation(final ServerPlayer player, final int phase) {
+        ServerLevel level = (ServerLevel) player.level();
+        double centerX = player.getX();
+        double centerY = player.getY() + 0.10;
+        double centerZ = player.getZ();
+
+        int points = 24;
+
+        // make the spiral become smaller
+        double radius = 1.05D - phase * 0.09D;
+        double rotation = phase * 0.75D;
+
+        for (int i = 0; i < points; i++) {
+            double progress = i / (double) (points - 1);
+            double y = centerY + progress * 2.0D;
+            double angle = progress * Math.PI * 4.0D + rotation;
+
+            // first spiral
+            double x1 = centerX + Math.cos(angle) * radius;
+            double z1 = centerZ + Math.sin(angle) * radius;
+
+            // second spiral
+            double x2 = centerX + Math.cos(angle + Math.PI) * radius;
+            double z2 = centerZ + Math.sin(angle + Math.PI) * radius;
+
+            level.sendParticles(ParticleTypes.PORTAL, x1, y, z1, 1, 0.02D, 0.02D, 0.02D, 0.03D);
+            level.sendParticles(ParticleTypes.REVERSE_PORTAL, x2, y, z2, 1, 0.02D, 0.02D, 0.02D, 0.03D);
+        }
+    }
+    // Tessera end - eyes of ender gamerule

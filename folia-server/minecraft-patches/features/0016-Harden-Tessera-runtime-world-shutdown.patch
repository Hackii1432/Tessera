@@ -17,6 +17,10 @@ import java.util.concurrent.TimeUnit;
 public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.util.TickThread {
 
     private static final Logger LOGGER = LogUtils.getClassLogger();
+    // Tessera - server shutdown must not close the same storage concurrently
+    // with a runtime snapshot/close thread.
+    private static final java.util.Set<java.util.concurrent.CompletableFuture<Void>> RUNTIME_OPERATIONS =
+        java.util.concurrent.ConcurrentHashMap.newKeySet();
 
     ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> shuttingDown;
     // Tessera start - runtime world lifecycle
@@ -60,6 +64,8 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
         final boolean save
     ) {
         final java.util.concurrent.CompletableFuture<Void> completion = new java.util.concurrent.CompletableFuture<>();
+        RUNTIME_OPERATIONS.add(completion);
+        completion.whenComplete((ignored, failure) -> RUNTIME_OPERATIONS.remove(completion));
         new RegionShutdownThread(
             "Tessera world close - " + world.getWorld().getName(),
             world,
@@ -72,6 +78,8 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
 
     public static java.util.concurrent.CompletableFuture<Void> flushRuntimeWorldSnapshot(final ServerLevel world) {
         final java.util.concurrent.CompletableFuture<Void> completion = new java.util.concurrent.CompletableFuture<>();
+        RUNTIME_OPERATIONS.add(completion);
+        completion.whenComplete((ignored, failure) -> RUNTIME_OPERATIONS.remove(completion));
         new RegionShutdownThread(
             "Tessera world snapshot - " + world.getWorld().getName(),
             world,
@@ -82,6 +90,35 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
         return completion;
     }
 
+    private static void tessera$awaitRuntimeOperations() {
+        final long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(60L);
+        while (!RUNTIME_OPERATIONS.isEmpty()) {
+            final java.util.concurrent.CompletableFuture<?>[] snapshot =
+                RUNTIME_OPERATIONS.toArray(java.util.concurrent.CompletableFuture[]::new);
+            final long remaining = deadline - System.nanoTime();
+            if (remaining <= 0L) {
+                LOGGER.error(
+                    "{} runtime world lifecycle operation(s) did not stop before server world shutdown",
+                    RUNTIME_OPERATIONS.size()
+                );
+                return;
+            }
+            try {
+                java.util.concurrent.CompletableFuture.allOf(snapshot).get(
+                    Math.min(remaining, TimeUnit.SECONDS.toNanos(5L)),
+                    TimeUnit.NANOSECONDS
+                );
+            } catch (final java.util.concurrent.TimeoutException ignored) {
+                // Re-snapshot so operations which completed are discarded.
+            } catch (final java.util.concurrent.ExecutionException ignored) {
+                // Failed operations are still terminal and remove themselves.
+            } catch (final InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+    }
+
     private List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>>
     tessera$regions(final ServerLevel world) {
         final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions =
@@ -321,6 +358,7 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
             return;
         }
         // Tessera end - runtime world lifecycle
+        tessera$awaitRuntimeOperations(); // Tessera - avoid concurrent per-world storage close
         // await scheduler termination
         LOGGER.info("Awaiting scheduler termination for 60s...");
         if (TickRegions.getScheduler().halt(true, TimeUnit.SECONDS.toNanos(60L))) {
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 65110a19fdd43d991499f9a93545253ba4d95bab..ea345aca39301877fcd7ac7440816a3af4332b9f 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1062,6 +1062,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     public void stopServer() { // Folia - region threading - public
         // Folia start - region threading
+        // Tessera start - runtime world lifecycle
+        // Close the admission gate before the region scheduler is halted. Any
+        // already-started operation is reconciled by RegionShutdownThread.
+        if (this.server != null) {
+            this.server.tessera$beginRuntimeWorldManagerShutdown();
+        }
+        // Tessera end - runtime world lifecycle
         // halt scheduler
         // don't wait, we may be on a scheduler thread
         io.papermc.paper.threadedregions.TickRegions.getScheduler().halt(false, 0L);
@@ -1169,6 +1176,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         LOGGER.info("Waiting for all RegionFile I/O tasks to complete...");
         ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flush((MinecraftServer)(Object)this);
         LOGGER.info("All RegionFile I/O tasks to complete");
+        // Tessera start - runtime world lifecycle
+        // Only now may stop-interrupted API futures report SERVER_STOPPING:
+        // every world and global storage worker has completed its final flush.
+        if (this.server != null) {
+            this.server.tessera$completeRuntimeWorldManagerShutdown();
+        }
+        // Tessera end - runtime world lifecycle
         if ((Object)this instanceof net.minecraft.server.dedicated.DedicatedServer) {
             ca.spottedleaf.moonrise.common.util.MoonriseCommon.haltExecutors();
         }

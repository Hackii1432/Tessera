+    // Tessera start - keep dragon collision lookups region-local
+    private List<Entity> getEntitiesOnCurrentRegion(
+        final ServerLevel level, final Entity except, final AABB boundingBox, final Predicate<? super Entity> predicate
+    ) {
+        final List<Entity> entities = Lists.newArrayList();
+        // The dragon's multipart hitboxes can temporarily point into another region (notably at the world origin on its first tick).
+        // Query the concurrent entity lookup and only expose entities owned by this tick thread to the collision handlers below.
+        level.moonrise$getEntityLookup().getEntities(except, boundingBox, entities, null);
+        entities.removeIf(entity -> !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(entity) || !predicate.test(entity));
+        return entities;
+    }
+    // Tessera end - keep dragon collision lookups region-local
+

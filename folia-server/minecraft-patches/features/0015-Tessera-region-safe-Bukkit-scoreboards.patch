+    private synchronized void broadcastAll(Packet<?> packet) {
+        this.broadcastAll(List.of(packet)); // Tessera - region-safe scoreboards
+    }
+
+    // Tessera start - region-safe scoreboards
+    private synchronized void broadcastAll(final Collection<? extends Packet<?>> packets) {
+        if (packets.isEmpty()) {
+            return;
+        }
+        final VersionedPacketBatch batch = new VersionedPacketBatch(
+            ++this.tessera$revision,
+            List.copyOf(packets)
+        );
+        for (final TesseraSubscriber subscriber : this.tessera$subscribers.values()) {
+            subscriber.enqueue(batch);
+        }
+    }
+
+    public synchronized VersionedPacketBatch tessera$fullSnapshot() {
+        final List<Packet<?>> packets = new ArrayList<>();
+        for (final PlayerTeam team : List.copyOf(this.getPlayerTeams())) {
+            packets.add(ClientboundSetPlayerTeamPacket.createAddOrModifyPacket(team, true));
+        }
+        final Set<Objective> objectives = Sets.newHashSet();
+        for (final DisplaySlot slot : DisplaySlot.values()) {
+            final Objective objective = this.getDisplayObjective(slot);
+            if (objective != null && objectives.add(objective)) {
+                packets.addAll(this.getStartTrackingPackets(objective));
+            }
+        }
+        return new VersionedPacketBatch(++this.tessera$revision, List.copyOf(packets));
+    }
+
+    public synchronized VersionedPacketBatch tessera$removalSnapshot() {
+        final List<Packet<?>> packets = new ArrayList<>();
+        final Set<Objective> objectives = Sets.newHashSet();
+        for (final DisplaySlot slot : DisplaySlot.values()) {
+            final Objective objective = this.getDisplayObjective(slot);
+            if (objective != null && objectives.add(objective)) {
+                packets.add(new ClientboundSetObjectivePacket(objective, ClientboundSetObjectivePacket.METHOD_REMOVE));
+            }
+        }
+        for (final PlayerTeam team : List.copyOf(this.getPlayerTeams())) {
+            packets.add(ClientboundSetPlayerTeamPacket.createRemovePacket(team));
+        }
+        return new VersionedPacketBatch(++this.tessera$revision, List.copyOf(packets));
+    }
+
+    public void tessera$subscribe(final CraftPlayer player) {
+        final TesseraSubscriber replacement = new TesseraSubscriber(player);
+        final TesseraSubscriber previous = this.tessera$subscribers.put(player.getUniqueId(), replacement);
+        if (previous != null) {
+            previous.retire();
+        }
+    }
+
+    public void tessera$unsubscribe(final UUID playerId) {
+        final TesseraSubscriber subscriber = this.tessera$subscribers.remove(playerId);
+        if (subscriber != null) {
+            subscriber.retire();
+        }
+    }
+
+    public void tessera$sendNow(final ServerPlayer player, final VersionedPacketBatch... batches) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(player, "Applying scoreboard snapshot");
+        if (player.connection == null) {
+            return;
+        }
+        for (final VersionedPacketBatch batch : batches) {
+            for (final Packet<?> packet : batch.packets) {
+                player.connection.send(packet);
+            }
+        }
+    }
+
+    public record VersionedPacketBatch(long version, List<Packet<?>> packets) {
+        public VersionedPacketBatch {
+            packets = List.copyOf(packets);
+        }
+    }
+
+    private final class TesseraSubscriber {
+        private final CraftPlayer player;
+        private final Object lock = new Object();
+        private final List<Packet<?>> pendingPackets = new ArrayList<>();
+        private final AtomicBoolean scheduled = new AtomicBoolean();
+        private long pendingVersion;
+        private boolean retired;
+
+        private TesseraSubscriber(final CraftPlayer player) {
+            this.player = player;
+        }
+
+        private void enqueue(final VersionedPacketBatch batch) {
+            synchronized (this.lock) {
+                if (this.retired) {
+                    return;
+                }
+                this.pendingPackets.addAll(batch.packets);
+                this.pendingVersion = Math.max(this.pendingVersion, batch.version);
+            }
+            this.scheduleDelivery();
+        }
+
+        private void scheduleDelivery() {
+            if (!this.scheduled.compareAndSet(false, true)) {
+                return;
+            }
+            final boolean accepted = this.player.taskScheduler.schedule(
+                entity -> this.deliver((ServerPlayer)entity),
+                entity -> ServerScoreboard.this.tessera$subscribers.remove(this.player.getUniqueId(), this),
+                1L
+            );
+            if (!accepted) {
+                this.scheduled.set(false);
+                ServerScoreboard.this.tessera$subscribers.remove(this.player.getUniqueId(), this);
+            }
+        }
+
+        private void deliver(final ServerPlayer currentPlayer) {
+            final VersionedPacketBatch batch;
+            synchronized (this.lock) {
+                batch = new VersionedPacketBatch(this.pendingVersion, List.copyOf(this.pendingPackets));
+                this.pendingPackets.clear();
+                this.scheduled.set(false);
+                if (this.retired) {
+                    return;
+                }
+            }
+            final CraftPlayer current = currentPlayer.getBukkitEntity();
+            if (currentPlayer.connection == null
+                || current.getScoreboard().getHandle() != ServerScoreboard.this
+                || ServerScoreboard.this.tessera$subscribers.get(current.getUniqueId()) != this) {
+                ServerScoreboard.this.tessera$subscribers.remove(current.getUniqueId(), this);
+                return;
+            }
+            ServerScoreboard.this.tessera$sendNow(currentPlayer, batch);
+            synchronized (this.lock) {
+                if (!this.pendingPackets.isEmpty() && !this.retired) {
+                    this.scheduleDelivery();
+                }
+            }
+        }
+
+        private void retire() {
+            synchronized (this.lock) {
+                this.retired = true;
+                this.pendingPackets.clear();
             }
         }
     }
+    // Tessera end - region-safe scoreboards
     // CraftBukkit end
 }

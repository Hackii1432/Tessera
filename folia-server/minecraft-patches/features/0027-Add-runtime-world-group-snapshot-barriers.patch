From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Thu, 10 Sep 2026 00:52:10 +0200
Subject: [PATCH] Add runtime world group snapshot barriers


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 0c8b6276d16439ba9ebd4c5dd0dfcd166aadf56d..7a6121fb460bd88dae20acc252f65927cbcf8aec 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -731,6 +731,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         ACTIVE,
         INITIALIZING,
         QUIESCING,
+        SNAPSHOTTING,
         UNLOADING,
         CLOSED
     }
@@ -761,7 +762,10 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         final RuntimeLifecycleState state = this.tessera$runtimeLifecycleState.get();
         // INITIALIZING must process chunk preparation, and QUIESCING must
         // drain already accepted work up to the lifecycle barrier. New API
-        // admission remains restricted to ACTIVE in both cases.
+        // admission remains restricted to ACTIVE in both cases. SNAPSHOTTING
+        // deliberately suppresses normal ticks; TickRegions still drains its
+        // intermediate region/chunk/packet queues so snapshot barriers and
+        // owner-thread player saves can complete without blocking a region.
         return state == RuntimeLifecycleState.ACTIVE
             || state == RuntimeLifecycleState.INITIALIZING
             || state == RuntimeLifecycleState.QUIESCING;
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index c21d3f4a95c7ce84382d9ce47fa5a0451a36f53e..87a92c04dceac7408ed87508c98eb5594a09b49f 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -502,6 +502,18 @@ public abstract class PlayerList {
         }
     }
 
+    // Tessera start - fresh runtime world group snapshots
+    /**
+     * Flushes one connected player's vanilla data files for a runtime-world
+     * snapshot. The caller must schedule this method through the player's
+     * transferred entity scheduler, which supplies the current live handle.
+     */
+    public void tessera$savePlayerSnapshot(final ServerPlayer player) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(player, "Cannot snapshot player data off the owning region");
+        this.save(player);
+    }
+    // Tessera end - fresh runtime world group snapshots
+
     public net.kyori.adventure.text.@Nullable Component remove(final ServerPlayer player) { // CraftBukkit - return string // Paper - return Component
         // Paper start - Fix kick event leave message not being sent
         return this.remove(player, net.kyori.adventure.text.Component.translatable("multiplayer.player.left", net.kyori.adventure.text.format.NamedTextColor.YELLOW, io.papermc.paper.configuration.GlobalConfiguration.get().messages.useDisplayNameInQuitMessage ? player.getBukkitEntity().displayName() : io.papermc.paper.adventure.PaperAdventure.asAdventure(player.getDisplayName())));

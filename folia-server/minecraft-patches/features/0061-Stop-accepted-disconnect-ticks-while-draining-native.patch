         // Paper start - improve keepalives
         long now = System.nanoTime();
         io.papermc.paper.util.KeepAlive.PendingKeepAlive pending = this.keepAlive.pendingKeepAlives.peek();
@@ -257,7 +258,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         Profiler.get().push("keepAlive");
         long now = Util.getMillis();
         // Paper start - improve keepalives
-        if (this.checkIfClosed(now)) {
+        if (!this.connection.handleConnectionDisconnectOnNextTick && this.checkIfClosed(now)) { // Tessera - do not retry an accepted disconnect
             long currTime = System.nanoTime();
 
             if ((currTime - this.keepAlive.lastKeepAliveTx) >= java.util.concurrent.TimeUnit.SECONDS.toNanos(1L)) {
@@ -270,7 +271,6 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
 
             io.papermc.paper.util.KeepAlive.PendingKeepAlive oldest = this.keepAlive.pendingKeepAlives.peek();
             if (oldest != null && (currTime - oldest.txTimeNS()) > java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(KEEPALIVE_LIMIT)) {
-                LOGGER.info("{} was kicked due to keepalive timeout!", this.playerProfile().name());
                 this.disconnect(TIMEOUT_DISCONNECTION_MESSAGE, io.papermc.paper.connection.DisconnectionReason.TIMEOUT); // Paper - kick event cause
                 // Paper end - improve keepalives
             }
@@ -341,7 +341,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
 
     public void disconnect(final DisconnectionDetails details) {
         // CraftBukkit start - fire PlayerKickEvent
-        if (!this.connection.isConnected()) {
+        if (!this.connection.isConnected() || this.connection.handleConnectionDisconnectOnNextTick) { // Tessera - accepted disconnect is idempotent
             return;
         }
         // Folia start - region threading
@@ -402,9 +402,15 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     }
 
     private void disconnect0(final DisconnectionDetails details) {
+        if (!this.connection.isConnected() || this.connection.handleConnectionDisconnectOnNextTick) return; // Tessera - kick listeners may have accepted a reentrant disconnect
+        // Tessera start - seal an accepted disconnect before dispatching its packet; cancelled kicks never reach here.
+        this.connection.handleConnectionDisconnectOnNextTick = true;
+        if (details.disconnectionReason().filter(reason -> reason == io.papermc.paper.connection.DisconnectionReason.TIMEOUT).isPresent()) {
+            LOGGER.info("{} was kicked due to keepalive timeout!", this.playerProfile().name());
+        }
+        // Tessera end - seal an accepted disconnect
         this.connection.send(new ClientboundDisconnectPacket(details.reason()), PacketSendListener.thenRun(() -> this.connection.disconnect(details)));
         this.connection.setReadOnly();
-        this.connection.handleConnectionDisconnectOnNextTick = true; // Paper - Force kill connection ticking. Let this close the connection
     }
 
     // Paper start - add proper async disconnect

diff --git a/net/minecraft/util/datafix/fixes/SinopiaHiddenComponentsFix.java b/net/minecraft/util/datafix/fixes/SinopiaHiddenComponentsFix.java
new file mode 100644
index 0000000000000000000000000000000000000000..74e5e7686b2cf25ad90f83d44bf04e6551345a57
--- /dev/null
+++ b/net/minecraft/util/datafix/fixes/SinopiaHiddenComponentsFix.java
@@ -0,0 +1,55 @@
+package net.minecraft.util.datafix.fixes;
+
+import com.mojang.datafixers.DSL;
+import com.mojang.datafixers.DataFix;
+import com.mojang.datafixers.TypeRewriteRule;
+import com.mojang.datafixers.schemas.Schema;
+import com.mojang.serialization.Dynamic;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Paper's tooltip migration on Sinopia's active vanilla DFU backend. */
+public final class SinopiaHiddenComponentsFix extends DataFix {
+    private final String from;
+    private final List<String> replacements;
+
+    public SinopiaHiddenComponentsFix(final Schema schema, final String from, final String... replacements) {
+        super(schema, false);
+        this.from = from;
+        this.replacements = List.of(replacements);
+    }
+
+    @Override
+    protected TypeRewriteRule makeRule() {
+        return this.fixTypeEverywhereTyped("Sinopia hidden component " + this.from,
+            this.getInputSchema().getType(References.DATA_COMPONENTS),
+            input -> input.update(DSL.remainderFinder(), this::replaceHiddenComponent));
+    }
+
+    private <T> Dynamic<T> replaceHiddenComponent(final Dynamic<T> components) {
+        return components.update("minecraft:tooltip_display", tooltip -> tooltip.update("hidden_components", hidden -> {
+            final var stream = hidden.asStreamOpt().result();
+            if (stream.isEmpty()) return hidden;
+            final List<Dynamic<?>> values = new ArrayList<>(stream.get().toList());
+            if (values.stream().anyMatch(value -> value.asString().result().isEmpty())) return hidden;
+            int insertion = -1;
+            for (int i = values.size() - 1; i >= 0; --i) {
+                if (this.from.equals(namespace(values.get(i).asString().getOrThrow()))) {
+                    values.remove(i);
+                    insertion = i;
+                }
+            }
+            if (insertion < 0) return hidden;
+            for (final String replacement : this.replacements) {
+                if (values.stream().noneMatch(value -> replacement.equals(namespace(value.asString().getOrThrow())))) {
+                    values.add(insertion++, hidden.createString(replacement));
+                }
+            }
+            return hidden.createList(values.stream());
+        }));
+    }
+
+    private static String namespace(final String name) {
+        return name.indexOf(':') < 0 ? "minecraft:" + name : name;
+    }
+}
diff --git a/net/minecraft/util/datafix/fixes/SinopiaStructureStateFix.java b/net/minecraft/util/datafix/fixes/SinopiaStructureStateFix.java
new file mode 100644
index 0000000000000000000000000000000000000000..436c6f037c9d92ab84cc04b4af2afcadf558b490
--- /dev/null
+++ b/net/minecraft/util/datafix/fixes/SinopiaStructureStateFix.java
@@ -0,0 +1,67 @@
+package net.minecraft.util.datafix.fixes;
+
+import com.mojang.datafixers.DSL;
+import com.mojang.datafixers.DataFix;
+import com.mojang.datafixers.TypeRewriteRule;
+import com.mojang.datafixers.schemas.Schema;
+import com.mojang.serialization.Dynamic;
+import java.util.function.UnaryOperator;
+
+/** Migrate block states embedded in structure-start remainders, not arbitrary NBT. */
+public final class SinopiaStructureStateFix extends DataFix {
+    public SinopiaStructureStateFix(final Schema schema) {
+        super(schema, false);
+    }
+
+    @Override
+    protected TypeRewriteRule makeRule() {
+        return this.fixTypeEverywhereTyped("Sinopia embedded structure block states",
+            this.getInputSchema().getType(References.STRUCTURE_FEATURE),
+            input -> input.update(DSL.remainderFinder(), structure -> structure.update("Children", children -> list(children, SinopiaStructureStateFix::child))));
+    }
+
+    private static <T> Dynamic<T> child(Dynamic<T> child) {
+        for (final String field : new String[] {"CA", "CB", "CC", "CD"}) {
+            child = child.update(field, SinopiaStructureStateFix::state);
+        }
+        return child.update("pool_element", SinopiaStructureStateFix::pool);
+    }
+
+    private static <T> Dynamic<T> state(final Dynamic<T> state) {
+        return state.renameField("Name", "id").renameField("Properties", "properties");
+    }
+
+    private static <T> Dynamic<T> pool(final Dynamic<T> element) {
+        return element.update("elements", elements -> list(elements, SinopiaStructureStateFix::pool))
+            .update("processors", processors -> processors.asStreamOpt().result().isPresent()
+                ? list(processors, SinopiaStructureStateFix::processor)
+                : processors.update("processors", entries -> list(entries, SinopiaStructureStateFix::processor)));
+    }
+
+    private static <T> Dynamic<T> processor(final Dynamic<T> processor) {
+        return switch (namespace(processor.get("processor_type").asString(""))) {
+            case "minecraft:rule" -> processor.update("rules", rules -> list(rules, rule -> rule
+                .update("input_predicate", SinopiaStructureStateFix::test)
+                .update("location_predicate", SinopiaStructureStateFix::test)
+                .update("output_state", SinopiaStructureStateFix::state)));
+            case "minecraft:block_ignore" -> processor.update("blocks", blocks -> list(blocks, SinopiaStructureStateFix::state));
+            case "minecraft:capped" -> processor.update("delegate", SinopiaStructureStateFix::processor);
+            default -> processor;
+        };
+    }
+
+    private static <T> Dynamic<T> test(final Dynamic<T> test) {
+        return switch (namespace(test.get("predicate_type").asString(""))) {
+            case "minecraft:blockstate_match", "minecraft:random_blockstate_match" -> test.update("block_state", SinopiaStructureStateFix::state);
+            default -> test;
+        };
+    }
+
+    private static <T> Dynamic<T> list(final Dynamic<T> value, final UnaryOperator<Dynamic<T>> visitor) {
+        return value.asStreamOpt().result().map(stream -> value.createList(stream.map(visitor))).orElse(value);
+    }
+
+    private static String namespace(final String name) {
+        return name.indexOf(':') < 0 ? "minecraft:" + name : name;
+    }
+}

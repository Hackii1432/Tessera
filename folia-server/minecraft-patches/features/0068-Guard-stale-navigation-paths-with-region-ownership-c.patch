     @Override
     public void tick() {
+        this.ensureNavigationOwner(); // Tessera - the fallback also mutates the mob's controls
         if (!this.isDone()) {
             super.tick();
         } else {
             if (this.pathToPosition != null) {
+                // Tessera start - do not retain foreign fallback steering after path invalidation
+                if (!this.isRegionSafeNavigationPosition(this.pathToPosition)) {
+                    this.pathToPosition = null;
+                    this.stopForRegionSafety();
+                    return;
+                }
+                // Tessera end - do not retain foreign fallback steering after path invalidation
                 if (!this.pathToPosition.closerToCenterThan(this.mob.position(), this.mob.getBbWidth())
                     && (
                         !(this.mob.getY() > this.pathToPosition.getY())
diff --git a/net/minecraft/world/level/PathNavigationRegion.java b/net/minecraft/world/level/PathNavigationRegion.java
index 24e82cff2bc2908852bcd4f1367b54690a65e2da..f6848ab7a1d6f5d0098b28c96a6052f5a13d5ca2 100644

         for (int xc = this.centerX; xc <= xc2; xc++) {
             for (int zc = this.centerZ; zc <= zc2; zc++) {
-                this.chunks[xc - this.centerX][zc - this.centerZ] = chunkSource.getChunkNow(xc, zc);
+                // Tessera - a cache for recomputation must not expose another region's loaded chunks.
+                this.chunks[xc - this.centerX][zc - this.centerZ] = level instanceof net.minecraft.server.level.ServerLevel serverLevel
+                    && !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(serverLevel, xc, zc)
+                    ? null : chunkSource.getChunkNow(xc, zc);
             }
         }
 

+    // Tessera start - owned End portal falling-block tick continuation
+    private boolean tessera$runTickPrefix(final Block block) {
+        if (this.tessera$continuationOnly) {
+            return false;
+        }
+        this.time++;
+        this.applyGravity();
+        this.move(MoverType.SELF, this.getDeltaMovement());
+        this.applyEffectsFromBlocks();
+        // Paper - Configurable falling blocks height nerf (unchanged)
+        if (this.level().paperConfig().fixes.fallingBlockHeightNerf.test(v -> this.getY() > v)) {
+            if (this.dropItem && this.level() instanceof final ServerLevel serverLevel && serverLevel.getGameRules().get(GameRules.ENTITY_DROPS)) {
+                this.spawnAtLocation(serverLevel, block);
+            }
+            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.OUT_OF_WORLD);
+            return true;
+        }
+        if (this.isAlive()
+            && io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.allowUnsafeEndPortalTeleportation
+            && this.portalProcess != null
+            && this.portalProcess.isSamePortal((net.minecraft.world.level.block.Portal) Blocks.END_PORTAL)) {
+            this.tessera$insidePortalTick = true;
+            this.tessera$skipPostTickPortal = true;
+            try {
+                super.handlePortal();
+            } finally {
+                this.tessera$insidePortalTick = false;
+            }
+            return this.tessera$portalContinuation != null || this.isRemoved();
+        }
+        return false;
+    }
+
+    @Override
+    public boolean handlePortal() {
+        if (this.tessera$skipPostTickPortal || this.tessera$portalContinuation != null || this.tessera$continuationOnly) {
+            this.tessera$skipPostTickPortal = false;
+            return false;
+        }
+        return super.handlePortal();
+    }
+
+    @Override
+    protected boolean canTeleportAsync() {
+        // The one-shot source tail is not another transferable falling block.
+        return !this.tessera$continuationOnly && super.canTeleportAsync();
+    }
+
+    @Override
+    protected void tessera$portalTransferQueued(final ServerLevel origin, final ServerLevel destination, final Entity.PortalType type) {
+        // No passenger trees, unrelated teleports, Nether portals or plugin redirection
+        // to a non-End dimension. The disabled setting follows Folia's existing path.
+        if (!this.tessera$insidePortalTick || type != Entity.PortalType.END || origin == destination
+            || (origin.dimension() != Level.END && destination.dimension() != Level.END)
+            || this.isPassenger() || this.isVehicle()
+            || !io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.allowUnsafeEndPortalTeleportation) {
+            return;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot capture falling-block portal continuation off owner");
+        final FallingBlockEntity continuation = new FallingBlockEntity(EntityTypes.FALLING_BLOCK, origin);
+        // Entity.restoreFrom also forwards the Bukkit handle. A continuation MUST
+        // NOT steal that handle, its scheduler, UUID or passenger tree.
+        try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(this.problemPath(), LOGGER)) {
+            TagValueOutput output = TagValueOutput.createWithContext(reporter, this.registryAccess());
+            this.saveWithoutId(output);
+            continuation.load(TagValueInput.create(reporter, origin.registryAccess(), output.buildResult()));
+        }
+        continuation.setUUID(java.util.UUID.randomUUID());
+        continuation.portalProcess = null;
+        continuation.forceTickAfterTeleportToDuplicate = false;
+        continuation.tessera$continuationOnly = true;
+        continuation.setStartPos(this.getStartPos());
+        continuation.setDeltaMovement(this.getDeltaMovement());
+        continuation.xo = this.xo;
+        continuation.yo = this.yo;
+        continuation.zo = this.zo;
+        continuation.xOld = this.xOld;
+        continuation.yOld = this.yOld;
+        continuation.zOld = this.zOld;
+        continuation.onGround = this.onGround;
+        continuation.horizontalCollision = this.horizontalCollision;
+        continuation.verticalCollision = this.verticalCollision;
+        continuation.verticalCollisionBelow = this.verticalCollisionBelow;
+        continuation.minorHorizontalCollision = this.minorHorizontalCollision;
+        this.tessera$portalContinuation = continuation;
+    }
+
+    @Override
+    protected @Nullable Runnable tessera$finishPortalPreparation(final boolean transferring) {
+        final FallingBlockEntity continuation = this.tessera$portalContinuation;
+        this.tessera$portalContinuation = null;
+        if (continuation == null || !transferring
+            || !io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.allowUnsafeEndPortalTeleportation
+            || this.level() != continuation.level() || !this.position().equals(continuation.position())) {
+            return null;
+        }
+        final ServerLevel origin = (ServerLevel) continuation.level();
+        // A plugin/piston can move the original during preparation. Never route a
+        // stale frame across owners, or revive it in an unloading/replaced world.
+        if (!origin.tessera$isRuntimeWorldActive()
+            || origin.getServer().getLevel(origin.dimension()) != origin
+            || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(origin,
+                continuation.getBoundingBox().minmax(new net.minecraft.world.phys.AABB(
+                    continuation.xo, continuation.yo, continuation.zo, continuation.xo, continuation.yo, continuation.zo)).inflate(1.0))) {
+            return null;
+        }
+        return () -> {
+            try {
+                origin.addDuringTeleport(continuation);
+                if (!continuation.hasNullCallback() && !continuation.isRemoved()) {
+                    continuation.tick();
+                }
+            } finally {
+                if (!continuation.isRemoved()) {
+                    continuation.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+                }
+            }
+        };
+    }
+    // Tessera end - owned End portal falling-block tick continuation
+
     @Override
     public boolean causeFallDamage(final double fallDistance, final float damageModifier, final DamageSource damageSource) {
         if (!this.hurtEntities) {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hackii1432 <hunter122@hotmail.de>
Date: Tue, 29 Sep 2026 21:29:36 +0200
Subject: [PATCH] Restore opt-in End portal duplication with owned tick
 continuations

Resume the vanilla landing tail on a separately registered source entity instead of ticking the removed original. Preserve Tessera asynchronous portal preflight, plugin vetoes and wrapper ownership. Continuation approach informed by CraftCanvasMC/Canvas PR 307; implemented against Tessera's deferred transfer lifecycle.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index e75d4e2c357adc8b3114e703b4399ecabd132eec..45f013550528199af36eadd3d840741d3f493325 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -5052,6 +5052,15 @@ public abstract class Entity
 
     }
 
+    // Tessera start - owned End portal falling-block tick continuation
+    protected void tessera$portalTransferQueued(ServerLevel origin, ServerLevel destination, PortalType type) {
+    }
+
+    protected @Nullable Runnable tessera$finishPortalPreparation(boolean transferring) {
+        return null;
+    }
+    // Tessera end - owned End portal falling-block tick continuation
+
     protected boolean portalToAsync(ServerLevel destination, BlockPos portalPos, boolean takePassengers,
                                     PortalType type, AsyncPortalTarget target,
                                     java.util.function.Consumer<Entity> teleportComplete) {
@@ -5076,6 +5085,7 @@ public abstract class Entity
                     if (throwable != null || info == null || current.level() != originWorld
                         || !isUsablePortalTarget(destination)
                         || !current.canPortalAsync(destination, takePassengers)) {
+                        current.tessera$finishPortalPreparation(false); // Tessera - resume a suspended falling-block tick on failure
                         if (teleportComplete != null) {
                             teleportComplete.accept(null);
                         }
@@ -5097,7 +5107,16 @@ public abstract class Entity
             }
         });
 
-        this.findOrCreatePortalAsync(originWorld, portalPos, destination, type, target, portalInfoCompletable);
+        // Tessera start - capture only after portal events/admission, on the source owner
+        try {
+            this.tessera$portalTransferQueued(originWorld, destination, type);
+            this.findOrCreatePortalAsync(originWorld, portalPos, destination, type, target, portalInfoCompletable);
+        } catch (RuntimeException | Error failure) {
+            this.tessera$portalTransferPending = false;
+            this.tessera$finishPortalPreparation(false);
+            throw failure;
+        }
+        // Tessera end - capture only after portal events/admission, on the source owner
 
         return true;
     }
@@ -5111,6 +5130,7 @@ public abstract class Entity
         final java.util.function.Consumer<Entity> teleportComplete
     ) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot complete portal transfer off the owning region");
+        final Runnable sourceContinuation = this.tessera$finishPortalPreparation(true); // Tessera - before wrapper forwarding/removal
         final EntityTreeNode passengerTree = this.detachPassengers();
         final List<EntityTreeNode> fullPassengerTree = passengerTree.getFullTree();
         for (final EntityTreeNode node : fullPassengerTree) {
@@ -5136,6 +5156,11 @@ public abstract class Entity
                 }
             }
         );
+        // Tessera start - never tick the removed original or touch the destination here
+        if (sourceContinuation != null) {
+            sourceContinuation.run();
+        }
+        // Tessera end - owned End portal falling-block tick continuation
     }
     // Folia end - region threading
 

diff --git a/net/minecraft/world/clock/ServerClockManager.java b/net/minecraft/world/clock/ServerClockManager.java
index 60adf82ee5b5a71d7d54fe51728dba052eba1e82..523eb36c8b587923e5ef22e371cc71cc77b8a65e 100644
--- a/net/minecraft/world/clock/ServerClockManager.java
+++ b/net/minecraft/world/clock/ServerClockManager.java
@@ -173,13 +173,23 @@ public class ServerClockManager extends SavedData implements ClockManager {
 
     // Paper start - per-world time; per-player time
     private void broadcastUpdates(final Holder<WorldClock> clock, final ServerClockManager.ServerClockInstance instance) {
+        // Folia start - snapshot the clock globally, resolve player overrides only on the owner
+        final long gameTime = this.getGameTime();
+        final ClockNetworkState state = instance.packNetworkState(this.advanceTime());
         for (final net.minecraft.server.level.ServerPlayer player : this.level != null ? this.level.players() : this.server.getPlayerList().getPlayers()) {
-            final var packet = new net.minecraft.network.protocol.game.ClientboundSetTimePacket(
-                this.getGameTime(),
-                java.util.Map.of(clock, this.packNetworkState(clock, instance, player))
-            );
-            player.connection.send(packet);
+            player.getBukkitEntity().taskScheduler.schedule(current -> {
+                final net.minecraft.server.level.ServerPlayer owned = (net.minecraft.server.level.ServerPlayer) current;
+                if (owned.level().clockManager() != this) return; // dimension/configuration changed before dispatch
+                ClockNetworkState playerState = state;
+                if (owned.level().dimensionType().defaultClock().filter(clock::equals).isPresent()) {
+                    final long time = owned.relativeTime ? state.totalTicks() + owned.timeOffset
+                        : state.totalTicks() - state.totalTicks() % net.minecraft.SharedConstants.TICKS_PER_GAME_DAY + owned.timeOffset;
+                    playerState = new ClockNetworkState(time, state.partialTick(), owned.relativeTime ? state.rate() : 0.0F);
+                }
+                owned.connection.send(new ClientboundSetTimePacket(gameTime, Map.of(clock, playerState)));
+            }, null, 1L);
         }
+        // Folia end - snapshot the clock globally, resolve player overrides only on the owner
     }
 
     private ClockNetworkState packNetworkState(

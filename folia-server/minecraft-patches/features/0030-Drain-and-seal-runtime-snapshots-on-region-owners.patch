             LOGGER.error("Couldn't save stats to {}", this.file, e);
         }
     }
diff --git a/net/minecraft/world/level/storage/PlayerDataStorage.java b/net/minecraft/world/level/storage/PlayerDataStorage.java
index eddb6ebe3fa50a818e54079b73ba117be0abd195..0b3ab028ca5d58026a6ae41f0602d73423305929 100644
--- a/net/minecraft/world/level/storage/PlayerDataStorage.java
+++ b/net/minecraft/world/level/storage/PlayerDataStorage.java
@@ -31,6 +31,10 @@ public class PlayerDataStorage {
     }
 
     public void save(final Player player) {
+        this.tessera$save(player, false);
+    }
+
+    public void tessera$save(final Player player, final boolean snapshot) {
         if (org.spigotmc.SpigotConfig.disablePlayerDataSaving) return; // Spigot
         try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(player.problemPath(), LOGGER)) {
             TagValueOutput output = TagValueOutput.createWithContext(reporter, player.registryAccess());
@@ -41,8 +45,13 @@ public class PlayerDataStorage {
             NbtIo.writeCompressed(dataToStore, tmpFile);
             Path realFile = playerDirPath.resolve(player.getStringUUID() + ".dat");
             Path oldFile = playerDirPath.resolve(player.getStringUUID() + ".dat_old");
-            Util.safeReplaceFile(realFile, tmpFile, oldFile);
+            if (!Util.safeReplaceOrMoveFile(realFile, tmpFile, oldFile, false) && snapshot) {
+                throw new java.io.IOException("Could not replace player data file " + realFile);
+            }
         } catch (Exception ignored) {
+            if (snapshot) {
+                throw new IllegalStateException("Could not snapshot player data for " + player.getStringUUID(), ignored);
+            }
             LOGGER.warn("Failed to save player data for {}", player.getPlainTextName(), ignored); // Paper - Print exception
         }
     }

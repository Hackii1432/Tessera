+    // Tessera start - runtime world lifecycle
+    /**
+     * Runtime lifecycle state is deliberately independent from chunk/region ownership.
+     * INITIALIZING and QUIESCING regions may drain internal tasks, but normal world
+     * ticks and new public scheduler work are only accepted while ACTIVE.
+     */
+    public enum RuntimeLifecycleState {
+        ACTIVE,
+        INITIALIZING,
+        QUIESCING,
+        UNLOADING,
+        CLOSED
+    }
+
+    private final java.util.concurrent.atomic.AtomicReference<RuntimeLifecycleState> tessera$runtimeLifecycleState =
+        new java.util.concurrent.atomic.AtomicReference<>(RuntimeLifecycleState.ACTIVE);
+
+    public RuntimeLifecycleState tessera$getRuntimeLifecycleState() {
+        return this.tessera$runtimeLifecycleState.get();
+    }
+
+    public boolean tessera$transitionRuntimeLifecycle(
+        final RuntimeLifecycleState expected,
+        final RuntimeLifecycleState update
+    ) {
+        return this.tessera$runtimeLifecycleState.compareAndSet(expected, update);
+    }
+
+    public void tessera$setRuntimeLifecycle(final RuntimeLifecycleState update) {
+        this.tessera$runtimeLifecycleState.set(java.util.Objects.requireNonNull(update, "update"));
+    }
+
+    public boolean tessera$isRuntimeWorldActive() {
+        return this.tessera$runtimeLifecycleState.get() == RuntimeLifecycleState.ACTIVE;
+    }
+
+    public boolean tessera$isAcceptingApiTasks() {
+        return this.tessera$isRuntimeWorldActive();
+    }
+
+    public void tessera$ensureAcceptingApiTasks(final String operation) {
+        final RuntimeLifecycleState state = this.tessera$runtimeLifecycleState.get();
+        if (state != RuntimeLifecycleState.ACTIVE) {
+            throw new IllegalStateException(
+                "World '" + this.getWorld().getName() + "' is " + state.name().toLowerCase(java.util.Locale.ROOT)
+                    + " and cannot accept " + operation
+            );
+        }
+    }
+    // Tessera end - runtime world lifecycle
+

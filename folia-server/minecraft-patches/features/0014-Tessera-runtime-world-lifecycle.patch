@@ -19,14 +19,178 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
     private static final Logger LOGGER = LogUtils.getClassLogger();
 
     ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> shuttingDown;
+    // Tessera start - runtime world lifecycle
+    private final ServerLevel runtimeWorld;
+    private final boolean runtimeSave;
+    private final boolean runtimeSnapshotOnly;
+    private final java.util.concurrent.CompletableFuture<Void> runtimeCompletion;
+    // Tessera end - runtime world lifecycle
 
     public RegionShutdownThread(final String name) {
         super(name);
+        // Tessera start - runtime world lifecycle
+        this.runtimeWorld = null;
+        this.runtimeSave = false;
+        this.runtimeSnapshotOnly = false;
+        this.runtimeCompletion = null;
+        // Tessera end - runtime world lifecycle
         this.setUncaughtExceptionHandler((thread, thr) -> {
             LOGGER.error("Error shutting down server", thr);
         });
     }
 
+    // Tessera start - runtime world lifecycle
+    private RegionShutdownThread(
+        final String name,
+        final ServerLevel runtimeWorld,
+        final boolean runtimeSave,
+        final boolean runtimeSnapshotOnly,
+        final java.util.concurrent.CompletableFuture<Void> runtimeCompletion
+    ) {
+        super(name);
+        this.runtimeWorld = runtimeWorld;
+        this.runtimeSave = runtimeSave;
+        this.runtimeSnapshotOnly = runtimeSnapshotOnly;
+        this.runtimeCompletion = runtimeCompletion;
+        this.setDaemon(true);
+    }
+
+    public static java.util.concurrent.CompletableFuture<Void> closeRuntimeWorld(
+        final ServerLevel world,
+        final boolean save
+    ) {
+        final java.util.concurrent.CompletableFuture<Void> completion = new java.util.concurrent.CompletableFuture<>();
+        new RegionShutdownThread(
+            "Tessera world close - " + world.getWorld().getName(),
+            world,
+            save,
+            false,
+            completion
+        ).start();
+        return completion;
+    }
+
+    public static java.util.concurrent.CompletableFuture<Void> flushRuntimeWorldSnapshot(final ServerLevel world) {
+        final java.util.concurrent.CompletableFuture<Void> completion = new java.util.concurrent.CompletableFuture<>();
+        new RegionShutdownThread(
+            "Tessera world snapshot - " + world.getWorld().getName(),
+            world,
+            true,
+            true,
+            completion
+        ).start();
+        return completion;
+    }
+
+    private List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>>
+    tessera$regions(final ServerLevel world) {
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions =
+            new ArrayList<>();
+        world.regioniser.computeForAllRegions(regions::add);
+        return regions;
+    }
+
+    private void tessera$saveRegion(
+        final ServerLevel world,
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region,
+        final boolean first,
+        final boolean last,
+        final boolean shutdown
+    ) {
+        this.shuttingDown = region;
+        try {
+            world.moonrise$getChunkTaskScheduler().chunkHolderManager.saveAllChunksRegionised(
+                true,
+                shutdown,
+                false,
+                false,
+                first,
+                last,
+                false
+            );
+        } finally {
+            this.shuttingDown = null;
+        }
+    }
+
+    private void tessera$flushSnapshot(final ServerLevel world) throws Exception {
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions =
+            this.tessera$regions(world);
+        for (int i = 0; i < regions.size(); ++i) {
+            this.tessera$saveRegion(world, regions.get(i), i == 0, (i + 1) == regions.size(), false);
+        }
+        world.saveLevelData(true);
+        ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flush(world);
+        ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flushRegionStorages(world);
+    }
+
+    private void tessera$closeRuntimeWorld(final ServerLevel world, final boolean save) throws Exception {
+        final var holderManager = world.moonrise$getChunkTaskScheduler().chunkHolderManager;
+        holderManager.close(false, true, true, false, false);
+
+        final List<ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>> regions =
+            this.tessera$regions(world);
+        for (final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region : regions) {
+            this.finishTeleportations(region, world);
+        }
+
+        if (regions.isEmpty()) {
+            holderManager.close(save, true, false, true, false);
+        } else {
+            for (int i = 0; i < regions.size(); ++i) {
+                final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region = regions.get(i);
+                this.shuttingDown = region;
+                try {
+                    holderManager.close(save, true, false, (i + 1) == regions.size(), false);
+                } finally {
+                    this.shuttingDown = null;
+                }
+            }
+        }
+
+        if (save) {
+            world.saveLevelData(true);
+        }
+        world.getDataStorage().close();
+    }
+
+    private void tessera$runRuntimeLifecycle() {
+        Throwable failure = null;
+        try {
+            if (this.runtimeSnapshotOnly) {
+                this.tessera$flushSnapshot(this.runtimeWorld);
+            } else {
+                this.tessera$closeRuntimeWorld(this.runtimeWorld, this.runtimeSave);
+            }
+        } catch (final Throwable throwable) {
+            failure = throwable;
+            LOGGER.error(
+                "Runtime world {} failed for '{}'",
+                this.runtimeSnapshotOnly ? "snapshot" : "close",
+                this.runtimeWorld.getWorld().getName(),
+                throwable
+            );
+            if (!this.runtimeSnapshotOnly) {
+                try {
+                    this.runtimeWorld.getDataStorage().close();
+                } catch (final Throwable closeFailure) {
+                    throwable.addSuppressed(closeFailure);
+                }
+            }
+        } finally {
+            if (!this.runtimeSnapshotOnly) {
+                this.runtimeWorld.tessera$setRuntimeLifecycle(ServerLevel.RuntimeLifecycleState.CLOSED);
+            }
+        }
+
+        if (failure == null) {
+            this.runtimeCompletion.complete(null);
+        } else {
+            this.runtimeCompletion.completeExceptionally(failure);
+        }
+    }
+    // Tessera end - runtime world lifecycle
+

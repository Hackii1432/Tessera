@@ -68,6 +68,7 @@ public final class WorldPregenerator {
         return thread;
     });
     private final Map<Long, Job> jobs = new LinkedHashMap<>();
+    private final PregenerationHistory history = new PregenerationHistory(); // Tessera - metadata executor owns retention
     private final Map<ServerLevel, Integer> blockedWorlds = new HashMap<>();
     private final List<Drain> drains = new ArrayList<>();
     private final CompletableFuture<Void> ready = new CompletableFuture<>();
@@ -75,6 +76,8 @@ public final class WorldPregenerator {
     private long nextId = 1;
     private long lastCheckpoint;
     private long lastPressureSample;

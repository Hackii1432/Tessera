     private boolean pressure;
     private boolean memoryCritical;
@@ -88,7 +91,7 @@ public final class WorldPregenerator {
     public record View(long id, String world, String dimension, String state, Mode mode, long total, long generated,
                        long existing, int inFlight, double rate, boolean frozen, String detail) {}
     private record Checkpoint(int format, long id, Plan plan, State state, long cursor,
-                              long generated, long existing, String detail) {}
+                              long generated, long existing, String detail, boolean drained) {}
     private record Resolved(Plan plan, ServerLevel world) {}
     private record Drain(List<ServerLevel> worlds, CompletableFuture<LifecycleLease> result) {}
 
@@ -123,7 +126,7 @@ public final class WorldPregenerator {
             this.scan = plan.area().cursor(0);
         }
         Checkpoint checkpoint() {
-            return new Checkpoint(1, id, plan, state, cursor, generated, existing, detail);
+            return new Checkpoint(1, id, plan, state, cursor, generated, existing, detail, slots.isEmpty());

@@ -456,7 +459,7 @@ public final class WorldPregenerator {
                     job.cursor = job.plan.area().scanLimit();
                     job.state = State.COMPLETING;
                     final Checkpoint complete = new Checkpoint(1, job.id, job.plan, State.COMPLETED,
-                        job.cursor, job.generated, job.existing, "");
+                        job.cursor, job.generated, job.existing, "", true);
                     persist(complete).whenComplete((ignored, failure) -> controller.execute(() -> {
                         if (failure != null) fail(job, failure);
                         else {
@@ -692,13 +695,35 @@ public final class WorldPregenerator {
     private CompletableFuture<Void> persist(final Checkpoint checkpoint) {
         return CompletableFuture.runAsync(() -> {
             try {
-                PregenerationCheckpoint.write(directory.resolve(checkpoint.id() + ".json"), JSON.toJson(checkpoint));
+                // CANCELLING checkpoints can still precede a native failure. Do not prune
+                // or reject further writes until all admitted slots have actually drained.
+                final boolean finished = terminal(checkpoint.state()) && checkpoint.drained();
+                if (history.shouldWrite(checkpoint.id(), finished)) {
+                    PregenerationCheckpoint.write(directory.resolve(checkpoint.id() + ".json"), JSON.toJson(checkpoint));
+                }
+                history.published(checkpoint.id(), finished);
+                pruneHistory();
             } catch (final IOException failure) {
                 throw new java.io.UncheckedIOException(failure);
             }
         }, storage);
     }
 
+    private void pruneHistory() {
+        try {
+            history.prune(directory);
+            warnedHistory = false;
+        } catch (final IOException failure) {
+            // A cleanup failure must not turn an already durable job into a failed generation.
+            final long now = System.nanoTime();
+            if (!warnedHistory || now - lastHistoryWarning >= TimeUnit.SECONDS.toNanos(30)) {
+                LOGGER.warn("Could not remove obsolete finished pregeneration checkpoints", failure);
+                lastHistoryWarning = now;
+                warnedHistory = true;
+            }
+        }
+    }
+
     public static void finishShutdown() {
         final WorldPregenerator service = instance;
         if (service != null) {
@@ -742,6 +767,10 @@ public final class WorldPregenerator {
             throw new IllegalStateException("Could not recover pregeneration jobs", failure);
         }
         result.sort(java.util.Comparator.comparingLong(job -> job.id));
+        // A recovered terminal job has no surviving native work; legacy checkpoints
+        // without the optional drained field are therefore terminal here as well.
+        for (final Job job : result) history.published(job.id, terminal(job.state));
+        pruneHistory();
         return result;
     }
 

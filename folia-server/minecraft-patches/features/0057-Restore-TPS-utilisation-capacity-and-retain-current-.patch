+    private Component utilisation() {
+        double total = 0.0;
+        int samples = 0;
+        final RegionHealthSnapshot.Metrics global = snapshot.global();
+        if (global != null && global.valid()) {
+            total += global.utilisation();
+            ++samples;
+        }
+        for (final RegionHealthSnapshot.Region region : snapshot.regions()) {
+            final RegionHealthSnapshot.Metrics recent = region.recent();
+            if (recent != null && recent.valid()) {
+                total += recent.utilisation();
+                ++samples;
+            }
+        }
+        final int threads = Math.max(0, snapshot.threads());
+        final boolean measured = samples > 0 && Double.isFinite(total * 100.0);
+        return text("Utilisation (15 s): ")
+            .append(measured ? Component.text(number(total * 100.0) + "%", threads == 0
+                ? NamedTextColor.GRAY : CommandUtil.getUtilisationColourRegion(total / threads)) : hint("No measurements yet"))
+            .append(hint(" / ")).append(text(number(threads * 100.0) + "% max"))
+            .append(hint(" · Tick threads: " + threads))
+            .append(measured && samples < snapshot.regions().size() + 1 ? hint(" · Partial samples") : Component.empty())
+            .hoverEvent(hint("100% per tick thread; region plus global tick time, not CPU usage. Available samples only."));
+    }
+

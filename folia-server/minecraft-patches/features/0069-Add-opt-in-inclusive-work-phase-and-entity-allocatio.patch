diff --git a/dev/tessera/x/WorkTimings.java b/dev/tessera/x/WorkTimings.java
new file mode 100644
index 0000000000000000000000000000000000000000..eaa273214ec19c466d5cf242e7a48afaf3285c3f
--- /dev/null
+++ b/dev/tessera/x/WorkTimings.java
@@ -0,0 +1,44 @@
+package dev.tessera.x;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+import java.lang.management.ManagementFactory;
+
+/** Opt-in, process-wide inclusive wall-time diagnostics; disabled code performs no clock reads. */
+public final class WorkTimings {
+    public static final boolean ENABLED = Boolean.getBoolean("tessera-x.work-timings");
+    private static final ConcurrentHashMap<String, Counter> COUNTERS = new ConcurrentHashMap<>();
+    private static final com.sun.management.ThreadMXBean ALLOCATIONS = ENABLED
+        && ManagementFactory.getThreadMXBean() instanceof com.sun.management.ThreadMXBean bean ? bean : null;
+    private record Counter(LongAdder calls, LongAdder nanos, LongAdder allocated) {
+        Counter() { this(new LongAdder(), new LongAdder(), new LongAdder()); }
+    }
+    private WorkTimings() {}
+    public static long start() { return ENABLED ? System.nanoTime() : 0L; }
+    public static void stop(String name, long start) {
+        if (!ENABLED) return;
+        long elapsed = System.nanoTime() - start;
+        Counter counter = COUNTERS.computeIfAbsent(name, ignored -> new Counter());
+        counter.calls.increment(); counter.nanos.add(elapsed);
+    }
+    public static long allocatedStart() {
+        return ALLOCATIONS != null && ALLOCATIONS.isThreadAllocatedMemorySupported() && ALLOCATIONS.isThreadAllocatedMemoryEnabled()
+            ? ALLOCATIONS.getThreadAllocatedBytes(Thread.currentThread().threadId()) : -1L;
+    }
+    public static void allocatedStop(String name, long start) {
+        if (start < 0L) return;
+        long after = allocatedStart();
+        if (after >= start) COUNTERS.computeIfAbsent(name, ignored -> new Counter()).allocated.add(after - start);
+    }
+    public static Map<String, Long> metrics() {
+        Map<String, Long> result = new LinkedHashMap<>();
+        COUNTERS.forEach((name, counter) -> {
+            result.put("profile." + name + ".calls", counter.calls.sum());
+            result.put("profile." + name + ".nanos", counter.nanos.sum());
+            result.put("profile." + name + ".allocatedBytes", counter.allocated.sum());
+        });
+        return result;
+    }
+}

 public final class PoiAccess {
 
+    private static final boolean TESSERA_X_SCRATCH = Boolean.getBoolean("tessera-x.poi-scratch");
+    private static final ThreadLocal<SearchScratch> TESSERA_X_SEARCH = new ThreadLocal<>();
+    private static final class SearchScratch {
+        final LongArrayFIFOQueue queue = new LongArrayFIFOQueue();
+        final LongOpenHashSet seen = new LongOpenHashSet();
+        boolean busy;
+    }
+    private static SearchScratch acquireScratch() {
+        SearchScratch scratch = TESSERA_X_SEARCH.get();
+        if (scratch == null) { scratch = new SearchScratch(); TESSERA_X_SEARCH.set(scratch); }
+        else if (scratch.busy) scratch = new SearchScratch();
+        scratch.busy = true;
+        return scratch;
+    }
+    private static void releaseScratch(SearchScratch scratch) {
+        int visited = scratch.seen.size();
+        scratch.queue.clear(); scratch.seen.clear(); scratch.busy = false;
+        // Only primitive coordinates survive a call. Bound retained capacity on unusually broad searches.
+        if (visited > 8192 && TESSERA_X_SEARCH.get() == scratch) TESSERA_X_SEARCH.remove();
+    }
+
     public static final boolean LOAD_FOR_SEARCHING = true;
 

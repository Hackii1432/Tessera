+        final SearchScratch scratch = TESSERA_X_SCRATCH ? acquireScratch() : null;
+        final LongArrayFIFOQueue queue = scratch == null ? new LongArrayFIFOQueue() : scratch.queue;
+        final LongOpenHashSet seen = scratch == null ? new LongOpenHashSet() : scratch.seen;
+        try {
         seen.add(centerKey);
         queue.enqueue(centerKey);
 
@@ -550,6 +573,7 @@ public final class PoiAccess {
 
         // now we match perfectly what vanilla would have outputted, without having to search the whole radius (hopefully).
         ret.addAll(closestRecordsUnsorted);
+        } finally { if (scratch != null) releaseScratch(scratch); }
     }
 

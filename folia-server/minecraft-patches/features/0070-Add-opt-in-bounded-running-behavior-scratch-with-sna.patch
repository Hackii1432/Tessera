From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 12 Oct 2026 21:35:54 +0200
Subject: [PATCH] Add opt-in bounded running behavior scratch with snapshot and
 recursion semantics


diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 0f0561347601f38963540dac3c6dc861350603ed..caedfaf08bc1475e4426b98fdd3edb87a1c37519 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -36,6 +36,9 @@ import net.minecraft.world.phys.Vec3;
 import org.jspecify.annotations.Nullable;
 
 public class Brain<E extends LivingEntity> {
+    private static final boolean TESSERA_X_REUSE_RUNNING = Boolean.getBoolean("tessera-x.brain-scratch");
+    private @Nullable ObjectArrayList<BehaviorControl<? super E>> tesseraXRunningScratch;
+    private boolean tesseraXRunningScratchBusy;
     private static final int SCHEDULE_UPDATE_DELAY = 20;
     private final Map<MemoryModuleType<?>, MemorySlot<?>> memories = Maps.newHashMap();
     private final Map<SensorType<? extends Sensor<? super E>>, Sensor<? super E>> sensors = Maps.newLinkedHashMap();
@@ -269,7 +272,12 @@ public class Brain<E extends LivingEntity> {
         final long tesseraXTiming = dev.tessera.x.WorkTimings.start();
         try {
         List<BehaviorControl<? super E>> runningBehaviours = new ObjectArrayList<>();
+        this.tesseraX$collectRunning(runningBehaviours);
+        return runningBehaviours;
+        } finally { dev.tessera.x.WorkTimings.stop("brain.snapshot", tesseraXTiming); }
+    }
 
+    private void tesseraX$collectRunning(List<BehaviorControl<? super E>> runningBehaviours) {
         for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
             for (Set<BehaviorControl<? super E>> behaviors : behavioursByActivities.values()) {
                 for (BehaviorControl<? super E> behavior : behaviors) {
@@ -280,8 +288,6 @@ public class Brain<E extends LivingEntity> {
             }
         }
 
-        return runningBehaviours;
-            } finally { dev.tessera.x.WorkTimings.stop("brain.snapshot", tesseraXTiming); }
     }
 
     public void useDefaultActivity() {
@@ -456,6 +462,25 @@ public class Brain<E extends LivingEntity> {
     private void tickEachRunningBehavior(final ServerLevel level, final E body) {
         long timestamp = level.getGameTime();
 
+        if (TESSERA_X_REUSE_RUNNING && !this.tesseraXRunningScratchBusy) {
+            if (this.tesseraXRunningScratch == null) this.tesseraXRunningScratch = new ObjectArrayList<>();
+            this.tesseraXRunningScratchBusy = true;
+            try {
+                long timing = dev.tessera.x.WorkTimings.start();
+                try {
+                    this.tesseraX$collectRunning(this.tesseraXRunningScratch);
+                } finally { dev.tessera.x.WorkTimings.stop("brain.snapshot", timing); }
+                for (BehaviorControl<? super E> behavior : this.tesseraXRunningScratch) {
+                    behavior.tickOrStop(level, body, timestamp);
+                }
+            } finally {
+                int captured = this.tesseraXRunningScratch.size();
+                this.tesseraXRunningScratch.clear();
+                if (captured > 256) this.tesseraXRunningScratch = null;
+                this.tesseraXRunningScratchBusy = false;
+            }
+            return;
+        }
         for (BehaviorControl<? super E> behavior : this.getRunningBehaviors()) {
             behavior.tickOrStop(level, body, timestamp);
         }

Subject: [PATCH] Clear Nether travel origin on player death


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index c830858f6a7d87373a1bb811ff510610c0efc449..c84616d375c04a81171780ea549f30c00be1a0c8 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -3751,6 +3751,10 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
             this.newLevel = this.experienceLevel;
         }
 
+        // Tessera start - clear Nether travel origin on death
+        this.enteredNetherPosition = null;
+        // Tessera end - clear Nether travel origin on death
+
         this.setHealth(this.getMaxHealth());
         this.stopUsingItem(); // CraftBukkit - SPIGOT-6682: Clear active item on reset
         this.setAirSupply(this.getMaxAirSupply()); // Paper - Reset players airTicks on respawn

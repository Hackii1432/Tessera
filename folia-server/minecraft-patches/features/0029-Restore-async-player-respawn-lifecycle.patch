+    private static @Nullable AsyncAnchorReservation reserveAsyncAnchor(final ServerLevel world, final BlockPos pos) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(world, pos, "Cannot reserve respawn anchor off its region");
+        final BlockState state = world.getBlockState(pos);
+        if (!state.is(net.minecraft.world.level.block.Blocks.RESPAWN_ANCHOR)) {
+            return null;
+        }
+        final int charges = state.getValue(RespawnAnchorBlock.CHARGE);
+        if (charges <= 0) {
+            return null;
+        }
+
+        final AsyncAnchorKey key = new AsyncAnchorKey(world, pos.immutable());
+        final java.util.concurrent.atomic.AtomicBoolean acquired = new java.util.concurrent.atomic.AtomicBoolean();
+        ASYNC_ANCHOR_RESERVATIONS.compute(key, (ignored, reservations) -> {
+            final int current = reservations == null ? 0 : reservations;
+            if (current >= charges) {
+                return current;
+            }
+            acquired.set(true);
+            return current + 1;
         });
+        return acquired.get() ? new AsyncAnchorReservation(key) : null;
+    }
 

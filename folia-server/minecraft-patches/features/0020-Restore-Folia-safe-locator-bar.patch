+    private void publishWaypoint(final WaypointTransmitter waypoint, final PublicationMode mode) {
+        if (!(waypoint instanceof LivingEntity source)) {
+            return;
+        }
+
+        source.getBukkitEntity().taskScheduler.scheduleOrExecute(entity -> {
+            if (!(entity instanceof LivingEntity currentSource) || currentSource != source) {
+                return;
+            }
+
+            final UUID identifier = currentSource.getUUID();
+            if (currentSource.level() != this.level || currentSource.isRemoved() || !currentSource.isTransmittingWaypoint()) {
+                this.removePublishedWaypoint(identifier, currentSource);
+                return;
+            }
+
+            final WaypointSnapshot snapshot = WaypointSnapshot.capture(currentSource);
+            final AtomicBoolean changed = new AtomicBoolean();
+            this.waypoints.compute(identifier, (ignored, current) -> {
+                if (mode == PublicationMode.UPDATE && (current == null || current.source() != currentSource)) {
+                    return current;
+                }
+
+                final long connectionRevision = mode == PublicationMode.REMAKE
+                    ? (current == null ? 1L : current.connectionRevision() + 1L)
+                    : (current == null ? 0L : current.connectionRevision());
+                changed.set(true);
+                return new PublishedWaypoint(currentSource, snapshot, connectionRevision);
+            });
+            if (changed.get()) {
+                this.waypointsChanged();
+            }
+        });
+    }
+
+    private void removePublishedWaypoint(final UUID identifier, final LivingEntity source) {
+        final AtomicBoolean removed = new AtomicBoolean();
+        this.waypoints.computeIfPresent(identifier, (ignored, current) -> {
+            if (current.source() != source) {
+                return current;
+            }
+
+            removed.set(true);
+            return null;
+        });
+        if (removed.get()) {
+            this.waypointsChanged();
+        }
+    }
+
+    private void waypointsChanged() {
+        this.publicationRevision.incrementAndGet();
+        for (final ReceiverState state : this.players.values()) {
+            this.queueReceiverUpdate(state);
+        }
+    }
+
+    private void queueReceiverUpdate(final ReceiverState state) {
+        if (!state.active.get() || !state.updateQueued.compareAndSet(false, true)) {
+            return;
+        }
+
+        if (!state.player.getBukkitEntity().taskScheduler.schedule(
+            entity -> {
+                state.updateQueued.set(false);
+                if (!(entity instanceof ServerPlayer currentPlayer) || currentPlayer != state.player) {
+                    this.removeReceiverState(state);
+                    return;
                 }
+                this.synchronizeReceiver(currentPlayer, state);
+            },
+            entity -> this.removeReceiverState(state),
+            1L
+        )) {
+            this.removeReceiverState(state);
+        }
+    }
+
+    private void synchronizeReceiver(final ServerPlayer player, final ReceiverState state) {
+        if (!state.active.get() || this.players.get(player.getUUID()) != state) {
+            this.disconnectAll(player, state);
+            return;
+        }
+
+        if (state.clearRequested.getAndSet(false)) {
+            this.disconnectAll(player, state);
+        }
+
+        if (player.level() != this.level || player.isRemoved() || !player.isReceivingWaypoints() || player.connection == null || player.connection.isDisconnected()) {
+            if (this.players.remove(player.getUUID(), state)) {
+                state.active.set(false);
+            }
+            this.disconnectAll(player, state);
+            return;
+        }
+
+        if (!this.locatorBarEnabled) {
+            this.disconnectAll(player, state);
+            return;
+        }
+
+        final long revisionBefore = this.publicationRevision.get();
+        final List<PublishedWaypoint> published = new ArrayList<>(this.waypoints.values());
+        final Set<UUID> present = new HashSet<>();
+        for (final PublishedWaypoint waypoint : published) {
+            present.add(waypoint.snapshot().identifier());
+            this.synchronizeConnection(player, state, waypoint);
+        }
+
+        for (final UUID identifier : new ArrayList<>(state.connections.keySet())) {
+            if (!present.contains(identifier)) {
+                this.disconnect(player, state, identifier);
             }
         }
+
+        if (revisionBefore != this.publicationRevision.get()) {
+            this.queueReceiverUpdate(state);
+        }
+    }
+
+    private void synchronizeConnection(final ServerPlayer player, final ReceiverState state, final PublishedWaypoint published) {
+        final WaypointSnapshot waypoint = published.snapshot();
+        final UUID identifier = waypoint.identifier();
+        if (identifier.equals(player.getUUID()) || this.doesSourceIgnoreReceiver(waypoint, player)) {
+            this.disconnect(player, state, identifier);
+            return;
+        }
+
+        final SentConnection connection = state.connections.get(identifier);
+        if (connection == null
+            || connection.connectionRevision != published.connectionRevision()
+            || !connection.icon.matches(waypoint.icon())) {
+            this.replaceConnection(player, state, published);
+            return;
+        }
+
+        switch (connection.kind) {
+            case AZIMUTH -> {
+                if (this.isChunkVisible(waypoint.chunkPosition(), player) || !this.isReallyFar(waypoint, player)) {
+                    this.replaceConnection(player, state, published);
+                    return;
+                }
+
+                final float angle = this.calculateAzimuth(waypoint, player);
+                if (Mth.abs(angle - connection.lastAngle) > MINIMUM_AZIMUTH_CHANGE) {
+                    player.connection.send(ClientboundTrackedWaypointPacket.updateWaypointAzimuth(identifier, waypoint.icon().toIcon(), angle));
+                    connection.lastAngle = angle;
+                }
+            }
+            case BLOCK -> {
+                final BlockPos position = waypoint.blockPosition();
+                final int distance = connection.lastBlockPosition.distManhattan(position);
+                if (distance > 1) {
+                    this.replaceConnection(player, state, published);
+                } else if (distance > 0) {
+                    player.connection.send(ClientboundTrackedWaypointPacket.updateWaypointPosition(identifier, waypoint.icon().toIcon(), position));
+                    connection.lastBlockPosition = position;
+                }
+            }
+            case CHUNK -> {
+                final ChunkPos position = waypoint.chunkPosition();
+                final int distance = connection.lastChunkPosition.getChessboardDistance(position);
+                if (distance > 1 || this.isChunkVisible(connection.lastChunkPosition, player)) {
+                    this.replaceConnection(player, state, published);
+                } else if (distance > 0) {
+                    player.connection.send(ClientboundTrackedWaypointPacket.updateWaypointChunk(identifier, waypoint.icon().toIcon(), position));
+                    connection.lastChunkPosition = position;
+                }
+            }
+        }
+    }
+
+    private void replaceConnection(final ServerPlayer player, final ReceiverState state, final PublishedWaypoint published) {
+        final WaypointSnapshot waypoint = published.snapshot();
+        final UUID identifier = waypoint.identifier();
+        final SentConnection connection;
+        if (this.isReallyFar(waypoint, player)) {
+            final float angle = this.calculateAzimuth(waypoint, player);
+            player.connection.send(ClientboundTrackedWaypointPacket.addWaypointAzimuth(identifier, waypoint.icon().toIcon(), angle));
+            connection = SentConnection.azimuth(waypoint.icon(), published.connectionRevision(), angle);
+        } else if (!this.isChunkVisible(waypoint.chunkPosition(), player)) {
+            player.connection.send(ClientboundTrackedWaypointPacket.addWaypointChunk(identifier, waypoint.icon().toIcon(), waypoint.chunkPosition()));
+            connection = SentConnection.chunk(waypoint.icon(), published.connectionRevision(), waypoint.chunkPosition());
+        } else {
+            player.connection.send(ClientboundTrackedWaypointPacket.addWaypointPosition(identifier, waypoint.icon().toIcon(), waypoint.blockPosition()));
+            connection = SentConnection.block(waypoint.icon(), published.connectionRevision(), waypoint.blockPosition());
+        }
+        state.connections.put(identifier, connection);
+    }
+
+    private boolean doesSourceIgnoreReceiver(final WaypointSnapshot source, final ServerPlayer receiver) {
+        // CraftPlayer#canSee is receiver-owned state. The source wrapper is only used for its UUID/default visibility.
+        if (!receiver.getBukkitEntity().canSee(source.bukkitEntity())) {
+            return true;
+        }
+        if (receiver.isSpectator()) {
+            return false;
+        }
+        if (source.spectator() || source.indirectPassengers().contains(receiver.getUUID())) {
+            return true;
+        }
+
+        final double broadcastRange = Math.min(source.transmitRange(), receiver.getAttributeValue(Attributes.WAYPOINT_RECEIVE_RANGE));
+        return source.position().distanceToSqr(receiver.position()) >= Mth.square(broadcastRange);
+    }
+
+    private boolean isReallyFar(final WaypointSnapshot source, final ServerPlayer receiver) {
+        return source.position().distanceToSqr(receiver.position()) > REALLY_FAR_DISTANCE_SQUARED;
+    }
+
+    private boolean isChunkVisible(final ChunkPos chunkPosition, final ServerPlayer receiver) {
+        return WaypointTransmitter.isChunkVisible(chunkPosition, receiver);
+    }
+
+    private float calculateAzimuth(final WaypointSnapshot source, final ServerPlayer receiver) {
+        final Vec3 direction = receiver.position().subtract(source.position()).rotateClockwise90();
+        return (float)Mth.atan2(direction.z(), direction.x());
+    }
+
+    private void disconnect(final ServerPlayer player, final ReceiverState state, final UUID identifier) {
+        if (state.connections.remove(identifier) != null && player.connection != null && !player.connection.isDisconnected()) {
+            player.connection.send(ClientboundTrackedWaypointPacket.removeWaypoint(identifier));
+        }
+    }
+
+    private void disconnectAll(final ServerPlayer player, final ReceiverState state) {
+        if (state.connections.isEmpty()) {
+            return;
+        }
+
+        final boolean canSend = player.connection != null && !player.connection.isDisconnected();
+        for (final UUID identifier : new ArrayList<>(state.connections.keySet())) {
+            if (canSend) {
+                player.connection.send(ClientboundTrackedWaypointPacket.removeWaypoint(identifier));
+            }
+        }
+        state.connections.clear();
+    }
+
+    private void retireReceiver(final ReceiverState state) {
+        state.active.set(false);
+        state.player.getBukkitEntity().taskScheduler.scheduleOrExecute(entity -> {
+            if (entity instanceof ServerPlayer player) {
+                this.disconnectAll(player, state);
+            } else {
+                state.connections.clear();
+            }
+        });
+    }
+
+    private void removeReceiverState(final ReceiverState state) {
+        state.active.set(false);
+        state.updateQueued.set(false);
+        this.players.remove(state.player.getUUID(), state);
+        state.connections.clear();
+    }
+
+    private enum PublicationMode {
+        TRACK,
+        UPDATE,
+        REMAKE
+    }
+
+    private enum ConnectionKind {
+        AZIMUTH,
+        BLOCK,
+        CHUNK
+    }
+
+    private record PublishedWaypoint(LivingEntity source, WaypointSnapshot snapshot, long connectionRevision) {
+    }
+
+    private record WaypointSnapshot(
+        UUID identifier,
+        Vec3 position,
+        BlockPos blockPosition,
+        ChunkPos chunkPosition,
+        double transmitRange,
+        boolean spectator,
+        Set<UUID> indirectPassengers,
+        org.bukkit.entity.Entity bukkitEntity,
+        Component displayName,
+        IconSnapshot icon
+    ) {
+        private static WaypointSnapshot capture(final LivingEntity source) {
+            final Set<UUID> passengers = new HashSet<>();
+            for (final Entity passenger : source.getIndirectPassengers()) {
+                passengers.add(passenger.getUUID());
+            }
+
+            final Waypoint.Icon assignedIcon = source.waypointIcon().cloneAndAssignStyle(source);
+            return new WaypointSnapshot(
+                source.getUUID(),
+                source.position(),
+                source.blockPosition(),
+                source.chunkPosition(),
+                source.getAttributeValue(Attributes.WAYPOINT_TRANSMIT_RANGE),
+                source.isSpectator(),
+                Set.copyOf(passengers),
+                source.getBukkitEntity(),
+                source.getFeedbackDisplayName().copy(),
+                IconSnapshot.capture(assignedIcon)
+            );
+        }
+
+        private WaypointInfo toInfo() {
+            return new WaypointInfo(this.displayName, this.blockPosition, this.icon.color());
+        }
+    }
+
+    public record WaypointInfo(Component displayName, BlockPos blockPosition, Optional<Integer> color) {
+    }
+
+    private record IconSnapshot(ResourceKey<WaypointStyleAsset> style, Optional<Integer> color) {
+        private static IconSnapshot capture(final Waypoint.Icon icon) {
+            return new IconSnapshot(icon.style, icon.color);
+        }
+
+        private Waypoint.Icon toIcon() {
+            final Waypoint.Icon icon = new Waypoint.Icon();
+            icon.style = this.style;
+            icon.color = this.color;
+            return icon;
+        }
+
+        private boolean matches(final IconSnapshot other) {
+            return this.style.equals(other.style) && this.color.equals(other.color);
+        }
+    }
+
+    private static final class ReceiverState {
+        private final ServerPlayer player;
+        private final Map<UUID, SentConnection> connections = new HashMap<>();
+        private final AtomicBoolean active = new AtomicBoolean(true);
+        private final AtomicBoolean updateQueued = new AtomicBoolean();
+        private final AtomicBoolean clearRequested = new AtomicBoolean();
+
+        private ReceiverState(final ServerPlayer player) {
+            this.player = player;
+        }
+    }
+
+    private static final class SentConnection {
+        private final ConnectionKind kind;
+        private final IconSnapshot icon;
+        private final long connectionRevision;
+        private float lastAngle;
+        private BlockPos lastBlockPosition;
+        private ChunkPos lastChunkPosition;
+
+        private SentConnection(
+            final ConnectionKind kind,
+            final IconSnapshot icon,
+            final long connectionRevision,
+            final float lastAngle,
+            final BlockPos lastBlockPosition,
+            final ChunkPos lastChunkPosition
+        ) {
+            this.kind = kind;
+            this.icon = icon;
+            this.connectionRevision = connectionRevision;
+            this.lastAngle = lastAngle;
+            this.lastBlockPosition = lastBlockPosition;
+            this.lastChunkPosition = lastChunkPosition;
+        }
+
+        private static SentConnection azimuth(final IconSnapshot icon, final long revision, final float angle) {
+            return new SentConnection(ConnectionKind.AZIMUTH, icon, revision, angle, null, null);
+        }
+
+        private static SentConnection block(final IconSnapshot icon, final long revision, final BlockPos position) {
+            return new SentConnection(ConnectionKind.BLOCK, icon, revision, 0.0F, position, null);
+        }
+
+        private static SentConnection chunk(final IconSnapshot icon, final long revision, final ChunkPos position) {
+            return new SentConnection(ConnectionKind.CHUNK, icon, revision, 0.0F, null, position);
+        }
     }

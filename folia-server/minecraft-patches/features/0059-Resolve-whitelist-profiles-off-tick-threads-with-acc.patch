+    // Tessera start - await whitelist profiles outside all tick threads
+    private CompletableFuture<Void> tessera$scheduleWhitelistCommand(
+        final ParseResults<CommandSourceStack> command, final String commandString, final boolean throwCommandError,
+        final CommandSourceStack sender, final io.papermc.paper.command.WhitelistProfileLookup.Prepared lookup
+    ) {
+        final CompletableFuture<Void> completion = new CompletableFuture<>();
+        completion.orTimeout(15L, java.util.concurrent.TimeUnit.SECONDS);
+        final net.minecraft.world.entity.Entity sourceEntity = sender.getEntity();
+        final boolean refreshPlayerPermissions = sourceEntity instanceof net.minecraft.server.level.ServerPlayer player
+            && sender.source == player.commandSource();
+        final org.bukkit.craftbukkit.entity.CraftEntity sourceHandle = sourceEntity == null ? null : sourceEntity.getBukkitEntity();
+        lookup.result().whenComplete((outcome, lookupFailure) -> {
+            if (completion.isDone()) return;
+            lookup.argument().tessera$prepare(lookupFailure == null ? outcome
+                : new io.papermc.paper.command.WhitelistProfileLookup.Outcome(null, lookupFailure));
+            final java.util.function.Consumer<CommandSourceStack> resume = currentSource -> {
+                if (completion.isDone()) return;
+                if (sender.getServer().hasStopped()) {
+                    completion.completeExceptionally(new IllegalStateException("Server stopped before whitelist command completed"));
+                    return;
+                }
+                try {
+                    final ParseResults<CommandSourceStack> currentCommand = mapSource(command, ignored -> currentSource);
+                    // Permissions can change while the remote lookup is in flight.
+                    com.mojang.brigadier.context.CommandContextBuilder<CommandSourceStack> stage = currentCommand.getContext();
+                    while (stage != null) {
+                        for (final var node : stage.getNodes()) {
+                            if (!node.getNode().canUse(currentSource)) {
+                                currentSource.sendFailure(Component.literal("You no longer have permission to run this whitelist command."));
+                                currentSource.callback().onFailure();
+                                completion.complete(null);
+                                return;
+                            }
+                        }
+                        stage = stage.getChild();
+                    }
+                    if (outcome != null && outcome.profile() != null) {
+                        sender.getServer().services().nameToIdCache().add(outcome.profile());
+                    }
+                    this.performCommandAsync(currentCommand, commandString, throwCommandError)
+                        .whenComplete((ignored, failure) -> {
+                            if (failure == null) completion.complete(null);
+                            else completion.completeExceptionally(failure);
+                        });
+                } catch (final Throwable failure) {
+                    completion.completeExceptionally(failure);
+                }
+            };
+            if (sender.getServer().hasStopped()) {
+                completion.completeExceptionally(new IllegalStateException("Server stopped before whitelist command completed"));
+            } else if (sourceHandle != null) {
+                final boolean scheduled = sourceHandle.taskScheduler.schedule(currentEntity -> {
+                    if (currentEntity instanceof net.minecraft.server.level.ServerPlayer player && !player.connection.isAcceptingMessages()) {
+                        completion.completeExceptionally(new IllegalStateException("Whitelist command source disconnected"));
+                        return;
+                    }
+                    CommandSourceStack currentSource = sender.withEntity(currentEntity).withLevel((ServerLevel)currentEntity.level())
+                        .withPosition(currentEntity.position());
+                    if (refreshPlayerPermissions && currentEntity instanceof net.minecraft.server.level.ServerPlayer player) {
+                        currentSource = currentSource.withSource(player.commandSource()).withPermission(player.permissions());
+                    }
+                    resume.accept(currentSource);
+                }, retired -> completion.completeExceptionally(new IllegalStateException("Whitelist command source retired")), 1L);
+                if (!scheduled) completion.completeExceptionally(new IllegalStateException("Whitelist command source retired"));
+            } else if (sender.source == sender.getServer() || sender.source instanceof net.minecraft.server.rcon.RconConsoleSource) {
+                io.papermc.paper.threadedregions.RegionizedServer.getInstance().addTask(() -> resume.accept(sender));
+            } else {
+                // Command blocks and non-entity plugin sources retain their captured region.
+                final var task = io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.createTickTaskQueue(
+                    sender.getLevel(), net.minecraft.util.Mth.floor(sender.getPosition().x()) >> 4,
+                    net.minecraft.util.Mth.floor(sender.getPosition().z()) >> 4, () -> resume.accept(sender)
+                );
+                if (!task.queue()) completion.completeExceptionally(new IllegalStateException("Whitelist command source region unavailable"));
+            }
+        });
+        return completion;
+    }
+    // Tessera end - await whitelist profiles outside all tick threads
+

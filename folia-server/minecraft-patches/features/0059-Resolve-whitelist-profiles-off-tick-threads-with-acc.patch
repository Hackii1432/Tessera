@@ -0,0 +1,156 @@
+package io.papermc.paper.command;
+
+import com.mojang.brigadier.context.ContextChain;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import com.mojang.brigadier.exceptions.SimpleCommandExceptionType;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executor;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Supplier;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.arguments.GameProfileArgument;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.players.CachedUserNameToIdResolver;
+import net.minecraft.server.players.NameAndId;
+import net.minecraft.util.StringUtil;
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/** Internal command preparation, not a plugin API or a replacement for authentication. */
+@NullMarked
+public final class WhitelistProfileLookup {
+    private static final org.slf4j.Logger LOGGER = com.mojang.logging.LogUtils.getLogger();
+    private static final WhitelistProfileLookup INSTANCE = new WhitelistProfileLookup(
+        new ThreadPoolExecutor(2, 2, 0L, TimeUnit.MILLISECONDS, new ArrayBlockingQueue<>(32),
+            Thread.ofPlatform().daemon().name("Tessera whitelist profiles-", 0).factory(),
+            new ThreadPoolExecutor.AbortPolicy()), 10L, TimeUnit.SECONDS
+    );
+    private final Executor executor;
+    private final long timeout;
+    private final TimeUnit timeoutUnit;
+    private final ConcurrentHashMap<String, CompletableFuture<Outcome>> inFlight = new ConcurrentHashMap<>();
+
+    public WhitelistProfileLookup(final Executor executor, final long timeout, final TimeUnit timeoutUnit) {
+        this.executor = executor;
+        this.timeout = timeout;
+        this.timeoutUnit = timeoutUnit;
+    }
+
+    public record Outcome(@Nullable NameAndId profile, @Nullable Throwable failure) {
+        public NameAndId requireProfile(final String requestedName) throws CommandSyntaxException {
+            if (this.failure != null) {
+                throw new SimpleCommandExceptionType(Component.literal(
+                    "Unable to look up player '" + requestedName + "': profile service unavailable, timed out or busy. Please try again."
+                )).create();
+            }
+            if (this.profile == null) {
+                throw GameProfileArgument.ERROR_UNKNOWN_PLAYER.create();
+            }
+            return this.profile;
+        }
+    }
+
+    public record Prepared(GameProfileArgument.NameResult argument, CompletableFuture<Outcome> result) {}
+
+    public static @Nullable Prepared prepare(final ContextChain<CommandSourceStack> chain, final CommandSourceStack sender) {
+        ContextChain<CommandSourceStack> terminal = chain;
+        boolean whitelist = false;
+        while (true) {
+            whitelist |= terminal.getTopContext().getNodes().stream().anyMatch(node -> {
+                final String name = node.getNode().getName();
+                return name.equals("whitelist") || name.equals("minecraft:whitelist");
+            });
+            if (terminal.getStage() == ContextChain.Stage.EXECUTE) break;
+            terminal = terminal.nextStage();
+        }
+        final var context = terminal.getTopContext();
+        if (!whitelist) {
+            return null;
+        }
+        final GameProfileArgument.Result targets;
+        try {
+            targets = context.getArgument("targets", GameProfileArgument.Result.class);
+        } catch (final IllegalArgumentException absent) {
+            return null; // on/off/list/reload
+        }
+        if (!(targets instanceof GameProfileArgument.NameResult named) || named.tessera$isPrepared()) {
+            return null; // selectors need their existing owner's context
+        }
+        final String name = named.tessera$name();
+        final boolean removing = context.getNodes().stream().anyMatch(node -> node.getNode().getName().equals("remove"));
+        final NameAndId known = removing ? findKnownForRemoval(sender, name) : findKnown(sender, name);
+        if (known != null) {
+            named.tessera$prepare(new Outcome(known, null));
+            return null;
+        }
+        if (!StringUtil.isValidPlayerName(name)) {
+            named.tessera$prepare(new Outcome(null, null));
+            return null;
+        }
+        if (!(sender.getServer().services().nameToIdCache() instanceof CachedUserNameToIdResolver resolver)) {
+            named.tessera$prepare(new Outcome(null, new IllegalStateException("Unsupported profile resolver")));
+            return null;
+        }
+        return new Prepared(named, INSTANCE.request(name, () -> resolver.tessera$lookupUncachedForWhitelist(name)));
+    }
+
+    public static @Nullable NameAndId findKnown(final CommandSourceStack sender, final String name) {
+        if (sender.getServer().services().nameToIdCache() instanceof CachedUserNameToIdResolver resolver) {
+            return resolver.tessera$getValidCached(name);
+        }
+        return null;
+    }
+
+    public static @Nullable NameAndId findKnownForRemoval(final CommandSourceStack sender, final String name) {
+        // Remove the stored identity even without usercache/network availability. For add,
+        // a stale whitelist name alone is NOT evidence of the name's current UUID owner.
+        for (final var entry : sender.getServer().getPlayerList().getWhiteList().getEntries()) {
+            final NameAndId profile = entry.getUser();
+            if (profile != null && profile.name().equalsIgnoreCase(name)) {
+                return profile;
+            }
+        }
+        return findKnown(sender, name);
+    }
+
+    public CompletableFuture<Outcome> request(final String name, final Supplier<Optional<NameAndId>> lookup) {
+        final String key = name.toLowerCase(Locale.ROOT);
+        final CompletableFuture<Outcome> pending = new CompletableFuture<>();
+        final CompletableFuture<Outcome> existing = this.inFlight.putIfAbsent(key, pending);
+        if (existing != null) {
+            // A caller cancelling its own command must not cancel another caller's lookup.
+            return existing.copy();
+        }
+        pending.orTimeout(this.timeout, this.timeoutUnit);
+        pending.whenComplete((ignored, failure) -> this.inFlight.remove(key, pending));
+        try {
+            this.executor.execute(() -> {
+                if (pending.isDone()) return;
+                try {
+                    final Optional<NameAndId> result = lookup.get();
+                    final NameAndId profile = result.orElse(null);
+                    if (profile != null && (profile.id() == null || !profile.name().equalsIgnoreCase(name))) {
+                        throw new IllegalStateException("Profile service returned a different player identity");
+                    }
+                    pending.complete(new Outcome(profile, null));
+                } catch (final Throwable failure) {
+                    pending.complete(new Outcome(null, failure));
+                }
+            });
+        } catch (final java.util.concurrent.RejectedExecutionException busy) {
+            pending.complete(new Outcome(null, busy));
+        }
+        return pending.handle((result, failure) -> {
+            final Outcome outcome = failure == null ? result : new Outcome(null, failure);
+            if (outcome.failure() != null) {
+                LOGGER.warn("Whitelist profile lookup failed for {}: {}", name, outcome.failure().toString());
+            }
+            return outcome;
+        });
+    }
+}

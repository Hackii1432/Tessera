+    // Tessera start - nonblocking whitelist profile preparation
+    public @org.jspecify.annotations.Nullable NameAndId tessera$getValidCached(final String name) {
+        this.stateLock.lock();
+        try {
+            final GameProfileInfo entry = this.profilesByName.get(name.toLowerCase(Locale.ROOT));
+            if (entry == null || System.currentTimeMillis() >= entry.expirationDate.getTime()) {
+                return null;
+            }
+            entry.setLastAccess(this.getNextOperation());
+            return entry.nameAndId();
+        } finally {
+            this.stateLock.unlock();
+        }
+    }
+
+    public Optional<NameAndId> tessera$lookupUncachedForWhitelist(final String name) {
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()) {
+            throw new IllegalStateException("Whitelist profile network lookups cannot run on a tick thread");
+        }
+        if (!StringUtil.isValidPlayerName(name)) {
+            return Optional.empty();
+        }
+        if (!io.papermc.paper.configuration.GlobalConfiguration.get().proxies.isProxyOnlineMode()) {
+            // Preserve Vanilla's case-sensitive offline UUID derivation. Known profiles
+            // and existing whitelist entries are resolved before reaching this fallback.
+            return this.createUnknownProfile(name);
+        }
+        if (this.profileRepository instanceof com.mojang.authlib.services.MinecraftServicesProfileRepository repository) {
+            return repository.tessera$findProfileByNameStrict(name).map(NameAndId::new);
+        }
+        return this.profileRepository.findProfileByName(name).map(NameAndId::new);
+    }
+    // Tessera end - nonblocking whitelist profile preparation
+

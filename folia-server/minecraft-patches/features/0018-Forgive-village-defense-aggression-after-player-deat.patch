     @Override
@@ -151,6 +165,12 @@ public class IronGolem extends AbstractGolem implements NeutralMob {
         super.readAdditionalSaveData(input);
         this.setPlayerCreated(input.getBooleanOr("PlayerCreated", false));
         this.readPersistentAngerSaveData(this.level(), input);
+        this.tesseraForgivenVillagePlayers.clear();
+        for (ValueInput entry : input.childrenListOrEmpty("Tessera.ForgivenVillagePlayers")) {
+            entry.read("Player", UUIDUtil.CODEC)
+                .ifPresent(playerUuid -> entry.getLong("VillagerOffenseCounter")
+                    .ifPresent(offenseCounter -> this.tesseraForgivenVillagePlayers.put(playerUuid, offenseCounter)));
+        }
     }
 
     @Override
@@ -178,6 +198,30 @@ public class IronGolem extends AbstractGolem implements NeutralMob {
         return this.persistentAngerTarget;
     }
 
+    @Override
+    public void playerDied(final ServerLevel level, final UUID playerUuid, final long villagerOffenseCounter) {
+        NeutralMob.super.playerDied(level, playerUuid, villagerOffenseCounter);
+        if (level.getGameRules().get(net.minecraft.world.level.gamerules.GameRules.FORGIVE_DEAD_PLAYERS)) {
+            this.tesseraForgivenVillagePlayers.put(playerUuid, villagerOffenseCounter);
+        }
+    }
+
+    public boolean tessera$isVillagePlayerForgiven(final UUID playerUuid, final long villagerOffenseCounter) {
+        Long forgivenCounter = this.tesseraForgivenVillagePlayers.get(playerUuid);
+        if (forgivenCounter == null) {
+            return false;
+        }
+        if (forgivenCounter.longValue() != villagerOffenseCounter) {
+            this.tesseraForgivenVillagePlayers.remove(playerUuid);
+            return false;
+        }
+        return true;
+    }
+
+    public void tessera$revokeVillagePlayerForgiveness(final UUID playerUuid) {
+        this.tesseraForgivenVillagePlayers.remove(playerUuid);
+    }
+
     private float getAttackDamage() {
         return (float)this.getAttributeValue(Attributes.ATTACK_DAMAGE);
     }

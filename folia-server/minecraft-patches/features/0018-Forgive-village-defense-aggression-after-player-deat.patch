@@ -144,6 +150,14 @@ public class IronGolem extends AbstractGolem implements NeutralMob {
         super.addAdditionalSaveData(output);
         output.putBoolean("PlayerCreated", this.isPlayerCreated());
         this.addPersistentAngerSaveData(output);
+        if (!this.tesseraForgivenVillagePlayers.isEmpty()) {
+            ValueOutput.ValueOutputList forgivenPlayers = output.childrenList("Tessera.ForgivenVillagePlayers");
+            this.tesseraForgivenVillagePlayers.forEach((playerUuid, offenseCounter) -> {
+                ValueOutput entry = forgivenPlayers.addChild();
